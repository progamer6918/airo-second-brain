filters:
  and:
    - 'file.inFolder("worklog/sessions")'
    - 'file.ext == "md"'
    - 'type == "airo-session"'

properties:
  project:
    displayName: Project
  objective:
    displayName: Tujuan
  position:
    displayName: Posisi
  status:
    displayName: Hasil
  can_advance:
    displayName: Boleh lanjut
  date:
    displayName: Tanggal

views:
  - type: table
    name: Hari Ini
    filters:
      and:
        - 'date == today()'
    order:
      - file.name
      - project
      - position
      - status
      - can_advance

  - type: table
    name: Semua Sesi
    order:
      - file.name
      - date
      - project
      - position
      - status
      - can_advance
