filters:
  and:
    - 'file.inFolder("worklog/sessions")'
    - 'file.ext == "md"'
    - 'type == "airo-session"'

properties:
  title:
    displayName: Sesi
  project:
    displayName: Proyek
  objective:
    displayName: Tujuan
  position:
    displayName: Posisi
  status:
    displayName: Hasil
  can_advance:
    displayName: Boleh lanjut
  date:
    displayName: Tanggal
  closed_at:
    displayName: Waktu Selesai

views:
  - type: table
    name: Hari Ini
    filters:
      and:
        - 'date == today()'
    order:
      - closed_at
      - date
      - title
      - project
      - position
      - status
      - can_advance

  - type: table
    name: Sesi Terbaru
    filters:
      and:
        - 'date >= dateadd(today(), -14, "days")'
    order:
      - closed_at
      - date
      - title
      - project
      - position
      - status
      - can_advance
    orderDirection: desc

  - type: table
    name: Riwayat Sesi
    order:
      - closed_at
      - date
      - title
      - project
      - position
      - status
      - can_advance
    orderDirection: desc
