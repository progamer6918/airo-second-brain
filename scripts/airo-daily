#!/usr/bin/env python3
import os
import sys
import argparse
from datetime import datetime


def _load_project_registry(repo_root):
    """Load PROJECT_REGISTRY.tsv for project link resolution."""
    reg_path = os.path.join(repo_root, "control/PROJECT_REGISTRY.tsv")
    if not os.path.exists(reg_path):
        return {}
    registry = {}
    with open(reg_path, encoding="utf-8") as f:
        reader = __import__("csv").DictReader(f, delimiter="\t")
        for row in reader:
            registry[row["project_name"]] = row
            for alias in row.get("aliases", "").split(","):
                alias = alias.strip()
                if alias:
                    registry[alias] = row
    return registry

_PROJECT_REGISTRY_CACHE = None

def _resolve_project_for_daily(proj_name):
    """Resolve project name/alias to registry entry. Returns None if unresolvable."""
    global _PROJECT_REGISTRY_CACHE
    if _PROJECT_REGISTRY_CACHE is None:
        repo_root = os.environ.get("AIRO_REPO_ROOT") or os.path.abspath(
            os.path.join(os.path.dirname(__file__), "..")
        )
        _PROJECT_REGISTRY_CACHE = _load_project_registry(repo_root)
    return _PROJECT_REGISTRY_CACHE.get(proj_name)

def parse_session_file(filepath):
    with open(filepath, "r", encoding="utf-8") as f:
        content = f.read()

    title = os.path.basename(filepath).replace(".md", "")
    lines = content.splitlines()

    status_block = []
    in_status = False

    hasil_block = []
    in_hasil = False

    berikutnya_block = []
    in_berikutnya = False

    for line in lines:
        if "## 🧭 AIRO STATUS" in line or "## STATUS" in line:
            in_status = True
            in_hasil = False
            in_berikutnya = False
            continue
        elif "## 📌 Hasil" in line:
            in_status = False
            in_hasil = True
            in_berikutnya = False
            continue
        elif "## ➡️ Berikutnya" in line:
            in_status = False
            in_hasil = False
            in_berikutnya = True
            continue
        elif line.startswith("## "):
            in_status = False
            in_hasil = False
            in_berikutnya = False

        if in_status:
            status_block.append(line)
        elif in_hasil:
            hasil_block.append(line)
        elif in_berikutnya:
            berikutnya_block.append(line)

    status_text = "\n".join(status_block).strip()
    hasil_text = "\n".join(hasil_block).strip()
    berikutnya_text = "\n".join(berikutnya_block).strip()

    return {
        "filename": os.path.basename(filepath),
        "title": title,
        "status": status_text,
        "hasil": hasil_text,
        "berikutnya": berikutnya_text,
        "path": filepath
    }

def generate_daily(repo_root, date_str):
    sessions_root = os.path.join(repo_root, "worklog/sessions", date_str)
    daily_file = os.path.join(repo_root, "worklog/daily", date_str + ".md")
    os.makedirs(os.path.dirname(daily_file), exist_ok=True)

    if not os.path.exists(sessions_root):
        content = "# Ringkasan Harian — " + date_str + "\n\n"
        content += "*(Generator Harian Otomatis — Terderivasi secara Deterministik)*\n\n"
        content += "## 🧭 Status Umum\nTidak ada sesi pekerjaan terpantau pada tanggal " + date_str + ".\n"
        with open(daily_file, "w", encoding="utf-8") as f:
            f.write(content)
        return daily_file

    project_dirs = sorted([d for d in os.listdir(sessions_root) if os.path.isdir(os.path.join(sessions_root, d))])
    
    sections = []
    for proj in project_dirs:
        pdir = os.path.join(sessions_root, proj)
        files = sorted([f for f in os.listdir(pdir) if f.endswith(".md")])
        if not files:
            continue
        
        # Resolve project wikilink from registry
        proj_reg = _resolve_project_for_daily(proj)
        if proj_reg and proj_reg.get("project_path"):
            proj_link = "[[" + proj_reg["project_path"].replace(".md","") + "|" + proj_reg["project_name"] + "]]"
        else:
            proj_link = proj  # safe plain fallback
        proj_section = ["### Proyek: " + proj_link]
        for fname in files:
            fpath = os.path.join(pdir, fname)
            parsed = parse_session_file(fpath)
            rel_link = "../sessions/" + date_str + "/" + proj + "/" + fname
            proj_section.append("- **[" + parsed['title'] + "](" + rel_link + ")**")

            # High-quality semantic summary if available, else degrade gracefully to status block
            if parsed["hasil"] and parsed["berikutnya"] and "Pekerjaan sesi telah selesai dieksekusi" not in parsed["hasil"]:
                block_lines = []
                block_lines.append("  Hasil — " + parsed["hasil"].replace("\n", "; "))
                block_lines.append("  Berikutnya — " + parsed["berikutnya"].replace("\n", "; "))
                proj_section.append("\n".join(block_lines))
            elif parsed["status"]:
                indent_status = "\n  ".join(parsed["status"].splitlines())
                proj_section.append("  ```text\n  " + indent_status + "\n  ```")

        sections.append("\n".join(proj_section))

    has_backfill = any("M1 Governance" in s for s in sections)
    backfill_note = ""
    if date_str == "2026-08-04" or has_backfill:
        backfill_note = "\n> [!NOTE]\n> Coverage before M2 activation is partial/backfilled, not a complete record of every project activity that occurred that day.\n"

    content = "# Ringkasan Harian — " + date_str + "\n\n"
    content += "*(Generator Harian Otomatis — Terderivasi secara Deterministik)*\n"
    content += backfill_note + "\n"
    content += "## 🧭 Sesi Pekerjaan Terdaftar\n\n"
    content += "\n\n".join(sections) + "\n"

    with open(daily_file, "w", encoding="utf-8") as f:
        f.write(content)
    return daily_file

def main():
    parser = argparse.ArgumentParser(description="AIRO Daily View Generator")
    parser.add_argument("date", nargs="?", default=datetime.now().strftime("%Y-%m-%d"), help="Date string YYYY-MM-DD")
    args = parser.parse_args()

    repo_root = os.environ.get("AIRO_REPO_ROOT") or os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
    daily_file = generate_daily(repo_root, args.date)
    print("DAILY_GENERATED=" + daily_file)

if __name__ == "__main__":
    main()
