#!/home/egitaristorandas/.hermes/hermes-agent/venv/bin/python
# -*- coding: utf-8 -*-
"""
airo-hermes-worker ? Persistent NL queue worker for AIRO Second Brain

Polls ~/.local/state/airo-second-brain/hermes-bridge/queue/ every POLL_INTERVAL seconds for pending items.
Processes each item via AIAgent.chat() using Hermes Direct Python API.
Sends reply directly via Telegram sendMessage (NOT getUpdates).

Contract proofs (static, verified 2026-06-18):
  - AIAgent.chat(msg) -> str: run_agent.py L4588-4600
    def chat(self, message: str, ...) -> str:
        result = self.run_conversation(message, ...)
        return result["final_response"]
  - "safe" toolset: toolsets.py L334-338
    "safe": {"description": "Safe toolkit without terminal access",
             "tools": [], "includes": ["web", "vision", "image_gen"]}
    Expanded: web_search, web_extract, vision_analyze, image_generate
    EXCLUDED: terminal, process, write_file, patch, execute_code, search_files

Architecture:
  Worker polls ~/.local/state/airo-second-brain/hermes-bridge/queue/ (no Telegram getUpdates).
  Token read from ~/.airo/telegram.env (same source as gateway, never logged).
  Session ID per chat_id for conversation continuity.
"""

import sys
import os
import json
import time
import fcntl
import logging
import subprocess
import urllib.request
import urllib.parse
import urllib.error
import uuid
import re
from typing import Optional

# ─── Bounded EAB Intent Pre-Router ───────────────────────────────────────────
def try_handle_eab_intent(text: str, owner_chat_id: str) -> Optional[str]:
    """Bounded EAB pre-router for pending, clarification, and manual intake."""
    clean = text.strip().lower()

    eab_project_dir = os.path.join(
        REPO_DIR,
        "ecosystem/projects/earesmes-arfin-bridge",
    )
    if eab_project_dir not in sys.path:
        sys.path.insert(0, eab_project_dir)

    from src.adapter.eab_live_client import EABLiveSignedClient

    # Existing read-only pending path.
    if "cek" in clean and (
        "pending" in clean
        or "transaksi" in clean
        or "arfin" in clean
    ):
        try:
            client = EABLiveSignedClient(fake_mode=False)
            res = client.list_pending(owner_chat_id)

            application_status = str(
                res.get("application_status", "")
            ).upper()
            if (
                res.get("status") == "error"
                or res.get("ok") is False
                or application_status != "SUCCESS"
            ):
                return "⚠️ Gagal menghubungi service Arfin live."

            payload = res.get("payload")
            if not isinstance(payload, dict):
                payload = {}

            items = (
                res.get("pending_items")
                or payload.get("items")
                or []
            )

            if not items:
                return (
                    "ℹ️ Tidak ada transaksi Arfin yang "
                    "memerlukan klarifikasi saat ini."
                )

            lines = [
                "📋 Daftar Transaksi Arfin Pending Clarification:"
            ]
            for idx, item in enumerate(items, 1):
                short_ref = (
                    item.get("short_ref")
                    or f"AF-{1000 + idx}"
                )
                desc = item.get(
                    "description",
                    "Transaksi Baru",
                )
                amt = item.get("amount", 0)
                lines.append(
                    f"{idx}. {short_ref} — "
                    f"Rp {amt:,.0f} ({desc})"
                )
            return "\n".join(lines)
        except Exception:
            return (
                "⚠️ Terjadi kesalahan saat memeriksa "
                "transaksi pending."
            )

    # Existing explicit AF-XXXX clarification path.
    # M16 resolves display short_ref to canonical pending_id/version first.
    af_match = re.match(
        r"^(AF-\d+)\s+(.+)$",
        text.strip(),
        re.IGNORECASE,
    )
    if af_match:
        short_ref = af_match.group(1).upper()
        clarification_text = af_match.group(2).strip()
        try:
            client = _eab_new_live_client()
            pending_res = client.list_pending(owner_chat_id)
            if not _eab_application_success(pending_res):
                return (
                    f"⚠️ Klarifikasi {short_ref} "
                    "belum terkonfirmasi terkirim."
                )
            matches = []
            for item in _eab_extract_pending_items(
                pending_res
            ):
                record = _eab_pending_record(item)
                if (
                    record is not None
                    and record["short_ref"].upper()
                    == short_ref
                ):
                    matches.append(record)
            if len(matches) != 1:
                return (
                    f"⚠️ Referensi {short_ref} tidak bisa "
                    "dipetakan ke satu pending Arfin aktif."
                )
            record = matches[0]
            res = client.submit_clarification(
                pending_id=record["pending_id"],
                pending_version=record["pending_version"],
                clarification_text=clarification_text,
                owner_chat_id=owner_chat_id,
            )
            if not _eab_application_success(res):
                return (
                    f"⚠️ Klarifikasi {short_ref} "
                    "belum terkonfirmasi terkirim."
                )
            payload = res.get("payload")
            if not isinstance(payload, dict):
                payload = {}
            if payload.get(
                "arfin_telegram_outbound_suppressed"
            ) is not True:
                return (
                    f"⚠️ Klarifikasi {short_ref} "
                    "tidak memenuhi kontrak EAB."
                )
            return (
                str(
                    payload.get("next_prompt")
                    or payload.get("completion_message")
                    or ""
                ).strip()
                or f"✅ Klarifikasi {short_ref} diproses Arfin."
            )
        except Exception:
            return (
                f"⚠️ Klarifikasi {short_ref} "
                "belum terkonfirmasi terkirim."
            )

    parsed = _eab_parse_manual_catat(text)
    if parsed is not None:
        drafts = _eab_load_manual_drafts()
        now_sec = int(time.time())
        request_id = (
            "manual_"
            + str(owner_chat_id)
            + "_"
            + uuid.uuid4().hex[:16]
        )

        drafts[str(owner_chat_id)] = {
            "request_id": request_id,
            "amount": parsed["amount"],
            "description": parsed["description"],
            "category": parsed["category"],
            "subcategory": parsed["subcategory"],
            "direction": "EXPENSE",
            "created_at": now_sec,
            "ttl_seconds": 86400,
            "expires_at": now_sec + 86400,
            "status": "NEEDS_FUNDING_ACCOUNT",
        }
        _eab_save_manual_drafts(drafts)

        return (
            f"Saya tangkap transaksi Rp"
            f"{parsed['amount']:,.0f} "
            f"({parsed['description']}). "
            "Sumber dananya apa? Contoh: Blu, BCA, Cash."
        )

    drafts = _eab_load_manual_drafts()
    key = str(owner_chat_id)
    draft = drafts.get(key)

    if draft:
        now_sec = int(time.time())

        if now_sec >= int(draft.get("expires_at", 0)):
            drafts.pop(key, None)
            _eab_save_manual_drafts(drafts)
            return (
                "Draft transaksi sebelumnya sudah kedaluwarsa. "
                "Kirim ulang dengan format `catat ...`."
            )

        if clean in {"batal", "cancel", "batalkan"}:
            drafts.pop(key, None)
            _eab_save_manual_drafts(drafts)
            return "Draft transaksi manual dibatalkan."

        funding_account = text.strip()
        if not funding_account:
            return "Sumber dananya apa? Contoh: Blu, BCA, Cash."

        try:
            client = EABLiveSignedClient(fake_mode=False)
            res = client.create_manual(
                request_id=draft["request_id"],
                owner_chat_id=owner_chat_id,
                amount=draft["amount"],
                description=draft["description"],
                funding_account=funding_account,
                category=draft["category"],
                subcategory=draft["subcategory"],
                direction=draft.get("direction", "EXPENSE"),
            )
        except Exception:
            res = {}

        payload = res.get("payload")
        if not isinstance(payload, dict):
            payload = {}

        verified = (
            str(res.get("application_status", "")).upper()
            == "SUCCESS"
            and payload.get("staged") is True
            and payload.get("write_verified") is True
            and payload.get("direct_ledger_write") is False
            and bool(payload.get("review_queue_ref"))
        )

        if verified:
            drafts.pop(key, None)
            _eab_save_manual_drafts(drafts)
            return (
                f"✅ Transaksi Rp{draft['amount']:,.0f} "
                f"({draft['description']}, via {funding_account}) "
                "sudah terverifikasi masuk Review Queue Arfin. "
                "Belum ada direct ledger write."
            )

        # Do not delete the draft on backend uncertainty.
        return (
            "⚠️ Transaksi belum terkonfirmasi masuk "
            "Review Queue Arfin. Draft tetap tersimpan "
            "untuk retry; saya tidak mengklaim transaksi berhasil."
        )

    active_reply = _eab_handle_active_prompt_reply(
        text,
        owner_chat_id,
    )
    if active_reply is not None:
        return active_reply

    return None

from datetime import datetime
from pathlib import Path

# ??? Paths ???????????????????????????????????????????????????????????????????
REPO_DIR       = str(Path(__file__).resolve().parents[1])
HERMES_ROOT    = "/home/egitaristorandas/.hermes/hermes-agent"
ENV_FILE       = "/home/egitaristorandas/.airo/telegram.env"

LOCAL_STATE_DIR = os.path.expanduser(
    "~/.local/state/airo-second-brain/hermes-bridge"
)
NL_QUEUE_DIR   = os.path.join(LOCAL_STATE_DIR, "queue")
DEAD_DIR       = os.path.join(LOCAL_STATE_DIR, "dead")
LOG_FILE       = os.path.join(LOCAL_STATE_DIR, "hermes-worker.log")
TICK_FILE      = os.path.join(LOCAL_STATE_DIR, "hermes-worker-last-tick.txt")
WORKER_LOCK    = os.path.join(LOCAL_STATE_DIR, "hermes-worker.lock")
SESSION_MAP    = os.path.join(LOCAL_STATE_DIR, "hermes-worker-sessions.json")

# ??? Worker config ???????????????????????????????????????????????????????????
POLL_INTERVAL  = 5          # seconds between queue scans
MAX_ATTEMPTS   = 3          # dead-letter after this many failures
HERMES_TIMEOUT = 120        # wall-clock seconds for one AIAgent.chat() call
HERMES_MAX_TURNS = 8        # max model iterations per turn
HERMES_TOOLSETS  = ["safe"] # toolsets.py L334: web_search, web_extract, vision_analyze, image_generate
                             # EXCLUDED: terminal, process, write_file, patch, execute_code

EAB_MANUAL_DRAFTS_FILE = os.path.join(
    LOCAL_STATE_DIR,
    "eab-manual-drafts.json",
)

# EAB_M16_PROACTIVE_FRONTDESK_V1
EAB_PROACTIVE_STATE_FILE = os.path.join(
    LOCAL_STATE_DIR,
    "eab-proactive-frontdesk.json",
)
EAB_PROACTIVE_POLL_SECONDS = 60
EAB_PROACTIVE_ERROR_BACKOFF_SECONDS = 300

def _eab_load_manual_drafts() -> dict:
    try:
        if os.path.isfile(EAB_MANUAL_DRAFTS_FILE):
            with open(
                EAB_MANUAL_DRAFTS_FILE,
                encoding="utf-8",
            ) as f:
                data = json.load(f)
                return data if isinstance(data, dict) else {}
    except Exception:
        pass
    return {}

def _eab_save_manual_drafts(drafts: dict) -> None:
    os.makedirs(
        os.path.dirname(EAB_MANUAL_DRAFTS_FILE),
        exist_ok=True,
    )
    tmp = (
        EAB_MANUAL_DRAFTS_FILE
        + "."
        + uuid.uuid4().hex
        + ".tmp"
    )
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(
            drafts,
            f,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    os.replace(tmp, EAB_MANUAL_DRAFTS_FILE)

def _eab_new_live_client():
    eab_project_dir = os.path.join(
        REPO_DIR,
        "ecosystem/projects/earesmes-arfin-bridge",
    )
    if eab_project_dir not in sys.path:
        sys.path.insert(0, eab_project_dir)
    from src.adapter.eab_live_client import EABLiveSignedClient
    return EABLiveSignedClient(fake_mode=False)


def _eab_application_success(res: dict) -> bool:
    return (
        isinstance(res, dict)
        and res.get("status") != "error"
        and res.get("ok") is not False
        and str(
            res.get("application_status", "")
        ).upper() == "SUCCESS"
    )


def _eab_extract_pending_items(res: dict) -> list:
    if not _eab_application_success(res):
        return []
    payload = res.get("payload")
    if not isinstance(payload, dict):
        payload = {}
    items = (
        res.get("pending_items")
        or payload.get("items")
        or []
    )
    return items if isinstance(items, list) else []


def _eab_load_proactive_state() -> dict:
    default = {
        "schema_version": 1,
        "next_poll_at": 0,
        "active_prompt": None,
        "delivered": {},
    }
    try:
        if os.path.isfile(EAB_PROACTIVE_STATE_FILE):
            with open(
                EAB_PROACTIVE_STATE_FILE,
                encoding="utf-8",
            ) as f:
                data = json.load(f)
            if isinstance(data, dict):
                default.update(data)
    except Exception:
        pass
    if not isinstance(default.get("delivered"), dict):
        default["delivered"] = {}
    return default


def _eab_save_proactive_state(state: dict) -> None:
    os.makedirs(
        os.path.dirname(EAB_PROACTIVE_STATE_FILE),
        exist_ok=True,
    )
    tmp = (
        EAB_PROACTIVE_STATE_FILE
        + "."
        + uuid.uuid4().hex
        + ".tmp"
    )
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(
            state,
            f,
            indent=2,
            ensure_ascii=False,
            sort_keys=True,
        )
    os.replace(tmp, EAB_PROACTIVE_STATE_FILE)


def _eab_pending_record(item: dict):
    if not isinstance(item, dict):
        return None
    pending_id = str(item.get("pending_id") or "").strip()
    try:
        version = int(item.get("pending_version") or 0)
    except Exception:
        version = 0
    if not pending_id or version < 1:
        return None
    return {
        "pending_id": pending_id,
        "pending_version": version,
        "short_ref": str(item.get("short_ref") or "").strip(),
        "type": str(item.get("type") or "").strip(),
        "amount": item.get("amount"),
        "account": str(item.get("account") or "").strip(),
        "category": str(item.get("category") or "").strip(),
        "description": str(
            item.get("description") or ""
        ).strip(),
        "prompt": str(item.get("prompt") or "").strip(),
    }


def _eab_format_proactive_prompt(item: dict) -> str:
    record = _eab_pending_record(item)
    if record is None:
        return ""
    desc = record["description"] or "Transaksi Arfin"
    amount = record.get("amount")
    try:
        amount_line = (
            f"Rp{float(amount):,.0f} · {desc}"
            if amount is not None
            else desc
        )
    except Exception:
        amount_line = desc

    prompt = record["prompt"]
    if not prompt:
        ptype = record["type"]
        if ptype in {
            "missing_account",
            "outgoing_confirmation",
        }:
            prompt = "Sumber dana / akun yang benar apa?"
        elif ptype == "missing_category":
            prompt = "Kategori atau subkategori yang benar apa?"
        elif ptype == "missing_amount_account":
            prompt = "Nominal dan akun yang benar apa?"
        else:
            prompt = "Arfin membutuhkan klarifikasi untuk transaksi ini."

    return (
        "📥 Ada transaksi Arfin yang butuh klarifikasi.\n\n"
        + amount_line
        + "\n\n"
        + prompt
        + "\n\nBalas langsung di sini."
    )


def _eab_set_active_record(
    state: dict,
    record: dict | None,
    *,
    mark_delivered: bool = False,
    now_sec: int | None = None,
) -> None:
    state["active_prompt"] = record
    if record is None or not mark_delivered:
        return
    delivered = state.setdefault("delivered", {})
    delivered[record["pending_id"]] = {
        "pending_version": int(record["pending_version"]),
        "sent_at": int(
            time.time()
            if now_sec is None
            else now_sec
        ),
    }
    if len(delivered) > 50:
        ordered = sorted(
            delivered.items(),
            key=lambda kv: int(
                (kv[1] or {}).get("sent_at", 0)
            ),
        )
        for key, _ in ordered[:-50]:
            delivered.pop(key, None)


def _eab_proactive_tick(
    token: str,
    owner_chat_id: str,
    *,
    now_sec: int | None = None,
    client=None,
    sender=None,
) -> dict:
    now = int(
        time.time()
        if now_sec is None
        else now_sec
    )
    state = _eab_load_proactive_state()
    if now < int(state.get("next_poll_at") or 0):
        return {"checked": False, "reason": "not_due"}

    state["next_poll_at"] = (
        now + EAB_PROACTIVE_POLL_SECONDS
    )

    try:
        live_client = client or _eab_new_live_client()
        res = live_client.list_pending(owner_chat_id)
    except Exception:
        state["next_poll_at"] = (
            now + EAB_PROACTIVE_ERROR_BACKOFF_SECONDS
        )
        _eab_save_proactive_state(state)
        return {"checked": True, "status": "backend_error"}

    if not _eab_application_success(res):
        state["next_poll_at"] = (
            now + EAB_PROACTIVE_ERROR_BACKOFF_SECONDS
        )
        _eab_save_proactive_state(state)
        return {"checked": True, "status": "backend_error"}

    items = _eab_extract_pending_items(res)
    if not items:
        _eab_set_active_record(state, None)
        _eab_save_proactive_state(state)
        return {"checked": True, "status": "no_pending"}

    record = _eab_pending_record(items[0])
    if record is None:
        state["next_poll_at"] = (
            now + EAB_PROACTIVE_ERROR_BACKOFF_SECONDS
        )
        _eab_save_proactive_state(state)
        return {"checked": True, "status": "malformed_pending"}

    delivered = state.setdefault("delivered", {})
    previous = delivered.get(record["pending_id"])
    previous_version = 0
    if isinstance(previous, dict):
        try:
            previous_version = int(
                previous.get("pending_version") or 0
            )
        except Exception:
            previous_version = 0

    _eab_set_active_record(state, record)

    if previous_version == record["pending_version"]:
        _eab_save_proactive_state(state)
        return {
            "checked": True,
            "status": "deduped",
            "pending_id": record["pending_id"],
        }

    message = _eab_format_proactive_prompt(record)
    if not message:
        state["next_poll_at"] = (
            now + EAB_PROACTIVE_ERROR_BACKOFF_SECONDS
        )
        _eab_save_proactive_state(state)
        return {"checked": True, "status": "malformed_pending"}

    send = sender or tg_send_message
    sent = bool(
        send(
            token,
            str(owner_chat_id),
            message,
        )
    )

    if not sent:
        _eab_save_proactive_state(state)
        return {
            "checked": True,
            "status": "send_failed",
            "pending_id": record["pending_id"],
        }

    _eab_set_active_record(
        state,
        record,
        mark_delivered=True,
        now_sec=now,
    )
    _eab_save_proactive_state(state)
    return {
        "checked": True,
        "status": "sent",
        "pending_id": record["pending_id"],
        "pending_version": record["pending_version"],
    }


def _eab_active_reply_reserved(text: str) -> bool:
    value = str(text or "").strip().lower()
    return (
        value.startswith("/")
        or value.startswith("catat ")
        or value.startswith("cek ")
        or value in {
            "batal",
            "cancel",
            "batalkan",
            "help",
            "bantuan",
        }
    )


def _eab_handle_active_prompt_reply(
    text: str,
    owner_chat_id: str,
    *,
    client=None,
):
    if _eab_active_reply_reserved(text):
        return None

    state = _eab_load_proactive_state()
    active = state.get("active_prompt")
    if not isinstance(active, dict):
        return None

    active_record = _eab_pending_record(active)
    if active_record is None:
        _eab_set_active_record(state, None)
        _eab_save_proactive_state(state)
        return None

    live_client = client or _eab_new_live_client()

    try:
        get_res = live_client.get_pending(
            active_record["pending_id"],
            owner_chat_id,
        )
    except Exception:
        return (
            "⚠️ Saya belum bisa memverifikasi status "
            "klarifikasi Arfin. Jawaban belum saya kirim."
        )

    if not _eab_application_success(get_res):
        return (
            "⚠️ Saya belum bisa memverifikasi status "
            "klarifikasi Arfin. Jawaban belum saya kirim."
        )

    payload = get_res.get("payload")
    if not isinstance(payload, dict):
        payload = {}

    if payload.get("found") is not True:
        _eab_set_active_record(state, None)
        _eab_save_proactive_state(state)
        return (
            "ℹ️ Klarifikasi Arfin ini sudah tidak pending. "
            "Tidak ada jawaban yang dikirim."
        )

    current = _eab_pending_record(
        payload.get("record")
    )
    if current is None:
        return (
            "⚠️ Status klarifikasi Arfin tidak valid. "
            "Jawaban belum saya kirim."
        )

    if (
        current["pending_version"]
        != active_record["pending_version"]
    ):
        _eab_set_active_record(state, current)
        _eab_save_proactive_state(state)
        return (
            "⚠️ Klarifikasi Arfin berubah sejak prompt terakhir. "
            "Saya tidak mengirim jawaban lama.\n\n"
            + _eab_format_proactive_prompt(current)
        )

    try:
        submit = live_client.submit_clarification(
            pending_id=current["pending_id"],
            pending_version=current["pending_version"],
            clarification_text=str(text).strip(),
            owner_chat_id=owner_chat_id,
        )
    except Exception:
        return (
            "⚠️ Jawaban belum terkonfirmasi diproses Arfin. "
            "Prompt tetap aktif untuk retry."
        )

    if not _eab_application_success(submit):
        return (
            "⚠️ Jawaban belum terkonfirmasi diproses Arfin. "
            "Prompt tetap aktif untuk retry."
        )

    result = submit.get("payload")
    if not isinstance(result, dict):
        result = {}

    if result.get(
        "arfin_telegram_outbound_suppressed"
    ) is not True:
        return (
            "⚠️ Respons Arfin tidak memenuhi kontrak EAB. "
            "Saya tidak mengklaim klarifikasi berhasil."
        )

    next_record = _eab_pending_record(
        result.get("pending")
    )

    if next_record is not None:
        _eab_set_active_record(
            state,
            next_record,
            mark_delivered=True,
        )
        _eab_save_proactive_state(state)
        next_prompt = str(
            result.get("next_prompt")
            or next_record.get("prompt")
            or ""
        ).strip()
        return (
            next_prompt
            or _eab_format_proactive_prompt(
                next_record
            )
        )

    _eab_set_active_record(state, None)
    _eab_save_proactive_state(state)

    completion = str(
        result.get("completion_message") or ""
    ).strip()

    return (
        completion
        or "✅ Klarifikasi Arfin sudah diproses dan "
           "tidak lagi tercatat sebagai pending."
    )


def _eab_parse_manual_catat(text: str):
    value = str(text or "").strip()
    match = re.match(
        r"^catat\s+(.+)$",
        value,
        re.IGNORECASE,
    )
    if not match:
        return None

    body = match.group(1).strip()
    amount_match = re.match(
        r"^(?:rp\.?\s*)?"
        r"(\d[\d.,]*)"
        r"(?:\s*(k|rb|ribu))?"
        r"\b\s*(.*)$",
        body,
        re.IGNORECASE,
    )
    if not amount_match:
        return None

    raw_number = amount_match.group(1)
    suffix = (amount_match.group(2) or "").lower()
    description = (
        amount_match.group(3).strip()
        or "Transaksi manual"
    )

    if suffix:
        normalized = raw_number.replace(",", ".")
        if normalized.count(".") > 1:
            normalized = normalized.replace(".", "")
        amount = int(float(normalized) * 1000)
    else:
        digits = re.sub(r"\D", "", raw_number)
        amount = int(digits or "0")

    if amount <= 0:
        return None

    return {
        "amount": amount,
        "description": description,
        "category": "Other / Review",
        "subcategory": "Lainnya",
    }

# ??? Logging ?????????????????????????????????????????????????????????????????
logger = logging.getLogger(__name__)
logger.addHandler(logging.NullHandler())
_logging_configured = False


def configure_logging():
    """Configure file and stderr logging only when main() starts."""
    global _logging_configured

    if _logging_configured:
        return

    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)

    logger.handlers.clear()
    logger.setLevel(logging.INFO)
    logger.propagate = False

    formatter = logging.Formatter(
        "[%(asctime)s] [HERMES-WORKER] %(message)s",
        datefmt="%Y-%m-%dT%H:%M:%S",
    )

    file_handler = logging.FileHandler(LOG_FILE, encoding="utf-8")
    file_handler.setFormatter(formatter)

    stderr_handler = logging.StreamHandler(sys.stderr)
    stderr_handler.setFormatter(formatter)

    logger.addHandler(file_handler)
    logger.addHandler(stderr_handler)
    _logging_configured = True


# ??? Credentials (read-only, token never logged) ?????????????????????????????
def load_credentials():
    """Read token and owner chat_id from ~/.airo/telegram.env.
    Token is NEVER written to any log file or queue item.
    """
    token, owner_chat_id = "", ""
    if not os.path.exists(ENV_FILE):
        logger.error("ENV_FILE not found: %s", ENV_FILE)
        return None, None
    try:
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    k, v = k.strip(), v.strip()
                    if k == "AIRO_TELEGRAM_BOT_TOKEN":
                        token = v
                    elif k == "AIRO_TELEGRAM_CHAT_ID":
                        owner_chat_id = v
    except Exception as e:
        logger.error("Error reading credentials: %s", e)
        return None, None
    if not token or not owner_chat_id:
        logger.error("Missing token or chat_id in env file")
        return None, None
    if token.startswith("YOUR_BOT_TOKEN") or owner_chat_id.startswith("YOUR_CHAT_ID"):
        logger.error("Placeholder credentials detected ? not configured")
        return None, None
    # Log only that credentials are present, never the values
    logger.info("Credentials loaded: token=<present>, owner_chat_id=<present>")
    return token, owner_chat_id


# ??? Session map: stable session_id per Telegram chat_id ?????????????????????
def load_session_map() -> dict:
    try:
        if os.path.exists(SESSION_MAP):
            with open(SESSION_MAP) as f:
                return json.load(f)
    except Exception as e:
        logger.warning("Could not load session map: %s", e)
    return {}


def save_session_map(smap: dict):
    tmp = SESSION_MAP + "." + uuid.uuid4().hex + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(smap, f, indent=2)
        os.replace(tmp, SESSION_MAP)
    except Exception as e:
        logger.warning("Could not save session map: %s", e)
        try:
            os.remove(tmp)
        except Exception:
            pass


def get_or_create_session_id(chat_id: str, smap: dict) -> str:
    """Return a stable session_id for this chat_id, creating if absent."""
    if chat_id not in smap:
        smap[chat_id] = str(uuid.uuid4())
        save_session_map(smap)
        logger.info("Created new session for chat_id=<redacted>: %s", smap[chat_id])
    return smap[chat_id]


# ??? Telegram sendMessage (bot token never logged) ???????????????????????????
def tg_send_message(token: str, chat_id: str, text: str) -> bool:
    """Send a reply via Telegram sendMessage. NOT getUpdates. No second poller."""
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    # Truncate to Telegram max 4096 chars
    if len(text) > 4000:
        text = text[:4000] + "\n\n_(truncated)_"
    # Send plain text. Model replies may contain Markdown characters that
    # Telegram rejects with HTTP 400 when parse_mode is enabled.
    payload = urllib.parse.urlencode({
        "chat_id": chat_id,
        "text": text,
    }).encode("utf-8")
    for attempt in range(3):
        try:
            req = urllib.request.Request(url, data=payload, method="POST")
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                if data.get("ok"):
                    return True
                logger.warning("sendMessage not ok: %s", data.get("description", ""))
        except urllib.error.HTTPError as e:
            try:
                detail = e.read().decode("utf-8", errors="replace")[:500]
            except Exception:
                detail = "<unavailable>"
            logger.warning(
                "sendMessage attempt %d failed: HTTP %s: %s",
                attempt + 1,
                e.code,
                detail,
            )
            if attempt < 2:
                time.sleep(2 ** attempt)
        except Exception as e:
            logger.warning("sendMessage attempt %d failed: %s", attempt + 1, e)
            if attempt < 2:
                time.sleep(2 ** attempt)
    return False


# ??? Queue item I/O ??????????????????????????????????????????????????????????
def load_item(path: str) -> dict | None:
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        logger.error("Failed to read queue item %s: %s", path, e)
        return None


def save_item(path: str, item: dict):
    """Atomic save via tmp + os.replace."""
    tmp = path + "." + uuid.uuid4().hex + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(item, f, indent=2, ensure_ascii=False)
        os.replace(tmp, path)
    except Exception as e:
        logger.error("Failed to save queue item %s: %s", path, e)
        try:
            os.remove(tmp)
        except Exception:
            pass


def move_to_dead(path: str, item: dict):
    """Move failed item to dead-letter directory."""
    os.makedirs(DEAD_DIR, exist_ok=True)
    dead_path = os.path.join(DEAD_DIR, os.path.basename(path))
    item["status"] = "dead"
    item["dead_at"] = datetime.now().isoformat()
    save_item(dead_path, item)
    try:
        os.remove(path)
    except Exception:
        pass
    logger.error("Dead-lettered: %s", item.get("request_id", "unknown"))


# ??? Per-item fcntl lock ?????????????????????????????????????????????????????
def try_lock_item(lock_path: str):
    """Try to acquire exclusive non-blocking flock on item lock file.
    Returns open file object on success, None if already locked."""
    try:
        fd = open(lock_path, "w")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return fd
    except (IOError, OSError):
        return None


def unlock_item(fd):
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
        fd.close()
    except Exception:
        pass


# ??? Hermes invocation via Direct Python API ?????????????????????????????????
def init_hermes():
    """Add Hermes root to sys.path so run_agent can be imported."""
    if HERMES_ROOT not in sys.path:
        sys.path.insert(0, HERMES_ROOT)



EARESMES_CONTEXT_FILES = (
    ("BOOT.md", 6000, "head"),
    ("CURRENT.md", 5000, "head"),
    ("state/active-context.md", 7000, "tail"),
    ("CONTEXT.md", 3000, "head"),
    ("AGENTS.md", 3000, "head"),
    ("SECURITY.md", 2000, "head"),
    ("personas/airo-sync.md", 3500, "head"),
    ("agents/earesmes.md", 3000, "head"),
    ("ecosystem/earesmes-hermes.md", 3500, "head"),
)


def _git_context(args: list[str]) -> str:
    result = subprocess.run(
        ["git", "-C", REPO_DIR, *args],
        capture_output=True,
        text=True,
        timeout=5,
        check=False,
    )

    if result.returncode != 0:
        return f"[unavailable rc={result.returncode}]"

    return result.stdout.strip() or "[empty]"


def build_earesmes_system_prompt() -> str:
    identity = """
You are Earesmes, Egit's single owner-facing personal AI,
chief of staff, AIRO ecosystem operator, and resident AIRO Sync persona.

AIRO Sync is your operating responsibility across agents and interfaces.
It is not another persona and not another worker separate from Earesmes.

Hermes is the local runtime infrastructure underneath Earesmes.
AIRO Second Brain (ASB) is your canonical shared memory.

Use the canonical context and live Git evidence below before relying on
conversation history or model memory.

When asked what was last synced or updated:
- report the latest canonical ASB commit shown below;
- include its short hash and subject;
- distinguish a canonical Git update from a scheduler heartbeat;
- do not invent activity not shown by evidence;
- do not tell Egit to run terminal commands when evidence is already present.

Never claim that Earesmes is unrelated to AIRO Sync.
Never claim that Earesmes is only a Telegram chatbot.
Use Bahasa Indonesia. Be direct, casual, factual, and concise.
""".strip()

    head = _git_context(["rev-parse", "--short=12", "HEAD"])

    log = _git_context([
        "log",
        "-5",
        "--pretty=format:%h | %ad | %s",
        "--date=iso-strict",
    ])

    sections = [
        identity,
        "# LIVE ASB GIT EVIDENCE",
        f"HEAD: {head}\n\nRecent commits:\n{log}",
    ]

    for relative, limit, mode in EARESMES_CONTEXT_FILES:
        file_path = Path(REPO_DIR) / relative

        if not file_path.is_file():
            if relative == "state/active-context.md":
                continue

            raise RuntimeError(
                f"Required canonical context missing: {relative}"
            )

        content = file_path.read_text(
            encoding="utf-8",
            errors="replace",
        )

        if len(content) > limit:
            if mode == "tail":
                content = "[older content truncated]\n" + content[-limit:]
            else:
                content = content[:limit] + "\n[file truncated]"

        sections.append(
            f"# CANONICAL ASB FILE: {relative}\n{content}"
        )

    return "\n\n".join(sections)[:38000]


_hermes_runtime_config = None


def load_hermes_model_config() -> dict:
    global _hermes_runtime_config

    if _hermes_runtime_config is not None:
        return dict(_hermes_runtime_config)

    from pathlib import Path
    import yaml

    home = Path(
        os.environ.get("HERMES_HOME", "~/.hermes")
    ).expanduser()

    candidates = (
        home / "config.yaml",
        home / "cli-config.yaml",
    )

    for config_path in candidates:
        if not config_path.is_file():
            continue

        data = yaml.safe_load(
            config_path.read_text(encoding="utf-8")
        ) or {}

        config = data.get("model")

        if isinstance(config, str):
            model = config.strip()
            provider = "auto"
            base_url = ""

        elif isinstance(config, dict):
            model = str(
                config.get("default")
                or config.get("model")
                or ""
            ).strip()

            provider = str(
                config.get("provider")
                or "auto"
            ).strip()

            base_url = str(
                config.get("base_url")
                or ""
            ).strip()

        else:
            continue

        if not model:
            continue

        _hermes_runtime_config = {
            "model": model,
            "provider": provider or "auto",
            "base_url": base_url,
        }

        return dict(_hermes_runtime_config)

    raise RuntimeError(
        "Hermes model missing from config.yaml"
    )


def call_hermes(text: str, session_id: str) -> str | None:
    """
    Call AIAgent.chat(text) via Hermes Direct Python API.

    Contract (static proof, run_agent.py L4588-4600):
      AIAgent.chat(message: str) -> str
      Returns result["final_response"] ? plain string, the model reply.

    Tool restriction (static proof, toolsets.py L334-338):
      enabled_toolsets=["safe"]
      Resolved tools: web_search, web_extract, vision_analyze, image_generate
      EXCLUDED: terminal, process, write_file, patch, execute_code, search_files

    The worker process runs inside the Hermes venv; imports are safe.
    """
    try:
        from run_agent import AIAgent  # available after init_hermes()
    except ImportError as e:
        logger.error("Cannot import AIAgent: %s", e)
        return None

    try:
        runtime = load_hermes_model_config()

        agent_kwargs = {
            "model": runtime["model"],
            "provider": runtime["provider"],
            "session_id": session_id,
            "enabled_toolsets": HERMES_TOOLSETS,
            "max_iterations": HERMES_MAX_TURNS,
            "quiet_mode": True,
            "skip_memory": False,
            "ephemeral_system_prompt": build_earesmes_system_prompt(),
        }

        if runtime["base_url"]:
            agent_kwargs["base_url"] = runtime["base_url"]

        agent = AIAgent(**agent_kwargs)
        # AIAgent.chat() -> str (run_agent.py L4600: return result["final_response"])
        reply = agent.chat(text)
        if reply is None:
            logger.warning("AIAgent.chat() returned None for session %s", session_id)
            return None
        return str(reply)
    except Exception as e:
        logger.error("AIAgent.chat() raised: %s", e)
        return None


# ??? Single worker flock ??????????????????????????????????????????????????????
_worker_lock_fd = None


def acquire_worker_lock() -> bool:
    global _worker_lock_fd
    try:
        _worker_lock_fd = open(WORKER_LOCK, "w")
        fcntl.flock(_worker_lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        _worker_lock_fd.write(str(os.getpid()))
        _worker_lock_fd.flush()
        return True
    except (IOError, OSError):
        return False


def release_worker_lock():
    global _worker_lock_fd
    try:
        if _worker_lock_fd:
            fcntl.flock(_worker_lock_fd, fcntl.LOCK_UN)
            _worker_lock_fd.close()
    except Exception:
        pass
    try:
        os.remove(WORKER_LOCK)
    except Exception:
        pass


# ??? Process one queue item ???????????????????????????????????????????????????
def process_item(path: str, item: dict, token: str, owner_chat_id: str, smap: dict):
    request_id = item.get("request_id", "unknown")
    chat_id = item.get("chat_id", "")
    text = item.get("text", "")

    # Security: chat_id must match owner allowlist
    if chat_id != owner_chat_id:
        logger.error("SECURITY: item %s has unauthorized chat_id ? dead-lettering", request_id)
        move_to_dead(path, item)
        return

    # Duplicate reply guard
    if item.get("reply_sent"):
        logger.info("Item %s already replied ? skipping", request_id)
        item["status"] = "done"
        save_item(path, item)
        return

    # Check attempts
    attempt_count = item.get("attempt_count", 0)
    if attempt_count >= MAX_ATTEMPTS:
        logger.error("Item %s exceeded max_attempts=%d ? dead-lettering", request_id, MAX_ATTEMPTS)
        move_to_dead(path, item)
        return

    # Transition to processing
    item["status"] = "processing"
    item["last_attempt_at"] = datetime.now().isoformat()
    item["attempt_count"] = attempt_count + 1
    save_item(path, item)

    logger.info("Processing item %s (attempt %d/%d)", request_id, attempt_count + 1, MAX_ATTEMPTS)

    # Reuse an already-computed reply after a Telegram send failure.
    # This prevents duplicate model calls on retry.
    reply = item.get("reply_text")

    if reply:
        logger.info(
            "Item %s: reusing cached reply; model call skipped",
            request_id,
        )
    else:
        # Check bounded EAB intent pre-router first
        eab_reply = try_handle_eab_intent(text, owner_chat_id)
        if eab_reply is not None:
            logger.info("Item %s: handled by bounded EAB pre-router", request_id)
            reply = eab_reply
        else:
            session_id = get_or_create_session_id(chat_id, smap)

            import signal as _signal

            def _timeout_handler(signum, frame):
                raise TimeoutError(
                    f"Hermes timeout after {HERMES_TIMEOUT}s"
                )

            old_handler = _signal.signal(
                _signal.SIGALRM,
                _timeout_handler,
            )
            _signal.alarm(HERMES_TIMEOUT)

            try:
                reply = call_hermes(text, session_id)
            except TimeoutError as exc:
                logger.error(
                    "Item %s timed out: %s",
                    request_id,
                    exc,
                )
                reply = None
            except Exception as exc:
                logger.error(
                    "Item %s Hermes error: %s",
                    request_id,
                    exc,
                )
                reply = None
            finally:
                _signal.alarm(0)
                _signal.signal(_signal.SIGALRM, old_handler)

        if reply:
            item["reply_text"] = reply
            save_item(path, item)

    if not reply:
        # Failure ? increment and mark failed (will retry up to MAX_ATTEMPTS)
        item["status"] = "failed"
        save_item(path, item)
        logger.warning("Item %s: no reply (attempt %d)", request_id, attempt_count + 1)
        return

    # Send reply via Telegram (NOT getUpdates, NOT second poller)
    sent = tg_send_message(token, chat_id, reply)
    if sent:
        item["status"] = "done"
        item["reply_sent"] = True
        item["done_at"] = datetime.now().isoformat()
        save_item(path, item)
        logger.info("Item %s: done (reply sent)", request_id)
    else:
        item["status"] = "failed"
        save_item(path, item)
        logger.warning("Item %s: reply computed but sendMessage failed (attempt %d)", request_id, attempt_count + 1)


# ??? Main loop ????????????????????????????????????????????????????????????????
def main():
    os.makedirs(NL_QUEUE_DIR, exist_ok=True)
    os.makedirs(DEAD_DIR, exist_ok=True)
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    os.makedirs(os.path.dirname(TICK_FILE), exist_ok=True)

    configure_logging()
    logger.info("airo-hermes-worker starting. PID=%d", os.getpid())

    if not acquire_worker_lock():
        logger.error("Another worker instance is running (lock held). Exiting.")
        sys.exit(1)

    token, owner_chat_id = load_credentials()
    if not token or not owner_chat_id:
        logger.error("Credentials not configured. Exiting.")
        release_worker_lock()
        sys.exit(1)

    # Initialize Hermes Python path and validate model before queue processing.
    init_hermes()

    try:
        runtime = load_hermes_model_config()
    except Exception as exc:
        logger.error(
            "Hermes model configuration invalid: %s",
            exc,
        )
        release_worker_lock()
        sys.exit(1)

    logger.info(
        "Hermes runtime configured: model=%s provider=%s base_url=%s",
        runtime["model"],
        runtime["provider"],
        "configured" if runtime["base_url"] else "default",
    )

    try:
        context_chars = len(build_earesmes_system_prompt())
    except Exception as exc:
        logger.error("Earesmes ASB context invalid: %s", exc)
        release_worker_lock()
        sys.exit(1)

    logger.info(
        "Earesmes ASB context ready: chars=%d",
        context_chars,
    )

    # Load session map
    smap = load_session_map()

    logger.info(
        "Worker ready. Queue=%s Poll=%ds Timeout=%ds MaxTurns=%d Toolsets=%s",
        NL_QUEUE_DIR, POLL_INTERVAL, HERMES_TIMEOUT, HERMES_MAX_TURNS, HERMES_TOOLSETS,
    )

    import signal as _signal

    def shutdown(signum, frame):
        logger.info("Signal %d received. Shutting down.", signum)
        release_worker_lock()
        sys.exit(0)

    _signal.signal(_signal.SIGTERM, shutdown)
    _signal.signal(_signal.SIGINT, shutdown)

    try:
        while True:
            # Write health tick
            try:
                with open(TICK_FILE, "w") as f:
                    f.write(datetime.now().isoformat())
            except Exception:
                pass

            # M16 proactive front-desk timer.
            # No Telegram getUpdates: signed EAB reads plus
            # outbound sendMessage only for a new pending/version.
            try:
                _eab_proactive_tick(
                    token,
                    owner_chat_id,
                )
            except Exception as exc:
                logger.warning(
                    "EAB proactive tick failed closed: %s",
                    exc,
                )

            # Scan queue for pending and retryable-failed items
            try:
                entries = sorted(os.listdir(NL_QUEUE_DIR))
            except Exception as e:
                logger.error("Cannot list queue dir: %s", e)
                time.sleep(POLL_INTERVAL)
                continue

            for fname in entries:
                if not fname.endswith(".json"):
                    continue

                path = os.path.join(NL_QUEUE_DIR, fname)
                lock_path = path + ".lock"

                item = load_item(path)
                if item is None:
                    continue

                status = item.get("status", "pending")
                if status in ("done", "dead"):
                    continue
                if status == "failed" and item.get("attempt_count", 0) >= MAX_ATTEMPTS:
                    move_to_dead(path, item)
                    continue

                # Try to acquire per-item lock (prevents concurrent processing)
                item_lock = try_lock_item(lock_path)
                if item_lock is None:
                    continue  # another worker instance holds it

                try:
                    # Re-read after lock (state may have changed)
                    item = load_item(path)
                    if item is None:
                        continue
                    status = item.get("status", "pending")
                    if status in ("done", "dead"):
                        continue

                    process_item(path, item, token, owner_chat_id, smap)
                finally:
                    unlock_item(item_lock)
                    try:
                        os.remove(lock_path)
                    except Exception:
                        pass

            time.sleep(POLL_INTERVAL)

    finally:
        release_worker_lock()
        logger.info("Worker stopped.")


if __name__ == "__main__":
    main()
