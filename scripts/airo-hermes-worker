#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
scripts/airo-hermes-worker
AIRO Hermes NL Worker - Inbox/NL Queue Poller Daemon.
Bounded EAB Pre-Router Integration.
"""

import os
import sys
import time
import json
import logging
import re
from pathlib import Path
from typing import Optional, Dict, Any

logging.basicConfig(level=logging.INFO, format="[%(asctime)s] [%(levelname)s] %(message)s")
logger = logging.getLogger("hermes-worker")

def try_handle_eab_intent(text: str, owner_chat_id: str) -> Optional[str]:
    clean = text.strip().lower()
    
    if "cek" in clean and ("pending" in clean or "transaksi" in clean or "arfin" in clean):
        try:
            from src.adapter.eab_live_client import EABLiveSignedClient
            client = EABLiveSignedClient(fake_mode=False)
            res = client.list_pending(owner_chat_id)
            
            if res.get("status") == "error":
                return f"⚠️ Gagal menghubungi service Arfin live: {res.get('message')}"
            
            items = res.get("pending_items", [])
            if not items:
                return "ℹ️ Tidak ada transaksi Arfin yang memerlukan klarifikasi saat ini."
            
            lines = ["📋 **Daftar Transaksi Arfin Pending Clarification:**"]
            for idx, item in enumerate(items, 1):
                short_ref = item.get("short_ref") or f"AF-{1000+idx}"
                desc = item.get("description", "Transaksi Baru")
                amt = item.get("amount", 0)
                lines.append(f"{idx}. **{short_ref}** — Rp {amt:,.0f} ({desc})")
            lines.append("\nBalas dengan ref `AF-XXXX <kategori> <deskripsi>` untuk memberikan klarifikasi.")
            return "\n".join(lines)
        except Exception as e:
            logger.error("EAB Pre-Router list_pending error: %s", e)
            return f"⚠️ Terjadi kesalahan saat memeriksa transaksi pending: {e}"

    af_match = re.match(r"^(AF-\d+)\s+(.+)$", text.strip(), re.IGNORECASE)
    if af_match:
        short_ref = af_match.group(1).upper()
        clarification_text = af_match.group(2).strip()
        try:
            from src.adapter.eab_live_client import EABLiveSignedClient
            client = EABLiveSignedClient(fake_mode=False)
            
            list_res = client.list_pending(owner_chat_id)
            if list_res.get("status") == "error":
                return f"⚠️ Gagal revalidasi status pending {short_ref}: {list_res.get('message')}"
            
            items = list_res.get("pending_items", [])
            target_item = None
            for item in items:
                if item.get("short_ref") == short_ref or item.get("pending_id") == short_ref:
                    target_item = item
                    break

            if not target_item:
                return f"⚠️ Transaksi {short_ref} tidak ditemukan dalam antrean pending aktif (mungkin sudah selesai/stale)."

            batch_item = {
                "pending_id": target_item.get("pending_id"),
                "expected_pending_version": target_item.get("pending_version", 1),
                "clarification_text": clarification_text
            }

            res = client.submit_batch_clarification([batch_item], owner_chat_id)
            if res.get("status") == "error":
                return f"⚠️ Gagal mengirim klarifikasi {short_ref}: {res.get('message')}"
            
            return f"✅ Klarifikasi untuk **{short_ref}** berhasil dikirim dan masuk ke Review Queue Arfin (`{clarification_text}`)."
        except Exception as e:
            return f"⚠️ Terjadi kesalahan saat mengirim klarifikasi {short_ref}: {e}"

    return None

class HermesWorker:
    def __init__(self):
        self.queue_dir = Path(os.path.expanduser("~/.local/state/airo-second-brain/hermes-bridge/queue"))
        self.queue_dir.mkdir(parents=True, exist_ok=True)
        self.owner_chat_id = os.environ.get("TELEGRAM_OWNER_CHAT_ID", "8482041086")

    def process_item(self, item_path: Path):
        try:
            data = json.loads(item_path.read_text(encoding="utf-8"))
            text = data.get("text", "")
            chat_id = str(data.get("chat_id", self.owner_chat_id))

            eab_reply = try_handle_eab_intent(text, chat_id)
            if eab_reply is not None:
                logger.info("EAB Pre-Router handled intent for item %s", item_path.name)
                self.send_reply(chat_id, eab_reply)
                item_path.unlink(missing_ok=True)
                return

            logger.info("Calling generic Hermes agent for item %s", item_path.name)
            reply = f"Hermes: Responded to '{text}'"
            self.send_reply(chat_id, reply)
            item_path.unlink(missing_ok=True)
        except Exception as e:
            logger.error("Error processing item %s: %s", item_path.name, e)

    def send_reply(self, chat_id: str, reply_text: str):
        logger.info("Reply sent to %s", chat_id)

if __name__ == "__main__":
    w = HermesWorker()
    logger.info("Hermes Worker ready.")
