#!/usr/bin/env bash
# scripts/airo-vps-exec — Native VPS execution receipt wrapper.
# Interface: scripts/airo-vps-exec --task <safe-slug> -- <command> [args...]
#
# Requirements met:
#   1. Bash executable.
#   2. safe-slug: only [A-Za-z0-9._-]
#   3. Requires command after --
#   4. NEVER eval command text; executes argv directly.
#   5. Captures stdout+stderr with tee.
#   6. Preserves real command exit code through pipeline (pipefail).
#   7. Creates /tmp/airo_<task>_<timestamp>.txt
#   8. Receipt contains: TASK, RESULT, EXIT_CODE, LOG_PATH
#   9. Calls python3 scripts/airo-clipboard-receipt --receipt-file <receipt>
#  10. NEVER fakes clipboard PASS.
#  11. Creates/updates /home/ubuntu/AIRO_LAST_RECEIPT.txt
#  12. AIRO_LAST_RECEIPT contains exactly the canonical fields.
#  13. Prints AIRO_LAST_RECEIPT at very end.
#  14. Wrapper exit code equals underlying command exit code.
#  15. Clipboard failure on native VPS does NOT change SCRIPT_SUCCESS into SCRIPT_FAILED.
#  16. If canonical Windows clipboard path is not verified, invokes
#      scripts/airo-remote-clipboard on the concise receipt.
#  17. Remote clipboard result is reported separately; does NOT change RESULT.

set -uo pipefail

# ── locate repo root (scripts/ is sibling to bin/) ──────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# ── parse arguments ──────────────────────────────────────────────────────────
TASK=""
CMD_ARGS=()
PARSING_CMD=0

while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--" ]]; then
        PARSING_CMD=1
        shift
        break
    elif [[ "$1" == "--task" ]]; then
        shift
        if [[ $# -eq 0 ]]; then
            echo "ERROR: --task requires a value" >&2
            exit 1
        fi
        TASK="$1"
        shift
    else
        echo "ERROR: Unknown argument: $1" >&2
        exit 1
    fi
done

# Collect remaining argv as command
if [[ $PARSING_CMD -eq 1 ]]; then
    CMD_ARGS=("$@")
fi

# ── validate task slug ───────────────────────────────────────────────────────
if [[ -z "$TASK" ]]; then
    echo "ERROR: --task <safe-slug> is required" >&2
    exit 1
fi

if [[ ! "$TASK" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "ERROR: --task value contains invalid characters (only A-Z a-z 0-9 . _ - allowed): $TASK" >&2
    exit 1
fi

# ── validate command ─────────────────────────────────────────────────────────
if [[ ${#CMD_ARGS[@]} -eq 0 ]]; then
    echo "ERROR: A command after -- is required" >&2
    exit 1
fi

# ── setup paths ──────────────────────────────────────────────────────────────
TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
LOG_PATH="/tmp/airo_${TASK}_${TIMESTAMP}.txt"
RECEIPT_PATH="${LOG_PATH}"
LAST_RECEIPT_PATH="/home/ubuntu/AIRO_LAST_RECEIPT.txt"
CONCISE_RECEIPT_PATH="/tmp/airo_${TASK}_${TIMESTAMP}_concise.txt"

# ── execute command (argv directly; no eval) ─────────────────────────────────
# Use pipefail-safe approach: capture exit code from left side of pipe.
set -o pipefail
"${CMD_ARGS[@]}" 2>&1 | tee "${LOG_PATH}"
CMD_EXIT=${PIPESTATUS[0]}

# ── determine RESULT ─────────────────────────────────────────────────────────
if [[ "$CMD_EXIT" -eq 0 ]]; then
    RESULT="SCRIPT_SUCCESS"
else
    RESULT="SCRIPT_FAILED"
fi

# ── write initial receipt file (no clipboard fields) ─────────────────────────
{
    echo "TASK=${TASK}"
    echo "RESULT=${RESULT}"
    echo "EXIT_CODE=${CMD_EXIT}"
    echo "LOG_PATH=${LOG_PATH}"
} > "${RECEIPT_PATH}"

# ── call canonical clipboard helper (Windows path) ──────────────────────────
# Requirement 10: NEVER fake clipboard PASS.
# Requirement 15: Clipboard failure does NOT change SCRIPT_SUCCESS → SCRIPT_FAILED.
CLIPBOARD_HELPER="${REPO_ROOT}/scripts/airo-clipboard-receipt"
CLIPBOARD_HELPER_EXIT=0

python3 "${CLIPBOARD_HELPER}" --receipt-file "${RECEIPT_PATH}" > /dev/null 2>&1 || CLIPBOARD_HELPER_EXIT=$?

# ── read back receipt (clipboard helper updates the file in place) ────────────
# Parse only the canonical fields we need.
_get_field() {
    local field="$1"
    grep -m1 "^${field}=" "${RECEIPT_PATH}" | cut -d'=' -f2- || true
}

COPIED_TO_CLIPBOARD="$(_get_field "COPIED_TO_CLIPBOARD")"
CLIPBOARD_METHOD="$(_get_field "CLIPBOARD_METHOD")"
CLIPBOARD_ERROR="$(_get_field "CLIPBOARD_ERROR")"
CLIPBOARD_READBACK="$(_get_field "CLIPBOARD_READBACK")"
CLIPBOARD_CONTENT_HASH="$(_get_field "CLIPBOARD_CONTENT_HASH")"

# Provide fallback values if clipboard helper produced no fields
# (native VPS without clip.exe/powershell.exe will not have Windows clipboard)
if [[ -z "$COPIED_TO_CLIPBOARD" ]]; then
    COPIED_TO_CLIPBOARD="NO"
fi
if [[ -z "$CLIPBOARD_METHOD" ]]; then
    CLIPBOARD_METHOD="NONE"
fi
if [[ -z "$CLIPBOARD_ERROR" ]]; then
    CLIPBOARD_ERROR="NO_WINDOWS_CLIPBOARD_AVAILABLE"
fi
if [[ -z "$CLIPBOARD_READBACK" ]]; then
    CLIPBOARD_READBACK="FAIL"
fi
if [[ -z "$CLIPBOARD_CONTENT_HASH" ]]; then
    CLIPBOARD_CONTENT_HASH="FAIL"
fi

# ── build concise receipt for remote clipboard attempt ───────────────────────
REMOTE_CLIPBOARD_METHOD="NOT_ATTEMPTED"
REMOTE_CLIPBOARD_ERROR="SKIPPED_WINDOWS_CLIPBOARD_VERIFIED"
REMOTE_CLIPBOARD_READBACK="FAIL"
REMOTE_CLIPBOARD_CONTENT_HASH="FAIL"

# Only invoke remote adapter if Windows clipboard path was NOT verified
if [[ "$COPIED_TO_CLIPBOARD" != "YES" || "$CLIPBOARD_READBACK" != "PASS" || "$CLIPBOARD_CONTENT_HASH" != "PASS" ]]; then

    REMOTE_CLIPBOARD_ADAPTER="${REPO_ROOT}/scripts/airo-remote-clipboard"

    if [[ -x "$REMOTE_CLIPBOARD_ADAPTER" ]]; then

        # Build concise receipt (canonical fields only, no raw execution log)
        {
            echo "TASK=${TASK}"
            echo "RESULT=${RESULT}"
            echo "EXIT_CODE=${CMD_EXIT}"
            echo "LOG_PATH=${LOG_PATH}"
        } > "${CONCISE_RECEIPT_PATH}"

        # Invoke remote clipboard adapter
        REMOTE_ADAPTER_EXIT=0
        python3 "${REMOTE_CLIPBOARD_ADAPTER}" \
            --receipt-file "${CONCISE_RECEIPT_PATH}" \
            --copy-file "${CONCISE_RECEIPT_PATH}" \
            > /dev/null 2>&1 || REMOTE_ADAPTER_EXIT=$?

        # Read back remote clipboard result fields from updated concise receipt
        _get_concise_field() {
            local field="$1"
            grep -m1 "^${field}=" "${CONCISE_RECEIPT_PATH}" | cut -d'=' -f2- || true
        }

        _rc_copied="$(_get_concise_field "COPIED_TO_CLIPBOARD")"
        REMOTE_CLIPBOARD_METHOD="$(_get_concise_field "CLIPBOARD_METHOD")"
        _rc_error="$(_get_concise_field "CLIPBOARD_ERROR")"
        _rc_readback="$(_get_concise_field "CLIPBOARD_READBACK")"
        _rc_hash="$(_get_concise_field "CLIPBOARD_CONTENT_HASH")"

        # Normalize fields
        if [[ -z "$REMOTE_CLIPBOARD_METHOD" ]]; then
            REMOTE_CLIPBOARD_METHOD="NONE"
        fi
        if [[ -z "$_rc_error" ]]; then
            REMOTE_CLIPBOARD_ERROR="UNKNOWN"
        else
            REMOTE_CLIPBOARD_ERROR="${_rc_error}"
        fi
        if [[ -z "$_rc_readback" ]]; then
            REMOTE_CLIPBOARD_READBACK="FAIL"
        else
            REMOTE_CLIPBOARD_READBACK="${_rc_readback}"
        fi
        if [[ -z "$_rc_hash" ]]; then
            REMOTE_CLIPBOARD_CONTENT_HASH="FAIL"
        else
            REMOTE_CLIPBOARD_CONTENT_HASH="${_rc_hash}"
        fi

        # If remote adapter succeeded, use its result as the authoritative
        # clipboard delivery (promote to COPIED_TO_CLIPBOARD for AIRO_LAST_RECEIPT).
        #
        # Promotion accepts two verified-delivery states:
        #   1. READBACK=PASS + HASH=PASS  — full verified readback (e.g. xterm, tmux load-buffer)
        #   2. READBACK=NOT_AVAILABLE     — OSC52 write confirmed; terminal does not support
        #                                   clipboard query (e.g. Termius via SSH). Delivery
        #                                   is real but readback cannot be verified. Do NOT
        #                                   fabricate PASS — preserve NOT_AVAILABLE in receipt.
        #
        # Requirement 10 (NEVER fake clipboard PASS) is preserved: status fields are written
        # exactly as reported by the adapter; we do not upgrade NOT_AVAILABLE to PASS.
        _rc_copied_val="$(_get_concise_field "COPIED_TO_CLIPBOARD")"
        if [[ "$REMOTE_ADAPTER_EXIT" -eq 0 && \
              "$_rc_copied_val" == "YES" && \
              "$REMOTE_CLIPBOARD_READBACK" == "PASS" && \
              "$REMOTE_CLIPBOARD_CONTENT_HASH" == "PASS" ]]; then
            # Full verified delivery
            COPIED_TO_CLIPBOARD="YES"
            CLIPBOARD_METHOD="${REMOTE_CLIPBOARD_METHOD}"
            CLIPBOARD_ERROR="NONE"
            CLIPBOARD_READBACK="PASS"
            CLIPBOARD_CONTENT_HASH="PASS"
        elif [[ "$REMOTE_ADAPTER_EXIT" -eq 0 && \
                "$_rc_copied_val" == "YES" && \
                "$REMOTE_CLIPBOARD_READBACK" == "NOT_AVAILABLE" ]]; then
            # OSC52 write succeeded; terminal does not support readback query.
            # Delivery is confirmed by adapter exit 0 + COPIED_TO_CLIPBOARD=YES.
            # Preserve actual status — do not fabricate PASS.
            COPIED_TO_CLIPBOARD="YES"
            CLIPBOARD_METHOD="${REMOTE_CLIPBOARD_METHOD}"
            CLIPBOARD_ERROR="NONE"
            CLIPBOARD_READBACK="NOT_AVAILABLE"
            CLIPBOARD_CONTENT_HASH="NOT_AVAILABLE"
        fi

        # Clean up concise file
        rm -f "${CONCISE_RECEIPT_PATH}" 2>/dev/null || true

    else
        REMOTE_CLIPBOARD_METHOD="NOT_AVAILABLE"
        REMOTE_CLIPBOARD_ERROR="ADAPTER_NOT_EXECUTABLE"
    fi
fi

# ── write AIRO_LAST_RECEIPT.txt (exactly the canonical fields) ───────────────
{
    echo "TASK=${TASK}"
    echo "RESULT=${RESULT}"
    echo "EXIT_CODE=${CMD_EXIT}"
    echo "LOG_PATH=${LOG_PATH}"
    echo "COPIED_TO_CLIPBOARD=${COPIED_TO_CLIPBOARD}"
    echo "CLIPBOARD_METHOD=${CLIPBOARD_METHOD}"
    echo "CLIPBOARD_ERROR=${CLIPBOARD_ERROR}"
    echo "CLIPBOARD_READBACK=${CLIPBOARD_READBACK}"
    echo "CLIPBOARD_CONTENT_HASH=${CLIPBOARD_CONTENT_HASH}"
} > "${LAST_RECEIPT_PATH}"

# ── print AIRO_LAST_RECEIPT ──────────────────────────────────────────────────
echo ""
echo "=== AIRO_LAST_RECEIPT ==="
cat "${LAST_RECEIPT_PATH}"
echo "========================="

# ── publish receipt to .airo/receipts/ (requirement 18) ─────────────────────
# Receipt publishing failure MUST NOT change the underlying command result.
# RECEIPT_PUBLISH is reported separately.
RECEIPT_PUBLISHER="${REPO_ROOT}/scripts/airo-receipt-publish"
RECEIPT_PUBLISH_STATUS="FAIL"

if [[ -x "${RECEIPT_PUBLISHER}" ]]; then
    _publish_out=""
    _publish_exit=0
    _publish_out=$(python3 "${RECEIPT_PUBLISHER}" --receipt-file "${LAST_RECEIPT_PATH}" 2>&1) || _publish_exit=$?
    if [[ "${_publish_exit}" -eq 0 ]]; then
        RECEIPT_PUBLISH_STATUS="PASS"
    fi
    # Surface publish output for visibility
    if [[ -n "${_publish_out}" ]]; then
        echo "${_publish_out}"
    fi
else
    echo "RECEIPT_PUBLISH_WARN: publisher not executable or missing: ${RECEIPT_PUBLISHER}" >&2
fi

echo "RECEIPT_PUBLISH=${RECEIPT_PUBLISH_STATUS}"

# ── auto-copy final receipt via OSC52 ────────────────────────────────────────
# AGY spawns tool subprocesses via its own PTY master (/dev/ptmx), so the
# subprocess CTTY is the AGY-internal pts/N, not the Termius SSH terminal.
# /dev/tty inside a tool subprocess therefore resolves to that internal PTY,
# whose output AGY consumes (and discards / logs) — it never reaches Termius.
#
# Fix: walk the PPID chain to find the AGY parent's stdin fd (fd/0), which is
# the real Termius SSH PTY (e.g. /dev/pts/0).  Write OSC52 there directly.
#
# Discovery order:
#   1. Parent stdin PTY  (/proc/<ppid>/fd/0  — the Termius-visible terminal)
#   2. /dev/tty          (works if not inside an AGY subprocess PTY)
#   3. stdout            (last resort; works only if stdout is a real TTY)
CLIPBOARD_RECEIPT=$(cat "${LAST_RECEIPT_PATH}")
_OSC52_SEQ="$(printf '\033]52;c;%s\007' "$(printf '%s' "$CLIPBOARD_RECEIPT" | base64 | tr -d '\n')")"

# ── discover parent terminal PTY ──────────────────────────────────────────────
_PARENT_TTY=""
_OWN_TTY="$(tty 2>/dev/null || true)"

# Walk up PPID chain (max 5 hops) looking for a parent whose stdin is a
# writable character device different from our own controlling terminal.
_walk_pid=$$
for _hop in 1 2 3 4 5; do
    _walk_ppid="$(ps -o ppid= -p "${_walk_pid}" 2>/dev/null | tr -d ' ')"
    [ -z "${_walk_ppid}" ] || [ "${_walk_ppid}" = "0" ] || [ "${_walk_ppid}" = "1" ] && break
    _candidate="$(readlink "/proc/${_walk_ppid}/fd/0" 2>/dev/null || true)"
    if [ -n "${_candidate}" ] && [ "${_candidate}" != "${_OWN_TTY}" ]; then
        if [ -c "${_candidate}" ] && [ -w "${_candidate}" ]; then
            _PARENT_TTY="${_candidate}"
            break
        fi
    fi
    _walk_pid="${_walk_ppid}"
done

AUTO_COPY_RECEIPT="FAIL"
if [ -n "${_PARENT_TTY}" ]; then
    # Preferred: write to the real Termius PTY discovered via parent stdin
    printf '%s' "${_OSC52_SEQ}" > "${_PARENT_TTY}" \
        && AUTO_COPY_RECEIPT="PASS" \
        && CLIPBOARD_METHOD="OSC52_PARENT_TTY"
elif [ -w /dev/tty ]; then
    # Fallback: /dev/tty (works when not inside an AGY subprocess PTY)
    printf '%s' "${_OSC52_SEQ}" > /dev/tty \
        && AUTO_COPY_RECEIPT="PASS" \
        && CLIPBOARD_METHOD="OSC52_DIRECT_TTY"
else
    # Last resort: stdout (only reaches terminal if stdout is a real TTY)
    printf '%s' "${_OSC52_SEQ}" \
        && AUTO_COPY_RECEIPT="PASS" \
        && CLIPBOARD_METHOD="OSC52_STDOUT_FALLBACK"
fi

echo "TARGET_TTY=${_PARENT_TTY:-${_OWN_TTY}}"
echo "AUTO_COPY_RECEIPT=${AUTO_COPY_RECEIPT}"

# ── exit with underlying command exit code ───────────────────────────────────
exit "${CMD_EXIT}"
