# Ensure scripts directory is in python path to load entity resolver
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from airo_workdesk_entity_resolver import AwdEntityResolver, format_resolution_receipt

def find_repo_root():
    if os.environ.get("AIRO_REPO_ROOT"):
        return os.path.abspath(os.environ["AIRO_REPO_ROOT"])
    cur = os.path.abspath(os.path.dirname(__file__))
    while cur and cur != os.path.dirname(cur):
        if os.path.exists(os.path.join(cur, "wiki", "workdesk")) or os.path.exists(os.path.join(cur, ".git")):
            return cur
        cur = os.path.dirname(cur)
    return os.getcwd()

REPO_ROOT = find_repo_root()

