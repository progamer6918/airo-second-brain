#!/usr/bin/env python3
"""
scripts/airo-workdesk-current-work
DEPRECATED / COMPATIBILITY WRAPPER:
Delegates WorkDesk current-work rendering directly to unified scripts/airo-session-projection-sync.
Preserved for backwards compatibility with existing callers.
Contract: docs/contracts/AIRO_SESSION_PROJECTION_SYNC_CONTRACT.md
"""
import os
import sys
import subprocess
from pathlib import Path

def main():
    repo_dir = Path(__file__).resolve().parent.parent
    sync_helper = repo_dir / "scripts/airo-session-projection-sync"

    res = subprocess.run(
        [sys.executable, str(sync_helper), "status", "--repo-root", str(repo_dir)],
        capture_output=True,
        text=True
    )

    if "PROJECTION_IDLE" in res.stdout or "PROJECTION_MISSING" in res.stdout:
        subprocess.run([sys.executable, str(sync_helper), "reset", "--repo-root", str(repo_dir)], check=False)

    print("WORKDESK_CURRENT_WORK_WRAPPER=DELEGATED_TO_AIRO_SESSION_PROJECTION_SYNC")
    return 0

if __name__ == "__main__":
    sys.exit(main())
