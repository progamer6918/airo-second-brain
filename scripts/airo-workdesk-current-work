#!/usr/bin/env python3
"""
scripts/airo-workdesk-current-work
Renders sanitized Owner current-work surface from canonical runtime session state.
Uses deterministic repo-specific runtime state directory matching bin/airo-session.
"""
import os
import sys
import json
import hashlib
from pathlib import Path

def get_repo_hash(repo_dir: Path) -> str:
    resolved_path = str(repo_dir.resolve())
    return hashlib.sha256(resolved_path.encode("utf-8")).hexdigest()[:12]

def resolve_owner_vault():
    env_v = os.environ.get("AIRO_WORKDESK_OWNER_VAULT")
    if env_v and Path(env_v).exists():
        return Path(env_v)
    
    cfg_p = Path(os.path.expanduser("~/.config/airo-workdesk/owner-vault-path"))
    if cfg_p.exists():
        val = cfg_p.read_text(encoding="utf-8").strip()
        if val and Path(val).exists():
            return Path(val)
    return None

def get_active_session(repo_dir: Path):
    override_dir = os.environ.get("AIRO_SESSION_STATE_DIR")
    if override_dir and Path(override_dir).exists():
        state_dir = Path(override_dir)
    else:
        repo_h = get_repo_hash(repo_dir)
        xdg_state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
        state_dir = Path(xdg_state) / "airo/second-brain" / repo_h
    
    session_json = state_dir / "active_session.json"
    if session_json.exists():
        try:
            return json.loads(session_json.read_text(encoding="utf-8"))
        except Exception:
            pass
    return None

def render_current_work(sess=None):
    if not sess or not (sess.get("internal_session_id") or sess.get("session_id")):
        return "# 🟢 Sedang Dikerjakan\n\nTidak ada pekerjaan aktif.\n"
    
    pname = sess.get("project_name", "AIRO WorkDesk")
    pos = sess.get("position", "Sedang mengerjakan tugas WorkDesk")
    
    events = sess.get("events", [])
    last_event = events[-1]["summary"] if events else "Sesi aktif dimulai"
    hambatan = "Tidak ada"
    next_act = sess.get("next_action") or "Melanjutkan pekerjaan sampai milestone selesai"

    return f"""# 🟢 Sedang Dikerjakan

| Project | Lagi di | Progress Terakhir | Hambatan | Berikutnya |
|---|---|---|---|---|
| {pname} | {pos} | {last_event} | {hambatan} | {next_act} |
"""

def main():
    repo_dir = Path(__file__).resolve().parent.parent
    sess = get_active_session(repo_dir)
    content = render_current_work(sess)

    # 1. WSL surface
    wsl_cw = repo_dir / "runtime/workdesk/current-work.md"
    wsl_cw.parent.mkdir(parents=True, exist_ok=True)
    wsl_cw.write_text(content, encoding="utf-8")

    # 2. Windows Mirror
    ov = resolve_owner_vault()
    if ov:
        win_cw = ov / "runtime/workdesk/current-work.md"
        win_cw.parent.mkdir(parents=True, exist_ok=True)
        win_cw.write_text(content, encoding="utf-8")

if __name__ == "__main__":
    main()
