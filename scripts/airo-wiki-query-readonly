def search_wiki(query):
    query_lower = query.lower()

    # Check predefined questions
    for key, data in WIKI_DB.items():
        if key in query_lower:
            return data

    # Default fall-back search on files content
    wiki_dir = "/home/egitaristorandas/AI_WORKSPACES/airo-second-brain/wiki"
    matched_files = []

    if os.path.exists(wiki_dir):
        for root, dirs, files in os.walk(wiki_dir):
            for f in files:
                if f.endswith(".md") and f != "README.md":
                    path = os.path.join(root, f)
                    try:
                        with open(path, "r", encoding="utf-8") as file:
                            content = file.read()
                        if query_lower in content.lower():
                            rel_path = os.path.relpath(path, "/home/egitaristorandas/AI_WORKSPACES/airo-second-brain")
                            matched_files.append(rel_path)
                    except:
                        pass

    if matched_files:
        return {
            "answer": f"Pertanyaan '{query}' dicocokkan dengan isi berkas wiki lokal. Silakan rujuk ke berkas referensi untuk informasi selengkapnya.",
            "sources": matched_files[:5],
            "confidence": "medium",
            "canonical_vs_derivative": "derivative wiki files containing query matches",
            "uncertainty": "Jawaban hasil pemindaian kata kunci otomatis tanpa sintesis mendalam.",
            "next_action": "Buka berkas referensi secara manual di Obsidian untuk membaca detailnya."
        }

    return {
        "answer": f"Maaf, tidak ditemukan informasi yang cocok untuk kueri: '{query}' di dalam basis pengetahuan ASB.",
        "sources": [],
        "confidence": "low",
        "canonical_vs_derivative": "none",
        "uncertainty": "Tidak ada kecocokan berkas.",
        "next_action": "Silakan formulasikan ulang kueri Anda atau pastikan data terkait sudah diimpor ke wiki."
    }

def main():
    parser = argparse.ArgumentParser(description="AIRO Hermes Read-Only Wiki Query Utility")
    parser.add_argument("--query", type=str, help="Question to query the wiki about")
    parser.add_argument("--json", action="store_true", help="Output result in JSON format")
    args = parser.parse_args()

    if not args.query:
        parser.print_help()
        sys.exit(0)

    result = search_wiki(args.query)

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print("=== AIRO WIKI READ-ONLY QUERY RESULT ===")
        print(f"Answer: {result['answer']}")
        print(f"Sources: {', '.join(result['sources'])}")
        print(f"Confidence: {result['confidence'].upper()}")
        print(f"Hierarchy: {result['canonical_vs_derivative']}")
        print(f"Uncertainty: {result['uncertainty']}")
        print(f"Next Action: {result['next_action']}")

if __name__ == "__main__":
    main()
