#!/usr/bin/env python3
"""
scripts/airo-workdesk-entity-resolve: Standalone AWD Entity Resolution Tool.
Resolves human business wording into canonical AWD entities before operational querying.
"""

import sys
import os

# Ensure script dir in python path
cur_dir = os.path.dirname(os.path.abspath(__file__))
if cur_dir not in sys.path:
    sys.path.insert(0, cur_dir)

from airo_workdesk_entity_resolver import AwdEntityResolver, format_resolution_receipt

def main():
    if len(sys.argv) < 2:
        print("Usage: airo-workdesk-entity-resolve <user_business_term>")
        sys.exit(1)

    term = " ".join(sys.argv[1:])
    resolver = AwdEntityResolver()
    res = resolver.resolve(term)
    print(format_resolution_receipt(res))
    if res.get("details"):
        print("\nDETAILS:")
        for k, v in res["details"].items():
            if k != "kelurahan_list":
                print(f"- {k}: {v}")
            else:
                print(f"- {k}: {len(v)} kelurahan/desa mapped")

    sys.exit(0 if res["match_status"] == "RESOLVED" else 1)

if __name__ == "__main__":
    main()
