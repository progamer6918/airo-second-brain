#!/usr/bin/env python3
"""
scripts/airo-workdesk-refresh-check: Operational TSV Refresh Validator & Runtime Status Generator.
Validates file existence, schema, row count, period, SHA256 checksum, and registry alignment.
Generates AWD_RUNTIME_STATUS.md automatically.
Zero database, zero materialization, zero TSV mutation.
"""

import os
import sys
import csv
import hashlib
import argparse
from datetime import datetime, timezone

def find_repo_root():
    if os.environ.get("AIRO_REPO_ROOT"):
        return os.path.abspath(os.environ["AIRO_REPO_ROOT"])
    cur = os.path.abspath(os.path.dirname(__file__))
    while cur and cur != os.path.dirname(cur):
        if os.path.exists(os.path.join(cur, "wiki", "workdesk")) or os.path.exists(os.path.join(cur, ".git")):
            return cur
        cur = os.path.dirname(cur)
    return os.getcwd()

REPO_ROOT = find_repo_root()

