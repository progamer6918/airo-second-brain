#!/usr/bin/env python3
import os
import sys
import json
import argparse
import uuid
import subprocess
from datetime import datetime, timezone

def log_error(msg):
    timestamp = datetime.now().isoformat()
    os.makedirs("logs", exist_ok=True)
    with open("logs/capture.log", "a") as f:
        f.write(f"[{timestamp}] [ERROR] {msg}\n")
    print(f"ERROR: {msg}", file=sys.stderr)

def main():
    parser = argparse.ArgumentParser(description="Append safe operational events to local disk.")
    parser.add_argument("--event", "-e", default="checkpoint", 
                        choices=["repo_change", "command", "validation", "error", "checkpoint", "decision_candidate"],
                        help="Event type.")
    parser.add_argument("--summary", "-s", required=True, help="Safe short summary of the event.")
    parser.add_argument("--project", "-p", default="airo-second-brain", help="Project ID.")
    parser.add_argument("--consumer", "-c", default="antigravity", help="Consumer ID.")
    parser.add_argument("--session-id", default=None, help="Session ID (UUID).")
    parser.add_argument("--source", default="consumer", choices=["system", "manual", "consumer"], help="Event source.")
    parser.add_argument("--phase", choices=["PRE_EXECUTION", "POST_EXECUTION"], default="POST_EXECUTION")
    parser.add_argument("--owner-request", help="Active owner request")
    parser.add_argument("--position", help="Current position")
    parser.add_argument("--progress", help="Current progress")
    parser.add_argument("--blocker", help="Active blocker")
    parser.add_argument("--next-action", help="Next action")
    parser.add_argument("--evidence", help="Evidence pointer")
    parser.add_argument("--sensitive", action="store_true", help="Mark event as sensitive.")
    parser.add_argument("--dry-run", action="store_true", help="Simulate write without appending to file.")
    parser.add_argument("--json", action="store_true", help="Output generated event in JSON format to stdout.")
    
    args = parser.parse_args()

    session_id = args.session_id or os.environ.get("AIRO_SESSION_ID") or str(uuid.uuid4())
    
    event = {
        "timestamp": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "consumer": args.consumer,
        "session_id": session_id,
        "project_id": args.project,
        "event_type": args.event,
        "summary": args.summary,
        "source": args.source,
        "sensitive": args.sensitive
    }

    if getattr(args, 'phase', None): event["phase"] = args.phase
    if getattr(args, 'owner_request', None): event["owner_request"] = args.owner_request
    if getattr(args, 'position', None): event["position"] = args.position
    if getattr(args, 'progress', None): event["progress"] = args.progress
    if getattr(args, 'blocker', None): event["blocker"] = args.blocker
    if getattr(args, 'next_action', None): event["next_action"] = args.next_action
    if getattr(args, 'evidence', None): event["evidence"] = args.evidence

    if os.environ.get("AIRO_CAPTURE_INTERNAL") != "1":
        repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        session_bin = os.path.join(repo_root, "bin", "airo-session")
        active_session_file = os.path.join(repo_root, "state", "active_session.json")
        if os.path.exists(active_session_file) and os.path.exists(session_bin):
            try:
                with open(active_session_file, "r", encoding="utf-8") as sf:
                    s_data = json.load(sf)
                if s_data and s_data.get("internal_session_id"):
                    s_cmd = [sys.executable, session_bin, "event", "--event-type", args.event, "--summary", args.summary]
                    if getattr(args, 'evidence', None): s_cmd.extend(["--evidence", args.evidence])
                    if getattr(args, 'phase', None): s_cmd.extend(["--phase", args.phase])
                    if getattr(args, 'owner_request', None): s_cmd.extend(["--owner-request", args.owner_request])
                    if getattr(args, 'position', None): s_cmd.extend(["--position", args.position])
                    if getattr(args, 'progress', None): s_cmd.extend(["--progress", args.progress])
                    if getattr(args, 'blocker', None): s_cmd.extend(["--blocker", args.blocker])
                    if getattr(args, 'next_action', None): s_cmd.extend(["--next-action", args.next_action])

                    res = subprocess.run(s_cmd, cwd=repo_root, env=dict(os.environ, AIRO_CAPTURE_INTERNAL="1"), capture_output=True, text=True)
                    if res.returncode == 0:
                        sys.exit(0)
                    else:
                        log_error(f"Delegated airo-session event failed: {res.stderr}")
                        sys.exit(res.returncode)
            except Exception as e:
                log_error(f"Delegation error: {e}")
                sys.exit(1)

    if args.json:
        print(json.dumps(event))

    if args.dry_run:
        os.makedirs("logs", exist_ok=True)
        with open("logs/capture.log", "a") as f:
            f.write(f"[{datetime.now().isoformat()}] [DRY-RUN] Simulated event: {args.summary}\n")
        sys.exit(0)

    try:
        os.makedirs("events/raw", exist_ok=True)
        os.makedirs("logs", exist_ok=True)
        
        ndjson_file = "events/raw/events.ndjson"
        with open(ndjson_file, "a") as f:
            f.write(json.dumps(event) + "\n")
            
        with open("logs/capture.log", "a") as f:
            f.write(f"[{datetime.now().isoformat()}] [INFO] Appended event to {ndjson_file}: {args.summary}\n")
            
    except Exception as e:
        log_error(f"Failed to append event: {e}")
        sys.exit(2)

    sys.exit(0)

if __name__ == "__main__":
    main()
