#!/usr/bin/env python3
# scripts/airo-receipt-publish — Publish a concise AIRO execution receipt to
# persistent repository receipt storage (.airo/receipts/).
#
# Interface:
#   scripts/airo-receipt-publish --receipt-file <path>
#
# Requirements:
#   1. Validates receipt file exists.
#   2. Validates receipt is text (not binary).
#   3. Does NOT store secrets or raw logs.
#   4. Writes .airo/receipts/latest.md (always updated).
#   5. Archives to .airo/receipts/archive/<timestamp>.md.
#   6. latest.md contains: task, result, exit_code, session_id (if present),
#      commit_sha (if present), timestamp, clipboard_status, short_reason.
#   7. Does NOT store full logs.
#   8. Does NOT invoke git commands.
#   9. Exits nonzero on failure.

import argparse
import os
import sys
import re
import datetime
import shutil

# ── Constants ────────────────────────────────────────────────────────────────
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RECEIPTS_DIR = os.path.join(REPO_ROOT, ".airo", "receipts")
ARCHIVE_DIR = os.path.join(RECEIPTS_DIR, "archive")
LATEST_PATH = os.path.join(RECEIPTS_DIR, "latest.md")

# Fields that must never appear in stored receipts.
_SECRET_PATTERNS = [
    re.compile(r"(?i)(api[_\-]?key|token|secret|password|oauth|bearer|private[_\-]?key)\s*=\s*\S+"),
    re.compile(r"(?i)Authorization:\s*\S+"),
]

# Maximum bytes we will read from the receipt file to prevent log dumps.
# A concise receipt is always well under 4 KiB.
MAX_RECEIPT_BYTES = 4096


def die(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def _parse_field(lines: list[str], key: str) -> str:
    """Return the value of KEY=value from lines, or empty string."""
    prefix = f"{key}="
    for line in lines:
        if line.startswith(prefix):
            return line[len(prefix):].strip()
    return ""


def _contains_secret(text: str) -> bool:
    for pat in _SECRET_PATTERNS:
        if pat.search(text):
            return True
    return False


def _is_text(path: str) -> bool:
    """Return True if file appears to be valid UTF-8 text."""
    try:
        with open(path, "rb") as fh:
            raw = fh.read(MAX_RECEIPT_BYTES)
        raw.decode("utf-8")
        return True
    except (UnicodeDecodeError, OSError):
        return False


def _read_receipt(path: str) -> list[str]:
    """Read receipt file safely, limited to MAX_RECEIPT_BYTES."""
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        content = fh.read(MAX_RECEIPT_BYTES)
    return content.splitlines()


def _build_markdown(fields: dict, timestamp: str) -> str:
    """Build the concise receipt markdown body."""
    task           = fields.get("TASK", "(unknown)")
    result         = fields.get("RESULT", "(unknown)")
    exit_code      = fields.get("EXIT_CODE", "(unknown)")
    session_id     = fields.get("SESSION_ID", "")
    commit_sha     = fields.get("COMMIT_SHA", "")
    clipboard      = fields.get("COPIED_TO_CLIPBOARD", "")
    clipboard_err  = fields.get("CLIPBOARD_ERROR", "")
    reason         = fields.get("SHORT_REASON", "")

    # Derive clipboard status label
    if clipboard == "YES":
        clipboard_status = "YES"
    elif clipboard == "NO":
        clipboard_status = f"NO ({clipboard_err})" if clipboard_err else "NO"
    else:
        clipboard_status = clipboard or "(unknown)"

    # Derive short reason if not explicitly supplied
    if not reason:
        if result == "SCRIPT_SUCCESS":
            reason = "Command completed successfully."
        elif result == "SCRIPT_FAILED":
            reason = f"Command exited with code {exit_code}."
        else:
            reason = f"Result: {result}."

    lines = [
        f"# AIRO Execution Receipt",
        f"",
        f"| Field             | Value |",
        f"|-------------------|-------|",
        f"| **Task**          | `{task}` |",
        f"| **Result**        | `{result}` |",
        f"| **Exit Code**     | `{exit_code}` |",
    ]

    if session_id:
        lines.append(f"| **Session ID**    | `{session_id}` |")
    if commit_sha:
        lines.append(f"| **Commit SHA**    | `{commit_sha}` |")

    lines += [
        f"| **Timestamp**     | `{timestamp}` |",
        f"| **Clipboard**     | `{clipboard_status}` |",
        f"| **Reason**        | {reason} |",
        f"",
        f"---",
        f"",
        f"_Generated by scripts/airo-receipt-publish. Not a log dump._",
    ]

    return "\n".join(lines) + "\n"


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Publish a concise AIRO execution receipt to .airo/receipts/."
    )
    parser.add_argument(
        "--receipt-file",
        required=True,
        metavar="PATH",
        help="Path to the receipt key=value file to publish.",
    )
    args = parser.parse_args()

    receipt_path = os.path.expanduser(args.receipt_file)

    # ── Validate existence ──────────────────────────────────────────────────
    if not os.path.isfile(receipt_path):
        die(f"Receipt file not found: {receipt_path}")

    # ── Validate text ───────────────────────────────────────────────────────
    if not _is_text(receipt_path):
        die(f"Receipt file is not valid UTF-8 text: {receipt_path}")

    # ── Read and parse ──────────────────────────────────────────────────────
    receipt_lines = _read_receipt(receipt_path)
    receipt_text  = "\n".join(receipt_lines)

    # ── Secret guard ────────────────────────────────────────────────────────
    if _contains_secret(receipt_text):
        die("Receipt file contains a pattern that looks like a secret. Refusing to publish.")

    # ── Parse known fields ──────────────────────────────────────────────────
    fields = {}
    for key in (
        "TASK", "RESULT", "EXIT_CODE", "SESSION_ID", "COMMIT_SHA",
        "COPIED_TO_CLIPBOARD", "CLIPBOARD_ERROR", "SHORT_REASON",
    ):
        fields[key] = _parse_field(receipt_lines, key)

    # ── Build timestamp ─────────────────────────────────────────────────────
    now = datetime.datetime.now(datetime.timezone.utc)
    timestamp_iso = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    timestamp_slug = now.strftime("%Y%m%dT%H%M%SZ")

    # ── Build markdown content ──────────────────────────────────────────────
    md_content = _build_markdown(fields, timestamp_iso)

    # ── Ensure directories exist ────────────────────────────────────────────
    try:
        os.makedirs(ARCHIVE_DIR, exist_ok=True)
    except OSError as exc:
        die(f"Cannot create receipt directories: {exc}")

    # ── Write latest.md ─────────────────────────────────────────────────────
    try:
        with open(LATEST_PATH, "w", encoding="utf-8") as fh:
            fh.write(md_content)
    except OSError as exc:
        die(f"Cannot write latest.md: {exc}")

    # ── Write archive/<timestamp>.md ─────────────────────────────────────────
    archive_path = os.path.join(ARCHIVE_DIR, f"{timestamp_slug}.md")
    try:
        with open(archive_path, "w", encoding="utf-8") as fh:
            fh.write(md_content)
    except OSError as exc:
        die(f"Cannot write archive receipt: {exc}")

    # ── Confirm ─────────────────────────────────────────────────────────────
    print(f"RECEIPT_PUBLISH=PASS")
    print(f"LATEST_RECEIPT={LATEST_PATH}")
    print(f"ARCHIVE_RECEIPT={archive_path}")
    print(f"TIMESTAMP={timestamp_iso}")


if __name__ == "__main__":
    main()
