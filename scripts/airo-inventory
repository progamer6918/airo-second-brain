#!/usr/bin/env python3
import os
import sys
import json
import argparse
import subprocess
from datetime import datetime
import yaml

def get_git_remote(path):
    try:
        res = subprocess.run(
            ["git", "config", "--get", "remote.origin.url"],
            cwd=path,
            capture_output=True,
            text=True,
            check=True
        )
        return res.stdout.strip()
    except Exception:
        return None

def scan_workspaces():
    base_dirs = [
        "/home/egitaristorandas",
        "/home/egitaristorandas/AI_WORKSPACES"
    ]
    
    tier_map = {
        "/home/egitaristorandas/AI_WORKSPACES/airo-second-brain": {
            "id": "airo-second-brain",
            "name": "AIRO Second Brain",
            "tier": "GOVERNED-BRAIN",
            "brain_file": None,
            "source_of_truth": []
        },
        "/home/egitaristorandas/vortex-ai-skill-lab": {
            "id": "airo-finance",
            "name": "AIRO Finance",
            "tier": "GOVERNED-GUARDED",
            "brain_file": "control/airo-finance.md",
            "source_of_truth": [
                "docs/AIRO_FINANCE_CURRENT_STATE.md",
                "docs/AIRO_FINANCE_PRD_LIVING.md"
            ]
        },
        "/home/egitaristorandas/earnsai-pulse-trading": {
            "id": "earnsai-pulse-trading",
            "name": "EarnsAI Pulse Trading",
            "tier": "OBSERVE-ONLY",
            "brain_file": None,
            "source_of_truth": []
        },
        "/home/egitaristorandas/earnsai-telegram-gateway": {
            "id": "earnsai-telegram-gateway",
            "name": "EarnsAI Telegram Gateway",
            "tier": "OBSERVE-ONLY",
            "brain_file": None,
            "source_of_truth": []
        },
        "/home/egitaristorandas/katoolin3": {
            "id": "katoolin3",
            "name": "Katoolin3",
            "tier": "OBSERVE-ONLY",
            "brain_file": None,
            "source_of_truth": []
        },
        "/home/egitaristorandas/AI_AGENT_WORKSPACE": {
            "id": "ai-agent-workspace",
            "name": "AI Agent Workspace",
            "tier": "OBSERVE-ONLY",
            "brain_file": None,
            "source_of_truth": []
        },
        "/home/egitaristorandas/vibe-coding": {
            "id": "vibe-coding",
            "name": "Vibe Coding",
            "tier": "OBSERVE-ONLY",
            "brain_file": None,
            "source_of_truth": []
        },
        "/home/egitaristorandas/finance-bot-alternatives": {
            "id": "finance-bot-alternatives",
            "name": "Finance Bot Alternatives",
            "tier": "OBSERVE-ONLY",
            "brain_file": None,
            "source_of_truth": []
        },
        "/home/egitaristorandas/github-handover": {
            "id": "github-handover",
            "name": "GitHub Handover",
            "tier": "OBSERVE-ONLY",
            "brain_file": None,
            "source_of_truth": []
        }
    }

    scanned = []
    processed_real_paths = set()
    
    for base in base_dirs:
        if not os.path.exists(base):
            continue
        try:
            for entry in os.scandir(base):
                if entry.is_dir() and not entry.name.startswith('.'):
                    real_path = os.path.realpath(entry.path)
                    if real_path in processed_real_paths:
                        continue
                    
                    git_dir = os.path.join(real_path, ".git")
                    if os.path.exists(git_dir):
                        processed_real_paths.add(real_path)
                        remote = get_git_remote(real_path)
                        
                        if real_path in tier_map:
                            info = tier_map[real_path]
                            scanned.append({
                                "id": info["id"],
                                "name": info["name"],
                                "local_path": real_path,
                                "remote": remote,
                                "tier": info["tier"],
                                "brain_file": info["brain_file"],
                                "source_of_truth": info["source_of_truth"],
                                "truth_status": "unknown",
                                "last_known_commit": None,
                                "last_checked_at": None,
                                "last_synced_at": None,
                                "safe_to_execute": False,
                                "notes": f"Scanned repository tier: {info['tier']}"
                            })
                        else:
                            # Default to UNKNOWN tier
                            slug = entry.name.lower().replace("_", "-").replace(" ", "-")
                            scanned.append({
                                "id": slug,
                                "name": entry.name,
                                "local_path": real_path,
                                "remote": remote,
                                "tier": "UNKNOWN",
                                "brain_file": None,
                                "source_of_truth": [],
                                "truth_status": "unknown",
                                "last_known_commit": None,
                                "last_checked_at": None,
                                "last_synced_at": None,
                                "safe_to_execute": False,
                                "notes": "Discovered unknown repository."
                            })
        except Exception as e:
            print(f"Error scanning {base}: {e}", file=sys.stderr)
            
    return scanned

def merge_registry(existing, new):
    existing_map = {}
    if existing:
        existing_map = {item["id"]: item for item in existing if isinstance(item, dict) and "id" in item}
    new_map = {item["id"]: item for item in new}
    
    merged_map = {}
    for key, new_val in new_map.items():
        if key in existing_map:
            ext_val = existing_map[key]
            merged_map[key] = {
                **new_val,
                "truth_status": ext_val.get("truth_status", new_val["truth_status"]),
                "last_known_commit": ext_val.get("last_known_commit", new_val["last_known_commit"]),
                "last_checked_at": ext_val.get("last_checked_at", new_val["last_checked_at"]),
                "last_synced_at": ext_val.get("last_synced_at", new_val["last_synced_at"]),
                "safe_to_execute": ext_val.get("safe_to_execute", new_val["safe_to_execute"]),
                "notes": ext_val.get("notes", new_val["notes"])
            }
        else:
            merged_map[key] = new_val
            
    return list(merged_map.values())

def main():
    parser = argparse.ArgumentParser(description="Scan WSL paths and update repository registry.")
    parser.add_argument("--dry-run", action="store_true", help="Perform scan without writing to repos.yaml.")
    parser.add_argument("--json", action="store_true", help="Output results in JSON format.")
    args = parser.parse_args()

    # Logging setup
    log_dir = "logs"
    os.makedirs(log_dir, exist_ok=True)
    log_file = os.path.join(log_dir, "inventory.log")
    
    def log(msg):
        timestamp = datetime.now().isoformat()
        log_line = f"[{timestamp}] {msg}\n"
        with open(log_file, "a") as f:
            f.write(log_line)
        if not args.json:
            print(msg)

    log("Starting workspace inventory scan...")
    scanned_repos = scan_workspaces()
    log(f"Scan complete. Found {len(scanned_repos)} repositories.")

    # Read existing registry
    registry_file = "registry/repos.yaml"
    existing_repos = []
    if os.path.exists(registry_file):
        try:
            with open(registry_file, "r") as f:
                data = yaml.safe_load(f)
                if isinstance(data, list):
                    existing_repos = data
                elif isinstance(data, dict):
                    # convert old dict format if exists
                    existing_repos = list(data.values())
            log("Loaded existing repos.yaml registry.")
        except Exception as e:
            log(f"Warning: Failed to load existing registry: {e}")

    # Merge scanned and existing
    final_repos = merge_registry(existing_repos, scanned_repos)

    if args.json:
        print(json.dumps(final_repos, indent=2))
    
    if args.dry_run:
        log("Dry-run mode active. Registry file not updated.")
    else:
        # Ensure directories
        os.makedirs("registry", exist_ok=True)
        os.makedirs("inbox/workspace-scans", exist_ok=True)
        
        # Write to registry/repos.yaml
        try:
            with open(registry_file, "w") as f:
                yaml.safe_dump(final_repos, f, default_flow_style=False, sort_keys=False)
            log(f"Registry updated: {registry_file}")
        except Exception as e:
            log(f"Fatal: Failed to write registry: {e}")
            sys.exit(2)
            
        # Write to inbox/workspace-scans
        scan_timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        scan_file = f"inbox/workspace-scans/scan-{scan_timestamp}.json"
        try:
            with open(scan_file, "w") as f:
                json.dump(final_repos, f, indent=2)
            log(f"Scan snapshot saved: {scan_file}")
        except Exception as e:
            log(f"Warning: Failed to write scan snapshot: {e}")

    sys.exit(0)

if __name__ == "__main__":
    main()
