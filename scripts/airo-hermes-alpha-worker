#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
scripts/airo-hermes-alpha-worker — Dedicated NL queue worker for AIRO Hermes Alpha.

Polls ~/.local/state/airo-second-brain/airo-hermes-bridge/queue/ for incoming requests.
Executes requests using native Hermes AIAgent bound to ~/.hermes/profiles/airo-hermes.
Sends responses via Telegram sendMessage.
Strictly isolated from Earesmes worker, queues, and credentials.
"""

