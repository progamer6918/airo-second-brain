#!/usr/bin/env python3
import os
import sys
import json
import argparse
import uuid
import hashlib
import subprocess
from datetime import datetime, timezone

SECRET_PATTERNS = ["sk-proj-", "sk-", "token=", "api_key=", "private_key", "begin private key", "-----begin"]

def check_public_safety(*fields):
    for field in fields:
        if field is None:
            continue
        val_str = str(field)
        val_lower = val_str.lower()
        for pat in SECRET_PATTERNS:
            if pat in val_lower:
                return False, pat
    return True, None

def validate_identifier(val, name="identifier"):
    if not val or not isinstance(val, str):
        return False, f"{name} must be a non-empty string"
    if ".." in val or "/" in val or "\\" in val or "\0" in val or "\r" in val or "\n" in val:
        return False, f"{name} contains invalid path characters or traversal"
    safe, pat = check_public_safety(val)
    if not safe:
        return False, f"{name} contains secret pattern '{pat}'"
    return True, None

def validate_string_list(val, name="list"):
    if val is None:
        return True, None
    if isinstance(val, str):
        try:
            val = json.loads(val)
        except Exception:
            return False, f"{name} is not valid JSON"
    if not isinstance(val, list):
        return False, f"{name} must be a JSON array"
    for item in val:
        if not isinstance(item, str):
            return False, f"{name} items must be strings"
        safe, pat = check_public_safety(item)
        if not safe:
            return False, f"{name} item contains secret pattern '{pat}'"
    return True, None

def is_path_contained(target_path, parent_dir):
    target_abs = os.path.abspath(target_path)
    parent_abs = os.path.abspath(parent_dir)
    return target_abs == parent_abs or target_abs.startswith(parent_abs + os.sep)

def get_repo_root():
    if os.environ.get("AIRO_REPO_ROOT"):
        return os.path.abspath(os.environ.get("AIRO_REPO_ROOT"))
    cwd = os.getcwd()
    try:
        res = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd, capture_output=True, text=True)
        if res.returncode == 0:
            return os.path.abspath(res.stdout.strip())
    except Exception:
        pass
    return os.path.abspath(cwd)

def get_state_dir(repo_root):
    if os.environ.get("AIRO_SESSION_STATE_DIR"):
        return os.environ.get("AIRO_SESSION_STATE_DIR")
    xdg_state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    repo_hash = hashlib.sha256(repo_root.encode("utf-8")).hexdigest()[:12]
    path = os.path.join(xdg_state, "airo", "second-brain", repo_hash)
    os.makedirs(path, exist_ok=True)
    return path

def get_state_file(repo_root):
    return os.path.join(get_state_dir(repo_root), "active_session.json")

def load_active_session(repo_root):
    state_file = get_state_file(repo_root)
    if os.path.exists(state_file):
        try:
            with open(state_file, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return None
    return None

def save_active_session(repo_root, session_data):
    state_file = get_state_file(repo_root)
    os.makedirs(os.path.dirname(state_file), exist_ok=True)
    with open(state_file, "w", encoding="utf-8") as f:
        json.dump(session_data, f, indent=2)

def clear_active_session(repo_root):
    state_file = get_state_file(repo_root)
    if os.path.exists(state_file):
        os.remove(state_file)

def verify_ledger_session_id(repo_root, session_id):
    ledger_file = os.path.join(repo_root, "events/raw/events.ndjson")
    if not os.path.exists(ledger_file):
        return False
    try:
        with open(ledger_file, "r", encoding="utf-8") as f:
            lines = [line.strip() for line in f if line.strip()]
        if not lines:
            return False
        last_line = lines[-1]
        data = json.loads(last_line)
        return data.get("session_id") == session_id
    except Exception:
        return False


def _resolve_project_link(project_id, project_name, repo_root):
    """Resolve project wikilink path from PROJECT_REGISTRY.tsv."""
    reg_path = os.path.join(repo_root, "projects/PROJECT_REGISTRY.tsv")
    if os.path.exists(reg_path):
        import csv as _csv
        with open(reg_path, encoding="utf-8") as f:
            for row in _csv.DictReader(f, delimiter="\t"):
                if row["project_id"] == project_id:
                    return row["project_path"].replace(".md", "")
    return "projects/" + project_name.lower().replace(" ", "-")

def _maybe_knowledge_line(project_id, project_name, repo_root):
    """Return knowledge frontmatter line if a knowledge home exists."""
    reg_path = os.path.join(repo_root, "projects/PROJECT_REGISTRY.tsv")
    if os.path.exists(reg_path):
        import csv as _csv
        with open(reg_path, encoding="utf-8") as f:
            for row in _csv.DictReader(f, delimiter="\t"):
                if row["project_id"] == project_id and row.get("knowledge_path"):
                    kp = row["knowledge_path"].replace(".md", "")
                    label = project_name + " Knowledge"
                    return f'        f"knowledge: \"[[{kp}|{label}]]\"",
'
    return ""

def invoke_airo_capture(repo_root, session_id, project_id, event_type, summary):
    capture_script = os.path.join(repo_root, "scripts/airo-capture")
    if not os.path.exists(capture_script):
        return False
    cmd = [
        sys.executable, capture_script,
        "--event", event_type,
        "--summary", summary,
        "--project", project_id,
        "--session-id", session_id
    ]
    try:
        res = subprocess.run(cmd, cwd=repo_root, env=os.environ, capture_output=True, text=True)
        if res.returncode != 0:
            return False
        return verify_ledger_session_id(repo_root, session_id)
    except Exception:
        return False

def cmd_start(args, repo_root):
    for val, name in [(args.project_id, "project_id"), (args.project_name, "project_name")]:
        valid, err = validate_identifier(val, name)
        if not valid:
            print(f"ERROR: {err}", file=sys.stderr)
            return 1

    safe, pat = check_public_safety(args.objective, args.title, args.position)
    if not safe:
        print(f"ERROR: Input contains secret pattern '{pat}'", file=sys.stderr)
        return 1

    active = load_active_session(repo_root)
    if active:
        if active.get("project_id") == args.project_id and active.get("objective") == args.objective:
            print("SESSION_ACTION=CONTINUE_EXISTING")
            print("SESSION_ID=" + str(active.get('internal_session_id')))
            return 0
        else:
            print("SESSION_SWITCH_REQUIRES_CLOSE=YES")
            print("ACTIVE_PROJECT=" + str(active.get('project_id')))
            print("ACTIVE_OBJECTIVE=" + str(active.get('objective')))
            return 1

    internal_id = str(uuid.uuid4())
    now_iso = datetime.now(timezone.utc).isoformat()
    session_data = {
        "internal_session_id": internal_id,
        "project_id": args.project_id,
        "project_name": args.project_name,
        "objective": args.objective,
        "title": args.title or args.objective,
        "position": args.position or "IN_PROGRESS",
        "created_at": now_iso,
        "last_activity_at": now_iso,
        "events": [],
        "evidence_list": [],
        "blockers": [],
        "limitations": [],
        "planned_closeout_path": None
    }

    save_active_session(repo_root, session_data)

    capture_ok = invoke_airo_capture(repo_root, internal_id, args.project_id, "checkpoint", "Session started: " + str(args.objective))
    if not capture_ok:
        print("EVENT_RECORDED=NO")
        print("CAPTURE_STATUS=FAILED")
        print("ACTIVE_SESSION_PRESERVED=YES")
        return 1

    print("SESSION_ACTION=STARTED")
    print("SESSION_ID=" + internal_id)
    return 0

def cmd_event(args, repo_root):
    active = load_active_session(repo_root)
    if not active:
        print("ERROR: No active session found. Start a session first.", file=sys.stderr)
        return 1

    safe, pat = check_public_safety(args.summary, args.evidence)
    if not safe:
        print(f"ERROR: Event summary contains potential secret keyword '{pat}'", file=sys.stderr)
        return 2

    now_iso = datetime.now(timezone.utc).isoformat()
    evt = {
        "timestamp": now_iso,
        "event_type": args.event_type,
        "summary": args.summary,
        "evidence": args.evidence or ""
    }

    active["events"].append(evt)
    active["last_activity_at"] = now_iso
    save_active_session(repo_root, active)

    capture_ok = invoke_airo_capture(repo_root, active["internal_session_id"], active["project_id"], args.event_type, args.summary)
    if not capture_ok:
        print("EVENT_RECORDED=NO")
        print("CAPTURE_STATUS=FAILED")
        print("ACTIVE_SESSION_PRESERVED=YES")
        return 1

    print("EVENT_RECORDED=YES")
    return 0

def cmd_status(args, repo_root):
    active = load_active_session(repo_root)
    if not active:
        print("ACTIVE_SESSION=NONE")
        return 0

    last_act_dt = datetime.fromisoformat(active["last_activity_at"])
    now_dt = datetime.now(timezone.utc)

    inactive_seconds = (now_dt - last_act_dt).total_seconds()
    draft_rec = "YES" if inactive_seconds > 2700 else "NO"

    blockers_text = "Tidak ada" if not active["blockers"] else ", ".join(active["blockers"])
    events_count = len(active["events"])
    proj_name = active["project_name"]
    proj_id = active["project_id"]
    pos = active.get("position", "IN_PROGRESS")
    obj = active["objective"]

    print("🧭 AIRO STATUS")
    print("")
    print("📍 Project — " + proj_name + " (" + proj_id + ")")
    print("📌 Lagi di — " + pos)
    print("📈 Progress — Active session with " + str(events_count) + " events recorded")
    print("")
    print("🧪 Bukti")
    print("Yang wajib ada — Evaluasi bukti saat sesi ditutup")
    print("Yang sudah ada — " + str(events_count) + " events logged")
    print("Kesimpulan — SEDANG DIKERJAKAN")
    print("Boleh lanjut — TIDAK / BELUM DINILAI")
    print("")
    print("⛔ Hambatan — " + blockers_text)
    print("➡️ Berikutnya — Continue work on: " + obj)
    print("🏁 Selesai kalau — Objective achieved and closeout executed")
    print("")
    print("DRAFT_CLOSEOUT_RECOMMENDED=" + draft_rec)
    return 0

def cmd_draft_closeout(args, repo_root):
    active = load_active_session(repo_root)
    if not active:
        print("ERROR: No active session found.", file=sys.stderr)
        return 1

    date_str = datetime.now().strftime("%Y-%m-%d")
    clean_proj = active["project_name"].replace("/", "-").replace("\\", "-").replace(" ", "_")
    clean_title = active["title"].replace("/", "-").replace("\\", "-").replace(" ", "_")
    draft_filename = date_str + " - " + clean_proj + " - " + clean_title + ".md"
    draft_path = os.path.join(repo_root, "inbox/session-closeouts", draft_filename)

    if not is_path_contained(draft_path, os.path.join(repo_root, "inbox/session-closeouts")):
        print("ERROR: Path traversal detected in draft path", file=sys.stderr)
        return 1

    os.makedirs(os.path.dirname(draft_path), exist_ok=True)

    blockers_text = "Tidak ada" if not active["blockers"] else ", ".join(active["blockers"])
    events_count = len(active["events"])

    lines = [
        "---",
        "type: airo-session",
        f"date: {date_str}",
        f"project_id: {active['project_id']}",
        f"project_name: {active['project_name']}",
        f"project: \"[[{_resolve_project_link(active['project_id'], active['project_name'], repo_root)}|{active['project_name']}]]\"",
        f"objective: \"{active['objective']}\"",
        f"position: \"{active.get('position', 'IN_PROGRESS')}\"",
        "status: BELUM_TERBUKTI",
        "can_advance: NO",
        "---",
        "",
        "# " + active['title'] + " — Draft Closeout",
        "",
        "## 🧭 AIRO STATUS",
        "",
        "📍 Project — [[" + _resolve_project_link(active['project_id'], active['project_name'], repo_root) + "|" + active['project_name'] + "]]",
        "📌 Lagi di — " + active.get('position', 'IN_PROGRESS'),
        "📈 Progress — Draft closeout generated",
        "",
        "🧪 Bukti",
        "Yang wajib ada — Required evidence items",
        "Yang sudah ada — " + str(events_count) + " events recorded",
        "Kesimpulan — BELUM_TERBUKTI",
        "Boleh lanjut — TIDAK",
        "",
        "⛔ Hambatan — " + blockers_text,
        "➡️ Berikutnya — Verify evidence and execute final closeout",
        "🏁 Selesai kalau — All acceptance criteria met",
        "",
        "---",
        "",
        "`PRE_M2_SESSION_CLOSEOUT_STAGING=YES`",
        "`DRAFT_ONLY=YES`"
    ]
    content = "\n".join(lines) + "\n"

    with open(draft_path, "w", encoding="utf-8") as f:
        f.write(content)

    print("DRAFT_CLOSEOUT_CREATED=YES")
    print("DRAFT_PATH=" + draft_path)
    return 0

def cmd_close(args, repo_root):
    active = load_active_session(repo_root)
    if not active:
        print("ERROR: No active session found.", file=sys.stderr)
        return 1

    # Validate JSON argument shapes
    for val, name in [
        (args.required_evidence, "required_evidence"),
        (args.actual_evidence, "actual_evidence"),
        (args.blockers, "blockers"),
        (args.limitations, "limitations")
    ]:
        valid, err = validate_string_list(val, name)
        if not valid:
            print(f"ERROR: {err}", file=sys.stderr)
            print("CLOSE_RESULT=FAILED")
            print("TASK_STATUS=BELUM_TERBUKTI")
            print("CAN_ADVANCE=NO")
            print("ACTIVE_SESSION_PRESERVED=YES")
            return 1

    verdict_status = "BELUM_TERBUKTI"
    can_advance = "NO"

    script_status = args.script_status or "SCRIPT_SUCCESS"
    has_explicit_evidence = args.required_evidence is not None and args.actual_evidence is not None

    req_ev = json.loads(args.required_evidence) if args.required_evidence else []
    act_ev = json.loads(args.actual_evidence) if args.actual_evidence else []
    blockers = json.loads(args.blockers) if args.blockers else active.get("blockers", [])
    limitations = json.loads(args.limitations) if args.limitations else active.get("limitations", [])

    if not has_explicit_evidence:
        verdict_status = "BELUM_TERBUKTI"
        can_advance = "NO"
    else:
        verdict_script = os.path.join(repo_root, "scripts/airo-task-verdict")
        if not os.path.exists(verdict_script) or not os.access(verdict_script, os.X_OK):
            print("ERROR: Task verdict validator missing or non-executable.", file=sys.stderr)
            print("CLOSE_RESULT=FAILED")
            print("TASK_STATUS=BELUM_TERBUKTI")
            print("CAN_ADVANCE=NO")
            print("ACTIVE_SESSION_PRESERVED=YES")
            return 1

        verdict_input = {
            "project_id": active["project_id"],
            "position_id": active.get("position", "M3"),
            "script_status": script_status,
            "required_evidence": req_ev,
            "actual_evidence": act_ev,
            "blockers": blockers,
            "limitations": limitations
        }

        try:
            res = subprocess.run([sys.executable, verdict_script], input=json.dumps(verdict_input), cwd=repo_root, env=os.environ, text=True, capture_output=True)
            if res.returncode != 0:
                print("ERROR: Validator returned nonzero exit code.", file=sys.stderr)
                print("CLOSE_RESULT=FAILED")
                print("TASK_STATUS=BELUM_TERBUKTI")
                print("CAN_ADVANCE=NO")
                print("ACTIVE_SESSION_PRESERVED=YES")
                return 1

            v_data = json.loads(res.stdout)
            if "task_status" not in v_data or "can_advance" not in v_data:
                raise ValueError("Validator output missing required keys")

            valid_statuses = ["BERHASIL", "BERHASIL_DENGAN_BATASAN", "BELUM_TERBUKTI", "TERHAMBAT", "GAGAL"]
            if v_data["task_status"] not in valid_statuses or v_data["can_advance"] not in ["YES", "NO"]:
                raise ValueError("Validator output contains unknown enum")

            verdict_status = v_data["task_status"]
            can_advance = v_data["can_advance"]
        except Exception as e:
            print(f"ERROR: Validator execution/parsing failed: {e}", file=sys.stderr)
            print("CLOSE_RESULT=FAILED")
            print("TASK_STATUS=BELUM_TERBUKTI")
            print("CAN_ADVANCE=NO")
            print("ACTIVE_SESSION_PRESERVED=YES")
            return 1

    date_str = datetime.now().strftime("%Y-%m-%d")
    project_dir = os.path.join(repo_root, "worklog/sessions", date_str, active["project_name"])

    if not is_path_contained(project_dir, os.path.join(repo_root, "worklog/sessions")):
        print("ERROR: Path containment violation in project directory.", file=sys.stderr)
        print("CLOSE_RESULT=FAILED")
        print("ACTIVE_SESSION_PRESERVED=YES")
        return 1

    os.makedirs(project_dir, exist_ok=True)

    if active.get("planned_closeout_path"):
        session_file_path = active["planned_closeout_path"]
        session_file_name = os.path.basename(session_file_path)
    else:
        existing_files = [f for f in os.listdir(project_dir) if f.endswith(".md")]
        next_num = len(existing_files) + 1
        session_file_name = f"{next_num:02d} - " + active['title'] + ".md"
        session_file_path = os.path.join(project_dir, session_file_name)
        active["planned_closeout_path"] = session_file_path
        save_active_session(repo_root, active)

    events_summary = "\n".join(["- **" + e['event_type'] + "**: " + e['summary'] for e in active["events"]]) if active["events"] else "- Sesi dijalankan."
    blockers_summary = ", ".join(blockers) if blockers else "Tidak ada"

    closeout_data = None
    if getattr(args, 'closeout_json', None):
        try:
            cj = json.loads(args.closeout_json)
            if not isinstance(cj, dict):
                raise ValueError("closeout-json must be a JSON object")

            for k, v in cj.items():
                if isinstance(v, list):
                    for item in v:
                        if not isinstance(item, str):
                            raise ValueError(f"List item in {k} must be string")
                        safe, pat = check_public_safety(item)
                        if not safe:
                            raise ValueError(f"Secret pattern '{pat}' in closeout-json field {k}")
                        if k == "changed_paths" or k == "evidence_refs":
                            if ".." in item or "\r" in item or "\n" in item or item.startswith("/"):
                                raise ValueError(f"Path traversal or absolute path in closeout-json field {k}: {item}")
                elif isinstance(v, str):
                    safe, pat = check_public_safety(v)
                    if not safe:
                        raise ValueError(f"Secret pattern '{pat}' in closeout-json field {k}")

            closeout_data = cj
        except Exception as e:
            print(f"ERROR: Invalid closeout-json payload: {e}", file=sys.stderr)
            print("CLOSE_RESULT=FAILED")
            print("ACTIVE_SESSION_PRESERVED=YES")
            return 1

    if closeout_data:
        actions_list = closeout_data.get("actions", [])
        outcomes_list = closeout_data.get("outcomes", [])
        evidence_refs_list = closeout_data.get("evidence_refs", [])
        decisions_list = closeout_data.get("decisions", [])
        changed_paths_list = closeout_data.get("changed_paths", [])
        unfinished_list = closeout_data.get("unfinished", [])
        next_action_str = closeout_data.get("next_action", "NONE — objective complete")
        completion_criteria_str = closeout_data.get("completion_criteria", "Definition of Done satisfied")

        sec_actions = "\n".join(["- " + a for a in actions_list]) if actions_list else "- " + active['objective']
        sec_outcomes = "\n".join(["- " + o for o in outcomes_list]) if outcomes_list else "- Verified state transition completed successfully."
        sec_decisions = "\n".join(["- " + d for d in decisions_list]) if decisions_list else "- Tidak ada keputusan baru."
        sec_unfinished = "\n".join(["- " + u for u in unfinished_list]) if unfinished_list else "- Tidak ada pekerjaan sesi yang tersisa."
        sec_next_action = next_action_str
        sec_completion_criteria = completion_criteria_str

        if changed_paths_list:
            sec_changed_paths = "\n".join(["- `" + p + "`" for p in changed_paths_list])
        else:
            sec_changed_paths = "- `worklog/sessions/" + date_str + "/" + active['project_name'] + "/" + session_file_name + "`"

        if evidence_refs_list:
            actual_ev_str = ", ".join(evidence_refs_list)
            sec_evidence_refs = "\n".join(["- " + e for e in evidence_refs_list])
        else:
            actual_ev_str = ", ".join(act_ev) if act_ev else "Tidak ada bukti terlampir"
            sec_evidence_refs = "- Task Verdict: " + verdict_status + "\n- Can Advance: " + can_advance
    else:
        sec_actions = events_summary
        sec_outcomes = "Pekerjaan sesi telah selesai dieksekusi dan diverifikasi."
        sec_decisions = "- Menggunakan format sesi kanonis 10-section.\n- Bukti verifikasi deterministik dinyatakan sah."
        sec_changed_paths = "- `worklog/sessions/" + date_str + "/" + active['project_name'] + "/" + session_file_name + "`"
        sec_unfinished = "- Pekerjaan milestone mendatang."
        sec_next_action = "Lanjut ke langkah berikutnya di roadmap kanonis."
        sec_completion_criteria = "Seluruh kriteria penerimaan terpenuhi"
        actual_ev_str = ", ".join(act_ev) if act_ev else "Tidak ada bukti terlampir"
        sec_evidence_refs = "- Task Verdict: " + verdict_status + "\n- Can Advance: " + can_advance

    # Render frontmatter + 10 human sections
    lines = [
        "---",
        "type: airo-session",
        f"date: {date_str}",
        f"project_id: {active['project_id']}",
        f"project_name: {active['project_name']}",
        f"project: \"[[{_resolve_project_link(active['project_id'], active['project_name'], repo_root)}|{active['project_name']}]]\"",
        f"objective: \"{active['objective']}\"",
        f"position: \"{active.get('position', 'M3')}\"",
        f"status: {verdict_status}",
        f"can_advance: {can_advance}",
        "---",
        "",
        "# " + active['title'],
        "",
        "## 🧭 AIRO STATUS",
        "",
        "📍 Project — [[" + _resolve_project_link(active['project_id'], active['project_name'], repo_root) + "|" + active['project_name'] + "]]",
        "📌 Lagi di — " + str(active.get('position', 'M3')),
        "📈 Progress — Sesi selesai dengan status " + verdict_status,
        "",
        "🧪 Bukti",
        "Yang wajib ada — " + (", ".join(req_ev) if req_ev else "Evaluasi bukti kanonis"),
        "Yang sudah ada — " + actual_ev_str,
        "Kesimpulan — " + verdict_status,
        "Boleh lanjut — " + ("YA" if can_advance == 'YES' else "TIDAK"),
        "",
        "⛔ Hambatan — " + blockers_summary,
        "➡️ Berikutnya — " + sec_next_action,
        "🏁 Selesai kalau — " + sec_completion_criteria,
        "",
        "## 🎯 Tujuan sesi",
        active['objective'],
        "",
        "## 🛠 Yang dilakukan",
        sec_actions,
        "",
        "## 📌 Hasil",
        sec_outcomes,
        "",
        "## 🧪 Bukti",
        sec_evidence_refs,
        "",
        "## ⛔ Masalah / hambatan",
        blockers_summary,
        "",
        "## ✅ Keputusan",
        sec_decisions,
        "",
        "## 📁 Yang berubah",
        sec_changed_paths,
        "",
        "## 📝 Yang belum selesai",
        sec_unfinished,
        "",
        "## ➡️ Berikutnya",
        sec_next_action
    ]
    note_content = "\n".join(lines) + "\n"

    tmp_note_path = session_file_path + ".tmp"
    with open(tmp_note_path, "w", encoding="utf-8") as f:
        f.write(note_content)
    os.replace(tmp_note_path, session_file_path)

    daily_script = os.path.join(repo_root, "scripts/airo-daily")
    if not os.path.exists(daily_script):
        print("ERROR: Daily generator script missing.", file=sys.stderr)
        print("CLOSE_RESULT=FAILED")
        print("ACTIVE_SESSION_PRESERVED=YES")
        return 1

    daily_res = subprocess.run([sys.executable, daily_script, date_str], cwd=repo_root, env=os.environ, capture_output=True, text=True)
    if daily_res.returncode != 0:
        print("ERROR: Daily generator failed.", file=sys.stderr)
        print("CLOSE_RESULT=FAILED")
        print("ACTIVE_SESSION_PRESERVED=YES")
        return 1

    daily_file = os.path.join(repo_root, "worklog/daily", date_str + ".md")
    if not os.path.exists(daily_file):
        print("ERROR: Daily file missing after generation.", file=sys.stderr)
        print("CLOSE_RESULT=FAILED")
        print("ACTIVE_SESSION_PRESERVED=YES")
        return 1

    clear_active_session(repo_root)
    print("SESSION_CLOSED=YES")
    print("PERMANENT_SESSION_NOTE=" + session_file_path)
    print("VERDICT_STATUS=" + verdict_status)
    print("CAN_ADVANCE=" + can_advance)
    return 0

def cmd_resume(args, repo_root):
    active = load_active_session(repo_root)
    if not active:
        print("ACTIVE_SESSION=NONE")
        return 1
    print("SESSION_RESUMED=YES")
    print("PROJECT_ID=" + str(active['project_id']))
    print("PROJECT_NAME=" + str(active['project_name']))
    print("OBJECTIVE=" + str(active['objective']))
    print("EVENT_COUNT=" + str(len(active['events'])))
    return 0

def main():
    repo_root = get_repo_root()
    parser = argparse.ArgumentParser(description="AIRO Session Lifecycle Manager")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    p_start = subparsers.add_parser("start")
    p_start.add_argument("--project-id", required=True)
    p_start.add_argument("--project-name", required=True)
    p_start.add_argument("--objective", required=True)
    p_start.add_argument("--title", default=None)
    p_start.add_argument("--position", default=None)

    p_event = subparsers.add_parser("event")
    p_event.add_argument("--event-type", default="checkpoint", choices=["command", "validation", "error", "checkpoint", "repo_change", "decision_candidate"])
    p_event.add_argument("--summary", required=True)
    p_event.add_argument("--evidence", default=None)

    p_status = subparsers.add_parser("status")
    p_draft = subparsers.add_parser("draft-closeout")

    p_close = subparsers.add_parser("close")
    p_close.add_argument("--script-status", default="SCRIPT_SUCCESS")
    p_close.add_argument("--required-evidence", default=None)
    p_close.add_argument("--actual-evidence", default=None)
    p_close.add_argument("--blockers", default=None)
    p_close.add_argument("--limitations", default=None)
    p_close.add_argument("--closeout-json", default=None)

    p_resume = subparsers.add_parser("resume")

    args = parser.parse_args()

    if args.subcommand == "start":
        sys.exit(cmd_start(args, repo_root))
    elif args.subcommand == "event":
        sys.exit(cmd_event(args, repo_root))
    elif args.subcommand == "status":
        sys.exit(cmd_status(args, repo_root))
    elif args.subcommand == "draft-closeout":
        sys.exit(cmd_draft_closeout(args, repo_root))
    elif args.subcommand == "close":
        sys.exit(cmd_close(args, repo_root))
    elif args.subcommand == "resume":
        sys.exit(cmd_resume(args, repo_root))

if __name__ == "__main__":
    main()
