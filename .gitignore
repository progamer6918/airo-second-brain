# === ASB LIVE WORKSPACE PROJECT LOCAL-ONLY IGNORE v2 ===
# Full local workspace content may exist in ecosystem/projects,
# but runtime/cache/backup/private subtrees must not be pushed.

# nested project git metadata
ecosystem/projects/**/.git/

# common dependency/cache/runtime
