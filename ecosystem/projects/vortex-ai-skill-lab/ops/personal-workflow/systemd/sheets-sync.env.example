AIRO_GOOGLE_OAUTH_TOKEN_PATH=/home/egitaristorandas/.config/airo-personal-workflow/oauth-token.json
AIRO_SYNC_PYTHON=/home/egitaristorandas/.config/airo-personal-workflow/venv/bin/python
