function cleanupDuplicateNetWorthPanels() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));

  const asset =
    getSheetLoose_(ss, AIRO_CONFIG.tabs.aset) ||
    getSheetLoose_(ss, 'Aset');

  if (!asset) {
    return { ok: false, reason: 'asset_sheet_missing' };
  }

  ensureSheetSize_(asset, 24, 31);

  // Remove visible duplicate panels from Aset only.
  // Do not touch Gold Summary, Gold Ledger, or original Estimasi Net Worth.
  const maxRows = Math.min(asset.getMaxRows(), 120);
  const maxCols = Math.min(asset.getMaxColumns(), 31);
  const values = asset.getRange(1, 1, maxRows, maxCols).getDisplayValues();

  const cleared = [];

  for (let r = 0; r < values.length; r++) {
    for (let c = 0; c < values[r].length; c++) {
      const text = String(values[r][c] || '').toLowerCase();

      const isDuplicatePanel =
        (text.includes('rumah') && text.includes('home equity')) ||
        text.includes('net worth final');

      if (!isDuplicatePanel) continue;

      const row = r + 1;
      const col = c + 1;

      // Ignore hidden helper marker around AA:AE.
      if (col >= 27 && col <= 31) continue;

      const height = Math.min(7, asset.getMaxRows() - row + 1);
      const width = Math.min(6, asset.getMaxColumns() - col + 1);
      const a1 = asset.getRange(row, col, height, width).getA1Notation();

      safeClearRange_(asset, a1);
      cleared.push(a1);
    }
  }

  const setup = setupNetWorthMetrics();

  return {
    ok: true,
    cleared_duplicate_asset_ranges: cleared,
    setup
  };
}

