  if (/^admin\s+(audit|check|cek)\s+cash\s+(parity|balance|total|ledger)/i.test(text)) {
    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
    const cashSheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.cash);
    const accountSheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.accountLedger);

    const normalizeHeader_ = function(value) {
      return String(value || '').toLowerCase().replace(/[^a-z0-9_]+/g, '_').replace(/^_+|_+$/g, '');
    };

    const toNumber_ = function(value) {
      if (typeof value === 'number') return value;
      const cleaned = String(value || '').replace(/[^0-9,.-]/g, '').replace(/\./g, '').replace(',', '.');
      const parsed = Number(cleaned);
      return isNaN(parsed) ? 0 : parsed;
    };

    const headerInfo_ = function(sheet) {
      if (!sheet) return { headers: [], normalized: [] };
      const lastCol = Math.max(sheet.getLastColumn(), 1);
      const headers = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
      return {
        headers: headers,
        normalized: headers.map(normalizeHeader_)
      };
    };

    const findColumn_ = function(info, aliases, fallbackIndex) {
      for (var i = 0; i < info.normalized.length; i++) {
        for (var j = 0; j < aliases.length; j++) {
          if (info.normalized[i] === aliases[j]) {
            return i + 1;
          }
        }
      }
      for (var i2 = 0; i2 < info.normalized.length; i2++) {
        for (var j2 = 0; j2 < aliases.length; j2++) {
          if (String(aliases[j2] || "").length >= 5 && info.normalized[i2].indexOf(aliases[j2]) >= 0) {
            return i2 + 1;
          }
        }
      }
      return fallbackIndex;
    };

    const sumDisplayColumn_ = function(sheet, colIndex) {
      if (!sheet || !colIndex) return 0;
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return 0;
      const values = sheet.getRange(2, colIndex, lastRow - 1, 1).getDisplayValues();
      return values.reduce(function(total, row) {
        return total + toNumber_(row[0]);
      }, 0);
    };

    const sumCashLedgerInWithFallback_ = function(sheet, cashInCol, info) {
      if (!sheet) return 0;
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return 0;
      const amountStartCol = findColumn_(info, ['amount_start', 'start_amount'], 3);
      const typeCol = findColumn_(info, ['type', 'jenis'], 16);
      const statusCol = findColumn_(info, ['status'], 10);
      const width = Math.max(cashInCol, amountStartCol, typeCol, statusCol);
      const values = sheet.getRange(2, 1, lastRow - 1, width).getDisplayValues();
      return values.reduce(function(total, row) {
        const primary = toNumber_(row[cashInCol - 1]);
        if (primary > 0) return total + primary;
        const amountStart = toNumber_(row[amountStartCol - 1]);
        const typeVal = String(row[typeCol - 1] || '').trim().toLowerCase();
        const statusVal = String(row[statusCol - 1] || '').trim().toLowerCase();
        if (
          amountStart > 0 &&
          (typeVal === 'income' || typeVal === 'transfer_in' || typeVal === 'cash_in' || statusVal === 'aktif')
        ) {
          return total + amountStart;
        }
        return total;
      }, 0);
    };

    const cashInfo = headerInfo_(cashSheet);
    const accountInfo = headerInfo_(accountSheet);

    const cashOutCol = findColumn_(cashInfo, ['amount_out', 'cash_out', 'nominal_keluar', 'keluar'], 16);
    const cashInCol = findColumn_(cashInfo, ['amount_in', 'cash_in', 'nominal_masuk', 'masuk'], 17);

    const accountCol = findColumn_(accountInfo, ['account', 'akun', 'wallet', 'rekening'], 3);
    const accountInCol = findColumn_(accountInfo, ['amount_in', 'cash_in', 'nominal_masuk', 'masuk'], 4);
    const accountOutCol = findColumn_(accountInfo, ['amount_out', 'cash_out', 'nominal_keluar', 'keluar'], 5);

    const cashOut = sumDisplayColumn_(cashSheet, cashOutCol);
    const cashIn = sumCashLedgerInWithFallback_(cashSheet, cashInCol, cashInfo);
    const cashNet = cashIn - cashOut;

    let accountIn = 0;
    let accountOut = 0;
    if (accountSheet && accountSheet.getLastRow() >= 2) {
      const width = Math.max(accountCol, accountInCol, accountOutCol);
      const rows = accountSheet.getRange(2, 1, accountSheet.getLastRow() - 1, width).getDisplayValues();
      rows.forEach(function(row) {
        const account = String(row[accountCol - 1] || '').trim().toLowerCase();
        if (isCashLedgerAccountName_(account)) {
          accountIn += toNumber_(row[accountInCol - 1]);
          accountOut += toNumber_(row[accountOutCol - 1]);
        }
      });
    }

    const accountNet = accountIn - accountOut;
    const deltaNet = accountNet - cashNet;
    const pass = Math.abs(deltaNet) <= 1;

    const cashInHeader = cashInfo.headers[cashInCol - 1] || '';
    const cashOutHeader = cashInfo.headers[cashOutCol - 1] || '';
    const accountHeader = accountInfo.headers[accountCol - 1] || '';
    const accountInHeader = accountInfo.headers[accountInCol - 1] || '';
    const accountOutHeader = accountInfo.headers[accountOutCol - 1] || '';

    const result = {
      cash_ledger_in: cashIn,
      cash_ledger_out: cashOut,
      cash_ledger_net: cashNet,
      account_ledger_cash_in: accountIn,
      account_ledger_cash_out: accountOut,
      account_ledger_cash_net: accountNet,
      delta_net: deltaNet,
      pass: pass,
      cash_columns: {
        in_col: cashInCol,
        in_header: cashInHeader,
        out_col: cashOutCol,
        out_header: cashOutHeader
      },
      account_columns: {
        account_col: accountCol,
        account_header: accountHeader,
        in_col: accountInCol,
        in_header: accountInHeader,
        out_col: accountOutCol,
        out_header: accountOutHeader
      }
    };

    const link = accountSheet ? getSheetTabUrl_(ss, accountSheet) : ss.getUrl();

    sendTelegram_(
      chatId,
      'Cash parity audit selesai.\n\n' +
      'Cash columns: in=' + cashInCol + ' (' + cashInHeader + '), out=' + cashOutCol + ' (' + cashOutHeader + ')\n' +
      'Account columns: account=' + accountCol + ' (' + accountHeader + '), in=' + accountInCol + ' (' + accountInHeader + '), out=' + accountOutCol + ' (' + accountOutHeader + ')\n\n' +
      'Cash Ledger in: Rp' + cashIn + '\n' +
      'Cash Ledger out: Rp' + cashOut + '\n' +
      'Cash Ledger net: Rp' + cashNet + '\n\n' +
      'Account Ledger Cash in: Rp' + accountIn + '\n' +
      'Account Ledger Cash out: Rp' + accountOut + '\n' +
      'Account Ledger Cash net: Rp' + accountNet + '\n\n' +
      'Delta net: Rp' + deltaNet + '\n' +
      'Status: ' + (pass ? 'PASS' : 'CHECK') + '\n\n' +
      'Buka Account Ledger: ' + link
    );

    return {
      handled: true,
      ok: true,
      command: 'cash_ledger_account_parity_audit',
      result,
      account_ledger_url: link
    };
  }

  if (/^admin\s+(audit|check|cek)\s+dashboard\s+(layout|sheet|read\s*only|readonly)/i.test(text)) {
    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
    const result = dashboardLayoutReadOnlyAudit_(ss);
    sendTelegram_(
      chatId,
      'Dashboard layout audit selesai.\n\n' +
      'Sheet: ' + (result.sheet_name || '-') + '\n' +
      'Non-empty cells scanned: ' + (result.non_empty_count || 0) + '\n' +
      'Google write: false'
    );
    return {
      handled: true,
      ok: true,
      command: 'dashboard_layout_read_only_audit',
      result: result
    };
  }

  if (/^admin\s+(audit|check|cek)\s+(cash\s+)?(reporting|report|formula|formulas|dashboard)/i.test(text)) {
    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
    const dashboard =
      getSheetLoose_(ss, '?? Dashboard') ||
      getSheetLoose_(ss, 'Dashboard');
    const monthly =
      getSheetLoose_(ss, '?? Monthly Review') ||
      getSheetLoose_(ss, 'Monthly Review');

    const monthlyB6 = monthly ? monthly.getRange('B6').getFormula() : '';
    const monthlyE6 = monthly ? monthly.getRange('E6').getFormula() : '';
    const monthlyB8 = monthly ? monthly.getRange('B8').getFormula() : '';
    const dashboardD17 = dashboard ? dashboard.getRange('D17').getFormula() : '';
    const formulaSnippet_ = function(value) {
      return String(value || '').slice(0, 180);
    };

    const result = {
      monthly_b6_uses_account_ledger: monthlyB6.indexOf('Account Ledger') >= 0,
      monthly_e6_uses_account_ledger: monthlyE6.indexOf('Account Ledger') >= 0,
      monthly_b8_present: Boolean(monthlyB8),
      dashboard_d17_uses_account_ledger: dashboardD17.indexOf('Account Ledger') >= 0
    };

    const link = dashboard ? getSheetTabUrl_(ss, dashboard) : ss.getUrl();

    sendTelegram_(
      chatId,
      '? Audit formula cash reporting selesai.\n\n' +
      'Monthly B6 pakai Account Ledger: ' + result.monthly_b6_uses_account_ledger + '\n' +
      'Monthly E6 pakai Account Ledger: ' + result.monthly_e6_uses_account_ledger + '\n' +
      'Monthly B8 formula ada: ' + result.monthly_b8_present + '\n' +
      'Dashboard D17 pakai Account Ledger: ' + result.dashboard_d17_uses_account_ledger + '\n\n' +
      'B6: ' + formulaSnippet_(monthlyB6) + '\n' +
      'E6: ' + formulaSnippet_(monthlyE6) + '\n' +
      'D17: ' + formulaSnippet_(dashboardD17) + '\n\n' +
      '?? Buka Dashboard: ' + link
    );

    return {
      handled: true,
      ok: true,
      command: 'cash_reporting_formula_audit',
      result,
      formulas: {
        monthly_b6: monthlyB6,
        monthly_e6: monthlyE6,
        monthly_b8: monthlyB8,
        dashboard_d17: dashboardD17
      },
      dashboard_url: link
    };
  }

  if (/^admin\s+(refresh|sync|update|reload)\s+(cash\s+)?(reporting|report|formula|formulas|dashboard)/i.test(text)) {
    const reporting = refreshCashReportingFormulas();
    const netWorth = setupDashboardNetWorthPanel();

    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
    const dashboard =
      getSheetLoose_(ss, '?? Dashboard') ||
      getSheetLoose_(ss, 'Dashboard');
    const link = dashboard ? getSheetTabUrl_(ss, dashboard) : ss.getUrl();

    sendTelegram_(
      chatId,
      '? Reporting formula direfresh.\n\n' +
      'Monthly Review dan Dashboard sekarang membaca ?? Account Ledger untuk akun Cash.\n\n' +
      '?? Buka Dashboard: ' + link
    );

    return {
      handled: true,
      ok: Boolean(reporting && reporting.ok),
      command: 'cash_reporting_refresh',
      reporting,
      net_worth: netWorth,
      dashboard_url: link
    };
  }

  if (!/^(set|atur|update)\s+/.test(text)) {
    return { handled: false };
  }

  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));

  const asset =
    getSheetLoose_(ss, AIRO_CONFIG.tabs.aset) ||
    getSheetLoose_(ss, 'Aset');

  const dashboard =
