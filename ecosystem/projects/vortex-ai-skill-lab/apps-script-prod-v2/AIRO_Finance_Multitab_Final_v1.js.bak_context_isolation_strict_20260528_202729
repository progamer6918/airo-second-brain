  if (amount <= 0) return false;
  if (!/\b(hutang|utang|pinjaman|pinjam)\b/i.test(text)) return false;

  if ((isBorrowInText_(text) || isDebtPaymentText_(text)) && parseDebtPerson_(rawText)) return false;

