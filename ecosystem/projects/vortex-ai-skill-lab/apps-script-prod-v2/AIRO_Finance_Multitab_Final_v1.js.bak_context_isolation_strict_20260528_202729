function refreshCashReportingFormulas() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));

  const dashboard =
    getSheetLoose_(ss, '🏠 Dashboard') ||
    getSheetLoose_(ss, 'Dashboard');

  const monthly =
    getSheetLoose_(ss, '📆 Monthly Review') ||
    getSheetLoose_(ss, 'Monthly Review');

  const accountLedgerMonthKeyFormula =
    `ARRAYFORMULA(IFERROR(TEXT('📒 Account Ledger'!B:B;"yyyy-mm");LEFT(TO_TEXT('📒 Account Ledger'!B:B);7)))`;

  const accountLedgerCashAccountFilterFormula =
    `REGEXMATCH('📒 Account Ledger'!C:C;"^Cash( Umum| Bensin)?$")`;

  const monthlyCashInFormula =
    `=IFERROR(SUM(FILTER('📒 Account Ledger'!D:D;${accountLedgerCashAccountFilterFormula};${accountLedgerMonthKeyFormula}=TO_TEXT($B$2)));0)`;

  const monthlyCashOutFormula =
    `=IFERROR(SUM(FILTER('📒 Account Ledger'!E:E;${accountLedgerCashAccountFilterFormula};${accountLedgerMonthKeyFormula}=TO_TEXT($B$2)));0)`;

  const monthlyNetFormula =
    `=IFERROR(B5+B6-E5-E6;0)`;

  const dashboardCashAktifFormula =
    `=IFERROR("💵 Cash Aktif"&CHAR(10)&TEXT((SUMIFS('📒 Account Ledger'!D:D;'📒 Account Ledger'!C:C;"Cash")+SUMIFS('📒 Account Ledger'!D:D;'📒 Account Ledger'!C:C;"Cash Umum")+SUMIFS('📒 Account Ledger'!D:D;'📒 Account Ledger'!C:C;"Cash Bensin"))-(SUMIFS('📒 Account Ledger'!E:E;'📒 Account Ledger'!C:C;"Cash")+SUMIFS('📒 Account Ledger'!E:E;'📒 Account Ledger'!C:C;"Cash Umum")+SUMIFS('📒 Account Ledger'!E:E;'📒 Account Ledger'!C:C;"Cash Bensin"));"Rp #,##0");"💵 Cash Aktif"&CHAR(10)&"— catat dulu —")`;

  const result = {
    ok: true,
    dashboard: {},
    monthly: {}
  };

  if (monthly) {
    monthly.getRange('B6').setFormula(monthlyCashInFormula);
    monthly.getRange('E6').setFormula(monthlyCashOutFormula);
    monthly.getRange('B8').setFormula(monthlyNetFormula);

    result.monthly.cash_masuk = 'B6';
    result.monthly.cash_keluar = 'E6';
    result.monthly.net = 'B8';
  } else {
    result.monthly.missing = true;
  }

  if (dashboard) {
    result.dashboard.cash_aktif =
      setFormulaOnCellContaining_(dashboard, ['cash aktif'], dashboardCashAktifFormula);
  } else {
    result.dashboard.missing = true;
  }

  return result;
}

function refreshCashMonthlyReviewFormulas() {
  return refreshCashReportingFormulas();
}

function setFormulaOnCellContaining_(sheet, labels, formula) {
  const maxRows = Math.min(sheet.getMaxRows(), 80);
  const maxCols = Math.min(sheet.getMaxColumns(), 30);
  const values = sheet.getRange(1, 1, maxRows, maxCols).getDisplayValues();
  const wanted = labels.map(v => canonicalSheetName_(v));

  for (let r = 0; r < values.length; r++) {
    for (let c = 0; c < values[r].length; c++) {
      const text = canonicalSheetName_(values[r][c] || '');

      if (!text) continue;

      const matched = wanted.some(label => text === label || text.includes(label));

      if (matched) {
        sheet.getRange(r + 1, c + 1).setFormula(formula);
        return sheet.getRange(r + 1, c + 1).getA1Notation();
      }
    }
  }

  return '';
}

/**
 * Daily ANTAM / Logam Mulia gold price updater.
 *
 * Purpose:
 * - Update GOLD_24K_PRICE_PER_GRAM_IDR once per day.
 * - Source: official Logam Mulia public price page.
 * - Recommended trigger time: 10:15 Asia/Jakarta.
 *
 * This is not tick-by-tick real-time pricing.
 * It is daily reference pricing for personal finance valuation.
 */

function updateAntamGoldPriceDaily() {
  const url = 'https://www.logammulia.com/harga-emas-hari-ini';

  const response = UrlFetchApp.fetch(url, {
    method: 'get',
    muteHttpExceptions: true,
    followRedirects: true,
    headers: {
      'User-Agent': 'Mozilla/5.0 AIRO-Finance-Gold-Price-Updater'
    }
  });

  const code = response.getResponseCode();
  const body = response.getContentText();

  if (code < 200 || code >= 300) {
    return recordGoldPriceUpdateFailure_('http_' + code);
  }

  const price = parseAntamOneGramPrice_(body);

  if (!price || price <= 0) {
    return recordGoldPriceUpdateFailure_('price_parse_failed');
  }

  const props = PropertiesService.getScriptProperties();
  const now = new Date();

  props.setProperty('GOLD_24K_PRICE_PER_GRAM_IDR', String(price));
  props.setProperty('GOLD_24K_PRICE_SOURCE', 'logammulia.com/harga-emas-hari-ini');
  props.setProperty('GOLD_24K_PRICE_UPDATED_AT', now.toISOString());
  props.setProperty('GOLD_24K_PRICE_UPDATE_STATUS', 'ok');

  return {
    ok: true,
    price_24k_per_gram_idr: price,
    source: 'logammulia.com/harga-emas-hari-ini',
    updated_at: now.toISOString()
  };
}

function parseAntamOneGramPrice_(html) {
  const text = String(html || '')
    .replace(/<script[\s\S]*?<\/script>/gi, ' ')
    .replace(/<style[\s\S]*?<\/style>/gi, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  // Expected public text pattern around official table:
  // "1 gr 2,839,000 2,846,098"
  const patterns = [
    /\b1\s*gr\b\s+([\d.,]{7,})\s+([\d.,]{7,})/i,
    /\b1\s*gram\b\s+([\d.,]{7,})\s+([\d.,]{7,})/i,
    /\b1\s*g\b\s+([\d.,]{7,})\s+([\d.,]{7,})/i
  ];

  for (const pattern of patterns) {
    const m = text.match(pattern);

    if (m && m[1]) {
      const price = cleanAmount_(m[1]);

      // Guardrail: ANTAM 1 gram should be in a plausible IDR range.
      if (price >= 500000 && price <= 10000000) {
        return price;
      }
    }
  }

  return 0;
}

function recordGoldPriceUpdateFailure_(reason) {
  const props = PropertiesService.getScriptProperties();
  const now = new Date();
  const lastPrice = Number(props.getProperty('GOLD_24K_PRICE_PER_GRAM_IDR') || 0);

  props.setProperty('GOLD_24K_PRICE_UPDATE_STATUS', 'failed:' + reason);
  props.setProperty('GOLD_24K_PRICE_LAST_FAILURE_AT', now.toISOString());

  return {
    ok: false,
    reason,
    last_price_24k_per_gram_idr: lastPrice || '',
    failed_at: now.toISOString()
  };
}

