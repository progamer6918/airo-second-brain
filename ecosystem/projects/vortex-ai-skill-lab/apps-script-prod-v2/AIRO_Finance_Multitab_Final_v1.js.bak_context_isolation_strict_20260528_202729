function airoSprint7EExtractSenderEmail_(fromValue) {
  var raw = String(fromValue || "").trim();
  var match = raw.match(/<([^>]+)>/);
  return String(match ? match[1] : raw).trim().toLowerCase();
}

function airoSprint7EProviderForSender_(sender) {
  var s = String(sender || "").toLowerCase();
  if (s === "receipts@blubybcadigital.id") {
    return "Blu";
  }
  if (s === "noreply@tokopedia.com") {
    return "Tokopedia Card";
  }
  return "Unknown";
}

function airoSprint7EIsAllowedSender_(sender, allowedSenders) {
  var s = String(sender || "").toLowerCase();
  for (var i = 0; i < allowedSenders.length; i++) {
    if (s === String(allowedSenders[i]).toLowerCase()) {
      return true;
    }
  }
  return false;
}

function airoSprint7EHasRequiredLabel_(thread, requiredLabel) {
  var labels = thread.getLabels();
  for (var i = 0; i < labels.length; i++) {
    if (String(labels[i].getName()) === String(requiredLabel)) {
      return true;
    }
  }
  return false;
}

function airoSprint7EIsSensitiveSubject_(subject) {
  var text = String(subject || "").toLowerCase();
  var terms = [
    "otp",
    "kode verifikasi",
    "verification code",
    "auth code",
    "password",
    "reset password",
    "login",
    "perangkat baru",
    "security",
    "keamanan",
    "suspicious",
    "kode keamanan",
    "authentication",
    "2fa"
  ];
  for (var i = 0; i < terms.length; i++) {
    if (text.indexOf(String(terms[i]).toLowerCase()) >= 0) {
      return true;
    }
  }
  return false;
}

function airoSprint7EClassifySubjectCandidate_(subject, provider) {
  var s = String(subject || "").toLowerCase();
  var p = String(provider || "");
  var classification = {
    candidate_status: "metadata_candidate",
    parse_status: "metadata_only_candidate",
    candidate_type: "unknown",
    clarification_needed: true,
    block_reason: ""
  };

  if (p === "Blu") {
    if (s.indexOf("masuk") >= 0) {
      classification.candidate_type = "transfer_masuk";
      classification.clarification_needed = false;
    } else if (s.indexOf("bayar otomatis") >= 0 || s.indexOf("transaksimu") >= 0 || s.indexOf("berhasil") >= 0) {
      classification.candidate_type = "blu_transaction";
      classification.clarification_needed = true;
    }
  }

  if (p === "Tokopedia Card") {
    if (s.indexOf("pembayaran tagihan") >= 0 && s.indexOf("berhasil") >= 0) {
      classification.candidate_type = "pembayaran_kartu_kredit";
      classification.clarification_needed = false;
    } else if (s.indexOf("refund") >= 0) {
      classification.candidate_type = "refund";
      classification.clarification_needed = true;
    } else {
      classification.candidate_type = "tokopedia_card_candidate";
      classification.clarification_needed = true;
    }
  }

  return classification;
}

function airoSprint7ERunOneShotReadOnlyPilot_() {
  var mailboxGuard = airoSprint7EAssertTargetMailbox_();
  if (!mailboxGuard.ok) {
    return airoSprint7EBlockedMailboxIdentityResult_(mailboxGuard);
  }


  var contract = airoSprint7EOneShotReadOnlyPilotContract_();
  var runId = "airo-7e-ro-" + Utilities.getUuid();
  var query = 'label:"' + contract.gmail_label_required + '" (from:receipts@blubybcadigital.id OR from:noreply@tokopedia.com)';
  var threads = GmailApp.search(query, 0, contract.max_threads_per_run);

  var scannedMessageCount = 0;
  var candidateCount = 0;
  var skippedSensitiveCount = 0;
  var skippedSenderNotAllowedCount = 0;
  var skippedMissingLabelCount = 0;
  var clarificationNeededCount = 0;
  var dryRunRouteCount = 0;
  var candidates = [];

  for (var t = 0; t < threads.length; t++) {
    var thread = threads[t];
    var hasLabel = airoSprint7EHasRequiredLabel_(thread, contract.gmail_label_required);
    var messages = thread.getMessages();

    for (var m = 0; m < messages.length; m++) {
      if (scannedMessageCount >= contract.max_messages_per_run) {
        break;
      }

      var message = messages[m];
      var sender = airoSprint7EExtractSenderEmail_(message.getFrom());
      var subject = String(message.getSubject() || "");
      var provider = airoSprint7EProviderForSender_(sender);

      if (!hasLabel) {
        skippedMissingLabelCount++;
        continue;
      }

      if (!airoSprint7EIsAllowedSender_(sender, contract.allowed_senders)) {
        skippedSenderNotAllowedCount++;
        continue;
      }

      scannedMessageCount++;

      if (airoSprint7EIsSensitiveSubject_(subject)) {
        skippedSensitiveCount++;
        continue;
      }

      var classification = airoSprint7EClassifySubjectCandidate_(subject, provider);
      if (classification.clarification_needed) {
        clarificationNeededCount++;
      }
      dryRunRouteCount++;
      candidateCount++;

      candidates.push({
        message_id: typeof message.getId === "function" ? message.getId() : "",
        thread_id: typeof thread.getId === "function" ? thread.getId() : "",
        sender: sender,
        provider: provider,
        subject: subject,
        date: Utilities.formatDate(message.getDate(), Session.getScriptTimeZone(), "yyyy-MM-dd'T'HH:mm:ssXXX"),
        candidate_status: classification.candidate_status,
        parse_status: classification.parse_status,
        candidate_type: classification.candidate_type,
        clarification_needed: classification.clarification_needed,
        dry_run_only: true,
        write_allowed: false,
        write_performed: false
      });
    }

    if (scannedMessageCount >= contract.max_messages_per_run) {
      break;
    }
  }

  return {
    ok: true,
    run_id: runId,
    command: contract.command,
    mode: contract.mode,
    status: "one_shot_read_only_pilot_completed",
