function appendGoldAssetRow_(sheet, parsed, rawText, common) {
  const headerRow = findGoldLedgerHeaderRow_(sheet);
  if (!headerRow) {
    return {
      status: 'fallback',
      writtenTab: sheet.getName(),
      reason: 'gold_ledger_header_not_found'
    };
  }

  const price24k = Number(parsed.goldMarketPrice24k || getGoldMarketPrice24kPerGram_() || 0);
  const physicalGram = Number(parsed.goldWeightGram || 0);
  const karat = Number(parsed.goldKarat || 24);
  const pureGram = physicalGram && karat ? physicalGram * karat / 24 : physicalGram;
  const purchasePrice = Number(parsed.goldPurchasePrice || 0);
  const action = parsed.goldAction || parseGoldAction_(rawText);

  if (!physicalGram || physicalGram <= 0) {
    return {
      status: 'fallback',
      writtenTab: sheet.getName(),
      reason: 'gold_weight_missing'
    };
  }

  const pureGramRounded = roundGoldGram_(pureGram);
  const isSell = action === 'sell';

  const gramsIn = isSell ? '' : pureGramRounded;
  const gramsOut = isSell ? pureGramRounded : '';

  const pricePerGram = purchasePrice && physicalGram
    ? Math.round(purchasePrice / physicalGram)
    : price24k;

  const totalAmount = purchasePrice || (price24k && pureGramRounded ? Math.round(price24k * pureGramRounded) : '');

  const notes = [
    parsed.goldNotes ? 'catatan: ' + parsed.goldNotes : '',
    'berat_fisik: ' + physicalGram + ' gr',
    'karat: ' + karat + 'K',
    'gram_setara_24k: ' + pureGramRounded + ' gr',
    isSell ? 'gold_outflow: true' : ''
  ].filter(Boolean).join(' | ');

  const targetRow = findNextGoldLedgerRow_(sheet, headerRow);

  // Gold Ledger fixed columns:
  // A gold_event_id
  // B date
  // C action
  // D grams_in
  // E grams_out
  // F price_per_gram
  // G fee
  // H total_amount
  // I source_account
  // J source
  // K raw_text
  // L notes, if column exists
  const row = [
    common.linked_txn_id || makeTxnId_({}, rawText),
    parsed.goldPurchaseDate || parsed.date || parseDate_(rawText),
    isSell ? 'sell' : 'buy',
    gramsIn,
    gramsOut,
    pricePerGram || '',
    '',
    totalAmount || '',
    parsed.account && parsed.account !== 'Unknown' ? parsed.account : '',
    'telegram',
    rawText,
    notes
  ];

  const width = Math.min(row.length, Math.max(sheet.getLastColumn(), 11));
  sheet.getRange(targetRow, 1, 1, width).setValues([row.slice(0, width)]);

  return {
    status: 'written',
    writtenTab: sheet.getName(),
    row: targetRow,
    rowId: sheet.getName() + ':' + targetRow,
    tabUrl: getSheetTabUrl_(SpreadsheetApp.openById(getProp_('SPREADSHEET_ID')), sheet),
    section: 'gold'
  };
}

function findGoldLedgerHeader_(sheet) {
  const maxRows = Math.min(sheet.getLastRow(), 80);
  const maxCols = Math.min(sheet.getLastColumn(), 20);
  const values = sheet.getRange(1, 1, maxRows, maxCols).getValues();

  for (let r = 0; r < values.length; r++) {
    const normalized = values[r].map(v => canonicalKey_(v));

    const hasGoldEvent = normalized.includes('gold_event_id');
    const hasGramsIn = normalized.includes('grams_in');
    const hasRawText = normalized.includes('raw_text');

    if (hasGoldEvent && hasGramsIn && hasRawText) {
      const lastNonEmpty = values[r].reduce((last, v, idx) => {
        return String(v || '').trim() ? idx + 1 : last;
      }, 0);

      return {
        row: r + 1,
        headers: values[r].slice(0, lastNonEmpty).map(v => String(v || '').trim())
      };
    }
  }

  return null;
}

function goldFieldForHeader_(header) {
  const h = canonicalKey_(header);

  const aliases = {
    gold_event_id: ['gold_event_id', 'event_id', 'id'],
    date: ['date', 'tanggal', 'tanggal_beli', 'purchase_date'],
    action: ['action', 'aksi', 'type', 'jenis'],
    grams_in: ['grams_in', 'gram_in', 'gram_masuk', 'berat', 'berat_gram'],
    grams_out: ['grams_out', 'gram_out', 'gram_keluar'],
    price_per_gram: ['price_per_gram', 'harga_per_gram', 'harga_gram'],
    fee: ['fee', 'biaya'],
    total_amount: ['total_amount', 'total', 'harga_beli', 'modal', 'nilai_beli'],
    source_account: ['source_account', 'akun_sumber', 'account'],
    source: ['source', 'sumber'],
    raw_text: ['raw_text', 'pesan', 'message'],
    notes: ['notes', 'catatan', 'note']
  };

  for (const field in aliases) {
    if (aliases[field].map(canonicalKey_).includes(h)) {
      return field;
    }
  }

  return '';
}

function parseGoldAsset_(rawText) {
  const text = String(rawText || '').toLowerCase();
  const isGoldAsset = /\b(aset\s+emas|emas|gold|antam|logam mulia)\b/i.test(text);

  if (!isGoldAsset) {
    return {
      isGoldAsset: false,
      action: '',
      karat: '',
      weightGram: '',
      pureGram: '',
      purchasePrice: '',
      purchaseDate: '',
      notes: '',
      marketPrice24k: '',
      estimatedValue: ''
    };
  }

  const action = parseGoldAction_(text);
  const karat = parseGoldKarat_(text);
  const weightGram = parseGoldWeightGram_(text);
  const pureGram = weightGram && karat ? weightGram * karat / 24 : '';
  const purchasePrice = parseGoldPurchasePrice_(text);
  const purchaseDate = parseIndonesianDate_(text) || parseDate_(text);
  const notes = parseGoldNotes_(rawText);
  const marketPrice24k = getGoldMarketPrice24kPerGram_();
  const estimatedValue = pureGram && marketPrice24k ? Math.round(pureGram * marketPrice24k) : '';

  return {
    isGoldAsset,
    action,
    karat,
    weightGram,
    pureGram,
    purchasePrice,
    purchaseDate,
    notes,
    marketPrice24k,
    estimatedValue
  };
}

function parseGoldKarat_(text) {
  const m = String(text || '').match(/\b(24|23|22|21|20|19|18|17|16|15|14|10|9)\s*k\b/i);
  if (m) return Number(m[1]);

  const jenis = String(text || '').match(/\bjenis\s+emas\s+(24|23|22|21|20|19|18|17|16|15|14|10|9)\s*k\b/i);
  if (jenis) return Number(jenis[1]);

  return 24;
}

function parseGoldWeightGram_(text) {
  const m = String(text || '').match(/\bberat\s+(\d+(?:[.,]\d+)?)\s*(gram|gr|g)\b/i);
  if (m) return Number(m[1].replace(',', '.'));

  const m2 = String(text || '').match(/\b(\d+(?:[.,]\d+)?)\s*(gram|gr|g)\b/i);
  if (m2) return Number(m2[1].replace(',', '.'));

  return '';
}

function parseGoldPurchasePrice_(text) {
  const buy = String(text || '').match(/\b(beli|harga|modal)\s+(\d+(?:[.,]\d+)?)\s*(jt|juta|rb|ribu)?\b/i);
  if (!buy) return '';

  const n = Number(buy[2].replace(',', '.'));
  const unit = String(buy[3] || '').toLowerCase();

  if (unit === 'jt' || unit === 'juta') return Math.round(n * 1000000);
  if (unit === 'rb' || unit === 'ribu') return Math.round(n * 1000);

  return cleanAmount_(buy[2]);
}

function parseGoldNotes_(rawText) {
  const m = String(rawText || '').match(/\bcatatan\s+(.+)$/i);
  return m ? m[1].trim() : '';
}

function parseIndonesianDate_(text) {
  const monthMap = {
    januari: '01', jan: '01',
    februari: '02', feb: '02',
    maret: '03', mar: '03',
    april: '04', apr: '04',
    mei: '05',
    juni: '06', jun: '06',
    juli: '07', jul: '07',
    agustus: '08', agu: '08', aug: '08',
    september: '09', sep: '09',
    oktober: '10', okt: '10', oct: '10',
    november: '11', nov: '11',
    desember: '12', des: '12', dec: '12'
  };

  const m = String(text || '').toLowerCase().match(/\btanggal\s+(\d{1,2})\s+([a-z]+)\s+(\d{4})\b/i);
  if (!m) return '';

  const day = String(m[1]).padStart(2, '0');
  const month = monthMap[m[2]];
  const year = m[3];

  if (!month) return '';

  return `${year}-${month}-${day}`;
}

function cleanupInvalidGoldLedgerRows() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
  const sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.aset);

  if (!sheet) return { ok: false, reason: 'asset_sheet_missing' };

  const headerRow = findGoldLedgerHeaderRow_(sheet);
  if (!headerRow) return { ok: false, reason: 'gold_header_missing' };

  let deleted = 0;

  for (let r = sheet.getLastRow(); r > headerRow; r--) {
    const row = sheet.getRange(r, 1, 1, 11).getValues()[0];

    const eventId = String(row[0] || '');
    const action = String(row[2] || '');
    const gramsIn = row[3];
    const rawText = String(row[10] || '').toLowerCase();

    const isGoldRow = eventId.startsWith('tg:') || rawText.includes('aset emas') || rawText.includes('emas');
    const gramsNum = Number(gramsIn);

    const invalid =
      isGoldRow &&
      (
        !action ||
        !gramsIn ||
        Number.isNaN(gramsNum) ||
        gramsNum <= 0 ||
        gramsNum > 1000
      );

    if (invalid) {
      sheet.deleteRow(r);
      deleted++;
    }
  }

  return {
    ok: true,
    deleted
  };
}

function findGoldLedgerHeaderRow_(sheet) {
  const maxRows = Math.min(sheet.getLastRow(), 100);
  const values = sheet.getRange(1, 1, maxRows, Math.min(sheet.getLastColumn(), 15)).getValues();

  for (let r = 0; r < values.length; r++) {
    const normalized = values[r].map(v => canonicalKey_(v));
    if (
      normalized.includes('gold_event_id') &&
      normalized.includes('date') &&
      normalized.includes('grams_in') &&
      normalized.includes('raw_text')
    ) {
      return r + 1;
    }
  }

  return 0;
}

function findNextGoldLedgerRow_(sheet, headerRow) {
  const lastRow = Math.max(sheet.getLastRow(), headerRow + 1);
  const values = sheet.getRange(headerRow + 1, 1, Math.max(1, lastRow - headerRow), 11).getValues();

  for (let i = values.length - 1; i >= 0; i--) {
    if (values[i].some(v => String(v || '').trim() !== '')) {
      return headerRow + 1 + i + 1;
    }
  }

  return headerRow + 1;
}

function roundGoldGram_(value) {
  const n = Number(value || 0);
  return Math.round(n * 10000) / 10000;
}

function parseGoldAction_(text) {
  const t = String(text || '').toLowerCase();

  if (/\b(jual|sell|sold|lepas)\b/i.test(t)) {
    return 'sell';
  }

  if (/\b(beli|buy|purchase|tambah|masuk)\b/i.test(t)) {
    return 'buy';
  }

  return '';
}

