// AIRO Sprint 7F-A manual dry-run poller.
// Editor-run only. No trigger. No email mutation. No full body read. No finance write.
function runSprint7FManualDryRunPollerFromEditor() {
  var guard = airoSprint7EAssertTargetMailbox_();
  var contract = airoSprint7FContract_();

  if (!guard.ok) {
    var blocked = airoSprint7EBlockedMailboxIdentityResult_(guard);
    blocked.status = "sprint7f_manual_poller_blocked_mailbox_identity";
    blocked.gmail_read_performed = false;
    blocked.mailbox_read_performed = false;
    blocked.mail_trigger_created = false;
    blocked.email_modified = false;
    blocked.full_email_body_stored = false;
    blocked.finance_write_performed = false;
    Logger.log(JSON.stringify(blocked));
    return blocked;
  }

  var labelExists = false;
  var labels = GmailApp.getUserLabels();
  for (var li = 0; li < labels.length; li++) {
    if (String(labels[li].getName() || "") === contract.gmail_label_required) {
      labelExists = true;
      break;
    }
  }

  var senderQuery = "(from:receipts@blubybcadigital.id OR from:noreply@tokopedia.com)";
  var query = labelExists
    ? 'label:"' + contract.gmail_label_required + '" ' + senderQuery
    : senderQuery;

  var threads = GmailApp.search(query, 0, contract.max_threads_per_run);

  var scannedMessageCount = 0;
  var candidateCount = 0;
  var skippedSensitiveCount = 0;
  var skippedSenderNotAllowedCount = 0;
  var candidates = [];

  for (var t = 0; t < threads.length; t++) {
    var thread = threads[t];
    var messages = thread.getMessages();

    for (var m = 0; m < messages.length; m++) {
      if (scannedMessageCount >= contract.max_messages_per_run) {
        break;
      }

      var message = messages[m];
      var sender = airoSprint7EExtractSenderEmail_(message.getFrom());
      var subject = String(message.getSubject() || "");

      if (!airoSprint7EIsAllowedSender_(sender, contract.allowed_senders)) {
        skippedSenderNotAllowedCount++;
        continue;
      }

      scannedMessageCount++;

      if (airoSprint7EIsSensitiveSubject_(subject)) {
        skippedSensitiveCount++;
        continue;
      }

      var provider = airoSprint7EProviderForSender_(sender);
      var classification = airoSprint7EClassifySubjectCandidate_(subject, provider);
      candidateCount++;

      candidates.push({
        candidate_id: "emc:" + airoSprint7FSubjectHashOnly_(typeof message.getId === "function" ? message.getId() : String(thread.getId ? thread.getId() : "")),
        message_id: typeof message.getId === "function" ? message.getId() : "",
        thread_id: typeof thread.getId === "function" ? thread.getId() : "",
        sender: sender,
        provider: provider,
        subject_hash: airoSprint7FSubjectHashOnly_(subject),
        display_amount: airoSprint7FExtractAmountFromSubject_(subject),
        inferred_direction: airoSprint7FInferDirection_(subject, classification.candidate_type),
        display_time: Utilities.formatDate(message.getDate(), Session.getScriptTimeZone(), "dd/MM/yyyy HH:mm"),
        clarification_question_type: airoSprint7FClarificationQuestionType_(airoSprint7FInferDirection_(subject, classification.candidate_type)),
        received_at: Utilities.formatDate(message.getDate(), Session.getScriptTimeZone(), "yyyy-MM-dd'T'HH:mm:ssXXX"),
        parse_status: classification.parse_status,
        candidate_type: classification.candidate_type,
        clarification_needed: classification.clarification_needed,
        dry_run_only: true,
        telegram_clarification_sent: false,
        write_allowed: false,
        write_performed: false
      });
    }

    if (scannedMessageCount >= contract.max_messages_per_run) {
      break;
    }
  }

  var result = {
    ok: true,
    sprint: "7F-A",
    status: "sprint7f_manual_dryrun_poller_completed",
    mode: "manual_editor_dryrun_no_trigger",
    target_gmail_account: contract.target_gmail_account,
    gmail_label: contract.gmail_label_required,
    max_threads: contract.max_threads_per_run,
    max_messages: contract.max_messages_per_run,
    scanned_thread_count: threads.length,
    scanned_message_count: scannedMessageCount,
    candidate_count: candidateCount,
    skipped_sensitive_count: skippedSensitiveCount,
    skipped_sender_not_allowed_count: skippedSenderNotAllowedCount,
    candidates: candidates,
    gmail_read_performed: true,
    mailbox_read_performed: true,
    mail_trigger_created: false,
