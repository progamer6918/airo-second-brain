function airoSprint7FSubjectHashOnly_(subject) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(subject || ""));
  var out = [];
  for (var i = 0; i < bytes.length; i++) {
    var v = bytes[i];
    if (v < 0) v += 256;
    out.push(("0" + v.toString(16)).slice(-2));
  }
  return out.join("").slice(0, 16);
}

