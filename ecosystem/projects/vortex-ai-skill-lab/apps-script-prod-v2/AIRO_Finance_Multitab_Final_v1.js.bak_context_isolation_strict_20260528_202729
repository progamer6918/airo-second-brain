/**
 * Safe, specific manual cleanup function for duplicate rows and blank source_tab in Account Ledger.
 */
function AIRO_CLEANUP_ACCOUNT_LEDGER_BACKFILL_DUPES_20260517() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
  var tz = ss.getSpreadsheetTimeZone() || Session.getScriptTimeZone();

  var sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.accountLedger);
  if (!sheet) {
    throw new Error('Account Ledger sheet not found');
  }

  var headerObj = findHeader_(sheet);
  if (!headerObj) {
    throw new Error('Header not found in Account Ledger');
  }

  var headers = headerObj.headers;
  var startRow = headerObj.row + 1;
  var lastRow = sheet.getLastRow();

  if (lastRow < 15) {
    throw new Error('Sheet row count is less than 15. Minimal 15 rows required before cleanup.');
  }

  // Inner helper to construct unique comparison key for a row
  function getRowKey(rowNum) {
    var vals = sheet.getRange(rowNum, 1, 1, headers.length).getValues()[0];
    var rowObj = {};
    for (var c = 0; c < headers.length; c++) {
      var h = headers[c];
      if (h) {
        rowObj[canonicalKey_(h)] = vals[c];
      }
    }
    var dateVal = rowObj['date'];
    if (dateVal instanceof Date) {
      dateVal = Utilities.formatDate(dateVal, tz, 'yyyy-MM-dd');
    }
    var d = String(dateVal || '').trim().toLowerCase();
    var acc = String(rowObj['account'] || '').trim().toLowerCase();
    var amtIn = Number(rowObj['amount_in']) || 0;
    var amtOut = Number(rowObj['amount_out']) || 0;
    var descVal = rowObj['description'] || rowObj['raw_text'] || '';
    var desc = String(descVal || '').trim().toLowerCase();
    return d + '|' + acc + '|' + amtIn + '|' + amtOut + '|' + desc;
  }

  // Safety validations: Row keys must match exactly
  var key2 = getRowKey(2);
  var key12 = getRowKey(12);
  if (key2 !== key12) {
    throw new Error('Safety validation failed: Row 2 key does not match Row 12 key.');
  }

  var key3 = getRowKey(3);
  var key13 = getRowKey(13);
  if (key3 !== key13) {
    throw new Error('Safety validation failed: Row 3 key does not match Row 13 key.');
  }

  var key4 = getRowKey(4);
  var key14 = getRowKey(14);
  if (key4 !== key14) {
    throw new Error('Safety validation failed: Row 4 key does not match Row 14 key.');
  }

  var key5 = getRowKey(5);
  var key15 = getRowKey(15);
  if (key5 !== key15) {
    throw new Error('Safety validation failed: Row 5 key does not match Row 15 key.');
  }

  // Perform deletion of exact row indices in descending order
  sheet.deleteRow(15);
  sheet.deleteRow(14);
  sheet.deleteRow(13);
  sheet.deleteRow(12);

  // Find column index of source_tab
  var sourceTabColIdx = -1;
  for (var c = 0; c < headers.length; c++) {
    if (canonicalKey_(headers[c]) === 'source_tab') {
      sourceTabColIdx = c + 1;
      break;
    }
  }

  if (sourceTabColIdx === -1) {
    throw new Error('Could not find column index of source_tab');
  }

  // Repair missing source_tab values for remaining rows
  var repairedSourceTabRows = [];
  var updatedLastRow = sheet.getLastRow();
  for (var r = startRow; r <= updatedLastRow; r++) {
    var val = sheet.getRange(r, sourceTabColIdx).getValue();
    if (String(val || '').trim() === '') {
      sheet.getRange(r, sourceTabColIdx).setValue(AIRO_CONFIG.tabs.cash);
      repairedSourceTabRows.push(r);
    }
  }

  var resultSummary = {
    deletedRows: [15, 14, 13, 12],
    repairedSourceTabRows: repairedSourceTabRows,
    accountLedgerTab: sheet.getName()
  };

  Logger.log(JSON.stringify(resultSummary));
  return resultSummary;
}

/**
 * Normalizes input value to supported accounts (Cash, Blu, BCA).
 */
function normalizeSupportedAccount_(value) {
  var v = String(value || '').toLowerCase().trim();
  if (v === 'cash' || v === 'tunai') return 'Cash';
  if (v === 'blu' || v === 'blu bca' || v === 'blubca' || v === 'pocket blu') return 'Blu';
  if (v === 'bca') return 'BCA';
  return '';
}

/**
 * Detects whether the transaction represents an internal transfer between Cash, Blu, and BCA.
 */
function detectInternalTransfer_(parsed, rawText) {
  var t = String(rawText || '').toLowerCase();

  // Find targetAccount (receipt) from "ke <account>" or parsed.account fallback
  var targetAccount = '';
  var toMatch = t.match(/\bke\s+(cash|tunai|blu|blu bca|blubca|pocket blu|bca)\b/i);
  if (toMatch) {
    targetAccount = normalizeSupportedAccount_(toMatch[1]);
  } else if (parsed && parsed.account) {
    targetAccount = normalizeSupportedAccount_(parsed.account);
  }

  // Find sourceAccount (sending) from "dari <account>"
  var sourceAccount = '';
  var fromMatch = t.match(/\bdari\s+(cash|tunai|blu|blu bca|blubca|pocket blu|bca)\b/i);
  if (fromMatch) {
    sourceAccount = normalizeSupportedAccount_(fromMatch[1]);
  }

  // Both must be valid and different
  if (!targetAccount || !sourceAccount) return null;
  if (targetAccount === sourceAccount) return null;

  return {
    sourceAccount: sourceAccount,
    targetAccount: targetAccount
  };
}

/**
 * Writes an internal transfer to the Account Ledger as two separate entries (outflow and inflow)
 * and synchronizes with the Cash Ledger compatibility layer if one of the accounts is Cash.
 */
function writeInternalTransferToAccountLedger_(ss, parsed, rawText, common, transfer) {
  var sharedTxnId = (common && (common.linked_txn_id || common.rowId)) || makeTxnId_({}, rawText);

  // Write Source Outflow Row
  var parsedOut = {
    ...parsed,
    account: transfer.sourceAccount,
    type: 'transfer_out',
    amount: parsed.amount
  };
  var commonOut = {
    ...common,
    rowId: sharedTxnId + ':out',
    linked_txn_id: sharedTxnId + ':in'
  };
  var outResult = writeAccountLedgerMirror_(ss, parsedOut, rawText, commonOut, transfer.sourceAccount);

  // Write Target Inflow Row
  var parsedIn = {
    ...parsed,
    account: transfer.targetAccount,
    type: 'transfer_in',
    amount: parsed.amount
  };
  var commonIn = {
    ...common,
    rowId: sharedTxnId + ':in',
    linked_txn_id: sharedTxnId + ':out'
  };
  var inResult = writeAccountLedgerMirror_(ss, parsedIn, rawText, commonIn, transfer.targetAccount);

  // Cash Ledger compatibility layer synchronization
  var cashResult = null;
  if (transfer.targetAccount === 'Cash') {
    var parsedCashIn = {
      ...parsed,
      account: 'Cash',
      type: 'transfer_in',
      amount: parsed.amount
    };
    cashResult = writeCashLedgerCompatibility_(ss, parsedCashIn, rawText, common);
  } else if (transfer.sourceAccount === 'Cash') {
    var parsedCashOut = {
      ...parsed,
      account: 'Cash',
      type: 'transfer_out',
      amount: parsed.amount
    };
    cashResult = writeCashLedgerCompatibility_(ss, parsedCashOut, rawText, common);
  }

  return {
    status: 'written',
    writtenTab: AIRO_CONFIG.tabs.accountLedger,
    transferInternal: true,
    sourceAccount: transfer.sourceAccount,
    targetAccount: transfer.targetAccount,
    accountLedgerRows: [
      (outResult && outResult.row) ? outResult.row : null,
      (inResult && inResult.row) ? inResult.row : null
    ],
    cashLedgerRow: (cashResult && cashResult.row) ? cashResult.row : null
  };
}

