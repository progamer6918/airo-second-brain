function airoSprint5ReconciliationReadOnly_(ss, options) {
  ss = ss || SpreadsheetApp.getActiveSpreadsheet();
  options = options || {};

  const limit = Math.max(1, Math.min(Number(options.sampleLimit || 8), 20));
  const accountSheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.accountLedger);
  const financeSheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.financeEvents);

  const result = {
    ok: true,
    command: 'sprint5_reconciliation_read_only',
    write_performed: false,
    google_write_performed: false,
    account_ledger: {
      sheet_found: Boolean(accountSheet),
      row_count: 0,
      missing_linked_txn_id: 0,
      missing_source_tab: 0,
      duplicate_linked_txn_id_candidates: 0,
      lainnya_category_rows: 0
    },
    finance_events: {
      sheet_found: Boolean(financeSheet),
      row_count: 0,
      transaction_created_rows: 0,
      missing_linked_txn_id: 0,
      missing_source_tab: 0,
      failed_status_rows: 0
    },
    reconciliation: {
      account_without_finance_event: 0,
      finance_event_without_account: 0,
      status: 'unknown'
    },
    samples: {
      duplicate_linked_txn_id: [],
      account_without_finance_event: [],
      finance_event_without_account: [],
      lainnya_category_rows: []
    }
  };

  const accountByLinked = {};
  const financeCreatedByLinked = {};

  if (accountSheet && accountSheet.getLastRow() > 1) {
    const lastRow = accountSheet.getLastRow();
    const lastCol = accountSheet.getLastColumn();
    const headers = accountSheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0].map(function(h) {
      return String(h || '').trim().toLowerCase();
    });

    const idx = {
      entry_id: headers.indexOf('entry_id'),
      category: headers.indexOf('category'),
      raw_text: headers.indexOf('raw_text'),
      source_tab: headers.indexOf('source_tab'),
      linked_txn_id: headers.indexOf('linked_txn_id')
    };

    const values = accountSheet.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();
    result.account_ledger.row_count = values.length;

    values.forEach(function(row, offset) {
      const sheetRow = offset + 2;
      const entryId = idx.entry_id >= 0 ? String(row[idx.entry_id] || '').trim() : '';
      const linked = idx.linked_txn_id >= 0 ? String(row[idx.linked_txn_id] || '').trim() : '';
      const sourceTab = idx.source_tab >= 0 ? String(row[idx.source_tab] || '').trim() : '';
      const category = idx.category >= 0 ? String(row[idx.category] || '').trim() : '';
      const rawText = idx.raw_text >= 0 ? String(row[idx.raw_text] || '').trim() : '';
      const key = linked || entryId;

      if (!linked) result.account_ledger.missing_linked_txn_id += 1;
      if (!sourceTab) result.account_ledger.missing_source_tab += 1;

      if (/^(lainnya|lain|uncategorized|unknown)$/i.test(category)) {
        result.account_ledger.lainnya_category_rows += 1;
        if (result.samples.lainnya_category_rows.length < limit) {
          result.samples.lainnya_category_rows.push({
            row: sheetRow,
            category: category,
            raw_text: rawText.slice(0, 140)
          });
        }
      }

      if (key) {
        if (!accountByLinked[key]) accountByLinked[key] = [];
        accountByLinked[key].push(sheetRow);
      }
    });

    Object.keys(accountByLinked).forEach(function(key) {
      if (accountByLinked[key].length > 1) {
        result.account_ledger.duplicate_linked_txn_id_candidates += 1;
        if (result.samples.duplicate_linked_txn_id.length < limit) {
          result.samples.duplicate_linked_txn_id.push({
            linked_txn_id: key,
            rows: accountByLinked[key]
          });
        }
      }
    });
  }

  if (financeSheet && financeSheet.getLastRow() > 1) {
    const lastRow = financeSheet.getLastRow();
    const lastCol = financeSheet.getLastColumn();
    const headers = financeSheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0].map(function(h) {
      return String(h || '').trim().toLowerCase();
    });

    const idx = {
      event_type: headers.indexOf('event_type'),
      source_tab: headers.indexOf('source_tab'),
      linked_txn_id: headers.indexOf('linked_txn_id'),
      status: headers.indexOf('status')
    };

    const values = financeSheet.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();
    result.finance_events.row_count = values.length;

    values.forEach(function(row, offset) {
      const sheetRow = offset + 2;
      const eventType = idx.event_type >= 0 ? String(row[idx.event_type] || '').trim() : '';
      const linked = idx.linked_txn_id >= 0 ? String(row[idx.linked_txn_id] || '').trim() : '';
      const sourceTab = idx.source_tab >= 0 ? String(row[idx.source_tab] || '').trim() : '';
      const status = idx.status >= 0 ? String(row[idx.status] || '').trim() : '';

      if (/^transaction_created$/i.test(eventType)) {
        result.finance_events.transaction_created_rows += 1;
      }
      if (!linked) result.finance_events.missing_linked_txn_id += 1;
      if (!sourceTab) result.finance_events.missing_source_tab += 1;
      if (/failed|error|partial/i.test(status)) result.finance_events.failed_status_rows += 1;

      if (linked && /^transaction_created$/i.test(eventType)) {
        if (!financeCreatedByLinked[linked]) financeCreatedByLinked[linked] = [];
        financeCreatedByLinked[linked].push(sheetRow);
      }
    });
  }

  Object.keys(accountByLinked).forEach(function(linked) {
    if (!financeCreatedByLinked[linked]) {
      result.reconciliation.account_without_finance_event += 1;
      if (result.samples.account_without_finance_event.length < limit) {
        result.samples.account_without_finance_event.push({
          linked_txn_id: linked,
          account_rows: accountByLinked[linked]
        });
      }
    }
  });

  Object.keys(financeCreatedByLinked).forEach(function(linked) {
    if (!accountByLinked[linked]) {
      result.reconciliation.finance_event_without_account += 1;
      if (result.samples.finance_event_without_account.length < limit) {
        result.samples.finance_event_without_account.push({
          linked_txn_id: linked,
          finance_event_rows: financeCreatedByLinked[linked]
        });
      }
    }
  });

  const issueCount =
    result.account_ledger.missing_linked_txn_id +
    result.account_ledger.missing_source_tab +
    result.account_ledger.duplicate_linked_txn_id_candidates +
    result.finance_events.missing_linked_txn_id +
    result.finance_events.missing_source_tab +
    result.finance_events.failed_status_rows +
    result.reconciliation.account_without_finance_event +
    result.reconciliation.finance_event_without_account;

  result.reconciliation.status = issueCount === 0 ? 'reconciled' : 'needs_review';
  result.issue_count = issueCount;

  airoApplySprint5DashboardAnalytics_(result);
  return result;
}

// AIRO_SPRINT5_DASHBOARD_SAFE_ANALYTICS_V1
// Converts read-only reconciliation output into Dashboard-safe trust signals.
// This helper must stay read-only: no Spreadsheet writes, no row mutation, no deletes.
function airoSprint5Number_(value) {
  const n = Number(value || 0);
  return Number.isFinite(n) ? n : 0;
}

function airoSprint5PickNumber_(obj, keys) {
  obj = obj || {};
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    if (Object.prototype.hasOwnProperty.call(obj, key)) {
      return airoSprint5Number_(obj[key]);
    }
  }
  return 0;
}

function airoBuildSprint5DashboardAnalytics_(result) {
  result = result || {};

  const account = result.account_ledger || result.accountLedger || result.account || {};
  const events = result.finance_events || result.financeEvents || result.events || {};
  const recon = result.reconciliation || {};

  const accountWithoutFinanceEvent = airoSprint5PickNumber_(recon, [
    'account_without_finance_event',
    'accountWithoutFinanceEvent',
    'account_without_event'
  ]);

  const financeEventWithoutAccount = airoSprint5PickNumber_(recon, [
    'finance_event_without_account',
    'financeEventWithoutAccount',
    'event_without_account'
  ]);

  const missingLinkedTxnId = airoSprint5PickNumber_(account, [
    'missing_linked_txn_id',
    'missingLinkedTxnId',
    'missing_linked_txn_id_count',
    'missing_linked_txn_rows'
  ]);

  const lainnyaCategoryRows = airoSprint5PickNumber_(account, [
    'lainnya_category_rows',
    'lainnyaCategoryRows',
    'lainnya_rows',
    'lainnya_category_count'
  ]);

  const financeFailedRows =
    airoSprint5PickNumber_(events, [
      'failed_error_rows',
      'failed_or_error_rows',
      'failed_rows',
      'error_rows'
    ]) +
    airoSprint5PickNumber_(recon, [
      'failed_error_rows',
      'failed_or_error_rows',
      'failed_rows',
      'error_rows'
    ]);

  const partialFailedRows =
    airoSprint5PickNumber_(events, [
      'partial_failed',
      'partial_failed_rows',
      'partialFailedRows'
    ]) +
    airoSprint5PickNumber_(recon, [
      'partial_failed',
      'partial_failed_rows',
      'partialFailedRows'
    ]);

  const legacyIssueCount = accountWithoutFinanceEvent + missingLinkedTxnId;
  const activeWarningCount = lainnyaCategoryRows;
  const activeCriticalCount = financeEventWithoutAccount + financeFailedRows + partialFailedRows;
  const activeIssueCount = activeWarningCount + activeCriticalCount;
  const totalDashboardIssueCount = legacyIssueCount + activeIssueCount;

  let dataStatus = 'Trusted';
  let dataStatusReason = 'No active or legacy reconciliation issue detected.';

  if (activeCriticalCount > 0) {
    dataStatus = 'Dirty';
    dataStatusReason = 'Active critical reconciliation issue detected.';
  } else if (activeWarningCount > 0 || legacyIssueCount > 0) {
    dataStatus = 'Warning';
    dataStatusReason = 'Reconciliation needs review, but no active critical issue was detected.';
  }

  const actionRequired = [];

  if (activeCriticalCount > 0) {
    actionRequired.push({
      severity: 'CRITICAL',
      key: 'active_critical_reconciliation_issue',
      message: String(activeCriticalCount) + ' active critical reconciliation issue needs inspect/retry/fix.',
      action: 'Fix'
    });
  }

  if (lainnyaCategoryRows > 0) {
    actionRequired.push({
      severity: 'WARNING',
      key: 'lainnya_category_rows',
      message: String(lainnyaCategoryRows) + ' Account Ledger rows use kategori Lainnya and need category review.',
      action: 'Review Category'
    });
  }

  if (accountWithoutFinanceEvent > 0) {
    actionRequired.push({
      severity: 'WARNING',
      key: 'account_without_finance_event_cutover_classification',
      message: String(accountWithoutFinanceEvent) + ' Account Ledger rows without Finance Event must be classified legacy vs post-cutover.',
      action: 'Classify'
    });
  }

  if (missingLinkedTxnId > 0) {
    actionRequired.push({
      severity: 'WARNING',
      key: 'missing_linked_txn_id_legacy_monitor',
      message: String(missingLinkedTxnId) + ' Account Ledger rows missing linked_txn_id; monitor as legacy unless active period affected.',
      action: 'Monitor'
    });
  }

  return {
    data_status: dataStatus,
    dashboard_status: dataStatus,
    data_status_reason: dataStatusReason,
    issue_count_total: totalDashboardIssueCount,
    issue_count_active: activeIssueCount,
    issue_count_legacy: legacyIssueCount,
    critical_count: activeCriticalCount,
    warning_count: activeWarningCount + (legacyIssueCount > 0 ? 1 : 0),
    action_required_count: actionRequired.length,
    last_reconciliation_mode: String(result.mode || 'read-only'),
    raw_reconciliation_status: String(recon.status || ''),
    raw_issue_count: airoSprint5Number_(recon.issue_count),
    issue_breakdown: {
      legacy_warning: {
        account_without_finance_event: accountWithoutFinanceEvent,
        missing_linked_txn_id: missingLinkedTxnId
      },
      active_warning: {
        lainnya_category_rows: lainnyaCategoryRows
      },
      active_dirty: {
        finance_event_without_account: financeEventWithoutAccount,
        finance_failed_rows: financeFailedRows,
        partial_failed_rows: partialFailedRows
      }
    },
    action_required: actionRequired
  };
}

