    'Saya tangkap ada transaksi Cash Rp' + ((parsed && parsed.amount) || 0) + ', tapi maksudnya belum jelas.\n\n' +
    'Pilih salah satu:\n' +
    'A. Cash masuk\n' +
    'B. Cash keluar\n' +
    'C. Saldo cash awal / saya pegang cash\n' +
    'D. Sisa cash\n' +
    'E. Lainnya / tulis manual\n\n' +
    'Boleh juga balas natural, contoh: keluar buat makan.'
  );
}

function cashClarificationResolvedText_(pending, rawText) {
  const direction = normalizeCashClarificationAnswer_(rawText);
  const amount = String(Number((pending && pending.amount) || 0));
  const t = String(rawText || '').trim();
  const tail = /^[a-e1-5]$/i.test(t) ? '' : t;

  if (direction === 'cash_in') return ('cash masuk ' + amount + ' ' + tail).trim();
  if (direction === 'cash_out') return ('cash keluar ' + amount + ' ' + tail).trim();
  if (direction === 'cash_start') return ('saya pegang cash ' + amount + ' saldo awal ' + tail).trim();
  if (direction === 'cash_remaining') return ('sisa cash ' + amount + ' saldo akhir ' + tail).trim();

  return '';
}

function normalizeDirectionClarificationAnswer_(text) {
  const t = String(text || '').toLowerCase().trim();

  if (/^(a|1)$/i.test(t) || /\b(keluar|pengeluaran|expense|bayar|beli|pakai)\b/i.test(t)) return 'out';
  if (/^(b|2)$/i.test(t) || /\b(masuk|pemasukan|income|terima|diterima|refund|gaji)\b/i.test(t)) return 'in';
  if (/^(c|3)$/i.test(t) || /\b(transfer|tf|pindah)\b/i.test(t)) return 'transfer';
  if (/^(d|4)$/i.test(t) || /\b(saldo|balance|tercatat|awal|akhir)\b/i.test(t)) return 'balance';
  if (/^(e|5)$/i.test(t) || /\b(lain|lainnya|manual)\b/i.test(t)) return 'manual';

  return '';
}

function canAskDirectionAmbiguousClarification_(parsed, rawText) {
  const text = String(rawText || '').toLowerCase();
  const amount = Number((parsed && parsed.amount) || 0);
  const account = String((parsed && parsed.account) || '').trim().toLowerCase();
