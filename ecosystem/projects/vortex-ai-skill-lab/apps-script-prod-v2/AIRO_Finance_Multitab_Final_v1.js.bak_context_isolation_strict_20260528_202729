      rowId: makeTxnId_(msg, effectiveRawText)
    };

    const finalTab = parsed.needsReview ? AIRO_CONFIG.tabs.review : plannedTab;
    const routedResult = writeRouted_(ss, finalTab, parsed, effectiveRawText, stagingResult);

    const tabLink = routedResult.tabUrl || getSheetTabUrlByName_(ss, routedResult.writtenTab || finalTab);

    const reply =
      '✅ Tercatat ke Google Sheet.\n\n' +
      'Rencana tab: ' + plannedTab + '\n' +
      'Ditulis ke: ' + (routedResult.writtenTab || finalTab) + '\n' +
      'Akun: ' + parsed.account + '\n' +
      'Kategori: ' + parsed.category + '\n' +
      'Nominal: Rp' + parsed.amount + '\n\n' +
      '🔗 Buka tab: ' + tabLink;

    sendTelegram_(chatId, reply);

    return json_({
      ok: true,
      appended: true,
      planned_tab: plannedTab,
      written_tab: routedResult.writtenTab || finalTab,
      routed_status: routedResult.status,
      row: routedResult.row || '',
      row_id: routedResult.rowId || '',
      write_verified: routedResult.writeVerified === true,
      readback_raw_text: routedResult.readbackRawText || '',
      spreadsheet_marker: routedResult.spreadsheetMarker || safeSpreadsheetMarker_(ss),
      amount: parsed.amount,
      category: parsed.category,
      account: parsed.account
    });
  } catch (err) {
    return json_({ ok: false, error: String(err && err.message ? err.message : err) });
  }
}

function makeTxnId_(msg, rawText) {
  const messageId = msg && msg.message_id ? String(msg.message_id) : 'no_msg_id';
  const chatId = msg && msg.chat && msg.chat.id ? String(msg.chat.id) : 'no_chat_id';
  const date = msg && msg.date ? String(msg.date) : String(Date.now());
  const textHash = Utilities.base64EncodeWebSafe(
    Utilities.computeDigest(
      Utilities.DigestAlgorithm.SHA_256,
      String(rawText || '')
    )
  ).slice(0, 16);

  return 'tg:' + chatId + ':' + messageId + ':' + date + ':' + textHash;
}

function findCashLedgerExactHeaderCol_(sheet, headerName) {
  try {
    if (!sheet) return 0;
    const lastCol = Math.max(sheet.getLastColumn(), 1);
    const headers = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
    const target = String(headerName || '').toLowerCase().trim();
    for (var i = 0; i < headers.length; i++) {
      const h = String(headers[i] || '').toLowerCase().trim();
      if (h === target) return i + 1;
    }
  } catch (e) {}
  return 0;
}

function syncCashLedgerRuntimeAmountColumns_(ss, rowNumber, inflow, amount) {
  try {
    const sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.cash);
    if (!sheet || !rowNumber || rowNumber <= 1) return;
    const inCol = findCashLedgerExactHeaderCol_(sheet, 'amount_in');
    const outCol = findCashLedgerExactHeaderCol_(sheet, 'amount_out');
    if (inCol) sheet.getRange(rowNumber, inCol).setValue(inflow ? amount : '');
    if (outCol) sheet.getRange(rowNumber, outCol).setValue(inflow ? '' : amount);
  } catch (e) {}
}

function isCashLedgerCompatibilityWriteEnabled_() {
  // AIRO_SPRINT3_SAFE_CASH_COMPAT_FLAG_V1
  // This flag is optional. Missing flag means legacy Cash Ledger writes stay disabled.
  // Do not use getProp_ here because getProp_ throws on missing properties.
  let value = '';

  try {
    value = PropertiesService
      .getScriptProperties()
      .getProperty('AIRO_CASH_LEDGER_COMPAT_WRITES_ENABLED');
  } catch (err) {
    return false;
  }

  if (value === null || value === undefined || String(value).trim() === '') {
    return false;
  }

  return /^(1|true|yes|on)$/i.test(String(value).trim());
}

function getFinanceEventsHeaders_() {
  return [
    'event_id',
    'event_ts',
    'event_type',
    'event_source',
    'source_tab',
    'source_row',
    'linked_txn_id',
    'account',
    'category',
    'amount',
    'direction',
    'status',
    'reason',
    'payload_json',
    'notes'
  ];
}

function ensureFinanceEventsSheet_(ss) {
  ss = ss || SpreadsheetApp.getActiveSpreadsheet();
  const headers = getFinanceEventsHeaders_();
  let sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.financeEvents);
  if (!sheet) {
    sheet = ss.insertSheet(AIRO_CONFIG.tabs.financeEvents);
  }

  const existing = sheet
    .getRange(1, 1, 1, headers.length)
    .getValues()[0]
    .map(function(value) {
      return String(value || '').trim();
    });

  const needsHeader = existing.join('') === '' || headers.some(function(header, index) {
    return canonicalKey_(existing[index]) !== canonicalKey_(header);
  });

  if (needsHeader) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
  }

  return {
    ok: true,
    sheet: sheet,
    tabName: AIRO_CONFIG.tabs.financeEvents,
    headers: headers
  };
}

function financeEventPayloadJson_(payload) {
  if (payload === null || payload === undefined || payload === '') {
    return '';
  }

  try {
    const raw = typeof payload === 'string' ? payload : JSON.stringify(payload);
    if (/\b(otp|password|access_token|token|secret|pin)\b/i.test(raw)) {
      return JSON.stringify({
        redacted: true,
        reason: 'sensitive_payload_blocked'
      });
    }
    return String(raw).slice(0, 2000);
  } catch (err) {
    return '';
  }
}

function buildFinanceEvent_(event) {
  event = event || {};
  return {
    event_id: event.event_id || ('fe:' + Utilities.getUuid()),
    event_ts: event.event_ts || new Date(),
    event_type: event.event_type || 'manual_event',
    event_source: event.event_source || 'system',
    source_tab: event.source_tab || '',
    source_row: event.source_row || '',
    linked_txn_id: event.linked_txn_id || event.entry_id || '',
    account: event.account || '',
    category: event.category || '',
    amount: event.amount || '',
    direction: event.direction || '',
    status: event.status || 'ok',
    reason: event.reason || '',
    payload_json: financeEventPayloadJson_(event.payload_json || event.payload || ''),
    notes: event.notes || ''
  };
}

function writeFinanceEvent_(ss, event) {
  ss = ss || SpreadsheetApp.getActiveSpreadsheet();
  ensureFinanceEventsSheet_(ss);
  const row = buildFinanceEvent_(event);
  return appendByHeader_(ss, AIRO_CONFIG.tabs.financeEvents, row, { createIfMissing: false });
}

function appendFinanceEvent_(ss, event) {
  return writeFinanceEvent_(ss, event);
}

function writeCashLedgerCompatibility_(ss, parsed, rawText, common) {
  if (!isCashLedgerCompatibilityWriteEnabled_()) {
    return {
      ok: true,
      skipped: true,
      reason: 'cash_ledger_compat_writes_disabled'
    };
  }
  return writeCashLedger_(ss, parsed, rawText, common);
}

function writeCashLedger_(ss, parsed, rawText, common) {
  const cashInflow = isCashInflowData_({
    raw_text: rawText,
    type: parsed && parsed.type
  });
  const sessionId = cashSessionId_(rawText);
  const date = parsed.date || parseDate_(rawText || '');
  const entryId = common.linked_txn_id || makeTxnId_({}, rawText);

  const row = {
    ...common,
    entry_id: entryId,
    session_id: sessionId,
    date: date,
    date_start: date,
    date_end: date,
    amount_start: cashInflow ? parsed.amount : '',
    amount_remaining: cashInflow ? parsed.amount : '',
    days_lasted: '',
    type: cashInflow ? 'transfer_in' : (parsed.type || 'expense'),
    category: isCashBensinText_(rawText) ? 'Transport' : (parsed.category || 'Lainnya'),
    description: rawText,
    notes: rawText,
    amount: parsed.amount,
    amount_in: cashInflow ? parsed.amount : '',
    amount_out: cashInflow ? '' : parsed.amount,
    account: 'Cash',
    status: cashInflow ? 'aktif' : ''
  };

  const result = appendByHeader_(ss, AIRO_CONFIG.tabs.cash, row, { createIfMissing: false });
  if (result && result.status === 'written' && result.row) {
    syncCashLedgerRuntimeAmountColumns_(ss, result.row, cashInflow, parsed.amount);
  }
  return result;
}

/**
 * Mirrors cash movement to the Account Ledger tab.
 * Balance is intentionally left blank for Google Sheet formulas.
 */
function writeAccountLedgerMirror_(ss, parsed, rawText, common, sourceTab) {
  const entryId = common.rowId || common.linked_txn_id || makeTxnId_({}, rawText);
  const date = parsed.date || parseDate_(rawText || '');
  const type = String(parsed.type || '').toLowerCase();
  const amount = parsed.amount || 0;

  const explicitInflowTypes = ['income', 'transfer_in', 'cash_in'];
  const explicitOutflowTypes = ['expense', 'transfer_out', 'cash_out', 'cc_payment', 'debt_payment', 'asset_purchase'];
  let isInflow;
  if (explicitInflowTypes.includes(type)) {
    isInflow = true;
  } else if (explicitOutflowTypes.includes(type)) {
    isInflow = false;
  } else {
    isInflow = isCashInflowText_(rawText);
  }

  let accountName = parsed.account || 'Unknown';
  if (String(accountName || '').trim().toLowerCase() === 'cash') {
    accountName = cashAccountNameForLedger_(rawText);
  }

  const row = {
    entry_id: entryId,
    date: date,
    account: accountName,
    amount_in: isInflow ? amount : '',
    amount_out: isInflow ? '' : amount,
    balance: '',
    type: parsed.type || (isInflow ? 'transfer_in' : 'expense'),
    category: parsed.category || 'Lainnya',
    description: rawText,
    raw_text: rawText,
    source_tab: sourceTab,
    linked_txn_id: common.linked_txn_id || entryId,
    notes: ''
  };

  try { ensureAccountLedgerSheet_(ss); } catch (e) {}
  const result = appendByHeader_(ss, AIRO_CONFIG.tabs.accountLedger, row, { createIfMissing: false });

  if (result && result.status === 'written' && result.row) {
    try {
      const sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.accountLedger);
      if (sheet) {
        const r = result.row;
        const formula = '=IF(C' + r + '="";"";SUMIFS($D$2:D' + r + ';$C$2:C' + r + ';C' + r + ')-SUMIFS($E$2:E' + r + ';$C$2:C' + r + ';C' + r + '))';
        sheet.getRange(r, 6).setFormula(formula);
        applyAccountLedgerRowStyle_(sheet, r);
      }
    } catch (e) {}
  }

  return result;
}

/**
 * Ensures the 📒 Account Ledger tab exists with the correct headers.
 * Creates the tab and writes headers if missing. Freezes row 1.
 * Returns the sheet, or null on error (mirror will fallback safely).
 */
function ensureAccountLedgerSheet_(ss) {
  var ACCOUNT_LEDGER_HEADERS = [
    'entry_id', 'date', 'account', 'amount_in', 'amount_out',
    'balance', 'type', 'category', 'description', 'raw_text',
    'source_tab', 'linked_txn_id', 'notes'
  ];

  try {
    var sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.accountLedger);

    if (!sheet) {
      sheet = ss.insertSheet(AIRO_CONFIG.tabs.accountLedger);
      sheet.getRange(1, 1, 1, ACCOUNT_LEDGER_HEADERS.length)
        .setValues([ACCOUNT_LEDGER_HEADERS]);
      styleAccountLedgerSheet_(sheet);
      return sheet;
    }

    // Sheet exists — fill headers only if row 1 is completely empty
    var lastCol = Math.max(sheet.getLastColumn(), ACCOUNT_LEDGER_HEADERS.length);
    var existingHeaders = sheet.getRange(1, 1, 1, lastCol).getValues()[0]
      .map(function(v) { return String(v || '').trim(); });
    var allEmpty = existingHeaders.every(function(h) { return h === ''; });

    if (allEmpty) {
      sheet.getRange(1, 1, 1, ACCOUNT_LEDGER_HEADERS.length)
        .setValues([ACCOUNT_LEDGER_HEADERS]);
    }

    styleAccountLedgerSheet_(sheet);
    return sheet;
  } catch (err) {
    return null;
  }
}

function styleAccountLedgerSheet_(sheet) {
  try {
    var headerRange = sheet.getRange(1, 1, 1, 13);
    headerRange.setBackground('#4CAF50')
      .setFontColor('#ffffff')
      .setFontWeight('bold')
      .setHorizontalAlignment('center')
      .setVerticalAlignment('middle')
      .setWrap(true);

    sheet.setFrozenRows(1);

    var widths = [180, 110, 120, 120, 120, 120, 110, 140, 260, 280, 150, 180, 180];
    for (var i = 0; i < widths.length; i++) {
      sheet.setColumnWidth(i + 1, widths[i]);
    }

    sheet.getRange('B:B').setNumberFormat('yyyy-mm-dd');
    sheet.getRange('D:F').setNumberFormat('"Rp" #,##0');
    applyAccountLedgerAccountStyles_(sheet);

    if (!sheet.getFilter()) {
      var dataRange = sheet.getDataRange();
      if (dataRange.getNumRows() > 0) {
        dataRange.createFilter();
      }
    }
  } catch (e) {}
}

function accountLedgerFontColorForAccount_(account) {
  var v = String(account || '').trim().toLowerCase();
  if (v === 'cash umum') return '#1a73e8';
  if (v === 'cash bensin') return '#e8710a';
  if (v === 'cash') return '#5f6368';
  if (v === 'blu') return '#1565c0';
  if (v === 'bca') return '#188038';
  return '#202124';
}

function applyAccountLedgerRowStyle_(sheet, row) {
  try {
    if (!sheet || !row || row <= 1) return;
    var account = sheet.getRange(row, 3).getDisplayValue();
    var color = accountLedgerFontColorForAccount_(account);
    sheet.getRange(row, 1, 1, 13).setFontColor(color);
  } catch (e) {}
}

function applyAccountLedgerAccountStyles_(sheet) {
  try {
    if (!sheet) return;
    var lastRow = sheet.getLastRow();
    if (lastRow < 2) return;
    var values = sheet.getRange(2, 3, lastRow - 1, 1).getDisplayValues();
    for (var i = 0; i < values.length; i++) {
      var color = accountLedgerFontColorForAccount_(values[i][0]);
      sheet.getRange(i + 2, 1, 1, 13).setFontColor(color);
    }
  } catch (e) {}
}

function cashSessionId_(text) {
  return isCashBensinText_(text) ? 'cash_bensin' : 'cash_umum';
}

function cashAccountNameForLedger_(text) {
  return isCashBensinText_(text) ? 'Cash Bensin' : 'Cash Umum';
}

function isCashLedgerAccountName_(value) {
  var v = String(value || '').trim().toLowerCase();
  return v === 'cash' || v === 'cash umum' || v === 'cash bensin';
}

function isCashBensinText_(text) {
  const t = String(text || '').toLowerCase();
  return /\b(bensin|bbm|pertalite|pertamax|solar|shell|spbu|fuel)\b/i.test(t);
}

function recordFinanceEventForWriteResult_(ss, result, common, parsed, rawText, event) {
  if (!result || result.status !== 'written') return result;

  try {
    event = event || {};
    const financeEventResult = writeFinanceEvent_(ss, {
      event_type: event.event_type || 'transaction_created',
      event_source: event.event_source || 'telegram',
      source_tab: event.source_tab || result.writtenTab || '',
      source_row: event.source_row || result.row || '',
      linked_txn_id: event.linked_txn_id || common.linked_txn_id || common.rowId || result.rowId || '',
      account: event.account || parsed.account || '',
      category: event.category || parsed.category || '',
      amount: event.amount || parsed.amount || '',
      direction: event.direction || '',
      status: 'ok',
      reason: event.reason || '',
      payload: {
        row_id: result.rowId || '',
        write_verified: result.writeVerified === true,
        routed_status: result.status || '',
        raw_text_present: Boolean(rawText),
        raw_text: rawText || ''
      },
      notes: event.notes || ''
    });

    result.financeEventStatus = financeEventResult && financeEventResult.status
      ? financeEventResult.status
      : 'attempted';
    result.financeEventRow = financeEventResult && financeEventResult.row
      ? financeEventResult.row
      : '';
    result.financeEventTab = AIRO_CONFIG.tabs.financeEvents;
  } catch (err) {
    const message = String(err && err.message ? err.message : err).slice(0, 500);
    result.financeEventStatus = 'failed';
    result.financeEventError = message;
    result.financeEventTab = AIRO_CONFIG.tabs.financeEvents;

    try {
      console.error('AIRO_FINANCE_EVENT_WRITE_FAILED', {
        error: message,
        source_tab: result.writtenTab || '',
        source_row: result.row || '',
        linked_txn_id: (common && (common.linked_txn_id || common.rowId)) || result.rowId || '',
        raw_text_present: Boolean(rawText)
      });
    } catch (logErr) {}
  }

  return result;
}

function writeRouted_(ss, plannedTab, parsed, rawText, common) {
  const tabName = plannedTab || AIRO_CONFIG.tabs.transactions;
  const key = canonicalSheetName_(tabName);

  if (key.includes('credit card')) {
    return writeCreditCardSafely_(ss, parsed, rawText, common);
  }

  if (key.includes('hutang')) {
    return writeHutangSafely_(ss, parsed, rawText, common);
  }

  if (key.includes('aset')) {
    return writeAssetSafely_(ss, parsed, rawText, common);
  }

  var transfer = detectInternalTransfer_(parsed, rawText);
  if (transfer) {
    return writeInternalTransferToAccountLedger_(ss, parsed, rawText, common, transfer);
  }

  if (key.includes('cash ledger')) {
    // AIRO_SPRINT3_CASH_MIRROR_WHEN_COMPAT_DISABLED_V1
    // Sprint 3 disables new Cash Ledger writes by default, but cash movement
    // must still be written to Account Ledger as the primary wallet ledger.
    const cashResult = writeCashLedgerCompatibility_(ss, parsed, rawText, common);
    const ledgerResult = writeAccountLedgerMirror_(ss, parsed, rawText, common, AIRO_CONFIG.tabs.cash);

    if (ledgerResult && ledgerResult.status === 'written') {
      // AIRO_SPRINT4_CASH_ROUTE_FINANCE_EVENT_EMISSION_V1
      // Cash route returns before the generic appendByHeader_ path, so it must
      // emit Finance Events here after the Account Ledger source-of-truth write.
      const finalResult = {
        ...ledgerResult,
        writtenTab: AIRO_CONFIG.tabs.accountLedger,
        cashLedgerCompatibilityStatus: cashResult && cashResult.status ? cashResult.status : '',
        cashLedgerCompatibilityReason: cashResult && cashResult.reason ? cashResult.reason : ''
      };

      recordFinanceEventForWriteResult_(ss, finalResult, common, parsed, rawText, {
        event_type: 'transaction_created',
        event_source: 'telegram',
        source_tab: finalResult.writtenTab || AIRO_CONFIG.tabs.accountLedger,
        source_row: finalResult.row || '',
        linked_txn_id: common.linked_txn_id || common.rowId || finalResult.rowId || ''
      });

      return finalResult;
    }

    return cashResult;
  }

  if (tabName === AIRO_CONFIG.tabs.transactions && (parsed.account === 'Blu' || parsed.account === 'BCA')) {
    const sourceTab = parsed.account;
    const result = writeAccountLedgerMirror_(ss, parsed, rawText, common, sourceTab);
    if (result && result.status === 'written') {
      return {
        ...result,
        writtenTab: AIRO_CONFIG.tabs.accountLedger
      };
    }
    return result;
  }

  const result = appendByHeader_(ss, tabName, common, { createIfMissing: false });
  recordFinanceEventForWriteResult_(ss, result, common, parsed, rawText, {
    event_type: 'transaction_created',
    event_source: 'telegram',
    source_tab: result.writtenTab || tabName,
    source_row: result.row || '',
    linked_txn_id: common.linked_txn_id || common.rowId || ''
  });
  return result;
}

function writeAssetSafely_(ss, parsed, rawText, common) {
  const tabName = AIRO_CONFIG.tabs.aset;
  const sheet = getSheetLoose_(ss, tabName);

  if (!sheet) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'review',
      fallback_reason: 'asset_tab_missing'
    }, { createIfMissing: false });
  }

  function mirrorAssetPurchaseToAccountLedger_(result) {
    if (!result || result.status !== 'written') return result;

    const accountParsed = Object.assign({}, parsed, {
      type: 'asset_purchase',
      category: parsed.category || 'Aset',
      account: parsed.account || 'Unknown',
      amount: parsed.amount || amountForIntent_(parsed, rawText)
    });
    const accountCommon = Object.assign({}, common, {
      linked_txn_id: common.linked_txn_id || makeTxnId_({}, rawText)
    });
    const accountLedgerResult = writeAccountLedgerMirror_(ss, accountParsed, rawText, accountCommon, AIRO_CONFIG.tabs.aset);

    return Object.assign({}, result, {
      writtenTab: result.writtenTab || tabName,
      account_ledger_result: accountLedgerResult || null
    });
  }

  try {
    if (parsed.assetSection === 'gold') {
      return mirrorAssetPurchaseToAccountLedger_(appendGoldAssetRow_(sheet, parsed, rawText, common));
    }

    if (parsed.assetSection === 'savings') {
      const result = appendToAssetSection_(sheet, 'savings', common);
      if (result.status === 'written') return mirrorAssetPurchaseToAccountLedger_({ ...result, writtenTab: tabName });
    }

    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'review',
      fallback_reason: 'asset_section_unclear_or_header_not_found'
    }, { createIfMissing: false });
  } catch (err) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'review',
      fallback_reason: 'asset_write_error: ' + String(err && err.message ? err.message : err)
    }, { createIfMissing: false });
  }
}

function appendToAssetSection_(sheet, section, data) {
  const spec = section === 'gold'
    ? { startCol: 1, endCol: 13 }
    : { startCol: 15, endCol: 26 };

  const header = findHeaderInRange_(sheet, spec.startCol, spec.endCol);
  if (!header) return { status: 'fallback', reason: 'asset_section_header_not_found' };

  const rowData = {
    timestamp: data.timestamp,
    date: data.date,
    type: section === 'savings' ? savingsEventType_(data) : data.type,
    category: data.category,
    description: data.description,
    amount: data.amount,
    account: data.account,
    source: data.source,
    raw_text: data.raw_text,
    status: data.status,
    linked_txn_id: data.linked_txn_id,
    asset_section: section
  };

  let values = buildRowByHeader_(header.headers, rowData);
  const targetRow = findNextSectionRow_(sheet, header.row, spec.startCol, spec.endCol);
  values = sanitizeValuesForValidation_(sheet, targetRow, spec.startCol, values, rowData);
  sheet.getRange(targetRow, spec.startCol, 1, values.length).setValues([values]);

  return { status: 'written', writtenTab: sheet.getName(), row: targetRow, section };
}

function savingsEventType_(data) {
  const text = String(data.raw_text || '').toLowerCase();

  if (/\b(tarik|withdraw|ambil|keluar|transfer_out)\b/i.test(text)) {
    return 'savings_withdrawal';
  }

  if (/\b(pindah|internal|antar akun|internal_transfer)\b/i.test(text)) {
    return 'internal_transfer';
  }

  if (/\b(adjust|adjustment|koreksi)\b/i.test(text)) {
    return 'adjustment';
  }

  return 'savings_deposit';
}

function sanitizeValuesForValidation_(sheet, targetRow, startCol, values, data) {
  const range = sheet.getRange(targetRow, startCol, 1, values.length);
  const validations = range.getDataValidations()[0] || [];

  return values.map((value, idx) => {
    return normalizeValueForValidation_(value, validations[idx], data);
  });
}

function normalizeValueForValidation_(value, validation, data) {
  if (!validation) return value;

  const criteriaType = validation.getCriteriaType();
  const criteriaValues = validation.getCriteriaValues();

  if (criteriaType === SpreadsheetApp.DataValidationCriteria.CHECKBOX) {
    if (value === true || value === false) return value;
    const raw = String(value || '').toLowerCase();
    return raw === 'true' || raw === '1' || raw === 'yes';
  }

  let allowed = [];

  if (criteriaType === SpreadsheetApp.DataValidationCriteria.VALUE_IN_LIST) {
    allowed = (criteriaValues[0] || []).map(v => String(v));
  }

  if (criteriaType === SpreadsheetApp.DataValidationCriteria.VALUE_IN_RANGE) {
    try {
      allowed = criteriaValues[0]
        .getValues()
        .flat()
        .map(v => String(v))
        .filter(Boolean);
    } catch (err) {
      allowed = [];
    }
  }

  if (!allowed.length) return value;

  const current = String(value ?? '');
  const currentLower = current.toLowerCase();
  const allowedLower = allowed.map(v => v.toLowerCase());

  function pick(name) {
    const idx = allowedLower.indexOf(String(name).toLowerCase());
    return idx >= 0 ? allowed[idx] : '';
  }

  if (allowedLower.includes(currentLower)) {
    return allowed[allowedLower.indexOf(currentLower)];
  }

  // Cash Ledger movement type validation.
  // If the dropdown accepts transfer_in/transfer_out, use those exact valid values.
  if (allowedLower.includes('transfer_in') && isCashInflowData_(data)) {
    return pick('transfer_in');
  }

  if (allowedLower.includes('transfer_out')) {
    const type = String((data && data.type) || '').toLowerCase();
    if (['expense', 'cash_out', 'transfer_out'].includes(type)) {
      return pick('transfer_out');
    }
  }

  // Transactions / production status validation
  if (allowedLower.includes('auto_approved') && allowedLower.includes('needs_review')) {
    if (['review', 'pending', 'needs_review'].includes(currentLower)) {
      return pick('needs_review');
    }
    return pick('auto_approved');
  }

  // Review Queue status validation
  if (allowedLower.includes('pending') && allowedLower.includes('approved')) {
    return pick('pending');
  }

  // Asset savings validation
  if (allowedLower.includes('savings_deposit')) {
    const eventType = savingsEventType_(data);
    if (allowedLower.includes(String(eventType).toLowerCase())) {
      return pick(eventType);
    }
    return pick('savings_deposit');
  }

  // TRUE/FALSE dropdown validation
  if (allowedLower.includes('true') && allowedLower.includes('false')) {
    if (currentLower === 'true' || current === '1') return pick('TRUE');
    return pick('FALSE');
  }

  // Last safety: blank is safer than invalid value for unknown validated dropdowns.
  return '';
}

function normalizeDataForTab_(tabName, data) {
  const d = { ...data };
  const canonicalTab = canonicalSheetName_(tabName);
  const reviewTab = canonicalSheetName_(AIRO_CONFIG.tabs.review);

  if (canonicalTab === reviewTab) {
    if (!d.status || d.status === 'review' || d.status === 'posted') {
      d.status = 'pending';
    }
  }

  return d;
}

function safeSpreadsheetMarker_(ss) {
  try {
    const id = ss && ss.getId ? String(ss.getId()) : '';
    return id ? '...' + id.slice(-8) : '';
  } catch (err) {
    return '';
  }
}

function stringifyReadbackCell_(value) {
  if (value === null || typeof value === 'undefined') return '';
  return String(value).trim();
}

function buildReadbackText_(values) {
  return values.map(stringifyReadbackCell_).join(' | ');
}

function verifyAppendWrite_(ss, sheet, row, col, values) {
  SpreadsheetApp.flush();

  const readbackRawValues = sheet.getRange(row, col, 1, values.length).getValues()[0];
  const readbackRawText = buildReadbackText_(readbackRawValues);
  const expectedRawText = buildReadbackText_(values);

  return {
    writeVerified: readbackRawText === expectedRawText,
    readbackRawText: readbackRawText,
    spreadsheetMarker: safeSpreadsheetMarker_(ss)
  };
}

function appendByHeader_(ss, tabName, data, options) {
  data = normalizeDataForTab_(tabName, data);

  const sheet = getSheetLoose_(ss, tabName);

  if (!sheet) {
    if (options && options.createIfMissing) {
      const created = ss.insertSheet(tabName);
      const headers = Object.keys(data);
      created.getRange(1, 1, 1, headers.length).setValues([headers]);
      const createdValues = headers.map(k => data[k] ?? '');
      created.getRange(2, 1, 1, headers.length).setValues([createdValues]);
      const createdTruth = verifyAppendWrite_(ss, created, 2, 1, createdValues);
      return {
        status: 'written',
        writtenTab: created.getName(),
        row: 2,
        rowId: created.getName() + ':2',
        tabUrl: getSheetTabUrl_(ss, created),
        writeVerified: createdTruth.writeVerified,
        readbackRawText: createdTruth.readbackRawText,
        spreadsheetMarker: createdTruth.spreadsheetMarker
      };
    }
    return { status: 'fallback', reason: 'sheet_missing', writtenTab: '' };
  }

  const header = findHeader_(sheet);
  if (!header) return { status: 'fallback', reason: 'header_not_found', writtenTab: sheet.getName() };

  let values = buildRowByHeader_(header.headers, data);
  const targetRow = sheet.getLastRow() + 1;
  ensureDropdownAcceptsCurrentValues_(sheet, targetRow, 1, header.headers, data);
  values = sanitizeValuesForValidation_(sheet, targetRow, 1, values, data);
  sheet.getRange(targetRow, 1, 1, values.length).setValues([values]);
  const writeTruth = verifyAppendWrite_(ss, sheet, targetRow, 1, values);

  return {
    status: 'written',
    writtenTab: sheet.getName(),
    row: targetRow,
    rowId: sheet.getName() + ':' + targetRow,
    tabUrl: getSheetTabUrl_(ss, sheet),
    writeVerified: writeTruth.writeVerified,
    readbackRawText: writeTruth.readbackRawText,
    spreadsheetMarker: writeTruth.spreadsheetMarker
  };
}

function findHeader_(sheet) {
  const maxRows = Math.min(sheet.getLastRow(), 50);
  const maxCols = Math.min(sheet.getLastColumn(), 80);
  if (maxRows < 1 || maxCols < 1) return null;

  const values = sheet.getRange(1, 1, maxRows, maxCols).getValues();

  for (let r = 0; r < values.length; r++) {
    const score = headerScore_(values[r]);
    if (score >= 2) {
      return { row: r + 1, headers: values[r].map(v => String(v || '').trim()) };
    }
  }

  return null;
}

function findHeaderInRange_(sheet, startCol, endCol) {
  const maxRows = Math.min(sheet.getLastRow(), 50);
  const width = endCol - startCol + 1;
  if (maxRows < 1 || width < 1) return null;

  const values = sheet.getRange(1, startCol, maxRows, width).getValues();

  for (let r = 0; r < values.length; r++) {
    const score = headerScore_(values[r]);
    if (score >= 2) {
      return { row: r + 1, headers: values[r].map(v => String(v || '').trim()) };
    }
  }

  return null;
}

function findNextSectionRow_(sheet, headerRow, startCol, endCol) {
  const width = endCol - startCol + 1;
  const last = Math.max(sheet.getLastRow(), headerRow + 1);
  const values = sheet.getRange(headerRow + 1, startCol, Math.max(1, last - headerRow), width).getValues();

  for (let i = values.length - 1; i >= 0; i--) {
    if (values[i].some(v => String(v || '').trim() !== '')) return headerRow + 1 + i + 1;
  }
  return headerRow + 1;
}

function buildRowByHeader_(headers, data) {
  return headers.map(h => {
    const headerKey = canonicalKey_(h);
    const cashInflow = isCashInflowData_(data);

    if (headerKey === 'session_id' || headerKey.includes('session_id')) {
      return data.session_id ?? '';
    }

    if (headerKey === 'entry_id' || headerKey.includes('entry_id')) {
      return data.entry_id || data.linked_txn_id || '';
    }

    if (headerKey === 'date_start' || headerKey.includes('date_start')) {
      return data.date_start || data.date || '';
    }

    if (headerKey === 'date_end' || headerKey.includes('date_end')) {
      return data.date_end || data.date || '';
    }

    if (headerKey === 'amount_start' || headerKey.includes('amount_start')) {
      return data.amount_start ?? '';
    }

    if (headerKey === 'amount_remaining' || headerKey.includes('amount_remaining')) {
      return data.amount_remaining ?? '';
    }

    if (headerKey === 'days_lasted' || headerKey.includes('days_lasted')) {
      return data.days_lasted ?? '';
    }

    if (headerKey === 'notes' || headerKey === 'note' || headerKey.includes('notes')) {
      return data.notes || data.description || '';
    }

    if (
      headerKey === 'amount_out' ||
      headerKey.includes('amount_out') ||
      headerKey === 'cash_out' ||
      headerKey.includes('cash_out') ||
      headerKey === 'uang_keluar' ||
      headerKey.includes('uang_keluar') ||
      headerKey === 'nominal_keluar' ||
      headerKey.includes('nominal_keluar')
    ) {
      return cashInflow ? '' : (data.amount_out ?? data.amount ?? '');
    }

    if (
      headerKey === 'amount_in' ||
      headerKey.includes('amount_in') ||
      headerKey === 'cash_in' ||
      headerKey.includes('cash_in') ||
      headerKey === 'uang_masuk' ||
      headerKey.includes('uang_masuk') ||
      headerKey === 'nominal_masuk' ||
      headerKey.includes('nominal_masuk')
    ) {
      return cashInflow ? (data.amount_in || data.amount || '') : (data.amount_in ?? '');
    }

    if (headerKey === 'type' || headerKey === 'jenis' || headerKey.includes('transaction_type')) {
      return cashInflow ? 'transfer_in' : (data.type ?? '');
    }

    if (headerKey === 'status') {
      return data.status ?? '';
    }

    if (headerKey === 'source_tab' || headerKey.includes('source_tab')) {
      return data.source_tab || data.source || '';
    }

    const field = fieldForHeader_(h);
    if (field) return data[field] ?? '';

    return data[headerKey] ?? '';
  });
}

function headerScore_(row) {
  const fields = row.map(h => fieldForHeader_(h)).filter(Boolean);
  const unique = [...new Set(fields)];

  return ['date', 'amount', 'description', 'category', 'account', 'status', 'raw_text', 'type']
    .filter(f => unique.includes(f)).length;
}

function fieldForHeader_(header) {
  const h = canonicalKey_(header);
  if (!h) return '';

  // Important: check amount_in / amount_out before generic amount,
  // otherwise amount_out may be filled as expense for cash inflow rows.
  if (
    h === 'amount_in' ||
    h.includes('amount_in') ||
    h === 'cash_in' ||
    h.includes('cash_in') ||
    h === 'uang_masuk' ||
    h.includes('uang_masuk') ||
    h === 'nominal_masuk' ||
    h.includes('nominal_masuk')
  ) {
    return 'amount_in';
  }

  if (
    h === 'amount_out' ||
    h.includes('amount_out') ||
    h === 'cash_out' ||
    h.includes('cash_out') ||
    h === 'uang_keluar' ||
    h.includes('uang_keluar') ||
    h === 'nominal_keluar' ||
    h.includes('nominal_keluar')
  ) {
    return 'amount_out';
  }

  const aliases = {
    timestamp: ['timestamp', 'created_at', 'waktu_input', 'created'],
    date: ['date', 'tanggal', 'tgl', 'payment_date', 'tanggal_bayar', 'tanggal_transaksi'],
    type: ['type', 'jenis', 'event_type', 'jenis_transaksi', 'transaction_type'],
    category: ['category', 'kategori'],
    description: ['description', 'deskripsi', 'catatan', 'note', 'notes', 'keterangan', 'rincian'],
    amount: ['amount', 'nominal', 'jumlah', 'nilai', 'total', 'payment_amount', 'nominal_bayar', 'jumlah_bayar', 'angsuran'],
    account: ['account', 'akun', 'wallet', 'rekening', 'sumber_dana', 'payment_account'],
    source: ['source', 'sumber'],
    raw_text: ['raw_text', 'raw text', 'pesan', 'message', 'telegram_text', 'input_text'],
    status: ['status', 'state'],
    planned_tab: ['planned_tab', 'planned tab', 'target_tab', 'target tab'],
    linked_txn_id: ['linked_txn_id', 'linked transaction id', 'transaction_id', 'txn_id', 'linked_id'],
    billing_cycle_id: ['billing_cycle_id', 'billing cycle id', 'cycle_id', 'billing_cycle'],
    creditor: ['creditor', 'kreditur', 'pemberi_hutang', 'pemberi_utang', 'lender'],
    merchant: ['merchant', 'toko', 'vendor'],
    fallback_reason: ['fallback_reason', 'reason', 'alasan'],
    asset_section: ['asset_section', 'section', 'bagian']
  };

  for (const field in aliases) {
    for (const alias of aliases[field]) {
      const a = canonicalKey_(alias);
      if (h === a || h.includes(a)) return field;
    }
  }

  return '';
}

function routePlannedTab_(parsed, rawText) {
  const text = String(rawText || '').toLowerCase();

  if (parsed.needsReview) return AIRO_CONFIG.tabs.review;

  // AIRO_HUTANG_DIRECT_ROUTING_V1
  // Hutang is the domain. "cash" in "pinjam dari Budi ... masuk cash"
  // is only the receiving account and must not steal routing priority.
  if (
    /\b(hutang|utang|bayar hutang|bayar utang|pinjam|pinjaman)\b/i.test(text) ||
    isBorrowInText_(text) ||
    isDebtPaymentText_(text)
  ) {
    return AIRO_CONFIG.tabs.hutang;
  }

  if (/\b(cash|tunai)\b/i.test(text)) return AIRO_CONFIG.tabs.cash;

  if (
    /\b(tokopedia\s*card|tokopedia\s*cc|credit\s*card|kartu\s*kredit|\bcc\b)/i.test(text) ||
    isCreditCardPaymentText_(text)
  ) {
    return AIRO_CONFIG.tabs.creditCard;
  }

  if (/\b(cicilan rumah|kpr|angsuran rumah|bayar rumah)\b/i.test(text)) return AIRO_CONFIG.tabs.cicilanRumah;

  if (
    /\b(hutang|utang|bayar hutang|bayar utang|pinjam|pinjaman)\b/i.test(text) ||
    isBorrowInText_(text) ||
    isDebtPaymentText_(text)
  ) {
    return AIRO_CONFIG.tabs.hutang;
  }

  if (/\b(aset\s+emas|emas|gold|antam|logam mulia|nabung|tabung|saving|savings|aset|investasi|dana darurat)\b/i.test(text)) return AIRO_CONFIG.tabs.aset;

  // AIRO_SPRINT3_ROUTE_CASH_TO_COMPAT_BRANCH_V1
  // Cash messages must route to the Cash Ledger compatibility branch first.
  // Sprint 3 disables legacy Cash Ledger writes there, then mirrors to Account Ledger.
  if (
    String((parsed && parsed.account) || '').toLowerCase() === 'cash' ||
    /\b(cash|tunai)\b/i.test(text)
  ) {
    return AIRO_CONFIG.tabs.cash;
  }

  return AIRO_CONFIG.tabs.transactions;
}

function reviewIssueReasonForParsed_(rawText, data) {
  const text = String(rawText || '').toLowerCase();
  const amount = Number(data && data.amount ? data.amount : 0);
  const account = String((data && data.account) || '').trim();
  const category = String((data && data.category) || '').trim();

  if (!amount || amount <= 0) return 'amount_missing_or_zero';

  if (/\b(kayaknya|mungkin|lupa|sesuatu|gatau|nggak tahu|ga tau|unknown)\b/i.test(text)) {
    return 'ambiguous_language';
  }

  if (!account || account.toLowerCase() === 'unknown') {
    return 'account_missing_or_unknown';
  }

  if (!category || category.toLowerCase() === 'lainnya') {
    if (/\b(hutang|utang|pinjam|pinjaman|cicilan rumah|kpr|angsuran rumah|cash|tunai)\b/i.test(text)) {
      return 'important_category_unclear';
    }
  }

  if (/\b(hutang|utang|pinjam|pinjaman)\b/i.test(text) && !parseCreditor_(text)) {
    return 'debt_person_unclear';
  }

  if (/\b(cicilan rumah|kpr|angsuran rumah|bayar rumah)\b/i.test(text) && !/\b\d+(?:[.,]\d+)?\s*(jt|juta|rb|ribu|k)?\b/i.test(text)) {
    return 'cicilan_rumah_amount_unclear';
  }

  if (/\b(cash|tunai)\b/i.test(text) && category.toLowerCase() === 'lainnya' && !/\b(dari|ke|masuk|keluar|terima|diterima|bensin|bbm)\b/i.test(text)) {
    return 'cash_detail_unclear';
  }

  return '';
}

function parseFinanceText_(rawText) {
  const text = String(rawText || '').toLowerCase();
  const gold = parseGoldAsset_(rawText);
  const baseAmount = parseAmount_(text);
  const amount = gold.isGoldAsset
    ? (gold.purchasePrice || gold.estimatedValue || 0)
    : baseAmount;

  const parsed = {
    date: gold.purchaseDate || parseDate_(text),
    type: gold.isGoldAsset ? 'asset' : parseType_(text),
    category: parseCategory_(text),
    description: rawText,
    amount,
    account: parseAccount_(text),
    creditor: parseCreditor_(text),
    merchant: parseMerchant_(text),
    billingCycleId: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM'),
    assetSection: parseAssetSection_(text),
    goldAction: gold.action,
    goldKarat: gold.karat,
    goldWeightGram: gold.weightGram,
    goldPureGram: gold.pureGram,
    goldPurchasePrice: gold.purchasePrice,
    goldPurchaseDate: gold.purchaseDate,
    goldNotes: gold.notes,
    goldEstimatedValue: gold.estimatedValue,
    goldMarketPrice24k: gold.marketPrice24k
  };

  let issueReason = gold.isGoldAsset
    ? ((!gold.weightGram || gold.weightGram <= 0) ? 'gold_weight_missing_or_zero' : '')
    : reviewIssueReasonForParsed_(rawText, parsed);

  // AIRO_HUTANG_DIRECT_ROUTING_V1
  // Clear borrow/debt-in intents should not be forced to Review Queue when
  // amount + person are available. Example:
  // "saya pinjam dari Budi 122218 masuk cash" -> 🤝 Hutang.
  if (!gold.isGoldAsset && isClearDebtBorrowIntentForDirectHutang_(rawText, parsed)) {
    parsed.type = 'debt_in';
    parsed.category = 'Hutang';
    parsed.creditor = parseDebtPerson_(rawText) || parsed.creditor || parseCreditor_(text);
    issueReason = '';
  }

  parsed.issue_reason = issueReason;
  parsed.needsReview = Boolean(issueReason);

  return parsed;
}

function parseAmount_(text) {
  const t = String(text || '').toLowerCase();

  const re = /(\d+(?:[.,]\d+)?)\s*(jt|juta|rb|ribu|k)?\b/gi;
  let m;
  let best = 0;

  while ((m = re.exec(t)) !== null) {
    const rawNum = String(m[1] || '');
    const unit = String(m[2] || '').toLowerCase();

    let n = Number(rawNum.replace(',', '.'));
    if (!n) continue;

    let value = n;

    if (unit === 'jt' || unit === 'juta') value = n * 1000000;
    else if (unit === 'rb' || unit === 'ribu' || unit === 'k') value = n * 1000;

    value = Math.round(value);

    // Skip obvious years when no money unit exists.
    if (!unit && value >= 1900 && value <= 2200) continue;

    if (value > best) best = value;
  }

  return best;
}

function cleanAmount_(s) {
  const only = String(s || '').replace(/[^\d.,]/g, '');
  if (!only) return 0;

  if (only.includes('.') && only.includes(',')) {
    return Number(only.replace(/\./g, '').replace(',', '.')) || 0;
  }

  return Number(only.replace(/[.,]/g, '')) || 0;
}

function parseAccount_(text) {
  const t = String(text || '').toLowerCase();

  // "bayar cc ..." means transfer/allocation from Pocket BLU to cover CC spending.
  if (typeof isCreditCardPaymentText_ === 'function' && isCreditCardPaymentText_(t)) return 'Blu';

  // "cc beli ..." / "cc bayar pdam ..." means purchase using credit card.
  if (typeof isCreditCardPurchaseText_ === 'function' && isCreditCardPurchaseText_(t)) return 'Credit Card';

  if (/\b(cash|tunai)\b/i.test(t)) return 'Cash';
  if (/\b(blu|blu bca|pocket blu|blubca)\b/i.test(t)) return 'Blu';
  if (/\b(bca|blu bca)\b/i.test(t)) return 'BCA';
  if (/\b(mandiri)\b/i.test(t)) return 'Mandiri';
  if (/\b(gopay)\b/i.test(t)) return 'GoPay';
  if (/\b(shopeepay|shopee pay)\b/i.test(t)) return 'ShopeePay';
  if (/\b(tokopedia\s*cc|tokopedia\s*card|credit\s*card|kartu\s*kredit|\bcc\b)\b/i.test(t)) return 'Credit Card';

  return 'Unknown';
}

function parseDate_(text) {
  const now = new Date();
  if (/\bkemarin\b/i.test(text)) {
    const d = new Date(now);
    d.setDate(d.getDate() - 1);
    return Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  }
  return Utilities.formatDate(now, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function parseCategory_(text) {
  const t = String(text || '').toLowerCase();

  if (/\b(gaji|salary|income|pemasukan|terima gaji|gajian)\b/i.test(t)) return 'Gaji';
  if (isCreditCardPaymentText_(t)) return 'CC Payment';
  if (isBorrowInText_(t) || isDebtPaymentText_(t)) return 'Hutang';

  if (/\b(pdam|pln|listrik|air|wifi|internet|tagihan)\b/i.test(t)) return 'Tagihan';
  if (/\b(makan|minum|kopi|es teh|resto|warung|sarapan|lunch|dinner)\b/i.test(t)) return 'Makan';
  if (/\b(bensin|bbm|pertalite|pertamax|solar|shell|spbu|parkir|tol|grab|gojek|transport)\b/i.test(t)) return 'Transport';
  if (/\b(cicilan rumah|kpr|angsuran rumah)\b/i.test(t)) return 'Cicilan Rumah';
  if (/\b(hutang|utang)\b/i.test(t)) return 'Hutang';
  if (/\b(nabung|tabung|saving|aset|investasi|emas|gold)\b/i.test(t)) return 'Aset';
  if (/\b(tokopedia|shopee|belanja|beli)\b/i.test(t)) return 'Belanja';

  return 'Lainnya';
}

function isCashInflowText_(text) {
  const t = String(text || '').toLowerCase();

  return (
    /\bcash\s+(masuk|terima|diterima|income)\b/i.test(t) ||
    /\b(terima|dapat|dapet)\s+cash\b/i.test(t) ||
    /\buang\s+masuk\s+cash\b/i.test(t) ||
    /\bcash\s+dari\b/i.test(t) ||

    // Cash pocket with words between "cash" and "masuk"
    /\bcash\b.*\b(masuk|terima|diterima|income)\b/i.test(t) ||

    // Fuel/bensin pocket inflow
    /\b(bensin|bbm|pertalite|pertamax|solar|shell|spbu|fuel)\b.*\b(masuk|terima|diterima|income)\b/i.test(t) ||
    /\buang\s+(bensin|bbm|pertalite|pertamax|solar|shell|spbu|fuel)\s+(masuk|terima|diterima)\b/i.test(t)
  );
}

function isCashInflowData_(data) {
  const text = String((data && data.raw_text) || '').toLowerCase();
  const type = String((data && data.type) || '').toLowerCase();

  return isCashInflowText_(text) || ['transfer_in', 'cash_in', 'income'].includes(type);
}

function parseType_(text) {
  const t = String(text || '').toLowerCase();

  if (isCashInflowText_(t)) return 'transfer_in';
  if (isCreditCardPaymentText_(t)) return 'cc_payment';
  if (isCreditCardPurchaseText_(t)) return 'cc_purchase';
  if (isBorrowInText_(t)) return 'debt_in';
  if (isDebtPaymentText_(t)) return 'debt_payment';

  if (/\b(gaji|salary|income|pemasukan|terima gaji|gajian|dibayar|refund|reimburse|reimbursement|uang masuk|dana masuk|transfer masuk|terima|diterima|dapat|dapet)\b/i.test(t)) {
    return 'income';
  }

  if (/\b(nabung|tabung|saving|investasi|aset)\b/i.test(t)) {
    return 'transfer';
  }

  return 'expense';
}

function parseCreditor_(text) {
  const t = String(text || '');

  // AIRO_HUTANG_DIRECT_ROUTING_V1
  // Borrow/debt-in wording: "pinjam dari Budi", "pinjaman dari Budi".
  const borrowFrom = t.match(/\b(?:pinjam|minjem|pinjaman|hutang|utang)\b.{0,50}\bdari\s+([a-zA-Z0-9 ._-]{2,40})/i);
  if (borrowFrom) return cleanDebtPersonName_(borrowFrom[1]);

  const m = t.match(/\b(?:ke|kepada|sama)\s+([a-zA-Z0-9 ._-]{2,40})/i);
  return m ? cleanDebtPersonName_(m[1]) : '';
}

function parseMerchant_(text) {
  if (/\btokopedia\b/i.test(text)) return 'Tokopedia';
  if (/\bshopee\b/i.test(text)) return 'Shopee';
  return '';
}

function parseAssetSection_(text) {
  if (/\b(aset\s+emas|emas|gold|antam|logam mulia)\b/i.test(text)) return 'gold';
  if (/\b(nabung|tabung|saving|savings|dana darurat|investasi|aset)\b/i.test(text)) return 'savings';
  return '';
}

function parseIncoming_(e) {
  if (!e || !e.postData || !e.postData.contents) return {};
  return JSON.parse(e.postData.contents);
}

function getProp_(key) {
  const value = PropertiesService.getScriptProperties().getProperty(key);
  if (!value) throw new Error('Missing Script Property: ' + key);
  return value;
}

function sendTelegram_(chatId, text) {
  const token = getProp_('BOT_TOKEN');
  const url = 'https://api.telegram.org/bot' + token + '/sendMessage';

  UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    muteHttpExceptions: true,
    payload: JSON.stringify({ chat_id: chatId, text })
  });
}

function getSheetLoose_(ss, wanted) {
  const exact = ss.getSheetByName(wanted);
  if (exact) return exact;

  const canonicalWanted = canonicalSheetName_(wanted);
  return ss.getSheets().find(s => canonicalSheetName_(s.getName()) === canonicalWanted) || null;
}

function canonicalSheetName_(name) {
  return String(name || '')
    .replace(/[^\p{L}\p{N} ]/gu, '')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
}

function canonicalKey_(name) {
  return String(name || '')
    .toLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, '_')
    .replace(/^_+|_+$/g, '');
}

function norm_(v) {
  return canonicalKey_(v);
}

function json_(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function authorizeRequiredScopes() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
  ss.getSheets().map(s => s.getName());
  UrlFetchApp.fetch('https://api.telegram.org', { muteHttpExceptions: true });
}

/**
 * Process Review Queue rows that have been manually marked approved/edited.
 *
 * Manual use:
 * - Edit row in 🧾 Review Queue
 * - Set review_status to approved or edited
 * - Run processReviewQueueApproved()
 *
 * Optional automation:
 * - Run setupReviewQueueAutoProcessor() once
 * - It creates an installable onEdit trigger
 */

function processReviewQueueApproved() {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
    const sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.review);

    if (!sheet) {
      return { ok: false, reason: 'review_queue_sheet_missing' };
    }

    const header = findHeader_(sheet);
    if (!header) {
      return { ok: false, reason: 'review_queue_header_missing' };
    }

    const lastRow = sheet.getLastRow();
    const lastCol = sheet.getLastColumn();

    if (lastRow <= header.row) {
      return { ok: true, processed: 0, skipped: 0 };
    }

    const headers = sheet
      .getRange(header.row, 1, 1, lastCol)
      .getValues()[0]
      .map(v => String(v || '').trim());

    const map = reviewHeaderMap_(headers);
    const values = sheet.getRange(header.row + 1, 1, lastRow - header.row, lastCol).getValues();

    let processed = 0;
    let skipped = 0;
    let errors = 0;

    values.forEach((row, idx) => {
      const sheetRow = header.row + 1 + idx;

      const status = String(getReviewValue_(row, map, ['review_status', 'status']) || '').toLowerCase();
      const approvedTxnId = String(getReviewValue_(row, map, ['approved_transaction_id']) || '').trim();

      if (!['approved', 'edited'].includes(status)) {
        skipped++;
        return;
      }

      if (approvedTxnId) {
        skipped++;
        return;
      }

      try {
        const rawText = String(getReviewValue_(row, map, ['raw_text', 'message', 'telegram_text']) || '').trim();
        const parsedAmount = getReviewValue_(row, map, ['parsed_amount', 'amount', 'nominal']);
        const amount = normalizeReviewAmount_(parsedAmount);

        const parsedAccount = String(getReviewValue_(row, map, ['parsed_account', 'account', 'akun']) || '').trim();
        const parsedCategory = String(getReviewValue_(row, map, ['parsed_category', 'category', 'kategori']) || '').trim();
        const parsedSubcategory = String(getReviewValue_(row, map, ['parsed_subcategory', 'subcategory']) || '').trim();
        const parsedType = String(getReviewValue_(row, map, ['parsed_type', 'type', 'jenis']) || '').trim();

        if (!amount || amount <= 0) {
          setReviewValue_(sheet, sheetRow, map, ['issue_reason'], 'approved_but_amount_missing');
          errors++;
          return;
        }

        if (!parsedAccount || parsedAccount.toLowerCase() === 'unknown') {
          setReviewValue_(sheet, sheetRow, map, ['issue_reason'], 'approved_but_account_missing');
          errors++;
          return;
        }

        const parsed = {
          date: parseDate_(rawText || ''),
          type: parsedType || parseType_(rawText || ''),
          category: parsedCategory || parseCategory_(rawText || ''),
          subcategory: parsedSubcategory || '',
          description: rawText || String(getReviewValue_(row, map, ['suggested_fix']) || ''),
          amount: amount,
          account: normalizeReviewAccount_(parsedAccount),
          creditor: parseCreditor_(rawText || ''),
          merchant: parseMerchant_(rawText || ''),
          billingCycleId: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM'),
          assetSection: parseAssetSection_(rawText || ''),
          needsReview: false
        };

        const plannedTab = routeReviewApprovedTab_(parsed, rawText);
        const queueId = String(getReviewValue_(row, map, ['queue_id']) || ('row_' + sheetRow));
        const stagingResult = { rowId: 'review:' + queueId };

        const result = writeRouted_(ss, plannedTab, parsed, rawText, stagingResult);

        if (result.status === 'written') {
          setReviewValue_(sheet, sheetRow, map, ['approved_transaction_id'], result.rowId || (result.writtenTab + ':' + result.row));
          setReviewValue_(sheet, sheetRow, map, ['reviewed_at'], new Date());
          setReviewValue_(sheet, sheetRow, map, ['issue_reason'], 'processed_to_' + result.writtenTab);
          processed++;
        } else {
          setReviewValue_(sheet, sheetRow, map, ['issue_reason'], 'process_failed_' + (result.reason || 'unknown'));
          errors++;
        }
      } catch (err) {
        setReviewValue_(sheet, sheetRow, map, ['issue_reason'], 'process_error_' + String(err && err.message ? err.message : err));
        errors++;
      }
    });

    return {
      ok: true,
      processed,
      skipped,
      errors
    };
  } finally {
    lock.releaseLock();
  }
}

function processReviewQueueApprovedOnEdit(e) {
