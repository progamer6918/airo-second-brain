  if (!dashboard) return { ok: false, reason: 'dashboard_sheet_missing' };
  if (!cc) return { ok: false, reason: 'credit_card_sheet_missing' };

  const header = findCcHeaderRow_(cc);
  if (!header) return { ok: false, reason: 'cc_header_missing' };

  const map = ccColMap_(header.headers);
  const required = ['amount', 'status_pocket_blu', 'billing_cycle_id', 'billing_start', 'billing_end'];
  for (let i = 0; i < required.length; i++) {
    if (!map[required[i]]) return { ok: false, reason: 'cc_column_missing_' + required[i] };
  }

  ensureSheetSize_(dashboard, 38, 8);
  safeClearRange_(dashboard, 'B25:G34');

  const currentCycle = ccBillingCycle_(todayDate_());
  const payableDate = new Date(currentCycle.start);
  payableDate.setDate(payableDate.getDate() - 1);
  const payableCycle = ccBillingCycle_(payableDate);
  const payableDueDate = ccDueDateForCycle_(payableCycle);

  const stats = {
    payable_total: 0,
    payable_belum_blu: 0,
    payable_sudah_blu: 0,
    unbilled_total: 0,
    unbilled_belum_blu: 0,
    unbilled_sudah_blu: 0,
    payable_rows: 0,
    unbilled_rows: 0
  };

  const lastRow = cc.getLastRow();
  const lastCol = cc.getLastColumn();

  const amountFromDisplay_ = function(value) {
    let s = String(value || '').replace(/\s+/g, '').replace(/[^0-9,.-]/g, '');
    if (!s) return 0;
    if (s.indexOf(',') >= 0 && s.indexOf('.') >= 0) {
      s = s.replace(/\./g, '').replace(',', '.');
    } else {
      s = s.replace(/[.,]/g, '');
    }
    return Number(s) || 0;
  };

  if (lastRow > header.row) {
    const rows = cc.getRange(header.row + 1, 1, lastRow - header.row, lastCol).getDisplayValues();

    rows.forEach(function(row) {
      const amount = amountFromDisplay_(row[map.amount - 1]);
      const status = String(row[map.status_pocket_blu - 1] || '').toLowerCase();
      const cycleId = String(row[map.billing_cycle_id - 1] || '').trim();

      if (!amount || !cycleId) return;

      const isSudahBlu =
        status.indexOf('sudah') >= 0 ||
        status.indexOf('paid') >= 0 ||
        status.indexOf('posted') >= 0 ||
        status.indexOf('transferred') >= 0;

      if (cycleId === payableCycle.id) {
        stats.payable_total += amount;
        stats.payable_rows++;
        if (isSudahBlu) stats.payable_sudah_blu += amount;
        else stats.payable_belum_blu += amount;
      }

      if (cycleId === currentCycle.id) {
        stats.unbilled_total += amount;
        stats.unbilled_rows++;
        if (isSudahBlu) stats.unbilled_sudah_blu += amount;
        else stats.unbilled_belum_blu += amount;
      }
    });
  }

  const overdue = todayDate_() > payableDueDate && stats.payable_belum_blu > 0;

  dashboard.getRange('B25:G25').merge();
  dashboard.getRange('B25').setValue('💳 CREDIT CARD — TOKOPEDIA CC');

  dashboard.getRange('B26:C26').merge().setValue('Tagihan Jatuh Tempo');
