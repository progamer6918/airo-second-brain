      if (cycleId === currentCycle.id) {
        stats.unbilled_total += amount;
        stats.unbilled_rows++;
        if (isSudahBlu) stats.unbilled_sudah_blu += amount;
        else stats.unbilled_belum_blu += amount;
      }
    });
