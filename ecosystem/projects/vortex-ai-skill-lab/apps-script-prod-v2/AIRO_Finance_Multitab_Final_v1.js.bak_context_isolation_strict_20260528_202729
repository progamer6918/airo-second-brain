function normalizeAssetGoldAmbiguousClarificationAnswer_(text) {
  const t = String(text || '').trim().toLowerCase();

  if (/^(a|1|beli|buy|tambah|masuk)\b/i.test(t)) return 'buy';
  if (/^(b|2|jual|sell|kurangi|keluar|lepas)\b/i.test(t)) return 'sell';
  if (/^(c|3|aset|tabung|tabungan|saving|savings|biasa)\b/i.test(t)) return 'savings';
  if (/^(d|4|abaikan|cancel|batal|skip)\b/i.test(t)) return 'ignore';

  return '';
}

function hasExplicitAssetGoldAction_(text) {
  const t = String(text || '').toLowerCase();

  return /\b(beli|buy|purchase|tambah|masuk|jual|sell|sold|lepas|kurangi|keluar)\b/i.test(t);
}

function canAskAssetGoldAmbiguousClarification_(parsed, rawText) {
  const text = String(rawText || '').toLowerCase();
  const isGoldAsset = /\b(aset\s+emas|emas|gold|antam|logam\s+mulia)\b/i.test(text);

  if (!isGoldAsset) return false;
  if (hasExplicitAssetGoldAction_(text)) return false;

  const category = String((parsed && parsed.category) || '').toLowerCase();
  const type = String((parsed && parsed.type) || '').toLowerCase();

  if (category && category !== 'aset') return false;
  if (type && type !== 'asset') return false;

  return true;
}

function buildAssetGoldAmbiguousClarificationMessage_(parsed) {
  return (
    'Saya tangkap ada transaksi Aset/Emas' +
    ((parsed && parsed.amount) ? ' Rp' + parsed.amount : '') +
    ', tapi maksudnya belum jelas.\n\n' +
    'Pilih maksudnya:\n' +
    'A. Beli / tambah emas\n' +
    'B. Jual / kurangi emas\n' +
    'C. Catat sebagai aset/tabungan biasa\n' +
    'D. Abaikan\n\n' +
    'Contoh aman:\n' +
    '- beli emas 2 gram harga 3jt\n' +
    '- jual emas 1 gram harga 1.5jt\n' +
    '- nabung 50000 ke dana darurat'
  );
}

function buildAssetGoldClarifiedText_(choice, rawText) {
  const text = String(rawText || '').trim();

  if (choice === 'buy') return hasExplicitAssetGoldAction_(text) ? text : 'beli ' + text;
  if (choice === 'sell') return hasExplicitAssetGoldAction_(text) ? text : 'jual ' + text;

  if (choice === 'savings') {
    return text
      .replace(/\baset\s+emas\b/ig, 'aset')
      .replace(/\b(logam\s+mulia|antam|emas|gold)\b/ig, 'aset')
      .trim();
  }

  return text;
}

function reprocessClarifiedTelegramText_(chatId, rawText) {
  return doPost({
    postData: {
      type: 'application/json',
      contents: JSON.stringify({
        update_id: Date.now(),
        message: {
          message_id: Date.now(),
          date: Math.floor(Date.now() / 1000),
          chat: {
            id: chatId,
            type: 'private'
          },
          text: String(rawText || '')
        }
      })
    }
  });
}

function debtAmbiguousClarificationResolvedText_(pending, rawText) {
  const text = String(rawText || '').trim();
  const lower = text.toLowerCase();
  const choice = normalizeDebtAmbiguousClarificationAnswer_(text);

  if ((isBorrowInText_(lower) || isDebtPaymentText_(lower)) && parseDebtPerson_(text)) {
    return text;
  }

  if (choice === 'debt_in') return 'DEBT_NEEDS_COMPLETE_REWRITE';
  if (choice === 'debt_payment') return 'DEBT_NEEDS_COMPLETE_REWRITE';
  if (choice === 'piutang_help') return 'DEBT_PIUTANG_HELP_ONLY';

  return '';
}

function isSprint0ANonFinanceSafeReject_(rawText) {
  const original = String(rawText || '').trim();
  if (!original) return true;

  const cleaned = original
    .replace(/https?:\/\/\S+/gi, ' ')
    .replace(/\bgid=\d+\b/gi, ' ')
    .replace(/\bchat[_ -]?id\b/gi, ' ')
    .replace(/\bupdate[_ -]?id\b/gi, ' ')
    .replace(/\bmessage[_ -]?id\b/gi, ' ')
    .replace(/\bsprint0a[_a-z0-9-]*\b/gi, ' ')
    .replace(/\bruntime[_a-z0-9-]*\b/gi, ' ')
    .replace(/\bregression[_a-z0-9-]*\b/gi, ' ')
    .replace(/\btest[_a-z0-9-]*\b/gi, ' ')
    .replace(/[0-9.,]+/g, ' ')
    .replace(/[^\p{L}\s]/gu, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();

  const financeIntent =
    /\b(beli|bayar|jajan|makan|minum|kopi|bensin|parkir|tol|grab|gojek|shopee|tokopedia|transfer|tf|topup|tarik|cash|tunai|cc|credit card|kartu kredit|hutang|utang|pinjam|cicilan|kpr|emas|gold|aset|nabung|tabung|saving|gaji|refund|terima|masuk|keluar|saldo|tagihan|angsuran)\b/i.test(original);

  if (financeIntent) return false;

  const transcriptNoise =
    /https?:\/\/\S+/i.test(original) ||
    /\bgid=\d+\b/i.test(original) ||
    /\b(chat\s*transcript|copy_paste|spreadsheet|docs\.google|google\.com\/spreadsheets)\b/i.test(original);

  if (transcriptNoise) return true;
  if (!cleaned) return true;

  return /^(halo|hai|hello|hi|apa kabar|pagi|siang|sore|malam|ok|oke|sip|mantap|test|tes|ping)(\b|$)/i.test(cleaned);
}

function canAskAmountOnlyMissingCategoryClarification_(parsed, rawText) {
  const text = String(rawText || '').trim();
  if (!text) return false;

  const amount = Number(parsed && parsed.amount ? parsed.amount : 0);
  if (!amount || amount <= 0) return false;

  const category = String((parsed && parsed.category) || '').trim().toLowerCase();
  const account = String((parsed && parsed.account) || '').trim().toLowerCase();

  const genericCategory = !category || category === 'lainnya' || category === 'other' || category === 'unknown';
  if (!genericCategory) return false;

  // URL/gid/chat transcript noise must not become amount/category evidence.
  const stripped = text
    .replace(/https?:\/\/\S+/gi, ' ')
    .replace(/\bgid=\d+\b/gi, ' ')
    .replace(/\bchat[_ -]?id\b/gi, ' ')
    .replace(/\bupdate[_ -]?id\b/gi, ' ')
    .replace(/\bmessage[_ -]?id\b/gi, ' ')
    .replace(/\bsprint0a[_a-z0-9-]*\b/gi, ' ')
    .replace(/\bruntime[_a-z0-9-]*\b/gi, ' ')
    .replace(/\bregression[_a-z0-9-]*\b/gi, ' ')
    .replace(/[0-9.,]+/g, ' ')
    .replace(/[^\p{L}\s]/gu, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const hasFinanceIntent =
    /\b(beli|bayar|jajan|makan|minum|kopi|bensin|parkir|tol|grab|gojek|shopee|tokopedia|transfer|tf|topup|tarik|cash|tunai|cc|credit card|kartu kredit|hutang|utang|pinjam|cicilan|kpr|emas|gold|aset|nabung|tabung|saving|gaji|refund|terima|masuk|keluar)\b/i.test(text);

  const accountMissing = !account || account === 'unknown';

  return accountMissing && (hasFinanceIntent || stripped.length === 0);
}

function canAskMissingCategoryClarification_(parsed, rawText) {
  const text = String(rawText || '').toLowerCase();
  const amount = Number((parsed && parsed.amount) || 0);
  const account = String((parsed && parsed.account) || '').trim().toLowerCase();
  const category = String((parsed && parsed.category) || '').trim().toLowerCase();

  if (amount <= 0) return false;
  if (!account || account === 'unknown') return false;
  if (category && category !== 'lainnya') return false;

  if (/\b(transfer|tf|topup|tarik|cash|tunai|cc|credit card|kartu kredit|tokopedia cc|tokopedia card|hutang|utang|pinjam|pinjaman|cicilan rumah|kpr|angsuran rumah|emas|gold|aset|nabung|tabung|saving|savings|investasi|gaji|refund|terima|diterima|masuk)\b/i.test(text)) return false;

  return /\b(bayar|beli|jajan|pakai|buat|untuk|keluar)\b/i.test(text);
}

