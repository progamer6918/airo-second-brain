function airoSprint6NormalizeTabName_(name) {
  return String(name || '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '');
}

function airoSprint6FindSheetLoose_(ss, tabName) {
  const exact = ss.getSheetByName(tabName);
  if (exact) {
    return {
      sheet: exact,
      requested_name: tabName,
      actual_name: exact.getName(),
      match_type: 'exact'
    };
  }

  const target = airoSprint6NormalizeTabName_(tabName);
  const sheets = ss.getSheets();

  for (let i = 0; i < sheets.length; i++) {
    const sh = sheets[i];
    const normalized = airoSprint6NormalizeTabName_(sh.getName());
    if (normalized === target) {
      return {
        sheet: sh,
        requested_name: tabName,
        actual_name: sh.getName(),
        match_type: 'normalized_exact'
      };
    }
  }

  for (let j = 0; j < sheets.length; j++) {
    const sh2 = sheets[j];
    const normalized2 = airoSprint6NormalizeTabName_(sh2.getName());
    if (
      target.length >= 5 &&
      normalized2.length >= 5 &&
      (normalized2.indexOf(target) >= 0 || target.indexOf(normalized2) >= 0)
    ) {
      return {
        sheet: sh2,
        requested_name: tabName,
        actual_name: sh2.getName(),
        match_type: 'normalized_partial'
      };
    }
  }

  return null;
}

