// AIRO Sprint 7F-A friendly clarification UX helpers.
// Metadata/subject-derived only. No body read. No email mutation. No finance write.
function airoSprint7FExtractAmountFromSubject_(subject) {
  var text = String(subject || "");
  var patterns = [
    /(?:rp|idr)\s*([0-9][0-9.,]{2,})/i,
    /([0-9][0-9.,]{3,})\s*(?:rp|idr)?/i
  ];

  for (var i = 0; i < patterns.length; i++) {
    var match = text.match(patterns[i]);
    if (match && match[1]) {
      var value = Number(String(match[1]).replace(/[.,]/g, ""));
      if (value > 0) {
        return value;
      }
    }
  }

  return 0;
}

function airoSprint7FFormatRupiah_(amount) {
  amount = Number(amount || 0);
  if (!amount) {
    return "Nominal belum terbaca";
  }

  return "Rp" + String(amount).replace(/\B(?=(\d{3})+(?!\d))/g, ".");
}

function airoSprint7FInferDirection_(subject, candidateType) {
  var text = String(subject || "").toLowerCase();
  var type = String(candidateType || "").toLowerCase();

  if (type.indexOf("transfer_masuk") >= 0) {
    return "pemasukan";
  }

  if (
    text.indexOf("masuk") >= 0 ||
    text.indexOf("diterima") >= 0 ||
    text.indexOf("received") >= 0 ||
    text.indexOf("transfer masuk") >= 0
  ) {
    return "pemasukan";
  }

  if (
    text.indexOf("keluar") >= 0 ||
    text.indexOf("pembayaran") >= 0 ||
    text.indexOf("transaksimu berhasil") >= 0 ||
    text.indexOf("debit") >= 0 ||
    text.indexOf("purchase") >= 0
  ) {
    return "pengeluaran";
  }

  if (type.indexOf("blu_transaction") >= 0) {
    return "pengeluaran";
  }

  return "ambigu";
}

function airoSprint7FClarificationQuestionType_(direction) {
  direction = String(direction || "").toLowerCase();

  if (direction === "pengeluaran") {
    return "category_expense";
  }

  if (direction === "pemasukan") {
    return "category_income";
  }

  return "direction";
}

