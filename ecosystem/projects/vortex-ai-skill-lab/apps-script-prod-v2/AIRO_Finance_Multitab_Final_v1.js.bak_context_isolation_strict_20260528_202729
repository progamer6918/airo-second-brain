    'D. Cash → BCA\n' +
    'E. Tulis manual\n\n' +
    'Contoh manual: transfer 100000 dari bca ke blu'
  );
}

function transferClarificationResolvedText_(pending, rawText) {
  const route = normalizeTransferRouteClarificationAnswer_(rawText);
  if (!route) return '';

  const amount = String(Number((pending && pending.amount) || 0));
  return 'transfer ' + amount + ' dari ' + route.source.toLowerCase() + ' ke ' + route.target.toLowerCase();
}

function normalizeCreditCardClarificationAnswer_(text) {
  const t = String(text || '').toLowerCase().trim();

  if (/^(a|1)(\b|[\s.:-])/i.test(t) || /\b(belanja|beli|purchase|transaksi baru|pakai cc|pakai credit card)\b/i.test(t)) return 'cc_purchase';
  if (/^(b|2)$/i.test(t) || /\b(bayar tagihan|bayar cc|payment|tagihan|lunas|pelunasan)\b/i.test(t)) return 'cc_payment';
  if (/^(c|3)$/i.test(t) || /\b(alokasi|pocket|blu cc|siapkan dana|belum ke blu|ke blu)\b/i.test(t)) return 'cc_allocation';
  if (/^(d|4|e|5)$/i.test(t) || /\b(lain|lainnya|manual)\b/i.test(t)) return 'manual';

  return '';
}

function canAskCreditCardAmbiguousClarification_(parsed, rawText) {
  const text = String(rawText || '').toLowerCase();
  const amount = Number((parsed && parsed.amount) || 0);

  if (amount <= 0) return false;
  if (!/\b(cc|credit card|kartu kredit|tokopedia cc|tokopedia card)\b/i.test(text)) return false;

  // Clear intents should keep existing behavior.
  if (/\b(beli|belanja|bayar tagihan|bayar cc|lunas|pelunasan|alokasi|pocket|blu cc|belum ke blu|dari blu|ke blu|transferred|transfer)\b/i.test(text)) {
    return false;
  }

  // Short forms such as "cc 24rb" should ask first.
  return true;
}

function buildCreditCardAmbiguousClarificationMessage_(parsed) {
  return (
    'Saya tangkap ada transaksi Credit Card Rp' + ((parsed && parsed.amount) || 0) + ', tapi maksudnya belum jelas.\n\n' +
    'Pilih salah satu:\n' +
    'A. Belanja pakai Credit Card\n' +
    'B. Bayar tagihan Credit Card\n' +
    'C. Alokasi dana ke Pocket Blu CC\n' +
    'D. Tulis manual\n\n' +
    'Contoh manual:\n' +
    '- cc beli makan 24000\n' +
    '- bayar cc 24000 dari blu\n' +
    '- alokasi 24000 ke pocket blu cc'
  );
}

function creditCardClarificationResolvedText_(pending, rawText) {
  const choice = normalizeCreditCardClarificationAnswer_(rawText);
  const amount = String(Number((pending && pending.amount) || 0));
  const answer = String(rawText || '').trim();

  if (choice === 'cc_purchase') {
    let detail = answer
      .replace(/^(a|1)\b[\s.:-]*/i, '')
      .replace(/\b(belanja|beli|purchase|transaksi baru|pakai cc|pakai credit card)\b/ig, ' ')
      .replace(/\s+/g, ' ')
      .trim();

    if (!detail || /^[a1]$/i.test(answer)) return 'CC_PURCHASE_NEEDS_DETAIL';

    return 'cc beli ' + detail + ' ' + amount;
  }

  if (choice === 'cc_payment') return 'CC_PAYMENT_HELP_ONLY';
  if (choice === 'cc_allocation') return 'CC_ALLOCATION_HELP_ONLY';

  return '';
}

function normalizeMissingCategoryClarificationAnswer_(text) {
  const t = String(text || '').toLowerCase().trim();
  if (/^(a|1)$/i.test(t) || /\b(makan|minum|kopi|resto|warung|sarapan|lunch|dinner)\b/i.test(t)) return 'makan';
  if (/^(b2|2)$/i.test(t) || /\b(transport|bensin|bbm|pertalite|pertamax|parkir|tol|grab|gojek)\b/i.test(t)) return 'transport';
  if (/^(c|3)$/i.test(t) || /\b(tagihan|pdam|pln|listrik|air|wifi|internet)\b/i.test(t)) return 'tagihan';
  if (/^(d|4)$/i.test(t) || /\b(belanja|shopping|tokopedia|shopee)\b/i.test(t)) return 'belanja';
  if (/^(e|5)$/i.test(t) || /\b(lain|lainnya|manual)\b/i.test(t)) return 'manual';
  return '';
}

function normalizeDebtAmbiguousClarificationAnswer_(text) {
