  }

  setupNetWorthMetrics();

  let handled = false;
  let label = '';
  let value = '';

  const homeValue = text.match(/^(set|atur|update)\s+(nilai rumah|harga rumah|value rumah)\s+(.+)$/i);
  const principal = text.match(/^(set|atur|update)\s+(sisa pokok rumah|pokok rumah|sisa principal rumah)\s+(.+)$/i);
  const haircut = text.match(/^(set|atur|update)\s+(haircut rumah|diskon rumah)\s+(\d+(?:[.,]\d+)?)\s*%?$/i);

  if (homeValue) {
    value = parseHumanMoney_(homeValue[3]);
    asset.getRange('AB17').setValue(value);
    asset.getRange('AB17').setNumberFormat('"Rp" #,##0');
    label = 'Nilai Rumah Pasar';
