function dashboardLayoutReadOnlyAudit_(ss) {
  const dashboard =
    getSheetLoose_(ss, AIRO_CONFIG.tabs.dashboard) ||
    getSheetLoose_(ss, 'Dashboard');

  if (!dashboard) {
    return {
      ok: false,
      reason: 'dashboard_sheet_missing'
    };
  }

  const maxRows = Math.min(dashboard.getMaxRows(), 80);
  const maxCols = Math.min(dashboard.getMaxColumns(), 12);
  const values = dashboard.getRange(1, 1, maxRows, maxCols).getDisplayValues();

  const labels = [];
  for (let r = 0; r < values.length; r++) {
    for (let c = 0; c < values[r].length; c++) {
      const text = String(values[r][c] || '').trim();
      if (!text) continue;
      labels.push({
        row: r + 1,
        col: c + 1,
        text: text.slice(0, 120)
      });
    }
  }

  const requiredHints = [
    'Net Worth',
    'Assets',
    'Cashflow',
    'Credit Card',
    'Cash',
    'Hutang',
    'Cicilan',
    'Review Queue',
    'Sync'
  ];

  const foundHints = {};
  requiredHints.forEach(function(hint) {
    const re = new RegExp(hint, 'i');
    foundHints[hint] = labels.some(function(item) {
      return re.test(item.text);
    });
  });

  return {
    ok: true,
    command: 'dashboard_layout_read_only_audit',
    sheet_name: dashboard.getName(),
    scanned_rows: maxRows,
    scanned_cols: maxCols,
    non_empty_count: labels.length,
    labels_sample: labels.slice(0, 60),
    found_hints: foundHints,
    google_write_performed: false
  };
}

