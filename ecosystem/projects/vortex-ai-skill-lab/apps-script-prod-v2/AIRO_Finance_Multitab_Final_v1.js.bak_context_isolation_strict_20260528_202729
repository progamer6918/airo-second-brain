  dashboard.getRange('G26').setValue('Due ' + formatDateYmd_(payableDueDate));

  dashboard.getRange('B27:C27').merge().setValue('Total Tagihan');
  dashboard.getRange('D27').setValue(stats.payable_total);
  dashboard.getRange('E27:F27').merge().setValue('Belum ke Blu');
  dashboard.getRange('G27').setValue(stats.payable_belum_blu);

  dashboard.getRange('B28:C28').merge().setValue('Status');
  dashboard.getRange('D28').setValue(overdue ? 'OVERDUE / CEK BLU' : (stats.payable_belum_blu > 0 ? 'PERLU SIAPKAN BLU' : 'AMAN'));
  dashboard.getRange('E28:F28').merge().setValue('Rows');
  dashboard.getRange('G28').setValue(stats.payable_rows);

  dashboard.getRange('B30:C30').merge().setValue('Periode Berjalan / Unbilled');
  dashboard.getRange('D30').setValue(currentCycle.id);
  dashboard.getRange('E30:F30').merge().setValue(formatDateYmd_(currentCycle.start) + ' – ' + formatDateYmd_(currentCycle.end));
  dashboard.getRange('G30').setValue('Belum closing');

  dashboard.getRange('B31:C31').merge().setValue('Total Sementara');
  dashboard.getRange('D31').setValue(stats.unbilled_total);
  dashboard.getRange('E31:F31').merge().setValue('Belum ke Blu');
