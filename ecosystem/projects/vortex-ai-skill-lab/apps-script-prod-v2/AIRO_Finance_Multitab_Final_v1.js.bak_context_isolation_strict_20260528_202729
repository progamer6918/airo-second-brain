function airoSprint6BDuplicateSuppressionRunner_(ss) {
  ss = ss || SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));

  const readback = airoSprint6BCooldownSuppressionReadback_(ss);
  const evaluated = readback.evaluated_alerts || [];
  const suppressed = readback.suppressed_alerts || [];
  const eligible = readback.eligible_alerts || [];

  let wouldSendCount = 0;
  let blockedDuplicateCount = 0;

  const decisions = [];

  for (let i = 0; i < evaluated.length; i++) {
    const item = evaluated[i] || {};
    const isSuppressed = Boolean(item.suppressed_by_cooldown);
    const decision = isSuppressed ? 'BLOCK_DUPLICATE' : 'WOULD_SEND_IF_TRIGGER_ENABLED';

    if (isSuppressed) {
      blockedDuplicateCount += 1;
    } else {
      wouldSendCount += 1;
    }

    decisions.push({
      alert_key: String(item.alert_key || ''),
      severity: String(item.severity || 'INFO'),
      title: String(item.title || ''),
      suppressed_by_cooldown: isSuppressed,
      decision: decision,
      sent: false
    });
  }

  const targetKey = 'data_status_warning:20260527:WARNING';
  let targetDecision = 'NOT_FOUND';

  for (let j = 0; j < decisions.length; j++) {
    if (decisions[j].alert_key === targetKey) {
      targetDecision = decisions[j].decision;
      break;
    }
  }

  return {
    ok: true,
    sprint: '6B',
    command: 'sprint6b_duplicate_suppression_runner',
    mode: 'read-only',
    write_performed: false,
    google_write_performed: false,
