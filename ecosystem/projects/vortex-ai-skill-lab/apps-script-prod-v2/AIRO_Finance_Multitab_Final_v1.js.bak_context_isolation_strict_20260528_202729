// Read-only cooldown suppression verifier for Sprint 6B.
// It checks whether ACK/cooldown records in _AIRO_Audit_Log suppress today's alert keys.
function airoSprint6BCooldownReadRecentKeys_(ss) {
  const audit = ss.getSheetByName('_AIRO_Audit_Log');
  const keys = {};
  const rows = [];

  if (!audit) {
    return {
      audit_exists: false,
      audit_rows: 0,
      keys: keys,
      rows: rows
    };
  }

  const lastRow = audit.getLastRow();
  const lastCol = audit.getLastColumn();

  if (lastRow < 2 || lastCol < 1) {
    return {
      audit_exists: true,
      audit_rows: lastRow,
      keys: keys,
      rows: rows
    };
  }

  const readRows = Math.min(Math.max(lastRow - 1, 0), 500);
  const startRow = Math.max(2, lastRow - readRows + 1);
  const values = audit.getRange(startRow, 1, readRows, Math.min(lastCol, 8)).getDisplayValues();

  for (let i = 0; i < values.length; i++) {
    const row = values[i] || [];
    const line = row.join(' | ');
    const eventType = String(row[2] || '');
    const ref = String(row[6] || '');
    const metadata = String(row[7] || '');

    let alertKey = '';

    if (ref.indexOf(':') >= 0) {
      alertKey = ref;
    }

    const match = metadata.match(/"alert_key"\s*:\s*"([^"]+)"/);
    if (match && match[1]) {
      alertKey = match[1];
    }

    if (alertKey) {
      keys[alertKey] = {
        event_type: eventType,
        row_number: startRow + i,
        ref: ref
      };
      rows.push({
        row_number: startRow + i,
        event_type: eventType,
        alert_key: alertKey,
        ref: ref
      });
    }
  }

  return {
    audit_exists: true,
    audit_rows: lastRow,
    keys: keys,
    rows: rows
  };
}

