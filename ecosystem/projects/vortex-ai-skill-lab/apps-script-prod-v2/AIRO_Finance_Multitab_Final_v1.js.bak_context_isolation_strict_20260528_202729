  });

  const alertTypes = [
    {
      key: 'cc_due',
      status: ccTab.exists ? 'planned' : 'blocked_missing_source',
      source: ccTab.actual_name || '💳 Credit Card',
      trigger: 'scheduled daily',
      cooldown_minutes: 1440,
      ack_supported: true
    },
    {
      key: 'data_status_dirty',
      status: 'planned',
      source: 'Sprint 5 reconciliation analytics',
      trigger: 'scheduled and after reconciliation',
      cooldown_minutes: 360,
      ack_supported: true
    },
    {
