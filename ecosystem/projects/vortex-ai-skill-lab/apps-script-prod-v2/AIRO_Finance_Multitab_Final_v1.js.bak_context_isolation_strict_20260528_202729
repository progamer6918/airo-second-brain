}

function setupReviewQueueAutoProcessor() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));

  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction && t.getHandlerFunction() === 'processReviewQueueApprovedOnEdit') {
      ScriptApp.deleteTrigger(t);
    }
  });

  ScriptApp
    .newTrigger('processReviewQueueApprovedOnEdit')
    .forSpreadsheet(ss)
    .onEdit()
    .create();

  return {
    ok: true,
    trigger: 'processReviewQueueApprovedOnEdit'
  };
}

function routeReviewApprovedTab_(parsed, rawText) {
  const text = String(rawText || '').toLowerCase();

  if (/\b(tokopedia\s*card|tokopedia\s*cc|credit\s*card|kartu\s*kredit|\bcc\b)/i.test(text)) {
    return AIRO_CONFIG.tabs.creditCard;
  }

  if (/\b(cicilan rumah|kpr|angsuran rumah|bayar rumah)\b/i.test(text) || parsed.category === 'Cicilan Rumah') {
    return AIRO_CONFIG.tabs.cicilanRumah;
  }

  if (/\b(hutang|utang|bayar hutang|bayar utang|pinjam|pinjaman)\b/i.test(text) || parsed.category === 'Hutang') {
    return AIRO_CONFIG.tabs.hutang;
  }

  if (/\b(nabung|tabung|saving|savings|aset|investasi|emas|gold|dana darurat)\b/i.test(text) || parsed.category === 'Aset') {
    return AIRO_CONFIG.tabs.aset;
  }

  if (String(parsed.account || '').toLowerCase() === 'cash') {
    return AIRO_CONFIG.tabs.cash;
  }

  return AIRO_CONFIG.tabs.transactions;
}

function reviewHeaderMap_(headers) {
  const map = {};

  headers.forEach((h, idx) => {
    const key = canonicalKey_(h);
    map[key] = idx;
  });

  return map;
}

function getReviewValue_(row, map, keys) {
  for (const key of keys) {
    const c = canonicalKey_(key);
    if (Object.prototype.hasOwnProperty.call(map, c)) {
      return row[map[c]];
    }
  }

  return '';
}

function setReviewValue_(sheet, rowNumber, map, keys, value) {
  for (const key of keys) {
    const c = canonicalKey_(key);
    if (Object.prototype.hasOwnProperty.call(map, c)) {
      sheet.getRange(rowNumber, map[c] + 1).setValue(value);
      return true;
    }
  }

  return false;
}

function normalizeReviewAmount_(value) {
  if (typeof value === 'number') return value;

  return cleanAmount_(String(value || ''));
}

function normalizeReviewAccount_(value) {
  const v = String(value || '').trim();

  if (!v) return 'Unknown';

  if (v.toLowerCase() === 'cash') return 'Cash';
  if (v.toLowerCase() === 'bca') return 'BCA';
  if (v.toLowerCase() === 'blu') return 'Blu';
  if (v.toLowerCase() === 'gopay') return 'GoPay';
  if (v.toLowerCase() === 'ovo') return 'OVO';
  if (v.toLowerCase() === 'dana') return 'DANA';

  return v;
}

function refreshCashLedgerMaintenance() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
  const sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.cash);

  if (!sheet) {
    return { ok: false, reason: 'cash_ledger_missing' };
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) {
    return { ok: true, updated: 0, reason: 'no_rows' };
  }

  const values = sheet.getRange(2, 1, lastRow - 1, Math.max(sheet.getLastColumn(), 17)).getValues();

  let updated = 0;

  values.forEach((row, idx) => {
    const r = idx + 2;

    const leftNotes = String(row[7] || '');
    const rightDesc = String(row[14] || '');
    const text = rightDesc || leftNotes;

    if (!text) return;

    const sessionId = cashSessionId_(text);
    const inflow = isCashInflowText_(text);
    const amountIn = Number(row[16] || 0);
    const amountOut = Number(row[15] || 0);
    const amountStart = Number(row[2] || 0);
    const amountRemaining = Number(row[4] || 0);
    const amount = amountIn || amountOut || amountStart || amountRemaining || 0;

    if (!amount) return;

    // Left session summary area.
    if (inflow) {
      sheet.getRange(r, 1).setValue(sessionId);       // session_id
      sheet.getRange(r, 3).setValue(amount);          // amount_start
      sheet.getRange(r, 5).setValue(amount);          // amount_remaining
      sheet.getRange(r, 7).setValue('aktif');         // status
      sheet.getRange(r, 8).setValue(text);            // notes
    }

    // Right movement ledger area.
    sheet.getRange(r, 11).setValue(sessionId);        // session_id
    sheet.getRange(r, 13).setValue(inflow ? 'transfer_in' : 'expense'); // type

    if (isCashBensinText_(text)) {
      sheet.getRange(r, 14).setValue('Transport');    // category
    }

    if (inflow) {
      sheet.getRange(r, 16).clearContent();           // amount_out
      sheet.getRange(r, 17).setValue(amount);         // amount_in
    } else {
      sheet.getRange(r, 16).setValue(amount);         // amount_out
      sheet.getRange(r, 17).clearContent();           // amount_in
    }

    updated++;
  });

  refreshCashMonthlyReviewFormulas();

  return {
    ok: true,
    updated
  };
}

function setFormulaNextToLabel_(sheet, labels, formula) {
  const maxRows = Math.min(sheet.getMaxRows(), 120);
  const maxCols = Math.min(sheet.getMaxColumns(), 30);
  const values = sheet.getRange(1, 1, maxRows, maxCols).getDisplayValues();

  const wanted = labels.map(v => canonicalSheetName_(v));

  for (let r = 0; r < values.length; r++) {
    for (let c = 0; c < values[r].length; c++) {
      const cellText = canonicalSheetName_(values[r][c]);

      if (!cellText) continue;

      const matched = wanted.some(label => {
        return cellText === label || cellText.includes(label);
      });

      if (matched) {
        const targetCol = Math.min(c + 2, sheet.getMaxColumns());
        sheet.getRange(r + 1, targetCol).setFormula(formula);
        return sheet.getRange(r + 1, targetCol).getA1Notation();
      }
    }
  }

  return '';
}

function refreshCashMonthlyReviewFormulas() {
