// AIRO_ADMIN_FIND_SMOKE_HELPERS_V1
// Read-only Telegram admin helper for operational smoke readback.
// Usage: admin find smoke <SMOKE_ID>
function airoFindSmokeColumnLetter_(columnNumber) {
  let n = Number(columnNumber || 0);
  let letter = '';
  while (n > 0) {
    const mod = (n - 1) % 26;
    letter = String.fromCharCode(65 + mod) + letter;
    n = Math.floor((n - mod) / 26);
  }
  return letter || '';
}

function airoFindSmokeSafeText_(value) {
  return String(value == null ? '' : value)
    .replace(/[\u0000-\u001F\u007F]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function airoFindSmokeRowPreview_(row, maxChars) {
  const joined = (row || [])
    .map(function(cell) { return airoFindSmokeSafeText_(cell); })
    .filter(function(cell) { return cell !== ''; })
    .join(' | ');
  const limit = Number(maxChars || 260);
  return joined.length > limit ? joined.slice(0, limit - 1) + '…' : joined;
}

function airoFindSmokeAcrossWorkbook_(ss, query, maxHits) {
  // AIRO_ADMIN_FIND_SMOKE_FAST_V2
  // Default mode is intentionally fast: scan operational tabs only and skip internal logs.
  // Use: admin find smoke all <QUERY> to include every tab.
  const rawNeedle = airoFindSmokeSafeText_(query);
  const includeAllTabs = /^all\s+/i.test(rawNeedle);
  const needle = includeAllTabs ? airoFindSmokeSafeText_(rawNeedle.replace(/^all\s+/i, '')) : rawNeedle;
  const needleLower = needle.toLowerCase();
  const limit = Math.max(1, Math.min(Number(maxHits || 5), 10));
  const matches = [];
  const errors = [];

  if (!needle) {
    return { query: needle, matches: matches, errors: [{ tab: '', error: 'empty_query' }] };
  }

  const priorityTabs = [
    '📒 Account Ledger',
    '💵 Cash Ledger',
    '💳 Credit Card',
    '🧾 Review Queue',
    '🤝 Hutang',
    '🥇 Aset',
    '🏠 Cicilan Rumah',
    AIRO_CONFIG.tabs.financeEvents,
    '💸 Transactions'
  ];

  const sheetsByName = {};
  ss.getSheets().forEach(function(sheet) {
    sheetsByName[sheet.getName()] = sheet;
  });

  const sheets = includeAllTabs
    ? ss.getSheets().filter(function(sheet) { return sheet.getName().charAt(0) !== '_'; })
    : priorityTabs.map(function(name) { return sheetsByName[name]; }).filter(function(sheet) { return !!sheet; });

  for (let s = 0; s < sheets.length; s++) {
    if (matches.length >= limit) break;

    const sheet = sheets[s];
    const tabName = sheet.getName();

    try {
      const lastRow = sheet.getLastRow();
      const lastCol = Math.min(sheet.getLastColumn(), 24);

      if (!lastRow || !lastCol) continue;

      const values = sheet.getRange(1, 1, lastRow, lastCol).getDisplayValues();

      for (let r = 0; r < values.length; r++) {
        if (matches.length >= limit) break;

        const row = values[r] || [];
        const rowText = row.join(' ').toLowerCase();

        if (rowText.indexOf(needleLower) < 0) continue;

        const hitCols = [];
        for (let c = 0; c < row.length; c++) {
          if (airoFindSmokeSafeText_(row[c]).toLowerCase().indexOf(needleLower) >= 0) {
            hitCols.push(airoFindSmokeColumnLetter_(c + 1));
          }
        }

        let tabUrl = '';
        try {
          if (typeof getSheetTabUrl_ === 'function') {
            tabUrl = getSheetTabUrl_(ss, sheet);
          }
        } catch (urlErr) {
          tabUrl = '';
        }

        matches.push({
          tab: tabName,
          row: r + 1,
          columns: hitCols.join(','),
          preview: airoFindSmokeRowPreview_(row, 220),
          tabUrl: tabUrl
        });
      }
    } catch (err) {
      errors.push({
        tab: tabName,
        error: String(err && err.message ? err.message : err)
      });
    }
  }

  return { query: needle, matches: matches, errors: errors, includeAllTabs: includeAllTabs };
}

function airoBuildFindSmokeReply_(result) {
  result = result || {};
  const query = result.query || '';
  const matches = result.matches || [];
  const errors = result.errors || [];

  if (!query) {
    return 'Admin readback gagal: query kosong.\n\nFormat:\nadmin find smoke AIRO_SMOKE_ID';
  }

  let msg = '';
  msg += '🔎 Smoke readback selesai.\n';
  msg += 'Query: ' + query + '\n';
  msg += 'Hasil: ' + matches.length + ' match\n';

  if (errors.length) {
    msg += 'Read warnings: ' + errors.length + ' tab error\n';
  }

  if (!matches.length) {
    msg += '\nTidak ditemukan di workbook live.\n';
    msg += 'Interpretasi: aman kalau query ini adalah ambiguity/safe-block smoke. Kalau seharusnya ada write, berarti write path gagal atau target sheet berbeda.';
    return msg.slice(0, 3900);
  }

  const shown = matches.slice(0, 10);

  for (let i = 0; i < shown.length; i++) {
    const m = shown[i];
    msg += '\n#' + (i + 1) + '\n';
    msg += 'Tab: ' + m.tab + '\n';
    msg += 'Row: ' + m.row + '\n';
    msg += 'Col: ' + (m.columns || '-') + '\n';
    msg += 'Preview: ' + (m.preview || '-') + '\n';
    if (m.tabUrl) {
      msg += 'Link: ' + m.tabUrl + '\n';
    }

    if (msg.length > 3600) {
      msg += '\nOutput dipotong karena terlalu panjang.';
      break;
    }
  }

  if (matches.length > shown.length) {
    msg += '\nMasih ada ' + (matches.length - shown.length) + ' match lain.';
  }

  return msg.slice(0, 3900);
}

function handleSpecialFinanceCommand_(rawText, chatId) {

  // AIRO_SPRINT5_READ_ONLY_RECONCILIATION_ADMIN_ROUTE_V1
