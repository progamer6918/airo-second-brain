    trigger_created: false,
    evaluated_count: evaluated.length,
    blocked_duplicate_count: blockedDuplicateCount,
    would_send_count: wouldSendCount,
    sent_count: 0,
    target_key: targetKey,
    target_suppressed: Boolean(readback.target_key_suppressed),
    target_decision: targetDecision,
    audit_exists: Boolean(readback.audit_exists),
    cooldown_record_count: Number(readback.cooldown_record_count || 0),
