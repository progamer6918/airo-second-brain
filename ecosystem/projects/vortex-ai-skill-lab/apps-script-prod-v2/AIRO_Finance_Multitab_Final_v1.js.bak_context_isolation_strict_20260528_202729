    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
    const cc = getSheetLoose_(ss, AIRO_CONFIG.tabs.creditCard);
    const link = cc ? getSheetTabUrl_(ss, cc) : ss.getUrl();

    sendTelegram_(
      chatId,
      '✅ Tanggal dan merchant Credit Card dirapikan.\n\n' +
      'Rows updated: ' + (result && result.changed ? result.changed : 0) + '\n\n' +
      '🔗 Buka tab: ' + link
    );

    return {
      handled: true,
      ok: Boolean(result && result.ok),
      command: 'cc_date_merchant_fix',
      result,
      tab_url: link
    };
  }

  if (
    /^(admin\s+)?(rapikan|fix|pindah)\s+cc\s+status/i.test(text) ||
    /^admin\s+cc\s+status/i.test(text)
  ) {
    const result = moveCreditCardStatusAfterAmount();
    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
    const cc = getSheetLoose_(ss, AIRO_CONFIG.tabs.creditCard);
    const link = cc ? getSheetTabUrl_(ss, cc) : ss.getUrl();

    sendTelegram_(
      chatId,
      '✅ Kolom Credit Card dirapikan.\n\n' +
      'status_pocket_blu sekarang berada setelah amount dan sebelum description.\n\n' +
      '🔗 Buka tab: ' + link
    );

    return {
      handled: true,
      ok: Boolean(result && result.ok),
      command: 'cc_status_column_reorder',
      result,
      tab_url: link
    };
  }

  if (/^admin\s+(audit|check|cek)\s+(cicilan\s+rumah|cicilan|kpr|angsuran\s+rumah)\s+(rows|row|headers|header|testrows|test|status)/i.test(text)) {
    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
    const sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.cicilanRumah);

    if (!sheet) {
      sendTelegram_(chatId, 'Cicilan Rumah audit gagal: sheet Cicilan Rumah tidak ditemukan.');
      return {
        handled: true,
        ok: false,
        command: 'cicilan_rumah_rows_runtime_audit',
        reason: 'cicilan_rumah_sheet_missing'
      };
    }

    const findCicilanHeader_ = function(s) {
      const lastRow = Math.max(s.getLastRow(), 1);
      const lastCol = Math.max(s.getLastColumn(), 1);
      const maxRows = Math.min(lastRow, 80);
      const values = s.getRange(1, 1, maxRows, lastCol).getDisplayValues();

      for (let r = 0; r < values.length; r++) {
        const normalized = values[r].map(function(v) {
          return canonicalKey_(v);
        });

        const hasPaymentId = normalized.indexOf('payment_id') >= 0;
        const hasCicilanKe = normalized.indexOf('cicilan_ke') >= 0 || normalized.indexOf('angsuran_ke') >= 0;
        const hasAmount = normalized.indexOf('amount') >= 0 || normalized.indexOf('nominal') >= 0 || normalized.indexOf('jumlah') >= 0;
        const hasDate = normalized.indexOf('date') >= 0 || normalized.indexOf('tanggal') >= 0;

        if (hasPaymentId || (hasCicilanKe && hasAmount) || (hasDate && hasAmount && values[r].join(' ').toLowerCase().indexOf('cicilan') >= 0)) {
          return {
            row: r + 1,
            headers: values[r].map(function(v) { return String(v || '').trim(); })
          };
        }
      }

      return null;
    };

    const header = findCicilanHeader_(sheet);

    if (!header) {
      sendTelegram_(
        chatId,
        'Cicilan Rumah audit gagal: header payment history tidak ditemukan.\n\n' +
        'Sheet: ' + sheet.getName() + ' gid=' + sheet.getSheetId()
      );

      return {
        handled: true,
        ok: false,
        command: 'cicilan_rumah_rows_runtime_audit',
        reason: 'cicilan_rumah_header_missing'
      };
    }

    const headers = header.headers;
    const lastRow = sheet.getLastRow();
    const lastCol = sheet.getLastColumn();

    const findCol_ = function(names) {
      const wanted = names.map(function(n) { return canonicalKey_(n); });

      for (let i = 0; i < headers.length; i++) {
        const h = canonicalKey_(headers[i]);
        if (wanted.indexOf(h) >= 0) return i + 1;
      }

      return 0;
    };

    const col = {
      payment_id: findCol_(['payment_id', 'payment id', 'id_pembayaran']),
      date: findCol_(['date', 'tanggal', 'payment_date', 'tanggal_bayar', 'date_paid', 'paid_date']),
      amount: findCol_(['amount', 'nominal', 'jumlah', 'payment_amount', 'amount_paid', 'paid_amount', 'angsuran']),
      cicilan_ke: findCol_(['cicilan_ke', 'cicilan ke', 'angsuran_ke', 'installment_no']),
      remaining: findCol_(['remaining_after_payment', 'remaining', 'sisa_cicilan', 'sisa']),
      notes: findCol_(['notes', 'note', 'catatan', 'description', 'keterangan']),
      source: findCol_(['source', 'sumber'])
    };

    const rows = [];

    if (lastRow > header.row) {
      const values = sheet.getRange(header.row + 1, 1, lastRow - header.row, lastCol).getDisplayValues();

      values.forEach(function(row, idx) {
        const compact = row.slice(0, Math.min(lastCol, 12)).map(function(v) {
          return String(v || '').trim();
        });

        const hasData = compact.some(function(v) { return Boolean(v); });
        if (!hasData) return;

        rows.push({
          row: header.row + 1 + idx,
          payment_id: col.payment_id ? row[col.payment_id - 1] : '',
          date: col.date ? row[col.date - 1] : '',
          amount: col.amount ? row[col.amount - 1] : '',
          cicilan_ke: col.cicilan_ke ? row[col.cicilan_ke - 1] : '',
          remaining: col.remaining ? row[col.remaining - 1] : '',
          source: col.source ? row[col.source - 1] : '',
          notes: col.notes ? row[col.notes - 1] : ''
