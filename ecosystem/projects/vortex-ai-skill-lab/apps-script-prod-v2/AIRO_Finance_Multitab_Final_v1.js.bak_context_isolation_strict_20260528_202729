  const lastRow = audit.getLastRow();
  const lastCol = audit.getLastColumn();
  if (lastRow < 2 || lastCol < 1) return keys;

  const readRows = Math.min(Math.max(lastRow - 1, 0), 250);
  const startRow = Math.max(2, lastRow - readRows + 1);
  const values = audit.getRange(startRow, 1, readRows, Math.min(lastCol, 8)).getDisplayValues();

  for (let i = 0; i < values.length; i++) {
    const line = values[i].join(' | ');
    if (line.indexOf('sprint6b_alert_runner') >= 0 || line.indexOf('alert_key') >= 0) {
      const match = line.match(/"alert_key"\s*:\s*"([^"]+)"/);
      if (match && match[1]) {
        keys[match[1]] = true;
      }
    }
  }

  return keys;
}

