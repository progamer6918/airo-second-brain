function airoSprint6BAlertRunnerSafeMode_(ss, options) {
  ss = ss || SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
  options = options || {};

  const mode = String(options.mode || 'safe');
  const shouldSend = Boolean(options.send === true);
  const shouldWriteAudit = Boolean(options.writeAudit === true);

  const plan = airoSprint6BAlertEnginePlan_(ss, { mode: 'runner-safe' });
  const candidates = plan.alert_candidates || [];
  const recentKeys = airoSprint6BReadRecentAlertKeys_(ss);

  const evaluated = [];
  const eligible = [];
  const suppressed = [];

  for (let i = 0; i < candidates.length; i++) {
    const alert = candidates[i] || {};
    const alertKey = airoSprint6BAlertKeyForToday_(alert);
    const isSuppressed = Boolean(recentKeys[alertKey]);

    const row = {
      key: String(alert.key || ''),
      alert_key: alertKey,
      severity: String(alert.severity || 'INFO'),
      title: String(alert.title || ''),
      message: String(alert.message || ''),
      source: String(alert.source || ''),
      cooldown_minutes: Number(alert.default_cooldown_minutes || 360),
      ack_supported: Boolean(alert.ack_supported),
      suppressed_by_cooldown: isSuppressed,
      would_send: !isSuppressed,
      sent: false
    };

    evaluated.push(row);

    if (isSuppressed) {
      suppressed.push(row);
    } else {
      eligible.push(row);
    }
  }

  let sentCount = 0;

  if (shouldSend) {
    for (let j = 0; j < eligible.length; j++) {
      const item = eligible[j];
      sendTelegram_(
        getProp_('ADMIN_CHAT_ID'),
        '🚨 AIRO Alert\n' +
        '[' + item.severity + '] ' + item.title + '\n\n' +
        item.message + '\n\n' +
        'Source: ' + item.source + '\n' +
        'ACK: admin alert ack ' + item.alert_key
      );
      item.sent = true;
      sentCount += 1;
    }
  }

  if (shouldWriteAudit) {
    const audit = ss.getSheetByName('_AIRO_Audit_Log');
    if (audit) {
      audit.appendRow([
        new Date(),
        'AIRO',
        'sprint6b_alert_runner_safe_mode',
        shouldSend ? 'INFO' : 'DRY_RUN',
        'Sprint 6B Alert Engine',
        'Alert runner evaluated candidates',
        'sprint6b_alert_runner',
        JSON.stringify({
          mode: mode,
          send: shouldSend,
          evaluated_count: evaluated.length,
          eligible_count: eligible.length,
          suppressed_count: suppressed.length,
          sent_count: sentCount,
          first_alert_key: eligible.length ? eligible[0].alert_key : ''
        })
      ]);
    }
  }

  return {
    ok: true,
    sprint: '6B',
    command: 'sprint6b_alert_runner_safe_mode',
    mode: mode,
    write_performed: shouldWriteAudit,
    google_write_performed: shouldWriteAudit,
    proactive_send_performed: shouldSend,
    trigger_created: false,
    evaluated_count: evaluated.length,
    eligible_count: eligible.length,
    suppressed_count: suppressed.length,
    sent_count: sentCount,
    cooldown_storage: '_AIRO_Audit_Log',
    ack_supported: true,
    evaluated_alerts: evaluated,
    top_eligible: eligible.slice(0, 6),
    top_suppressed: suppressed.slice(0, 6),
    next_step: shouldSend ? 'validate received proactive alert and cooldown behavior' : 'run send=false safe mode accepted, then implement ACK route or controlled send test'
  };
}

