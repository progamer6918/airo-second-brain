function airoSprint6EnsureAuditLogTab_(ss) {
  ss = ss || SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));

  const tabName = '_AIRO_Audit_Log';
  let sh = ss.getSheetByName(tabName);
  let created = false;

  if (!sh) {
    sh = ss.insertSheet(tabName);
    created = true;
  }

  const headers = [
    'timestamp',
    'actor',
    'event_type',
    'severity',
    'source',
    'message',
    'ref',
    'metadata_json'
  ];

  const currentLastRow = sh.getLastRow();
  const currentLastCol = sh.getLastColumn();

  if (currentLastRow === 0 || currentLastCol === 0) {
    sh.getRange(1, 1, 1, headers.length).setValues([headers]);
    sh.setFrozenRows(1);
  } else {
    const existing = sh.getRange(1, 1, 1, Math.max(currentLastCol, headers.length)).getValues()[0];
    let needsHeader = false;
    for (let i = 0; i < headers.length; i++) {
      if (String(existing[i] || '') !== headers[i]) {
        needsHeader = true;
        break;
      }
    }
    if (needsHeader) {
      sh.getRange(1, 1, 1, headers.length).setValues([headers]);
      sh.setFrozenRows(1);
    }
  }

  const now = new Date();
  sh.appendRow([
    now,
    'AIRO',
    'sprint6_audit_log_ensured',
    'INFO',
    'Sprint 6 Dashboard Final',
    created ? '_AIRO_Audit_Log created for Dashboard Data Quality Center' : '_AIRO_Audit_Log verified for Dashboard Data Quality Center',
    'sprint6_dashboard_final',
    JSON.stringify({
      created: created,
      write_performed: true,
      google_write_performed: true
    })
  ]);

  return {
    ok: true,
    tab: tabName,
    created: created,
    rows: sh.getLastRow(),
    cols: sh.getLastColumn(),
    gid: sh.getSheetId(),
    write_performed: true,
    google_write_performed: true
  };
}

