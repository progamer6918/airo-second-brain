function parseCcDateFromText_(rawText, fallbackDate) {
  const text = String(rawText || '').toLowerCase();
  const fallback = fallbackDate instanceof Date ? fallbackDate : todayDate_();
  const year = fallback.getFullYear();

  const months = {
    januari: 0, jan: 0,
    februari: 1, feb: 1,
    maret: 2, mar: 2,
    april: 3, apr: 3,
    mei: 4,
    juni: 5, jun: 5,
    juli: 6, jul: 6,
    agustus: 7, agu: 7, aug: 7,
    september: 8, sep: 8,
    oktober: 9, okt: 9, oct: 9,
    november: 10, nov: 10,
    desember: 11, des: 11, dec: 11
  };

  let m = text.match(/\b(?:tgl|tanggal)\s+(\d{1,2})\s+([a-z]+)(?:\s+(\d{4}))?\b/i);
  if (!m) {
    m = text.match(/\b(\d{1,2})\s+([a-z]+)(?:\s+(\d{4}))?\b/i);
  }

  if (m) {
    const day = Number(m[1]);
    const mon = months[String(m[2]).toLowerCase()];
    const y = m[3] ? Number(m[3]) : year;

    if (!Number.isNaN(mon) && day >= 1 && day <= 31) {
      return new Date(y, mon, day);
    }
  }

  if (/\bkemarin\b/i.test(text)) {
    const d = new Date(fallback);
    d.setDate(d.getDate() - 1);
    return d;
  }

  if (/\bbesok\b/i.test(text)) {
    const d = new Date(fallback);
    d.setDate(d.getDate() + 1);
    return d;
  }

  if (/\bhari ini\b/i.test(text)) {
    return fallback;
  }

  return fallback;
}

function fixCreditCardDateMerchantFromRawText() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
  const sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.creditCard);

  if (!sheet) {
    return { ok: false, reason: 'credit_card_sheet_missing' };
  }

  const header = findCcHeaderRow_(sheet);
  if (!header) {
    return { ok: false, reason: 'cc_header_missing' };
  }

  const map = ccColMap_(header.headers);

  const dateCol = map.date;
  const merchantCol = map.merchant_app;
  const descCol = map.description;
  const cycleCol = map.billing_cycle_id;
  const startCol = map.billing_start;
  const endCol = map.billing_end;
  const statementCol = map.statement_month;

  if (!dateCol || !merchantCol || !descCol) {
    return {
      ok: false,
      reason: 'required_columns_missing',
      dateCol,
      merchantCol,
      descCol
    };
  }

  const lastRow = sheet.getLastRow();
  if (lastRow <= header.row) {
    return { ok: true, changed: 0 };
  }

  let changed = 0;

  for (let r = header.row + 1; r <= lastRow; r++) {
    const desc = String(sheet.getRange(r, descCol).getValue() || '').trim();
    if (!desc) continue;

    const oldDate = sheet.getRange(r, dateCol).getValue();
    const fallbackDate = oldDate instanceof Date ? oldDate : todayDate_();

    const parsedDate = parseCcDateFromText_(desc, fallbackDate);
    const merchant = parseCcMerchant_(desc);
    const cycle = ccBillingCycle_(parsedDate);

    sheet.getRange(r, dateCol).setValue(parsedDate);
    sheet.getRange(r, merchantCol).setValue(merchant);

    if (cycleCol) sheet.getRange(r, cycleCol).setValue(cycle.id);
    if (startCol) sheet.getRange(r, startCol).setValue(cycle.start);
    if (endCol) sheet.getRange(r, endCol).setValue(cycle.end);
    if (statementCol) sheet.getRange(r, statementCol).setValue(cycle.statementMonth);

    changed++;
  }

  return {
    ok: true,
    sheet: sheet.getName(),
    changed
  };
}

/**
 * Manual backfill function to migrate historical data from 💵 Cash Ledger to 📒 Account Ledger.
 * Safe to run multiple times: it is append-only, performs strict deduplication based on entry_id
 * and key properties, and populates balance formulas dynamically without overwriting existing data.
 */
function AIRO_BACKFILL_ACCOUNT_LEDGER_FROM_CASH_LEDGER() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
  var tz = ss.getSpreadsheetTimeZone() || Session.getScriptTimeZone();

  var cashSheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.cash);
  if (!cashSheet) {
    throw new Error('Cash Ledger sheet not found');
  }

  var accountSheet = ensureAccountLedgerSheet_(ss);
  if (!accountSheet) {
    throw new Error('Failed to ensure Account Ledger sheet exists');
  }

  var cashHeaderObj = findHeader_(cashSheet);
  if (!cashHeaderObj) {
    throw new Error('Header not found in Cash Ledger');
  }

  var accountHeaderObj = findHeader_(accountSheet);
  if (!accountHeaderObj) {
    throw new Error('Header not found in Account Ledger');
  }

  var cashHeaders = cashHeaderObj.headers;
  var accountHeaders = accountHeaderObj.headers;

  // Validate required fields in Cash Ledger
  var hasDate = cashHeaders.some(function(h) {
    var f = fieldForHeader_(h);
    return f === 'date' || canonicalKey_(h) === 'date_start' || canonicalKey_(h) === 'date';
  });
  var hasAccount = cashHeaders.some(function(h) {
    var f = fieldForHeader_(h);
    return f === 'account' || f === 'source' || canonicalKey_(h) === 'account' || canonicalKey_(h) === 'source';
  });
  var hasAmount = cashHeaders.some(function(h) {
    var f = fieldForHeader_(h);
    return f === 'amount' || f === 'amount_in' || f === 'amount_out' || canonicalKey_(h) === 'amount';
  });
  var hasDesc = cashHeaders.some(function(h) {
    var f = fieldForHeader_(h);
    return f === 'description' || f === 'raw_text' || f === 'notes' || canonicalKey_(h) === 'description';
  });

  if (!hasDate || !hasAccount || !hasAmount || !hasDesc) {
    throw new Error('Cash Ledger is missing required columns (Date, Account, Amount, or Description)');
  }

  // Validate required fields in Account Ledger
  var hasAccDate = accountHeaders.some(function(h) {
    return canonicalKey_(h) === 'date';
  });
  var hasAccAccount = accountHeaders.some(function(h) {
    return canonicalKey_(h) === 'account';
  });
  var hasAccAmountIn = accountHeaders.some(function(h) {
    return canonicalKey_(h) === 'amount_in';
  });
  var hasAccAmountOut = accountHeaders.some(function(h) {
    return canonicalKey_(h) === 'amount_out';
  });
  var hasAccDesc = accountHeaders.some(function(h) {
    return canonicalKey_(h) === 'description';
  });

  if (!hasAccDate || !hasAccAccount || !hasAccAmountIn || !hasAccAmountOut || !hasAccDesc) {
    throw new Error('Account Ledger is missing required target columns (date, account, amount_in, amount_out, or description)');
  }

  // Read Cash Ledger rows
  var cashHeaderRow = cashHeaderObj.row;
  var cashLastRow = cashSheet.getLastRow();
  var parsedCashRows = [];

  if (cashLastRow > cashHeaderRow) {
    var maxCols = cashSheet.getLastColumn();
    var cashData = cashSheet.getRange(cashHeaderRow + 1, 1, cashLastRow - cashHeaderRow, maxCols).getValues();

    for (var r = 0; r < cashData.length; r++) {
      var rowVals = cashData[r];
      var rowObj = {};
      for (var c = 0; c < cashHeaders.length; c++) {
        var header = cashHeaders[c];
        if (header) {
          rowObj[canonicalKey_(header)] = rowVals[c];
        }
      }

      // Filter empty rows
      var entryId = getFieldValue_(rowObj, 'entry_id', cashHeaders) || getFieldValue_(rowObj, 'linked_txn_id', cashHeaders);
      var desc = getFieldValue_(rowObj, 'description', cashHeaders) || getFieldValue_(rowObj, 'raw_text', cashHeaders);
      var amt = getFieldValue_(rowObj, 'amount', cashHeaders) || getFieldValue_(rowObj, 'amount_in', cashHeaders) || getFieldValue_(rowObj, 'amount_out', cashHeaders);

      if (!entryId && !desc && !amt) {
        continue;
      }
      parsedCashRows.push(rowObj);
    }
  }

  var registerEntryIdVariants_ = function(map, value) {
    var entryStr = String(value || '').trim().toLowerCase();
    if (!entryStr) {
      return;
    }
    map[entryStr] = true;
    if (entryStr.slice(-3) === ':in') {
      map[entryStr.slice(0, -3)] = true;
    } else if (entryStr.slice(-4) === ':out') {
      map[entryStr.slice(0, -4)] = true;
    }
  };

  // Read Account Ledger rows for dedup
  var accountHeaderRow = accountHeaderObj.row;
  var accountLastRow = accountSheet.getLastRow();
  var existingAccountKeys = {};
  var existingEntryIds = {};
  var existingAccountRowsCount = 0;

  if (accountLastRow > accountHeaderRow) {
    var accountData = accountSheet.getRange(accountHeaderRow + 1, 1, accountLastRow - accountHeaderRow, accountHeaders.length).getValues();
    existingAccountRowsCount = accountData.length;

    for (var r = 0; r < accountData.length; r++) {
      var rowVals = accountData[r];
      var rowObj = {};
      for (var c = 0; c < accountHeaders.length; c++) {
        var header = accountHeaders[c];
        if (header) {
          rowObj[canonicalKey_(header)] = rowVals[c];
        }
      }

      var key = buildDedupKey_(rowObj, accountHeaders, tz);
      if (key) {
        existingAccountKeys[key] = true;
      }

      var entryId = getFieldValue_(rowObj, 'entry_id', accountHeaders) || getFieldValue_(rowObj, 'linked_txn_id', accountHeaders);
      registerEntryIdVariants_(existingEntryIds, entryId);
    }
  }

  // Backfill loop
  var appendedCount = 0;
  var skippedCount = 0;

  for (var i = 0; i < parsedCashRows.length; i++) {
    var cashRow = parsedCashRows[i];

    var cashEntryId = getFieldValue_(cashRow, 'entry_id', cashHeaders) || getFieldValue_(cashRow, 'linked_txn_id', cashHeaders);
    var cashEntryStr = String(cashEntryId || '').trim().toLowerCase();
    var isDuplicate = false;
    var cashKey = '';

    if (cashEntryStr && existingEntryIds[cashEntryStr]) {
      isDuplicate = true;
    } else {
      cashKey = buildDedupKey_(cashRow, cashHeaders, tz);
      if (cashKey && existingAccountKeys[cashKey]) {
        isDuplicate = true;
      }
    }

    if (isDuplicate) {
      skippedCount++;
      continue;
    }

    // Construct new row object for Account Ledger
    var entryId = cashEntryId || makeTxnId_({}, getFieldValue_(cashRow, 'description', cashHeaders) || getFieldValue_(cashRow, 'raw_text', cashHeaders) || 'backfill');
    var dateVal = getFieldValue_(cashRow, 'date', cashHeaders) || getFieldValue_(cashRow, 'date_start', cashHeaders);
    if (dateVal instanceof Date) {
      dateVal = Utilities.formatDate(dateVal, tz, 'yyyy-MM-dd');
    }

    var amountIn = getFieldValue_(cashRow, 'amount_in', cashHeaders);
    var amountOut = getFieldValue_(cashRow, 'amount_out', cashHeaders);

    // If amount_in / amount_out is not explicitly present, calculate based on amount & type
    if (amountIn === '' && amountOut === '') {
      var amountVal = getFieldValue_(cashRow, 'amount', cashHeaders);
      var typeVal = String(getFieldValue_(cashRow, 'type', cashHeaders) || '').toLowerCase();
      var rawTextVal = getFieldValue_(cashRow, 'raw_text', cashHeaders) || getFieldValue_(cashRow, 'description', cashHeaders) || '';
      var isInflow = ['income', 'transfer_in', 'cash_in'].indexOf(typeVal) >= 0 || isCashInflowText_(rawTextVal);

      if (isInflow) {
        amountIn = amountVal;
        amountOut = '';
      } else {
        amountIn = '';
        amountOut = amountVal;
      }
    }

    var cashRowTextForAccount = getFieldValue_(cashRow, 'raw_text', cashHeaders) || getFieldValue_(cashRow, 'description', cashHeaders) || '';
    var accountValForLedger = getFieldValue_(cashRow, 'account', cashHeaders) || getFieldValue_(cashRow, 'source', cashHeaders) || 'Cash';
    if (String(accountValForLedger || '').trim().toLowerCase() === 'cash') {
      accountValForLedger = cashAccountNameForLedger_(cashRowTextForAccount);
    }

    var row = {
      entry_id: entryId,
      date: dateVal,
      account: accountValForLedger,
      amount_in: amountIn,
      amount_out: amountOut,
      balance: '',
      type: getFieldValue_(cashRow, 'type', cashHeaders) || 'expense',
      category: getFieldValue_(cashRow, 'category', cashHeaders) || 'Lainnya',
      description: getFieldValue_(cashRow, 'description', cashHeaders) || getFieldValue_(cashRow, 'raw_text', cashHeaders) || '',
      raw_text: getFieldValue_(cashRow, 'raw_text', cashHeaders) || getFieldValue_(cashRow, 'description', cashHeaders) || '',
      source_tab: AIRO_CONFIG.tabs.cash,
      linked_txn_id: getFieldValue_(cashRow, 'linked_txn_id', cashHeaders) || '',
      notes: getFieldValue_(cashRow, 'notes', cashHeaders) || ''
    };

    var result = appendByHeader_(ss, AIRO_CONFIG.tabs.accountLedger, row, { createIfMissing: false });
    if (result && result.status === 'written' && result.row) {
      appendedCount++;
      // Set formula balance
      try {
        var r = result.row;
        var formula = '=IF(C' + r + '="";"";SUMIFS($D$2:D' + r + ';$C$2:C' + r + ';C' + r + ')-SUMIFS($E$2:E' + r + ';$C$2:C' + r + ';C' + r + '))';
        accountSheet.getRange(r, 6).setFormula(formula);
        applyAccountLedgerRowStyle_(accountSheet, r);
      } catch (e) {}

      // Update local dedup maps to avoid duplicates in the same batch
      if (cashEntryStr) {
        registerEntryIdVariants_(existingEntryIds, cashEntryStr);
      }
      if (!cashKey) {
        cashKey = buildDedupKey_(cashRow, cashHeaders, tz);
      }
      if (cashKey) {
        existingAccountKeys[cashKey] = true;
      }
    } else {
      skippedCount++;
    }
  }

  var resultSummary = {
    cashRows: parsedCashRows.length,
    existingAccountRows: existingAccountRowsCount,
    appendedRows: appendedCount,
    skippedRows: skippedCount,
    accountLedgerTab: accountSheet.getName()
  };
  Logger.log(JSON.stringify(resultSummary));
  return resultSummary;
}

function getFieldValue_(rowObj, fieldName, headers) {
  var canonicalField = canonicalKey_(fieldName);
  if (rowObj[canonicalField] !== undefined && rowObj[canonicalField] !== null && rowObj[canonicalField] !== '') {
    return rowObj[canonicalField];
  }
  for (var i = 0; i < headers.length; i++) {
    var h = headers[i];
    if (fieldForHeader_(h) === fieldName) {
      var key = canonicalKey_(h);
      if (rowObj[key] !== undefined && rowObj[key] !== null && rowObj[key] !== '') {
        return rowObj[key];
      }
    }
  }
  return '';
}

function buildDedupKey_(rowObj, headers, tz) {
  var dateVal = getFieldValue_(rowObj, 'date', headers) || getFieldValue_(rowObj, 'date_start', headers);
  if (dateVal instanceof Date) {
    dateVal = Utilities.formatDate(dateVal, tz || Session.getScriptTimeZone(), 'yyyy-MM-dd');
  }

  var accountVal = getFieldValue_(rowObj, 'account', headers) || getFieldValue_(rowObj, 'source', headers) || 'Cash';

  var amountVal = getFieldValue_(rowObj, 'amount', headers);
  if (amountVal === undefined || amountVal === null || amountVal === '') {
    var amountIn = getFieldValue_(rowObj, 'amount_in', headers);
    var amountOut = getFieldValue_(rowObj, 'amount_out', headers);
    amountVal = (Number(amountIn) || 0) + (Number(amountOut) || 0);
  }

  var typeVal = getFieldValue_(rowObj, 'type', headers) || 'expense';
  var descVal = getFieldValue_(rowObj, 'description', headers) || getFieldValue_(rowObj, 'raw_text', headers) || getFieldValue_(rowObj, 'notes', headers);

  var d = String(dateVal || '').trim().toLowerCase();
  var acc = String(accountVal || '').trim().toLowerCase();
  var amt = Number(amountVal) || 0;
  var t = String(typeVal || '').trim().toLowerCase();
  var desc = String(descVal || '').trim().toLowerCase();

  if (!d && !amt) {
    return '';
  }

  return d + '|' + acc + '|' + t + '|' + amt + '|' + desc;
}

/**
 * Audit function for Account Ledger to identify missing source_tab, cash backfill rows, and duplicate candidates.
 * Completely read-only.
 */
function AIRO_AUDIT_ACCOUNT_LEDGER_BACKFILL_CLEANUP() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
  var tz = ss.getSpreadsheetTimeZone() || Session.getScriptTimeZone();

  var sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.accountLedger);
  if (!sheet) {
    throw new Error('Account Ledger sheet not found');
  }

  var headerObj = findHeader_(sheet);
  if (!headerObj) {
    throw new Error('Header not found in Account Ledger');
  }

  var headers = headerObj.headers;
  var startRow = headerObj.row + 1;
  var lastRow = sheet.getLastRow();

  var emptySourceTabRows = [];
  var cashBackfillLikeRows = [];
  var suspectedDuplicateRows = [];
  var duplicateCandidatesMap = {};
  var totalRows = 0;

  if (lastRow >= startRow) {
    var data = sheet.getRange(startRow, 1, lastRow - startRow + 1, headers.length).getValues();
    totalRows = data.length;

    for (var i = 0; i < data.length; i++) {
      var rowVals = data[i];
      var rowNum = startRow + i;

      var rowObj = {};
      for (var c = 0; c < headers.length; c++) {
        var h = headers[c];
        if (h) {
          rowObj[canonicalKey_(h)] = rowVals[c];
        }
      }

      var sourceTabVal = String(rowObj['source_tab'] || '').trim();
      var entryIdVal = String(rowObj['entry_id'] || '').trim().toLowerCase();
      var notesVal = String(rowObj['notes'] || '').trim().toLowerCase();

      // Check empty source_tab
      if (sourceTabVal === '' && emptySourceTabRows.length < 30) {
        emptySourceTabRows.push(rowNum);
      }

      // Check cash backfill like
      var isCashBackfill = sourceTabVal.toLowerCase().indexOf('cash') >= 0 ||
                           entryIdVal.indexOf('backfill') >= 0 ||
                           notesVal.indexOf('backfill') >= 0;
      if (isCashBackfill && cashBackfillLikeRows.length < 30) {
        cashBackfillLikeRows.push(rowNum);
      }

      // Build a unique key for duplicate identification:
      // date + account + amount_in + amount_out + normalized description/raw_text
      var dateVal = rowObj['date'];
      if (dateVal instanceof Date) {
        dateVal = Utilities.formatDate(dateVal, tz, 'yyyy-MM-dd');
      }
      var d = String(dateVal || '').trim().toLowerCase();

      var acc = String(rowObj['account'] || '').trim().toLowerCase();
      var amtIn = Number(rowObj['amount_in']) || 0;
      var amtOut = Number(rowObj['amount_out']) || 0;

      var descVal = rowObj['description'] || rowObj['raw_text'] || '';
      var desc = String(descVal || '').trim().toLowerCase();

      var dupKey = d + '|' + acc + '|' + amtIn + '|' + amtOut + '|' + desc;

      if (dupKey) {
        if (!duplicateCandidatesMap[dupKey]) {
          duplicateCandidatesMap[dupKey] = [];
        }
        duplicateCandidatesMap[dupKey].push(rowNum);
      }
    }

    // Process duplicates
    var duplicateCandidates = [];
