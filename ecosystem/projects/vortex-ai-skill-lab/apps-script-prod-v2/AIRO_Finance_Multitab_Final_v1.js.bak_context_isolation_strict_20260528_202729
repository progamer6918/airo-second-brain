      C: "Transfer antar akun sendiri",
      D: "Abaikan"
    }
  };

  var selectedMap = maps[questionType] || maps.direction;
  var label = selectedMap[answer] || "";

  return {
    ok: !!label,
    answer: answer,
    label: label,
    question_type: questionType
  };
}

function airoSprint7FEnsureResolutionHeaders_() {
  var sheet = airoSprint7FEnsureEmailLogSheet_();
  var headers = airoSprint7FEmailLogHeaders_();
  var current = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), headers.length)).getValues()[0];

  var changed = false;
  for (var i = 0; i < headers.length; i++) {
    if (String(current[i] || "") !== headers[i]) {
      changed = true;
      break;
    }
  }

  if (changed) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
  }

  return sheet;
}

function airoSprint7FUpdatePendingEmailResolution_(pending, resolved) {
  var sheet = airoSprint7FEnsureResolutionHeaders_();
  var headers = airoSprint7FEmailLogHeaders_();

  if (sheet.getLastRow() < 2) {
    return {
      updated: false,
      row_number: 0,
      reason: "email_log_empty"
    };
  }

  var values = sheet.getRange(2, 1, sheet.getLastRow() - 1, headers.length).getValues();
  var messageCol = headers.indexOf("message_id");
  var candidateCol = headers.indexOf("candidate_id");

  var targetRow = 0;
  for (var i = 0; i < values.length; i++) {
    var rowMessageId = String(values[i][messageCol] || "").trim();
    var rowCandidateId = String(values[i][candidateCol] || "").trim();

    if (
      rowMessageId === String(pending.message_id || "").trim() ||
      rowCandidateId === String(pending.candidate_id || "").trim()
    ) {
      targetRow = i + 2;
      break;
    }
  }

  if (!targetRow) {
    return {
      updated: false,
      row_number: 0,
      reason: "pending_candidate_not_found"
    };
  }

  var now = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd'T'HH:mm:ssXXX");

  var updates = {
    clarification_status: "resolved",
    resolved_answer: resolved.answer,
    resolved_label: resolved.label,
    resolved_at: now,
    write_allowed: "false",
    write_performed: "false",
    notes: "Resolved by Telegram answer in Sprint 7F-A. Finance write remains disabled."
  };

  Object.keys(updates).forEach(function(key) {
    var col = headers.indexOf(key);
    if (col >= 0) {
      sheet.getRange(targetRow, col + 1).setValue(updates[key]);
    }
  });

  return {
    updated: true,
    row_number: targetRow,
    resolved_at: now
  };
}

function airoSprint7FEmailAnswerMaybeHandleRoute_(e) {
  var parsed = airoSprint7FParseTelegramPayload_(e);

  if (!parsed.chat_id) {
    return null;
  }

  var pending = airoSprint7FLoadPendingEmailCandidate_(parsed.chat_id);
  if (!pending) {
    return null;
  }

  var answer = String(parsed.text_raw || "").trim().toUpperCase();

  if (!/^[A-E]$/.test(answer)) {
    return null;
  }

  var resolved = airoSprint7FResolveAnswerLabel_(answer, pending);

  if (!resolved.ok) {
    sendTelegram_(parsed.chat_id, "Saya belum bisa membaca pilihan itu. Balas A/B/C/D/E sesuai opsi terakhir.");
    return json_({
      ok: false,
      sprint: "7F-A",
      status: "sprint7f_email_answer_invalid",
      telegram_chat_id: parsed.chat_id,
      finance_write_performed: false
    });
  }

  var updateResult = airoSprint7FUpdatePendingEmailResolution_(pending, resolved);

  if (updateResult.updated) {
    PropertiesService.getScriptProperties().deleteProperty(pending._property_key);
  }

  var lines = [];
  lines.push("✅ Kategori email kandidat disimpan");
  lines.push("");
  lines.push("Provider: " + String(pending.provider || "Email"));
  lines.push("Waktu: " + String(pending.display_time || pending.received_at || "-"));
  lines.push("Pilihan: " + resolved.answer + " — " + resolved.label);
  lines.push("");
  lines.push("Status: " + (updateResult.updated ? "resolved" : "perlu dicek"));
  lines.push("Finance write: false");

  sendTelegram_(parsed.chat_id, lines.join("\n"));

  var result = {
    ok: true,
    sprint: "7F-A",
    status: updateResult.updated ? "sprint7f_email_answer_resolved_no_write" : "sprint7f_email_answer_resolution_not_logged",
    telegram_chat_id: parsed.chat_id,
    answer: resolved.answer,
    resolved_label: resolved.label,
    question_type: resolved.question_type,
    pending_candidate_id: pending.candidate_id || "",
    pending_message_id: pending.message_id || "",
    email_log_updated: !!updateResult.updated,
    pending_row_number: updateResult.row_number || 0,
    pending_pointer_cleared: !!updateResult.updated,
    mail_trigger_created: false,
    email_modified: false,
    full_email_body_stored: false,
    sensitive_content_stored: false,
    raw_email_forwarded_to_telegram: false,
    finance_write_performed: false,
    account_ledger_write_performed: false,
    finance_events_write_performed: false,
    review_queue_write_performed: false,
    domain_tab_write_performed: false,
    write_approved: false
  };

  Logger.log(JSON.stringify(result));
  return json_(result);
}

// AIRO Clarification Context Isolation Guard.
// Scope: block unrelated new finance input while a core Telegram clarification is pending.
// Safety: no Gmail read, no trigger, no email mutation, no finance write.
function airoContextIsolationParseTelegramPayload_(e) {
  var payload = {};
  try {
    payload = JSON.parse(e && e.postData && e.postData.contents ? e.postData.contents : "{}");
  } catch (err) {
    payload = {};
  }

  var message = payload.message || payload.edited_message || payload.channel_post || {};
  return {
    chat_id: message.chat && message.chat.id,
    text_raw: String(message.text || message.caption || "").trim(),
    text: String(message.text || message.caption || "").trim().toLowerCase()
  };
}

function airoContextIsolationIsAdminCommand_(text) {
  text = String(text || "").trim().toLowerCase();
  return text.indexOf("admin ") === 0 || text === "admin";
}

function airoContextIsolationPendingLabel_(pending) {
  var type = String((pending && pending.type) || "").trim();

  var labels = {
    missing_amount_account: "jumlah dan akun belum lengkap",
    cc_ambiguous: "transaksi Credit Card belum jelas",
    asset_gold_ambiguous: "transaksi aset/emas belum jelas",
    debt_ambiguous: "transaksi hutang/piutang belum jelas",
    missing_category: "kategori transaksi belum dipilih",
    transfer_incomplete: "detail transfer belum lengkap",
    direction_ambiguous: "arah transaksi belum jelas",
    cash_ambiguous: "transaksi cash belum jelas",
    missing_account: "akun sumber belum dipilih"
  };

  return labels[type] || type || "klarifikasi pending";
}

function airoContextIsolationIsValidAnswerForPending_(pending, rawText) {
  var type = String((pending && pending.type) || "").trim();
  var text = String(rawText || "").trim();

  if (!type || !text) {
    return false;
  }

  try {
    if (type === "missing_amount_account") {
      return !!parseAmountAccountClarificationAnswer_(text);
    }

    if (type === "cc_ambiguous") {
      return !!normalizeCreditCardClarificationAnswer_(text);
    }

    if (type === "asset_gold_ambiguous") {
      return !!normalizeAssetGoldAmbiguousClarificationAnswer_(text);
    }

    if (type === "debt_ambiguous") {
      return !!normalizeDebtAmbiguousClarificationAnswer_(text);
    }

    if (type === "missing_category") {
      return !!normalizeMissingCategoryClarificationAnswer_(text);
    }

    if (type === "transfer_incomplete") {
      return !!normalizeTransferRouteClarificationAnswer_(text);
    }

    if (type === "direction_ambiguous") {
      return !!normalizeDirectionClarificationAnswer_(text);
    }

    if (type === "cash_ambiguous") {
      return !!normalizeCashClarificationAnswer_(text);
    }

    if (type === "missing_account") {
      return !!normalizeClarificationAccountAnswer_(text);
    }
  } catch (err) {
    return false;
  }

  return false;
}

function airoContextIsolationLooksLikeNewFinanceInput_(rawText) {
  var text = String(rawText || "").trim().toLowerCase();
  if (!text) {
    return false;
  }

  if (airoContextIsolationIsAdminCommand_(text)) {
    return false;
  }

  var hasAmount =
    /\b\d+[.,]?\d*\s*(rb|ribu|jt|juta)?\b/i.test(text) ||
    /\b(rp|idr)\s*\d+/i.test(text);

  var hasWallet =
    /\b(bca|blu|mandiri|cash|tunai|cc|credit card|kartu kredit|tokopedia card)\b/i.test(text);

  var hasFinanceAction =
    /\b(keluar|masuk|transfer|tf|bayar|beli|belanja|jajan|makan|minum|kopi|tagihan|topup|tarik|hutang|utang|pinjam|gaji|refund|emas|aset|cicilan|kpr)\b/i.test(text);

  var looksTransfer =
    /\b(transfer|tf)\b/i.test(text) &&
    (/\bdari\b/i.test(text) || /\bke\b/i.test(text));

  var looksCc =
    /\b(cc|credit card|kartu kredit|tokopedia card)\b/i.test(text) &&
    hasAmount;

  var looksWalletMovement =
    hasWallet &&
    hasAmount &&
    hasFinanceAction;

  return looksTransfer || looksCc || looksWalletMovement;
}

function airoContextIsolationBuildBlockMessage_(pending) {
  var pendingLabel = airoContextIsolationPendingLabel_(pending);

  return [
    "⚠️ Masih ada klarifikasi pending.",
    "",
    "Pending: " + pendingLabel,
    "",
    "Selesaikan dulu dengan balasan sesuai opsi terakhir.",
    "Kalau mau membatalkan pending ini, kirim:",
    "admin clear clarification",
    "",
    "Transaksi baru belum diproses supaya tidak salah masuk sebagai jawaban klarifikasi."
  ].join("\n");
}

function airoContextIsolationMaybeHandleRoute_(e) {
  var parsed = airoContextIsolationParseTelegramPayload_(e);

  if (!parsed.chat_id) {
    return null;
  }

  var pending = getPendingClarification_(parsed.chat_id);
  if (!pending || !pending.type) {
    return null;
  }

  if (airoContextIsolationIsAdminCommand_(parsed.text_raw)) {
    return null;
  }

  if (airoContextIsolationIsValidAnswerForPending_(pending, parsed.text_raw)) {
    return null;
  }

  if (!airoContextIsolationLooksLikeNewFinanceInput_(parsed.text_raw)) {
    return null;
  }

  var reply = airoContextIsolationBuildBlockMessage_(pending);
  sendTelegram_(parsed.chat_id, reply);

  var result = {
    ok: true,
    sprint: "clarification-context-isolation",
    status: "blocked_unrelated_finance_input_while_pending",
    pending_type: String(pending.type || ""),
    telegram_reply_sent: true,
    pending_cleared: false,
    finance_write_performed: false,
    account_ledger_write_performed: false,
    finance_events_write_performed: false,
    review_queue_write_performed: false,
    domain_tab_write_performed: false,
    gmail_read_performed: false,
    mail_trigger_created: false,
    email_modified: false,
    full_email_body_stored: false
  };

  Logger.log(JSON.stringify(result));
  return json_(result);
}
