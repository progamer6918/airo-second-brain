function airoSprint6DashboardFinalReadback_(ss) {
  ss = ss || SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));

  const found = airoSprint6FindSheetLoose_(ss, 'Dashboard');
  if (!found || !found.sheet) {
    return {
      ok: false,
      command: 'sprint6_dashboard_final_readback',
      write_performed: false,
      google_write_performed: false,
      dashboard_found: false,
      error: 'Dashboard tab not found'
    };
  }

  const sh = found.sheet;
  const lastRow = sh.getLastRow();
  const lastCol = sh.getLastColumn();
  const readRows = Math.max(1, Math.min(lastRow || 1, 80));
  const readCols = Math.max(1, Math.min(lastCol || 1, 10));

  const values = sh.getRange(1, 1, readRows, readCols).getDisplayValues();
  const flat = values.map(function(row) {
    return row.join(' | ');
  }).join('\n');

  const lower = flat.toLowerCase();

  const markers = [
    'AIRO Finance Command Center',
    'Sprint 6 Dashboard Final',
    'Data Status',
    'Cash Ledger dependency',
    'FORBIDDEN',
    'Action Required',
    'Executive Command Center',
    'Wallet & Cashflow',
    'Domain Health',
    'Data Quality Center',
    'Smart Insight Panel',
    'Email Ingestion',
    'HIDDEN'
  ];

  const markerStatus = {};
  for (let i = 0; i < markers.length; i++) {
    const marker = markers[i];
    markerStatus[marker] = lower.indexOf(marker.toLowerCase()) >= 0;
  }

  const preview = [];
  for (let r = 0; r < Math.min(values.length, 14); r++) {
    const row = values[r] || [];
    const line = row.slice(0, Math.min(row.length, 7)).join(' | ');
    if (String(line).replace(/\s+/g, '').length) {
      preview.push(String(r + 1) + ': ' + line);
    }
  }

  const backupTabs = ss.getSheets()
    .map(function(sheet) {
      return sheet.getName();
    })
    .filter(function(name) {
      return String(name || '').indexOf('_AIRO_Dashboard_Backup_') === 0;
    })
    .sort();

  const audit = ss.getSheetByName('_AIRO_Audit_Log');
  let auditRows = 0;
  let auditPreview = '';
  let auditHasBuildEvent = false;

  if (audit) {
    auditRows = audit.getLastRow();
    const auditCols = Math.max(1, Math.min(audit.getLastColumn() || 1, 8));
    const startRow = Math.max(1, auditRows - 4);
    const numRows = Math.max(1, auditRows - startRow + 1);
    const auditValues = audit.getRange(startRow, 1, numRows, auditCols).getDisplayValues();
    auditPreview = auditValues.map(function(row) {
      return row.join(' | ');
    }).join('\n');
    auditHasBuildEvent = auditPreview.toLowerCase().indexOf('sprint6_dashboard_final_controlled_build') >= 0;
  }

  const requiredMarkers = [
    'AIRO Finance Command Center',
    'Data Status',
    'Cash Ledger dependency',
    'FORBIDDEN',
    'Action Required',
    'Data Quality Center'
  ];

  let passCount = 0;
  for (let j = 0; j < requiredMarkers.length; j++) {
    if (markerStatus[requiredMarkers[j]]) {
      passCount += 1;
    }
  }

  return {
    ok: true,
    command: 'sprint6_dashboard_final_readback',
    write_performed: false,
    google_write_performed: false,
    dashboard_found: true,
    dashboard_requested_name: found.requested_name,
    dashboard_actual_name: found.actual_name,
    dashboard_match_type: found.match_type,
    dashboard_rows: lastRow,
    dashboard_cols: lastCol,
    marker_status: markerStatus,
    required_marker_pass_count: passCount,
    required_marker_total: requiredMarkers.length,
    required_marker_pass: passCount === requiredMarkers.length,
    backup_tab_count: backupTabs.length,
    latest_backup_tab: backupTabs.length ? backupTabs[backupTabs.length - 1] : '',
    audit_log_exists: Boolean(audit),
    audit_log_rows: auditRows,
    audit_has_build_event_in_last_rows: auditHasBuildEvent,
    preview: preview,
    audit_preview: auditPreview
  };
}

