function parseHumanMoney_(value) {
  const raw = String(value || '').toLowerCase().trim();

  const juta = raw.match(/(\d+(?:[.,]\d+)?)\s*(jt|juta)\b/i);
  if (juta) return Math.round(Number(juta[1].replace(',', '.')) * 1000000);

  const milyar = raw.match(/(\d+(?:[.,]\d+)?)\s*(m|miliar|milyar)\b/i);
  if (milyar) return Math.round(Number(milyar[1].replace(',', '.')) * 1000000000);

  const ribu = raw.match(/(\d+(?:[.,]\d+)?)\s*(rb|ribu)\b/i);
  if (ribu) return Math.round(Number(ribu[1].replace(',', '.')) * 1000);

  return cleanAmount_(raw);
}

/**
 * Remove old duplicate Net Worth/Home Equity panels from earlier layout attempts.
 * Keeps only the final safe panel in:
 * - AA:AB = Home Equity
 * - AD:AE = Net Worth Final
 */

function ensureSheetSize_(sheet, minRows, minCols) {
  const currentRows = sheet.getMaxRows();
  const currentCols = sheet.getMaxColumns();

  if (currentRows < minRows) {
    sheet.insertRowsAfter(currentRows, minRows - currentRows);
  }

  if (currentCols < minCols) {
    sheet.insertColumnsAfter(currentCols, minCols - currentCols);
  }

  return {
    ok: true,
    rows: sheet.getMaxRows(),
    cols: sheet.getMaxColumns()
  };
}

function breakMergedRangesSafely_(sheet, a1Notation) {
  const range = sheet.getRange(a1Notation);

  try {
    const mergedRanges = range.getMergedRanges();
    mergedRanges.forEach(mr => {
      try {
        mr.breakApart();
      } catch (err) {}
    });
  } catch (err) {}

  return true;
}

function safeClearRange_(sheet, a1Notation) {
  breakMergedRangesSafely_(sheet, a1Notation);

  const range = sheet.getRange(a1Notation);
  range.clearContent();
  range.clearFormat();
  range.clearDataValidations();

  return true;
}

