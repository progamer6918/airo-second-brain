      severity: 'WARNING',
      title: 'Data Status Warning',
      message: 'Dashboard Data Status is Warning; review Action Required before trusting clean insights.',
      source: 'Sprint 5 reconciliation analytics',
      cooldown_key: 'data_status_warning',
      default_cooldown_minutes: 720,
