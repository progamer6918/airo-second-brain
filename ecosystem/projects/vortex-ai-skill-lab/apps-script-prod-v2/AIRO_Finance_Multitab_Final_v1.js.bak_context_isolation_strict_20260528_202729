  if (/^(a|1)$/i.test(t) || /\b(pinjam|pinjaman|saya pinjam|tambah hutang|tambah utang)\b/i.test(t)) return 'debt_in';
  if (/^(b|2)$/i.test(t) || /\b(bayar hutang|bayar utang|lunasi|nyicil|cicil)\b/i.test(t)) return 'debt_payment';
  if (/^(c|3)$/i.test(t) || /\b(piutang|orang bayar|ke saya)\b/i.test(t)) return 'piutang_help';
  if (/^(d|4|e|5)$/i.test(t) || /\b(lain|lainnya|manual)\b/i.test(t)) return 'manual';

  return '';
}

function canAskDebtAmbiguousClarification_(parsed, rawText) {
