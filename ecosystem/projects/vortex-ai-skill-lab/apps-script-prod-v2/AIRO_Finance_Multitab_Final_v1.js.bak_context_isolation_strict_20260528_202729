function isCreditCardPaymentText_(text) {
  const t = String(text || '').toLowerCase().trim();

  return (
    /^bayar\s+cc\b/i.test(t) ||
    /^bayar\s+tagihan\b.*\b(cc|credit card|kartu kredit|tokopedia cc|tokopedia card)\b/i.test(t)
  );
}

function isBorrowInText_(text) {
  const t = String(text || '').toLowerCase();

  return (
    /\b(pinjam|dipinjamkan|minjem|hutang ke saya|utang ke saya|dipinjami)\b/i.test(t) ||
    /\b(dapat|terima)\s+(pinjaman|hutang|utang)\b/i.test(t)
  ) && !isDebtPaymentText_(t);
}

function isClearDebtBorrowIntentForDirectHutang_(rawText, parsed) {
  const text = String(rawText || '');
  if (!isBorrowInText_(text)) return false;
  if (isDebtPaymentText_(text)) return false;

  const amount = Number(parsed && parsed.amount ? parsed.amount : 0);
  if (!amount || amount <= 0) return false;

  const person = parseDebtPerson_(rawText) || (parsed && parsed.creditor) || parseCreditor_(text);
  return Boolean(String(person || '').trim());
}

function isDebtPaymentText_(text) {
  const t = String(text || '').toLowerCase();

  return /\b(bayar|lunasi|nyicil|cicil)\b.*\b(hutang|utang|pinjaman)\b/i.test(t);
}

function ensureDropdownAcceptsCurrentValues_(sheet, targetRow, startCol, headers, data) {
  if (!sheet || !headers || !data) return;

  headers.forEach((h, idx) => {
    const field = fieldForHeader_(h);

    // Only extend controlled semantic fields.
    // This prevents category/type like Gaji, CC Payment, debt_in from being blanked.
    if (!['category', 'type'].includes(field)) return;

    const value = data[field];
    if (value === '' || value === null || typeof value === 'undefined') return;

    const cell = sheet.getRange(targetRow, startCol + idx);
    const validation = cell.getDataValidation();

    if (!validation) return;

    const criteriaType = validation.getCriteriaType();
    const criteriaValues = validation.getCriteriaValues();
    const current = String(value);

    if (criteriaType === SpreadsheetApp.DataValidationCriteria.VALUE_IN_LIST) {
      const allowed = (criteriaValues[0] || [])
        .map(v => String(v))
        .filter(Boolean);

      const allowedLower = allowed.map(v => v.toLowerCase());

      if (!allowedLower.includes(current.toLowerCase())) {
        allowed.push(current);

        const rule = SpreadsheetApp
          .newDataValidation()
          .requireValueInList(allowed, true)
          .setAllowInvalid(false)
          .build();

        cell.setDataValidation(rule);
      }

      return;
    }

    if (criteriaType === SpreadsheetApp.DataValidationCriteria.VALUE_IN_RANGE) {
      try {
        const allowedRange = criteriaValues[0];
        const allowedValues = allowedRange
          .getValues()
          .flat()
          .map(v => String(v))
          .filter(Boolean);

        const allowedLower = allowedValues.map(v => v.toLowerCase());

        if (allowedLower.includes(current.toLowerCase())) {
          return;
        }

        const values = allowedRange.getValues();

        for (let r = 0; r < values.length; r++) {
          for (let c = 0; c < values[r].length; c++) {
            if (!String(values[r][c] || '').trim()) {
              allowedRange.getCell(r + 1, c + 1).setValue(current);
              return;
            }
          }
        }
      } catch (err) {
        // Do not block write if dropdown source range cannot be updated.
      }
    }
  });
}

function isCreditCardPurchaseText_(text) {
  const t = String(text || '').toLowerCase().trim();

  if (isCreditCardPaymentText_(t)) return false;
  if (isCreditCardRefundText_(t)) return false;

  return (
    /^cc\s+(beli|bayar)\b/i.test(t) ||
    /\b(tokopedia\s*cc|tokopedia\s*card|credit\s*card|kartu\s*kredit)\b.*\b(beli|bayar)\b/i.test(t) ||
    /\bcc\b.*\b(beli|bayar)\b/i.test(t)
  );
}

function isCreditCardRefundText_(text) {
  return /\b(refund|pengembalian|dikembalikan|retur)\b.*\b(cc|credit card|kartu kredit|tokopedia cc|tokopedia card)\b/i
    .test(String(text || '').toLowerCase());
}

function isDirtyCcLogText_(rawText) {
  const text = String(rawText || '').trim();

  // 1. admin command
  if (/^admin\s+(find|cari|cleanup|void|clear|reset|fix|rapikan|audit|check|cek)\b/i.test(text)) {
    return true;
  }

  // 2. baris transcript WhatsApp/Telegram
  if (/^\[\d{2}\/\d{2}\/\d{4},?\s+\d{2}:\d{2}(?::\d{2})?\]/m.test(text)) {
    return true;
  }
  if (/^\[\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}(?::\d{2})?\]/m.test(text)) {
    return true;
  }

  // 3. specific names/prefixes often found in logs
  if (/Airo Finance:/i.test(text)) {
    return true;
  }
  if (/Egit Aristo Randas:/i.test(text)) {
    return true;
  }

  // 4. multiline transcript with multiple timestamps/dates
  const lines = text.split('\n');
  let dateTimestampCount = 0;
  for (let i = 0; i < lines.length; i++) {
    if (/\b\d{2}\/\d{2}\/\d{4}\b/.test(lines[i]) || /\b\d{2}:\d{2}\b/.test(lines[i])) {
      dateTimestampCount++;
    }
  }
  if (lines.length > 2 && dateTimestampCount >= 2) {
    return true;
  }

  return false;
}

function writeCreditCardSafely_(ss, parsed, rawText, common) {
  const tabName = AIRO_CONFIG.tabs.creditCard;
  const sheet = getSheetLoose_(ss, tabName);

  if (!sheet) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'review',
      issue_reason: 'credit_card_tab_missing'
    }, { createIfMissing: false });
  }

  const text = String(rawText || '').toLowerCase();

  // Guard against admin commands/transcripts/logs leaking into CC
  if (isDirtyCcLogText_(rawText)) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'pending',
      issue_reason: 'cc_blocked_dirty_log_transcript'
    }, { createIfMissing: false });
  }

  // Refund CC is intentionally not auto-written yet to avoid corrupting CC totals.
  if (isCreditCardRefundText_(text)) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      category: 'CC Refund',
      status: 'pending',
      issue_reason: 'cc_refund_needs_manual_review'
    }, { createIfMissing: false });
  }

  if (isCreditCardPaymentText_(text)) {
    return markCreditCardPocketBluTransfer_(ss, sheet, parsed, rawText, common);
  }

  return appendCreditCardPurchase_(ss, sheet, parsed, rawText, common);
}

function writeHutangSafely_(ss, parsed, rawText, common) {
  const tabName = AIRO_CONFIG.tabs.hutang;
  const sheet = getSheetLoose_(ss, tabName);

  if (!sheet) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'pending',
      issue_reason: 'hutang_tab_missing'
    }, { createIfMissing: false });
  }

  const text = String(rawText || '').toLowerCase();

  // "mamak bayar hutang ke saya" is receivable/piutang, not current personal debt payment.
  if (/\bbayar\b.*\b(hutang|utang)\b.*\bke saya\b/i.test(text)) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      category: 'Piutang',
      status: 'pending',
      issue_reason: 'orang_bayar_hutang_ke_saya_needs_piutang_flow'
    }, { createIfMissing: false });
  }

  if (isDebtPaymentText_(text)) {
    return appendDebtPaymentAndUpdateMaster_(ss, sheet, parsed, rawText, common);
  }

  if (isBorrowInText_(text)) {
    return appendDebtIncreaseAndUpdateMaster_(ss, sheet, parsed, rawText, common);
  }

  return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
    ...common,
    status: 'pending',
    issue_reason: 'hutang_intent_unclear'
  }, { createIfMissing: false });
}

function stripQaTag_(text) {
  return String(text || '')
    .replace(/\bQA_[A-Z0-9_]+\b/gi, '')
    .trim();
}

function extractHumanAmountFromText_(text) {
  const t = String(text || '').toLowerCase();
  const re = /(\d+(?:[.,]\d+)?)\s*(jt|juta|rb|ribu|k)?/gi;
  let m;
  let best = 0;

  while ((m = re.exec(t)) !== null) {
    const n = Number(String(m[1]).replace(',', '.'));
    const unit = String(m[2] || '').toLowerCase();

    if (!n) continue;

    let value = n;
    if (unit === 'jt' || unit === 'juta') value = n * 1000000;
    else if (unit === 'rb' || unit === 'ribu' || unit === 'k') value = n * 1000;

    value = Math.round(value);

    // Skip obvious years unless unit is present.
    if (!unit && value >= 1900 && value <= 2200) continue;

    if (value > best) best = value;
  }

  return best;
}

function amountForIntent_(parsed, rawText) {
  const parsedAmount = Number(parsed && parsed.amount ? parsed.amount : 0);
  if (parsedAmount > 0) return parsedAmount;

  const human = extractHumanAmountFromText_(rawText);
  if (human > 0) return human;

  return 0;
}

function todayDate_() {
  return new Date();
}

function ccBillingCycle_(dateObj) {
  const d = dateObj instanceof Date ? dateObj : new Date();
  const y = d.getFullYear();
  const m = d.getMonth();
  const day = d.getDate();

  let start;
  let end;
  let cycleYear;
  let cycleMonth;

  if (day >= 16) {
    start = new Date(y, m, 16);
    end = new Date(y, m + 1, 15);
    cycleYear = end.getFullYear();
    cycleMonth = end.getMonth() + 1;
  } else {
    start = new Date(y, m - 1, 16);
    end = new Date(y, m, 15);
    cycleYear = end.getFullYear();
    cycleMonth = end.getMonth() + 1;
  }

  const cycleId = 'TOKPED_CC_' + cycleYear + '-' + String(cycleMonth).padStart(2, '0');

  return {
    id: cycleId,
    start,
    end,
    statementMonth: new Date(cycleYear, cycleMonth - 1, 1)
  };
}

function parseCcMerchant_(text) {
  let t = stripQaTag_(text).toLowerCase();

  if (/\bpdam\b/i.test(t)) return 'PDAM';
  if (/\bpln|listrik\b/i.test(t)) return 'PLN';
  if (/\bshopee\b/i.test(t)) return 'Shopee';
  if (/\btiktok\s*shop|tiktokshop\b/i.test(t)) return 'TikTok Shop';
  if (/\bgrabcar|grab\b/i.test(t)) return 'Grab';
  if (/\bgojek|gocar|goride\b/i.test(t)) return 'Gojek';
  if (/\btokopedia\b/i.test(t)) return 'Tokopedia';

  t = t
    .replace(/^cc\s+(beli|bayar|pesan)\s+/i, '')
    .replace(/\btokopedia\s+cc\b/gi, '')
    .replace(/\bcc\b/gi, '')
    .replace(/\bharga\b/gi, '')
    .replace(/\bhari ini\b/gi, '')
    .replace(/\bkemarin\b/gi, '')
    .replace(/\bbesok\b/gi, '')
    .replace(/\btgl\s+\d{1,2}\s+[a-z]+(?:\s+\d{4})?\b/gi, '')
    .replace(/\btanggal\s+\d{1,2}\s+[a-z]+(?:\s+\d{4})?\b/gi, '')
    .replace(/\d+(?:[.,]\d+)?\s*(jt|juta|rb|ribu|k)?/gi, '')
    .replace(/\s+/g, ' ')
    .trim();

  if (!t) return 'CC';

  const words = t.split(/\s+/).filter(Boolean).slice(0, 3);
  return titleCaseSimple_(words.join(' '));
}

function parseCcItemKeyword_(text) {
  let t = stripQaTag_(text).toLowerCase();

  t = t
    .replace(/^bayar\s+tagihan\s+/i, '')
    .replace(/^bayar\s+cc\s+/i, '')
    .replace(/^cc\s+(beli|bayar)\s+/i, '')
    .replace(/\btokopedia\s+cc\b/gi, '')
    .replace(/\bcc\b/gi, '')
    .replace(/\bhari ini\b/gi, '')
    .replace(/\bkemarin\b/gi, '')
    .replace(/\bbesok\b/gi, '')
    .replace(/\bdari\s+(blu|blu bca|bca|cash)\b/gi, '')
    .replace(/\bharga\b/gi, '')
    .replace(/\d+(?:[.,]\d+)?\s*(jt|juta|rb|ribu|k)?/gi, '')
    .replace(/\s+/g, ' ')
    .trim();

  return t || 'cc_payment';
}

function findCcHeaderRow_(sheet) {
  const maxRows = Math.min(sheet.getLastRow(), 20);
  const maxCols = Math.min(sheet.getLastColumn(), 15);
  const values = sheet.getRange(1, 1, maxRows, maxCols).getValues();

  for (let r = 0; r < values.length; r++) {
    const normalized = values[r].map(v => canonicalKey_(v));
    if (
      normalized.includes('cc_entry_id') &&
      normalized.includes('amount') &&
      normalized.includes('status_pocket_blu')
    ) {
      return {
        row: r + 1,
        headers: values[r].map(v => String(v || '').trim())
      };
    }
  }

  return null;
}

function ccColMap_(headers) {
  const map = {};
  headers.forEach((h, i) => {
    map[canonicalKey_(h)] = i + 1;
  });
  return map;
}

function appendCreditCardPurchase_(ss, sheet, parsed, rawText, common) {
  const header = findCcHeaderRow_(sheet);

  if (!header) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'pending',
      issue_reason: 'cc_header_not_found'
    }, { createIfMissing: false });
  }

  const amount = Number(parsed && parsed.amount ? parsed.amount : 0) || amountForIntent_(parsed, rawText);
  const date = parseCcDateFromText_(rawText, todayDate_());
  const cycle = ccBillingCycle_(date);
  const targetRow = findNextSectionRow_(sheet, header.row, 1, header.headers.length);

  const data = {
    cc_entry_id: common.linked_txn_id || makeTxnId_({}, rawText),
    date,
    merchant_app: parseCcMerchant_(rawText),
    amount,
    status_pocket_blu: '⏳ Belum',
    description: stripQaTag_(rawText),
    transferred_at: '',
    linked_txn_id: common.linked_txn_id || makeTxnId_({}, rawText),
    notes: 'cc_purchase',
    billing_cycle_id: cycle.id,
    billing_start: cycle.start,
    billing_end: cycle.end,
    statement_month: cycle.statementMonth
  };

  const row = header.headers.map(h => {
    const k = canonicalKey_(h);
    return data[k] !== undefined ? data[k] : '';
  });

  sheet.getRange(targetRow, 1, 1, row.length).setValues([row]);

  return {
    status: 'written',
    writtenTab: sheet.getName(),
    row: targetRow,
    rowId: sheet.getName() + ':' + targetRow,
    tabUrl: getSheetTabUrl_(ss, sheet)
  };
}

function markCreditCardPocketBluTransfer_(ss, sheet, parsed, rawText, common) {
  const header = findCcHeaderRow_(sheet);

  if (!header) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'pending',
      issue_reason: 'cc_header_not_found'
    }, { createIfMissing: false });
  }

  const map = ccColMap_(header.headers);
  const amountCol = map.amount;
  const statusCol = map.status_pocket_blu;
  const transferredCol = map.transferred_at;
  const descCol = map.description;
  const notesCol = map.notes;

  const amount = Number(parsed && parsed.amount ? parsed.amount : 0) || amountForIntent_(parsed, rawText);
  const keyword = parseCcItemKeyword_(rawText);

  if (!amount || !amountCol || !statusCol || !descCol) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'pending',
      issue_reason: 'cc_payment_amount_or_columns_missing'
    }, { createIfMissing: false });
  }

  const lastRow = sheet.getLastRow();
  const width = Math.max(...[amountCol, statusCol, transferredCol || 1, descCol, notesCol || 1]);
  const rows = sheet.getRange(header.row + 1, 1, Math.max(1, lastRow - header.row), width).getValues();

  let bestRow = 0;

  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    const rowAmount = Number(row[amountCol - 1] || 0);
    const rowStatus = String(row[statusCol - 1] || '').toLowerCase();
    const rowDesc = String(row[descCol - 1] || '').toLowerCase();

    if (rowAmount !== amount) continue;
    if (
      rowStatus === 'posted' ||
      rowStatus === 'paid' ||
      rowStatus === 'transferred' ||
      rowStatus.includes('sudah')
    ) continue;

    const words = keyword.split(/\s+/).filter(w => w.length >= 3);
    const keywordMatch = !words.length || words.some(w => rowDesc.includes(w));

    if (keywordMatch) {
      bestRow = header.row + 1 + i;
      break;
    }
  }

  if (!bestRow) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      category: 'CC Payment',
      status: 'pending',
      issue_reason: 'cc_payment_no_matching_pending_purchase'
    }, { createIfMissing: false });
  }

  const accountParsed = Object.assign({}, parsed, {
    type: 'cc_payment',
    category: parsed.category || 'Credit Card Payment',
    account: parsed.account || 'Blu',
    amount: amount
  });
  const accountCommon = Object.assign({}, common, {
    linked_txn_id: common.linked_txn_id || makeTxnId_({}, rawText)
  });
  const accountLedgerResult = writeAccountLedgerMirror_(ss, accountParsed, rawText, accountCommon, AIRO_CONFIG.tabs.creditCard);

  sheet.getRange(bestRow, statusCol).setValue('✅ Sudah');

  if (transferredCol) {
    sheet.getRange(bestRow, transferredCol).setValue(todayDate_());
  }

  if (notesCol) {
    const oldNotes = String(sheet.getRange(bestRow, notesCol).getValue() || '');
    const newNotes = [
      oldNotes,
      'pocket_blu_transfer: ' + stripQaTag_(rawText)
    ].filter(Boolean).join(' | ');

    sheet.getRange(bestRow, notesCol).setValue(newNotes);
  }

  return {
    status: 'written',
    writtenTab: sheet.getName(),
    row: bestRow,
    rowId: sheet.getName() + ':' + bestRow,
    account_ledger_result: accountLedgerResult || null,
    tabUrl: getSheetTabUrl_(ss, sheet)
  };
}

function findHutangMasterHeader_(sheet) {
  const maxRows = Math.min(sheet.getLastRow(), 15);
  const maxCols = Math.min(sheet.getLastColumn(), 10);
  const values = sheet.getRange(1, 1, maxRows, maxCols).getValues();

  for (let r = 0; r < values.length; r++) {
    const normalized = values[r].map(v => canonicalKey_(v));
    if (
      normalized.includes('hutang_id') &&
      normalized.includes('nama') &&
      normalized.includes('jumlah_pokok') &&
      normalized.includes('total_dibayar')
    ) {
      return {
        row: r + 1,
        headers: values[r].map(v => String(v || '').trim())
      };
    }
  }

  return null;
}

function findHutangPaymentHeader_(sheet) {
  const maxRows = Math.min(sheet.getLastRow(), 20);
  const maxCols = Math.min(sheet.getLastColumn(), 10);
  const values = sheet.getRange(1, 1, maxRows, maxCols).getValues();

  for (let r = 0; r < values.length; r++) {
    const normalized = values[r].map(v => canonicalKey_(v));
    if (
      normalized.includes('pay_id') &&
      normalized.includes('hutang_id') &&
      normalized.includes('nama') &&
      normalized.includes('amount')
    ) {
      return {
        row: r + 1,
        headers: values[r].map(v => String(v || '').trim())
      };
    }
  }

  return null;
}

function hutangColMap_(headers) {
  const map = {};
  headers.forEach((h, i) => {
    map[canonicalKey_(h)] = i + 1;
  });
  return map;
}

function normalizePersonName_(value) {
  return String(value || '')
    .toLowerCase()
    .replace(/\bQA_[A-Z0-9_]+\b/gi, '')
    .replace(/\b(hari ini|kemarin|besok)\b/gi, '')
    .replace(/\d+(?:[.,]\d+)?\s*(jt|juta|rb|ribu|k)?/gi, '')
    .replace(/[^a-z0-9 ]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function cleanDebtPersonName_(value) {
  // AIRO_HUTANG_CLEAN_DEBT_PERSON_ALIAS_V1
  // Compatibility alias for parseCreditor_ after Hutang direct routing patch.
  return normalizePersonName_(value);
}

function parseDebtPerson_(rawText) {
  const text = stripQaTag_(rawText).toLowerCase();

  let m = text.match(/\bbayar\s+(?:hutang|utang)\s+ke\s+(.+?)\s+\d/i);
  if (m) return normalizePersonName_(m[1]);

  m = text.match(/\bpinjam\s+(?:uang\s+)?dari\s+(.+?)\s+\d/i);
  if (m) return normalizePersonName_(m[1]);

  return '';
}

function findDebtMasterRowByName_(sheet, masterHeader, person) {
  const map = hutangColMap_(masterHeader.headers);
  const namaCol = map.nama;
  if (!namaCol) return null;

  const lastRow = Math.min(sheet.getLastRow(), 9);
  const values = sheet.getRange(masterHeader.row + 1, 1, Math.max(1, lastRow - masterHeader.row), masterHeader.headers.length).getValues();
  const wanted = normalizePersonName_(person);

  for (let i = 0; i < values.length; i++) {
    const rowName = normalizePersonName_(values[i][namaCol - 1]);

    if (!rowName) continue;

    if (rowName === wanted || rowName.includes(wanted) || wanted.includes(rowName)) {
      return {
        row: masterHeader.row + 1 + i,
        values: values[i],
        map
      };
    }
  }

  return null;
}

function titleDebtPersonName_(value) {
  const cleaned = normalizePersonName_(value);
  if (!cleaned) return '';

  return cleaned
    .split(/\s+/)
    .filter(Boolean)
    .map(function(part) {
      return part.charAt(0).toUpperCase() + part.slice(1);
    })
    .join(' ');
}

function findNextHutangMasterBlankRow_(sheet, masterHeader, paymentHeader) {
  // AIRO_HUTANG_AUTO_CREATE_MASTER_V1
  // Keep master writes inside the master section, above the payment/log header.
  const startRow = masterHeader.row + 1;
  const endRow = paymentHeader && paymentHeader.row
    ? Math.max(startRow, paymentHeader.row - 1)
    : Math.max(startRow, sheet.getLastRow() + 1);

  const width = Math.max(1, masterHeader.headers.length);
  const height = Math.max(1, endRow - startRow + 1);
  const values = sheet.getRange(startRow, 1, height, width).getValues();

  for (let i = 0; i < values.length; i++) {
    const hasAnyValue = values[i].some(function(v) {
      return String(v || '').trim() !== '';
    });

    if (!hasAnyValue) return startRow + i;
  }

  return 0;
}

function appendDebtMasterRow_(sheet, masterHeader, paymentHeader, person, amount, rawText, common) {
  // AIRO_HUTANG_AUTO_CREATE_MASTER_V1
  // Borrow/debt increase from a new person should create a Hutang master row,
  // not fall back to Review Queue.
  const targetRow = findNextHutangMasterBlankRow_(sheet, masterHeader, paymentHeader);
  if (!targetRow) {
    return {
      status: 'fallback',
      reason: 'hutang_master_no_blank_row'
    };
  }

  const normalizedPerson = normalizePersonName_(person);
  const displayName = titleDebtPersonName_(normalizedPerson) || String(person || '').trim();
  const hutangId = 'debt_' + String(common && common.linked_txn_id ? common.linked_txn_id : makeTxnId_({}, rawText));
  const notes = 'debt_auto_created: ' + stripQaTag_(rawText);

  const data = {
    hutang_id: hutangId,
    nama: displayName,
    creditor: displayName,
    jumlah_pokok: amount,
    total_dibayar: 0,
    sisa_hutang: amount,
    status: 'aktif',
    date: todayDate_(),
    tanggal: todayDate_(),
    created_at: new Date(),
    description: stripQaTag_(rawText),
    raw_text: rawText,
    notes: notes,
    catatan: notes,
    amount: amount,
    nominal: amount
  };

  let row = masterHeader.headers.map(function(h) {
    const key = canonicalKey_(h);
    return data[key] !== undefined ? data[key] : '';
  });

  row = sanitizeValuesForValidation_(sheet, targetRow, 1, row, data);
  sheet.getRange(targetRow, 1, 1, row.length).setValues([row]);

  return {
    status: 'written',
    row: targetRow,
    hutangId: hutangId,
    nama: displayName
  };
}

function appendDebtPaymentAndUpdateMaster_(ss, sheet, parsed, rawText, common) {
  const masterHeader = findHutangMasterHeader_(sheet);
  const paymentHeader = findHutangPaymentHeader_(sheet);

  if (!masterHeader || !paymentHeader) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'pending',
      issue_reason: 'hutang_header_missing'
    }, { createIfMissing: false });
  }

  const person = parseDebtPerson_(rawText);
  const amount = Number(parsed && parsed.amount ? parsed.amount : 0) || amountForIntent_(parsed, rawText);

  if (!person || !amount) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'pending',
      issue_reason: 'hutang_payment_person_or_amount_missing'
    }, { createIfMissing: false });
  }

  const master = findDebtMasterRowByName_(sheet, masterHeader, person);

  if (!master) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'pending',
      issue_reason: 'hutang_person_not_found_in_master'
    }, { createIfMissing: false });
  }

  const map = master.map;
  const hutangId = map.hutang_id ? sheet.getRange(master.row, map.hutang_id).getValue() : '';
  const nama = map.nama ? sheet.getRange(master.row, map.nama).getValue() : person;
  const pokok = map.jumlah_pokok ? Number(sheet.getRange(master.row, map.jumlah_pokok).getValue() || 0) : 0;
  const oldPaid = map.total_dibayar ? Number(sheet.getRange(master.row, map.total_dibayar).getValue() || 0) : 0;
  const newPaid = oldPaid + amount;
  const sisa = Math.max(0, pokok - newPaid);

  if (map.total_dibayar) sheet.getRange(master.row, map.total_dibayar).setValue(newPaid);
  if (map.sisa_hutang) sheet.getRange(master.row, map.sisa_hutang).setValue(sisa);
  if (map.status) sheet.getRange(master.row, map.status).setValue(sisa <= 0 ? 'lunas' : 'aktif');

  appendDebtPaymentLog_(sheet, paymentHeader, {
    pay_id: common.linked_txn_id || makeTxnId_({}, rawText),
    hutang_id: hutangId,
    nama,
    date: todayDate_(),
    amount,
    sisa_setelah: sisa,
    source: parsed.account && parsed.account !== 'Unknown' ? parsed.account : '',
    notes: stripQaTag_(rawText)
  });

  const accountParsed = Object.assign({}, parsed, {
    type: 'debt_payment',
    category: parsed.category || 'Hutang',
    account: parsed.account || 'Unknown',
    amount: parsed.amount || amountForIntent_(parsed, rawText)
  });
  const accountCommon = Object.assign({}, common, {
    linked_txn_id: common.linked_txn_id || makeTxnId_({}, rawText)
  });
  writeAccountLedgerMirror_(ss, accountParsed, rawText, accountCommon, AIRO_CONFIG.tabs.hutang);

  return {
    status: 'written',
    writtenTab: sheet.getName(),
    row: master.row,
    rowId: sheet.getName() + ':' + master.row,
    tabUrl: getSheetTabUrl_(ss, sheet)
  };
}

function appendDebtIncreaseAndUpdateMaster_(ss, sheet, parsed, rawText, common) {
  const masterHeader = findHutangMasterHeader_(sheet);
  const paymentHeader = findHutangPaymentHeader_(sheet);

  if (!masterHeader || !paymentHeader) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'pending',
      issue_reason: 'hutang_header_missing'
    }, { createIfMissing: false });
  }

  const person = parseDebtPerson_(rawText);
  const amount = Number(parsed && parsed.amount ? parsed.amount : 0) || amountForIntent_(parsed, rawText);

  if (!person || !amount) {
    return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
      ...common,
      status: 'pending',
      issue_reason: 'hutang_increase_person_or_amount_missing'
    }, { createIfMissing: false });
  }

  const master = findDebtMasterRowByName_(sheet, masterHeader, person);

  if (!master) {
    const created = appendDebtMasterRow_(sheet, masterHeader, paymentHeader, person, amount, rawText, common);

    if (!created || created.status !== 'written') {
      return appendByHeader_(ss, AIRO_CONFIG.tabs.review, {
        ...common,
        status: 'pending',
        issue_reason: created && created.reason ? created.reason : 'hutang_person_not_found_in_master'
      }, { createIfMissing: false });
    }

    appendDebtPaymentLog_(sheet, paymentHeader, {
      pay_id: common.linked_txn_id || makeTxnId_({}, rawText),
      hutang_id: created.hutangId,
      nama: created.nama || person,
      date: todayDate_(),
      amount,
      sisa_setelah: amount,
      source: parsed.account && parsed.account !== 'Unknown' ? parsed.account : '',
      notes: 'debt_increase: ' + stripQaTag_(rawText)
    });

    return {
      status: 'written',
      writtenTab: sheet.getName(),
      row: created.row,
      rowId: sheet.getName() + ':' + created.row,
      tabUrl: getSheetTabUrl_(ss, sheet)
    };
  }

  const map = master.map;
  const oldPokok = map.jumlah_pokok ? Number(sheet.getRange(master.row, map.jumlah_pokok).getValue() || 0) : 0;
  const paid = map.total_dibayar ? Number(sheet.getRange(master.row, map.total_dibayar).getValue() || 0) : 0;
  const newPokok = oldPokok + amount;
  const sisa = Math.max(0, newPokok - paid);

  if (map.jumlah_pokok) sheet.getRange(master.row, map.jumlah_pokok).setValue(newPokok);
  if (map.sisa_hutang) sheet.getRange(master.row, map.sisa_hutang).setValue(sisa);
  if (map.status) sheet.getRange(master.row, map.status).setValue(sisa <= 0 ? 'lunas' : 'aktif');

  appendDebtPaymentLog_(sheet, paymentHeader, {
    pay_id: common.linked_txn_id || makeTxnId_({}, rawText),
    hutang_id: map.hutang_id ? sheet.getRange(master.row, map.hutang_id).getValue() : '',
