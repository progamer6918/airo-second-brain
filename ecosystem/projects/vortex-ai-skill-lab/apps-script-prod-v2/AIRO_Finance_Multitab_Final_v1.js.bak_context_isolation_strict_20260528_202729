function setupCreditCardTabCycleHeader_() {
  const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
  const cc =
    getSheetLoose_(ss, AIRO_CONFIG.tabs.creditCard) ||
    getSheetLoose_(ss, 'Credit Card');

  if (!cc) return { ok: false, reason: 'credit_card_sheet_missing' };

  let header = findCcHeaderRow_(cc);
  if (!header) return { ok: false, reason: 'cc_header_missing' };

  // Stacked layout needs the real transaction table header to start at row 8.
  // If the header is still in the old row 3 layout, move it down once.
  if (header.row < 8) {
    cc.insertRowsBefore(header.row, 8 - header.row);
    header = findCcHeaderRow_(cc);
  }

  const map = ccColMap_(header.headers);
  const required = ['amount', 'status_pocket_blu', 'billing_cycle_id'];
  for (let i = 0; i < required.length; i++) {
    if (!map[required[i]]) return { ok: false, reason: 'cc_column_missing_' + required[i] };
  }

  ensureSheetSize_(cc, Math.max(cc.getMaxRows(), 20), 14);
  safeClearRange_(cc, 'A1:N6');

  const currentCycle = ccBillingCycle_(todayDate_());
  const payableDate = new Date(currentCycle.start);
  payableDate.setDate(payableDate.getDate() - 1);
  const payableCycle = ccBillingCycle_(payableDate);
  const payableDueDate = ccDueDateForCycle_(payableCycle);

  const amountFromDisplay_ = function(value) {
    let s = String(value || '').replace(/\s+/g, '').replace(/[^0-9,.-]/g, '');
    if (!s) return 0;
    if (s.indexOf(',') >= 0 && s.indexOf('.') >= 0) {
      s = s.replace(/\./g, '').replace(',', '.');
    } else {
      s = s.replace(/[.,]/g, '');
    }
    return Number(s) || 0;
  };

  const stats = {
    payable_total: 0,
    payable_belum_blu: 0,
    payable_sudah_blu: 0,
    payable_rows: 0,
    unbilled_total: 0,
    unbilled_belum_blu: 0,
    unbilled_sudah_blu: 0,
    unbilled_rows: 0
  };

  const lastRow = cc.getLastRow();
  const lastCol = cc.getLastColumn();

  if (lastRow > header.row) {
    const rows = cc.getRange(header.row + 1, 1, lastRow - header.row, lastCol).getDisplayValues();

    rows.forEach(function(row) {
      const amount = amountFromDisplay_(row[map.amount - 1]);
      const status = String(row[map.status_pocket_blu - 1] || '').toLowerCase();
      const cycleId = String(row[map.billing_cycle_id - 1] || '').trim();

