        write_performed: false,
        result: airoSprint5ReconResult_
      };
    } catch (airoSprint5ReconErr_) {
      sendTelegram_(
        chatId,
        'Sprint 5 reconciliation audit error.\n\n' +
        String(airoSprint5ReconErr_ && airoSprint5ReconErr_.message ? airoSprint5ReconErr_.message : airoSprint5ReconErr_)
      );
      return {
        handled: true,
        command: 'sprint5_reconciliation_read_only',
        ok: false,
        error: String(airoSprint5ReconErr_ && airoSprint5ReconErr_.message ? airoSprint5ReconErr_.message : airoSprint5ReconErr_)
      };
    }
  }

  // AIRO_ADMIN_FIND_SMOKE_COMMAND_V1
  const airoAdminFindRawText_ = String(rawText || '').trim();
  const airoAdminFindMatch_ = airoAdminFindRawText_.match(/^admin\s+(find|cari)\s+(smoke|text)\s+(.+)$/i);
  if (airoAdminFindMatch_) {
    const airoAdminFindQuery_ = String(airoAdminFindMatch_[3] || '').trim();

    try {
      const airoAdminFindSs_ = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
      const airoAdminFindResult_ = airoFindSmokeAcrossWorkbook_(airoAdminFindSs_, airoAdminFindQuery_, 5);
      sendTelegram_(chatId, airoBuildFindSmokeReply_(airoAdminFindResult_));
    } catch (airoAdminFindErr_) {
      sendTelegram_(
        chatId,
        'Admin readback error.\n\n' +
        String(airoAdminFindErr_ && airoAdminFindErr_.message ? airoAdminFindErr_.message : airoAdminFindErr_)
      );
    }

    return true;
  }

  const text = String(rawText || '').toLowerCase().trim();

  if (/^admin\s+(cleanup|void)\s+cc\s+dirty/i.test(text)) {
    try {
      const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
      const sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.creditCard);
      if (!sheet) {
        sendTelegram_(chatId, 'Admin CC cleanup gagal: sheet Credit Card tidak ditemukan.');
        return { handled: true, ok: false, command: 'cleanup_cc_dirty', reason: 'cc_sheet_missing' };
      }
      const header = findCcHeaderRow_(sheet);
      if (!header) {
        sendTelegram_(chatId, 'Admin CC cleanup gagal: header row tidak ditemukan.');
        return { handled: true, ok: false, command: 'cleanup_cc_dirty', reason: 'cc_header_missing' };
      }
      const map = ccColMap_(header.headers);
      const statusCol = map.status_pocket_blu;
      const notesCol = map.notes;

      if (!statusCol || !notesCol) {
        sendTelegram_(chatId, 'Admin CC cleanup gagal: kolom status/notes tidak ditemukan.');
        return { handled: true, ok: false, command: 'cleanup_cc_dirty', reason: 'cc_required_columns_missing' };
      }

      const updates = [
        { row: 20, status: 'void', notes: 'voided_test_dirty_wrong_amount' },
        { row: 21, status: 'void', notes: 'voided_admin_transcript_dirty_write' },
        { row: 22, status: 'void', notes: 'voided_test_dirty_wrong_amount' }
      ];

      updates.forEach(u => {
        if (u.row <= sheet.getLastRow()) {
          sheet.getRange(u.row, statusCol).setValue(u.status);
          sheet.getRange(u.row, notesCol).setValue(u.notes);
        }
      });

      sendTelegram_(chatId, '✅ Cleanup CC dirty rows 20, 21, 22 selesai dilakukan (di-void & diberi notes).');
      return {
        handled: true,
        ok: true,
        command: 'cleanup_cc_dirty'
      };
    } catch (err) {
      sendTelegram_(chatId, 'Admin CC cleanup error: ' + String(err.message || err));
      return { handled: true, ok: false, command: 'cleanup_cc_dirty', error: String(err.message || err) };
    }
  }

  if (/^admin\s+(clear|reset|hapus)\s+(clarification|klarifikasi|pending\s+clarification|pending\s+klarifikasi)/i.test(text)) {
    clearPendingClarification_(chatId);

