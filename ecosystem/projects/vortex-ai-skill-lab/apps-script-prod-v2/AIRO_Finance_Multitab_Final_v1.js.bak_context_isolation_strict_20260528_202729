function normalizeTransferRouteClarificationAnswer_(text) {
  const t = String(text || '').toLowerCase().trim();

  if (/^(a|1)$/i.test(t)) return { source: 'BCA', target: 'Blu' };
  if (/^(b|2)$/i.test(t)) return { source: 'Blu', target: 'BCA' };
  if (/^(c|3)$/i.test(t)) return { source: 'BCA', target: 'Cash' };
  if (/^(d|4)$/i.test(t)) return { source: 'Cash', target: 'BCA' };
  if (/^(e|5)$/i.test(t) || /\b(lain|lainnya|manual)\b/i.test(t)) return null;

  const accountPattern = '(bca|blu|cash|tunai)';
  let m = t.match(new RegExp('(?:dari|from)\\s+' + accountPattern + '\\s+(?:ke|to)\\s+' + accountPattern, 'i'));
  if (!m) {
    m = t.match(new RegExp('\\b' + accountPattern + '\\s+' + accountPattern + '\\b', 'i'));
  }

  if (!m) return null;

  const normalizeAccount_ = function(v) {
    v = String(v || '').toLowerCase();
    if (v === 'bca') return 'BCA';
    if (v === 'blu') return 'Blu';
    if (v === 'cash' || v === 'tunai') return 'Cash';
    return '';
  };

  const source = normalizeAccount_(m[1]);
  const target = normalizeAccount_(m[2]);

  if (!source || !target || source === target) return null;

  return { source: source, target: target };
}

function canAskTransferIncompleteClarification_(parsed, rawText) {
  const text = String(rawText || '').toLowerCase();
  const amount = Number((parsed && parsed.amount) || 0);

  if (amount <= 0) return false;
  if (!/\b(transfer|tf|pindah)\b/i.test(text)) return false;

  const hasFrom = /\b(dari|from)\s+(bca|blu|cash|tunai)\b/i.test(text);
  const hasTo = /\b(ke|to)\s+(bca|blu|cash|tunai)\b/i.test(text);

  return !(hasFrom && hasTo);
}

function buildTransferIncompleteClarificationMessage_(parsed) {
  return (
    'Transfer Rp' + ((parsed && parsed.amount) || 0) + ' ini dari akun mana ke akun mana?\n\n' +
    'A. BCA → Blu\n' +
    'B. Blu → BCA\n' +
