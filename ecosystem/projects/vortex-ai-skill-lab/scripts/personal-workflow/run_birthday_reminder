#!/usr/bin/env bash
set -euo pipefail
umask 077
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PRIVATE_ROOT="${BIRTHDAY_PRIVATE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/airo-birthday-reminder}"
# Credentials are injected only by the dedicated service/approved runtime.
# No old PC paths, shell sourcing, personal CSV fallback, or response logging.
exec /usr/bin/python3 "$SCRIPT_DIR/birthday_reminder_simple.py" --private-root "$PRIVATE_ROOT" "$@"
