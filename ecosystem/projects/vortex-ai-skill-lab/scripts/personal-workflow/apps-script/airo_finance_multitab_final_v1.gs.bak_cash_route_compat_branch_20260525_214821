function tryHandlePendingClarificationReply_(chatId, rawText) {
  const pending = getPendingClarification_(chatId);
  if (!pending || !pending.type) return null;

  function failOrRetry_(message) {
    const attempts = Number(pending.attempts || 0) + 1;

    if (attempts >= 2) {
      clearPendingClarification_(chatId);
      sendClarificationFormatHelp_(chatId);

      const fallbackText = String(
        (pending && (pending.original_text || pending.rawText || pending.text)) ||
        rawText ||
        ''
      ).trim();

      const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
      const fallbackParsed = parseFinanceText_(fallbackText);
      const fallbackStaging = {
        rowId: makeTxnId_({}, fallbackText || ('clarification_failed_' + String(new Date().getTime())))
      };
      const fallbackResult = writeRouted_(
        ss,
        AIRO_CONFIG.tabs.review,
        fallbackParsed,
        fallbackText,
        fallbackStaging
      );

      return {
        handled: true,
        cancelled: true,
        fallback_to_review: true,
        status: 'review_queue_fallback_after_clarification_failed',
        clarification_type: pending.type,
        written_tab: fallbackResult.writtenTab || AIRO_CONFIG.tabs.review,
        row: fallbackResult.row || '',
        sprint0a_guard: 'review_queue_after_clarification_failed'
      };
    }

    savePendingClarification_(chatId, { ...pending, attempts });
    sendTelegram_(chatId, message);

    return {
      handled: true,
      waiting: true
    };
  }

  if (pending.type === 'missing_amount_account') {
    const answer = parseAmountAccountClarificationAnswer_(rawText);

    if (!answer.amount || !answer.account) {
      return failOrRetry_(
        'Saya butuh nominal dan akun sekaligus.\n\n' +
        'Contoh jawaban:\n' +
        '- 8000 BCA\n' +
        '- 8rb cash\n' +
        '- 12000 blu'
      );
    }

    clearPendingClarification_(chatId);

    return {
      handled: false,
      resolved: true,
      original_text: pending.original_text || '',
      resolved_text:
        String(pending.original_text || '').trim() +
        ' ' + String(answer.amount) +
        ' pakai ' + answer.account.toLowerCase(),
      account: answer.account
    };
  }

  if (pending.type === 'cc_ambiguous') {
    const resolvedText = creditCardClarificationResolvedText_(pending, rawText);

    if (resolvedText === 'CC_PURCHASE_NEEDS_DETAIL') {
      return failOrRetry_(
        'Saya butuh detail kategori/merchant untuk transaksi CC ini.\n\n' +
        'Contoh jawaban:\n' +
        '- A makan\n' +
        '- A pdam\n' +
        '- beli kopi\n' +
        '- belanja tokopedia'
      );
    }

    if (resolvedText === 'CC_PAYMENT_HELP_ONLY') {
      clearPendingClarification_(chatId);
      sendTelegram_(
        chatId,
        'Saya belum mencatat pembayaran tagihan CC ini karena perlu detail transaksi yang mau ditandai.\n\n' +
        'Tulis ulang lengkap, contoh:\n' +
        '- bayar cc 24000 dari blu untuk makan\n' +
        '- bayar cc 62000 dari blu untuk pdam\n\n' +
        'Catatan: jumlah dan kata kunci harus cocok dengan transaksi CC yang masih Belum ke Blu.'
      );

      return {
        handled: true,
        cancelled: true
      };
    }

    if (resolvedText === 'CC_ALLOCATION_HELP_ONLY') {
      clearPendingClarification_(chatId);
      sendTelegram_(
        chatId,
        'Saya belum mencatat alokasi Pocket Blu CC ini karena flow alokasi belum dikunci.\n\n' +
        'Untuk sementara gunakan format pembayaran yang cocok dengan transaksi CC, contoh:\n' +
        '- bayar cc 24000 dari blu untuk makan\n' +
        '- bayar cc 62000 dari blu untuk pdam'
      );

      return {
        handled: true,
        cancelled: true
      };
    }

    if (!resolvedText) {
      clearPendingClarification_(chatId);
      sendTelegram_(
        chatId,
        'Saya belum mencatat transaksi CC ini.\n\n' +
        'Tulis ulang lengkap, contoh:\n' +
        '- cc beli makan 24000\n' +
        '- bayar cc 24000 dari blu untuk makan\n' +
        '- alokasi 24000 ke pocket blu cc'
      );

      return {
        handled: true,
        cancelled: true
      };
    }

    clearPendingClarification_(chatId);

    return {
      handled: false,
      resolved: true,
      original_text: pending.original_text || '',
      resolved_text: resolvedText
    };
  }


  
  if (pending.type === 'asset_gold_ambiguous') {
    const choice = normalizeAssetGoldAmbiguousClarificationAnswer_(rawText);

    if (!choice) {
      sendTelegram_(chatId, buildAssetGoldAmbiguousClarificationMessage_(pending.parsed || pending || {}));
      return {
        ok: true,
        handled: true,
        status: 'pending_clarification',
        clarification_type: 'asset_gold_ambiguous'
      };
    }

    clearPendingClarification_(chatId);

    if (choice === 'ignore') {
      sendTelegram_(
        chatId,
        'Saya belum mencatat transaksi Aset/Emas ini.'
      );
      return {
        ok: true,
        handled: true,
        status: 'ignored',
        clarification_type: 'asset_gold_ambiguous'
      };
    }

    const clarifiedText = buildAssetGoldClarifiedText_(choice, pending.rawText || pending.original_text || pending.text || '');
    return { ok: true, handled: true, reprocessed: true, result: reprocessClarifiedTelegramText_(chatId, clarifiedText) };
  }

  if (pending.type === 'debt_ambiguous') {
    const resolvedText = debtAmbiguousClarificationResolvedText_(pending, rawText);

    if (resolvedText === 'DEBT_NEEDS_COMPLETE_REWRITE') {
      return failOrRetry_(
        'Saya butuh detail orang dan format lengkap untuk Hutang.\n\n' +
        'Contoh jawaban:\n' +
        '- pinjam dari Budi 50000\n' +
        '- bayar hutang ke Budi 50000 dari bca'
