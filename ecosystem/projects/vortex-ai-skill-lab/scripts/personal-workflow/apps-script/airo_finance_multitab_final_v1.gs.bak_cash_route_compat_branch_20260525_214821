    const cashRows = [];

    if (accountSheet && accountSheet.getLastRow() >= 2) {
      const width = Math.max(accountDateCol, accountCol, accountInCol, accountDescCol, accountSourceCol);
      const values = accountSheet.getRange(2, 1, accountSheet.getLastRow() - 1, width).getDisplayValues();
      values.forEach(function(row, idx) {
        const account = String(row[accountCol - 1] || '').trim().toLowerCase();
