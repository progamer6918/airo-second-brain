        'Saya belum bisa memastikan akunnya.\n\n' +
        'Pilih salah satu:\n' +
        'A. BCA\n' +
        'B. Blu\n' +
        'C. Cash\n' +
        'D. Credit Card\n' +
        'E. Lainnya / tulis manual'
      );
    }

    clearPendingClarification_(chatId);

    const originalText = String(pending.original_text || '').trim();
    const resolvedText = originalText + ' pakai ' + account.toLowerCase();

    return {
      handled: false,
      resolved: true,
      original_text: originalText,
      resolved_text: resolvedText,
      account: account
    };
  }

  clearPendingClarification_(chatId);
  return null;
}

function doPost(e) {
  try {
    const payload = parseIncoming_(e);
    const msg = payload.message || payload.edited_message || {};
    const chatId = msg.chat && msg.chat.id;
    const rawText = String(msg.text || '').trim();

    if (!chatId || !rawText) {
      return json_({ ok: true, skipped: true, reason: 'empty_message' });
    }

    const dedupeUpdate =
      (typeof update !== 'undefined' && update) ? update :
      (typeof payload !== 'undefined' && payload) ? payload :
      (typeof data !== 'undefined' && data) ? data :
      (typeof body !== 'undefined' && body) ? body :
      {};

    const dedupeMessage =
      (typeof message !== 'undefined' && message) ? message :
      (typeof msg !== 'undefined' && msg) ? msg :
      (dedupeUpdate && dedupeUpdate.message) ? dedupeUpdate.message :
      (dedupeUpdate && dedupeUpdate.edited_message) ? dedupeUpdate.edited_message :
      {};

    const dedupe = reserveTelegramUpdateOnce_(dedupeUpdate, dedupeMessage, rawText);
    if (dedupe && dedupe.duplicate) {
      return json_({
        ok: true,
        skipped: true,
        reason: 'duplicate_telegram_update',
        dedupe_key: dedupe.key
      });
    }

    const specialCommand = handleSpecialFinanceCommand_(rawText, chatId);
    if (specialCommand === true) {
      return json_({
        ok: true,
        handled: true,
        special_command: true
      });
    }
    if (specialCommand && specialCommand.handled) {
      return json_(specialCommand);
    }

const pendingClarification = tryHandlePendingClarificationReply_(chatId, rawText);
    if (pendingClarification && pendingClarification.handled) {
      return json_(pendingClarification);
    }

    const effectiveRawText =
      pendingClarification && pendingClarification.resolved
        ? pendingClarification.resolved_text
        : rawText;

    const parsed = parseFinanceText_(effectiveRawText);
    const plannedTab = routePlannedTab_(parsed, effectiveRawText);
    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));

    if (isSprint0ANonFinanceSafeReject_(effectiveRawText)) {
      sendClarificationFormatHelp_(chatId);
      return json_({
        ok: true,
        skipped: true,
        reason: 'non_finance_or_too_unclear',
        sprint0a_guard: 'safe_reject_non_finance'
      });
    }

    if (isClearlyNonFinanceOrTooUnclear_(parsed, effectiveRawText)) {
      sendClarificationFormatHelp_(chatId);
      return json_({
        ok: true,
        skipped: true,
        reason: 'non_finance_or_too_unclear'
      });
