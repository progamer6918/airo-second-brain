    asset.getRange('AB18').setValue(value);
    asset.getRange('AB18').setNumberFormat('0.00%');
    label = 'Haircut Rumah';
    handled = true;
  }

  if (!handled) {
    return { handled: false };
  }

  setupNetWorthMetrics();

  const link = getSheetTabUrl_(ss, dashboard);
  const displayValue = label === 'Haircut Rumah'
    ? Math.round(value * 10000) / 100 + '%'
