    if (canAskMissingAmountAccountClarification_(parsed, effectiveRawText)) {
      savePendingClarification_(chatId, {
        type: 'missing_amount_account',
        original_text: effectiveRawText,
        rawText: effectiveRawText,
        amount: parsed.amount,
        category: parsed.category,
        attempts: 0
      });

      sendTelegram_(chatId, buildMissingAmountAccountClarificationMessage_(parsed));

      return json_({
        ok: true,
        clarification_requested: true,
        clarification_type: 'missing_amount_account',
        amount: parsed.amount,
        category: parsed.category
      });
    }


    if (canAskMissingCategoryClarification_(parsed, effectiveRawText)) {
      savePendingClarification_(chatId, {
        type: 'missing_category',
        original_text: effectiveRawText,
        rawText: effectiveRawText,
        amount: parsed.amount,
        category: parsed.category,
        account: parsed.account,
        attempts: 0
      });

      sendTelegram_(chatId, buildMissingCategoryClarificationMessage_(parsed));

      return json_({
        ok: true,
        clarification_requested: true,
        clarification_type: 'missing_category',
        amount: parsed.amount,
        category: parsed.category,
        account: parsed.account
      });
    }

    if (canAskMissingAccountClarification_(parsed, effectiveRawText)) {
      savePendingClarification_(chatId, {
        type: 'missing_account',
        original_text: effectiveRawText,
        rawText: effectiveRawText,
        amount: parsed.amount,
        category: parsed.category,
        attempts: 0
      });

      sendTelegram_(chatId, buildMissingAccountClarificationMessage_(parsed));

      return json_({
        ok: true,
        clarification_requested: true,
        missing_field: 'account',
        amount: parsed.amount,
        category: parsed.category
      });
    }

    // Legacy staging removed. Final path writes directly to routed finance tabs.
    // Final path writes directly to routed finance tabs.
    const stagingResult = {
      rowId: makeTxnId_(msg, effectiveRawText)
    };

    const finalTab = parsed.needsReview ? AIRO_CONFIG.tabs.review : plannedTab;
    const routedResult = writeRouted_(ss, finalTab, parsed, effectiveRawText, stagingResult);

    const tabLink = routedResult.tabUrl || getSheetTabUrlByName_(ss, routedResult.writtenTab || finalTab);

    const reply =
      '✅ Tercatat ke Google Sheet.\n\n' +
      'Rencana tab: ' + plannedTab + '\n' +
      'Ditulis ke: ' + (routedResult.writtenTab || finalTab) + '\n' +
      'Akun: ' + parsed.account + '\n' +
      'Kategori: ' + parsed.category + '\n' +
      'Nominal: Rp' + parsed.amount + '\n\n' +
      '🔗 Buka tab: ' + tabLink;

    sendTelegram_(chatId, reply);

    return json_({
      ok: true,
      appended: true,
      planned_tab: plannedTab,
      written_tab: routedResult.writtenTab || finalTab,
      routed_status: routedResult.status,
      row: routedResult.row || '',
      row_id: routedResult.rowId || '',
      write_verified: routedResult.writeVerified === true,
      readback_raw_text: routedResult.readbackRawText || '',
      spreadsheet_marker: routedResult.spreadsheetMarker || safeSpreadsheetMarker_(ss),
      amount: parsed.amount,
      category: parsed.category,
      account: parsed.account
    });
  } catch (err) {
    return json_({ ok: false, error: String(err && err.message ? err.message : err) });
  }
}


function makeTxnId_(msg, rawText) {
  const messageId = msg && msg.message_id ? String(msg.message_id) : 'no_msg_id';
  const chatId = msg && msg.chat && msg.chat.id ? String(msg.chat.id) : 'no_chat_id';
  const date = msg && msg.date ? String(msg.date) : String(Date.now());
  const textHash = Utilities.base64EncodeWebSafe(
    Utilities.computeDigest(
      Utilities.DigestAlgorithm.SHA_256,
      String(rawText || '')
    )
  ).slice(0, 16);

  return 'tg:' + chatId + ':' + messageId + ':' + date + ':' + textHash;
}


function findCashLedgerExactHeaderCol_(sheet, headerName) {
  try {
    if (!sheet) return 0;
    const lastCol = Math.max(sheet.getLastColumn(), 1);
    const headers = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
    const target = String(headerName || '').toLowerCase().trim();
    for (var i = 0; i < headers.length; i++) {
      const h = String(headers[i] || '').toLowerCase().trim();
      if (h === target) return i + 1;
    }
  } catch (e) {}
  return 0;
}

function syncCashLedgerRuntimeAmountColumns_(ss, rowNumber, inflow, amount) {
  try {
    const sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.cash);
    if (!sheet || !rowNumber || rowNumber <= 1) return;
    const inCol = findCashLedgerExactHeaderCol_(sheet, 'amount_in');
    const outCol = findCashLedgerExactHeaderCol_(sheet, 'amount_out');
    if (inCol) sheet.getRange(rowNumber, inCol).setValue(inflow ? amount : '');
    if (outCol) sheet.getRange(rowNumber, outCol).setValue(inflow ? '' : amount);
  } catch (e) {}
}

function isCashLedgerCompatibilityWriteEnabled_() {
  const value = getProp_('AIRO_CASH_LEDGER_COMPAT_WRITES_ENABLED');
  if (value === null || value === undefined || String(value).trim() === '') {
    return false;
  }
  return /^(1|true|yes|on)$/i.test(String(value).trim());
}

function getFinanceEventsHeaders_() {
  return [
    'event_id',
    'event_ts',
    'event_type',
    'event_source',
    'source_tab',
    'source_row',
    'linked_txn_id',
    'account',
    'category',
    'amount',
    'direction',
    'status',
    'reason',
    'payload_json',
    'notes'
  ];
}

function ensureFinanceEventsSheet_(ss) {
  ss = ss || SpreadsheetApp.getActiveSpreadsheet();
  const headers = getFinanceEventsHeaders_();
  let sheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.financeEvents);
  if (!sheet) {
    sheet = ss.insertSheet(AIRO_CONFIG.tabs.financeEvents);
  }

  const existing = sheet
    .getRange(1, 1, 1, headers.length)
    .getValues()[0]
    .map(function(value) {
      return String(value || '').trim();
    });

  const needsHeader = existing.join('') === '' || headers.some(function(header, index) {
    return canonicalKey_(existing[index]) !== canonicalKey_(header);
  });

  if (needsHeader) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
  }

  return {
    ok: true,
    sheet: sheet,
    tabName: AIRO_CONFIG.tabs.financeEvents,
    headers: headers
  };
}

function financeEventPayloadJson_(payload) {
  if (payload === null || payload === undefined || payload === '') {
    return '';
  }

  try {
    const raw = typeof payload === 'string' ? payload : JSON.stringify(payload);
    if (/\b(otp|password|access_token|token|secret|pin)\b/i.test(raw)) {
      return JSON.stringify({
        redacted: true,
        reason: 'sensitive_payload_blocked'
      });
    }
    return String(raw).slice(0, 2000);
  } catch (err) {
    return '';
  }
}

function buildFinanceEvent_(event) {
  event = event || {};
  return {
    event_id: event.event_id || ('fe:' + Utilities.getUuid()),
    event_ts: event.event_ts || new Date(),
    event_type: event.event_type || 'manual_event',
    event_source: event.event_source || 'system',
    source_tab: event.source_tab || '',
    source_row: event.source_row || '',
    linked_txn_id: event.linked_txn_id || event.entry_id || '',
    account: event.account || '',
    category: event.category || '',
    amount: event.amount || '',
    direction: event.direction || '',
    status: event.status || 'ok',
    reason: event.reason || '',
    payload_json: financeEventPayloadJson_(event.payload_json || event.payload || ''),
    notes: event.notes || ''
  };
}

function writeFinanceEvent_(ss, event) {
  ss = ss || SpreadsheetApp.getActiveSpreadsheet();
  ensureFinanceEventsSheet_(ss);
  const row = buildFinanceEvent_(event);
  return appendByHeader_(ss, AIRO_CONFIG.tabs.financeEvents, row, { createIfMissing: false });
