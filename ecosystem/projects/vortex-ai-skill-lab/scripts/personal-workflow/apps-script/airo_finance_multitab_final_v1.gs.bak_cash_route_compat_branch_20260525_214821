    const link = accountSheet ? getSheetTabUrl_(ss, accountSheet) : ss.getUrl();

    sendTelegram_(
      chatId,
      'Cash parity detail audit selesai.\n\n' +
      'Account Ledger Cash inflows recent/top:\n' +
      (recentAccount.map(formatAccountRow_).join('\n') || '-') + '\n\n' +
      'Cash Ledger inflows recent/top:\n' +
      (recentCash.map(formatCashRow_).join('\n') || '-') + '\n\n' +
      'Account total in: Rp' + accountTotalIn + '\n' +
      'Cash total in: Rp' + cashTotalIn + '\n' +
      'Delta in: Rp' + deltaIn + '\n\n' +
