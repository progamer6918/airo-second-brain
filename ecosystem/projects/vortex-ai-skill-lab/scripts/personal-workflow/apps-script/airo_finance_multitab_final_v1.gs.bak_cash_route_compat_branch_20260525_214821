  if (/^admin\s+(audit|check|cek)\s+cash\s+(parity|balance|total|ledger)/i.test(text)) {
    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
    const cashSheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.cash);
    const accountSheet = getSheetLoose_(ss, AIRO_CONFIG.tabs.accountLedger);

    const normalizeHeader_ = function(value) {
      return String(value || '').toLowerCase().replace(/[^a-z0-9_]+/g, '_').replace(/^_+|_+$/g, '');
    };

    const toNumber_ = function(value) {
      if (typeof value === 'number') return value;
      const cleaned = String(value || '').replace(/[^0-9,.-]/g, '').replace(/\./g, '').replace(',', '.');
      const parsed = Number(cleaned);
      return isNaN(parsed) ? 0 : parsed;
    };

    const headerInfo_ = function(sheet) {
      if (!sheet) return { headers: [], normalized: [] };
      const lastCol = Math.max(sheet.getLastColumn(), 1);
      const headers = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
      return {
        headers: headers,
        normalized: headers.map(normalizeHeader_)
      };
    };

    const findColumn_ = function(info, aliases, fallbackIndex) {
      for (var i = 0; i < info.normalized.length; i++) {
        for (var j = 0; j < aliases.length; j++) {
          if (info.normalized[i] === aliases[j]) {
            return i + 1;
          }
        }
      }
      for (var i2 = 0; i2 < info.normalized.length; i2++) {
        for (var j2 = 0; j2 < aliases.length; j2++) {
          if (String(aliases[j2] || "").length >= 5 && info.normalized[i2].indexOf(aliases[j2]) >= 0) {
            return i2 + 1;
          }
        }
      }
      return fallbackIndex;
    };

    const sumDisplayColumn_ = function(sheet, colIndex) {
      if (!sheet || !colIndex) return 0;
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return 0;
      const values = sheet.getRange(2, colIndex, lastRow - 1, 1).getDisplayValues();
      return values.reduce(function(total, row) {
        return total + toNumber_(row[0]);
      }, 0);
    };

    const sumCashLedgerInWithFallback_ = function(sheet, cashInCol, info) {
      if (!sheet) return 0;
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return 0;
      const amountStartCol = findColumn_(info, ['amount_start', 'start_amount'], 3);
      const typeCol = findColumn_(info, ['type', 'jenis'], 16);
      const statusCol = findColumn_(info, ['status'], 10);
      const width = Math.max(cashInCol, amountStartCol, typeCol, statusCol);
      const values = sheet.getRange(2, 1, lastRow - 1, width).getDisplayValues();
      return values.reduce(function(total, row) {
        const primary = toNumber_(row[cashInCol - 1]);
        if (primary > 0) return total + primary;
        const amountStart = toNumber_(row[amountStartCol - 1]);
        const typeVal = String(row[typeCol - 1] || '').trim().toLowerCase();
        const statusVal = String(row[statusCol - 1] || '').trim().toLowerCase();
        if (
          amountStart > 0 &&
          (typeVal === 'income' || typeVal === 'transfer_in' || typeVal === 'cash_in' || statusVal === 'aktif')
        ) {
          return total + amountStart;
        }
        return total;
      }, 0);
