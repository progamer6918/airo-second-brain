      const isSudahBlu =
        status.indexOf('sudah') >= 0 ||
        status.indexOf('paid') >= 0 ||
        status.indexOf('posted') >= 0 ||
        status.indexOf('transferred') >= 0;

      if (cycleId === payableCycle.id) {
        stats.payable_total += amount;
        stats.payable_rows++;
        if (isSudahBlu) stats.payable_sudah_blu += amount;
        else stats.payable_belum_blu += amount;
      }

      if (cycleId === currentCycle.id) {
        stats.unbilled_total += amount;
        stats.unbilled_rows++;
        if (isSudahBlu) stats.unbilled_sudah_blu += amount;
        else stats.unbilled_belum_blu += amount;
      }
    });
  }

  const overdue = todayDate_() > payableDueDate && stats.payable_belum_blu > 0;
