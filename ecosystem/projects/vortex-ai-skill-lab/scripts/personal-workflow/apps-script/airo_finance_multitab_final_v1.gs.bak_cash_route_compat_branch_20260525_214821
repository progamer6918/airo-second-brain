    if (resolvedText === 'DEBT_PIUTANG_HELP_ONLY') {
      clearPendingClarification_(chatId);
      sendTelegram_(
        chatId,
        'Saya belum mencatat piutang/orang bayar hutang ke saya karena flow piutang belum dikunci.\n\n' +
        'Untuk sekarang tulis manual nanti setelah flow piutang tersedia.'
      );

      return {
        handled: true,
        cancelled: true
      };
    }

    if (!resolvedText) {
      clearPendingClarification_(chatId);
      sendTelegram_(
        chatId,
        'Saya belum mencatat transaksi Hutang ini.\n\n' +
        'Tulis ulang lengkap, contoh:\n' +
        '- pinjam dari Budi 50000\n' +
        '- bayar hutang ke Budi 50000 dari bca'
      );

      return {
        handled: true,
        cancelled: true
      };
    }

    clearPendingClarification_(chatId);

    return {
      handled: false,
      resolved: true,
      original_text: pending.original_text || '',
      resolved_text: resolvedText
    };
  }

  if (pending.type === 'missing_category') {
    const resolvedText = missingCategoryClarificationResolvedText_(pending, rawText);

    if (resolvedText === 'MISSING_CATEGORY_MANUAL') {
      clearPendingClarification_(chatId);
      sendTelegram_(
        chatId,
        'Saya belum mencatat transaksi ini.\n\n' +
        'Tulis ulang lengkap, contoh:\n' +
        '- bayar 24000 bca untuk makan\n' +
        '- bayar 24000 bca tagihan\n' +
        '- bca keluar 24000 buat transport'
      );

      return {
        handled: true,
        cancelled: true
      };
    }

    if (!resolvedText) {
      return failOrRetry_(
        'Saya belum bisa memastikan kategorinya.\n\n' +
        'Pilih salah satu:\n' +
        'A. Makan / minum\n' +
        'B. Transport / bensin\n' +
        'C. Tagihan\n' +
        'D. Belanja\n' +
        'E. Tulis manual'
      );
    }

    clearPendingClarification_(chatId);

    return {
      handled: false,
      resolved: true,
      original_text: pending.original_text || '',
      resolved_text: resolvedText
    };
  }

  if (pending.type === 'transfer_incomplete') {
    const resolvedText = transferClarificationResolvedText_(pending, rawText);

    if (!resolvedText) {
      clearPendingClarification_(chatId);
      sendTelegram_(
        chatId,
        'Saya belum mencatat transfer ini.\n\n' +
        'Tulis ulang lengkap, contoh:\n' +
        '- transfer 100000 dari bca ke blu\n' +
        '- transfer 50rb dari blu ke bca\n' +
        '- transfer 25rb dari bca ke cash'
      );

      return {
        handled: true,
        cancelled: true
      };
    }

    clearPendingClarification_(chatId);

    return {
      handled: false,
      resolved: true,
      original_text: pending.original_text || '',
      resolved_text: resolvedText
    };
  }

  if (pending.type === 'direction_ambiguous') {
    const resolvedText = directionClarificationResolvedText_(pending, rawText);

    if (!resolvedText) {
      return failOrRetry_(
        'Saya belum bisa memastikan arah transaksinya.\n\n' +
        'Pilih salah satu:\n' +
        'A. Uang keluar\n' +
        'B. Uang masuk\n' +
        'C. Transfer\n' +
        'D. Saldo awal/saldo tercatat\n' +
        'E. Lainnya / tulis manual\n\n' +
        'Untuk transfer, tulis lengkap saja, contoh: transfer 50000 dari bca ke blu.'
      );
    }

    clearPendingClarification_(chatId);

    return {
      handled: false,
      resolved: true,
      original_text: pending.original_text || '',
      resolved_text: resolvedText,
      account: pending.account
    };
  }

  if (pending.type === 'cash_ambiguous') {
    const resolvedText = cashClarificationResolvedText_(pending, rawText);

    if (!resolvedText) {
      return failOrRetry_(
        'Saya belum bisa memastikan maksud cash-nya.\n\n' +
        'Pilih salah satu:\n' +
        'A. Cash masuk\n' +
        'B. Cash keluar\n' +
        'C. Saldo cash awal / saya pegang cash\n' +
        'D. Sisa cash\n' +
        'E. Lainnya / tulis manual'
      );
    }

    clearPendingClarification_(chatId);

    return {
      handled: false,
      resolved: true,
      original_text: pending.original_text || '',
      resolved_text: resolvedText,
      account: 'Cash'
    };
  }

  if (pending.type === 'missing_account') {
    const account = normalizeClarificationAccountAnswer_(rawText);

    if (!account || account === 'manual') {
