}


function normalizeCashClarificationAnswer_(text) {
  const t = String(text || '').toLowerCase().trim();

  if (/^(a|1)$/i.test(t) || /\b(masuk|terima|diterima|income|pemasukan)\b/i.test(t)) return 'cash_in';
  if (/^(b|2)$/i.test(t) || /\b(keluar|kepake|terpakai|pakai|bayar|beli|expense|pengeluaran)\b/i.test(t)) return 'cash_out';
  if (/^(c|3)$/i.test(t) || /\b(pegang|saldo awal|awal|start)\b/i.test(t)) return 'cash_start';
  if (/^(d|4)$/i.test(t) || /\b(sisa|remaining|saldo akhir|akhir)\b/i.test(t)) return 'cash_remaining';
  if (/^(e|5)$/i.test(t) || /\b(lain|lainnya|manual)\b/i.test(t)) return 'manual';

  return '';
}

function canAskCashAmbiguousClarification_(parsed, rawText) {
  const text = String(rawText || '').toLowerCase();
  const amount = Number((parsed && parsed.amount) || 0);
  const account = String((parsed && parsed.account) || '').trim().toLowerCase();
  const category = String((parsed && parsed.category) || '').trim().toLowerCase();

  if (amount <= 0) return false;
  if (account !== 'cash') return false;
  if (!/\b(cash|tunai)\b/i.test(text)) return false;

  const hasClearMeaning = /\b(masuk|keluar|terima|diterima|beli|bayar|kepake|terpakai|pegang|saldo|sisa|dari|ke|bensin|bbm)\b/i.test(text);

  return !hasClearMeaning || category === 'lainnya';
}

function buildCashAmbiguousClarificationMessage_(parsed) {
