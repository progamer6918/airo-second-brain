    if (cashSheet && cashSheet.getLastRow() >= 2) {
      const width = Math.max(cashDateCol, cashInCol, cashDescCol, cashAmountStartCol, cashTypeCol, cashStatusCol);
      const values = cashSheet.getRange(2, 1, cashSheet.getLastRow() - 1, width).getDisplayValues();
      values.forEach(function(row, idx) {
        const amount = cashInAmountFromRow_(row);
        if (amount > 0) {
          cashTotalIn += amount;
          cashRows.push({
            row: idx + 2,
            amount: amount,
            date: row[cashDateCol - 1],
            description: row[cashDescCol - 1]
          });
        }
      });
    }

    const recentAccount = accountRows.slice(-8).reverse();
    const recentCash = cashRows.slice(-8).reverse();
    const deltaIn = accountTotalIn - cashTotalIn;

    const formatAccountRow_ = function(item) {
      return '#' + item.row + ' Rp' + item.amount + ' ' + shorten_(item.date) + ' [' + shorten_(item.source) + '] ' + shorten_(item.description);
