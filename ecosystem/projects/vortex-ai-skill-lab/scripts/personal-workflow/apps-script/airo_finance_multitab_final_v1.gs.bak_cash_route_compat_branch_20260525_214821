    const accountDateCol = findColumn_(accountInfo, ['date', 'tanggal', 'tgl'], 2);
    const accountCol = findColumn_(accountInfo, ['account', 'akun', 'wallet', 'rekening'], 3);
    const accountInCol = findColumn_(accountInfo, ['amount_in', 'cash_in', 'nominal_masuk', 'masuk'], 4);
    const accountDescCol = findColumn_(accountInfo, ['description', 'deskripsi'], 9);
