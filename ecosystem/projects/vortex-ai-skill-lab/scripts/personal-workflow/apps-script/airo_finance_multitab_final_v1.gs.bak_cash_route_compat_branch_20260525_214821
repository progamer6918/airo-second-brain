  header = findCcHeaderRow_(cc);
  const refreshedMap = ccColMap_(header.headers);
  const refreshedLastRow = cc.getLastRow();
  const refreshedLastCol = cc.getLastColumn();

  if (refreshedLastRow > header.row && refreshedMap.billing_cycle_id) {
    const dataRange = cc.getRange(header.row + 1, 1, refreshedLastRow - header.row, refreshedLastCol);
