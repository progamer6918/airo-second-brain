      const typeVal = String(row[cashTypeCol - 1] || '').trim().toLowerCase();
      const statusVal = String(row[cashStatusCol - 1] || '').trim().toLowerCase();
      if (
        amountStart > 0 &&
        (typeVal === 'income' || typeVal === 'transfer_in' || typeVal === 'cash_in' || statusVal === 'aktif')
