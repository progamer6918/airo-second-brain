    if (canAskAssetGoldAmbiguousClarification_(parsed, effectiveRawText)) {
      savePendingClarification_(chatId, {
        type: 'asset_gold_ambiguous',
        original_text: effectiveRawText,
        rawText: effectiveRawText,
