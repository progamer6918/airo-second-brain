function reserveTelegramUpdateOnce_(update, message, rawText) {
  const key = makeTelegramDedupeKey_(update, message, rawText);

  if (!key) {
    return { ok: true, key: '' };
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(7000);

  try {
    const ss = SpreadsheetApp.openById(getProp_('SPREADSHEET_ID'));
    const sheet = getOrCreateDedupeSheet_(ss);

    const found = sheet
      .createTextFinder(key)
      .matchEntireCell(true)
      .findNext();

    if (found) {
      return {
        ok: true,
        duplicate: true,
        key
      };
    }

    sheet.appendRow([
      key,
      new Date(),
      update && update.update_id ? update.update_id : '',
      message && message.chat && message.chat.id ? message.chat.id : '',
      message && message.message_id ? message.message_id : '',
      String(rawText || '').slice(0, 500)
    ]);

    return {
      ok: true,
      duplicate: false,
      key
    };
  } finally {
    try {
      lock.releaseLock();
    } catch (err) {}
  }
}

function makeTelegramDedupeKey_(update, message, rawText) {
  const updateId = update && update.update_id ? String(update.update_id) : '';
  const chatId = message && message.chat && message.chat.id ? String(message.chat.id) : '';
  const messageId = message && message.message_id ? String(message.message_id) : '';
  const text = String(rawText || '');

  if (!updateId && !chatId && !messageId && !text) {
    return '';
  }

  const hash = Utilities.base64EncodeWebSafe(
    Utilities.computeDigest(
      Utilities.DigestAlgorithm.SHA_256,
      [updateId, chatId, messageId, text].join('|')
    )
  ).slice(0, 24);

