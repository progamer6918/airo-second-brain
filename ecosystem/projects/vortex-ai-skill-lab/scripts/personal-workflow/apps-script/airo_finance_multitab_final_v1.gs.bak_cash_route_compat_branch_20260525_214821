  const physicalGram = Number(parsed.goldWeightGram || 0);
  const karat = Number(parsed.goldKarat || 24);
  const pureGram = physicalGram && karat ? physicalGram * karat / 24 : physicalGram;
  const purchasePrice = Number(parsed.goldPurchasePrice || 0);
  const action = parsed.goldAction || parseGoldAction_(rawText);

  if (!physicalGram || physicalGram <= 0) {
    return {
      status: 'fallback',
      writtenTab: sheet.getName(),
      reason: 'gold_weight_missing'
    };
  }

  const pureGramRounded = roundGoldGram_(pureGram);
  const isSell = action === 'sell';

  const gramsIn = isSell ? '' : pureGramRounded;
  const gramsOut = isSell ? pureGramRounded : '';

  const pricePerGram = purchasePrice && physicalGram
    ? Math.round(purchasePrice / physicalGram)
    : price24k;

  const totalAmount = purchasePrice || (price24k && pureGramRounded ? Math.round(price24k * pureGramRounded) : '');

  const notes = [
    parsed.goldNotes ? 'catatan: ' + parsed.goldNotes : '',
    'berat_fisik: ' + physicalGram + ' gr',
    'karat: ' + karat + 'K',
    'gram_setara_24k: ' + pureGramRounded + ' gr',
    isSell ? 'gold_outflow: true' : ''
  ].filter(Boolean).join(' | ');

  const targetRow = findNextGoldLedgerRow_(sheet, headerRow);

  // Gold Ledger fixed columns:
  // A gold_event_id
  // B date
  // C action
  // D grams_in
  // E grams_out
  // F price_per_gram
  // G fee
  // H total_amount
  // I source_account
  // J source
  // K raw_text
  // L notes, if column exists
  const row = [
    common.linked_txn_id || makeTxnId_({}, rawText),
    parsed.goldPurchaseDate || parsed.date || parseDate_(rawText),
    isSell ? 'sell' : 'buy',
    gramsIn,
    gramsOut,
    pricePerGram || '',
    '',
    totalAmount || '',
    parsed.account && parsed.account !== 'Unknown' ? parsed.account : '',
    'telegram',
    rawText,
    notes
  ];

  const width = Math.min(row.length, Math.max(sheet.getLastColumn(), 11));
  sheet.getRange(targetRow, 1, 1, width).setValues([row.slice(0, width)]);

  return {
    status: 'written',
    writtenTab: sheet.getName(),
    row: targetRow,
    rowId: sheet.getName() + ':' + targetRow,
    tabUrl: getSheetTabUrl_(SpreadsheetApp.openById(getProp_('SPREADSHEET_ID')), sheet),
    section: 'gold'
  };
}





function findGoldLedgerHeader_(sheet) {
  const maxRows = Math.min(sheet.getLastRow(), 80);
  const maxCols = Math.min(sheet.getLastColumn(), 20);
  const values = sheet.getRange(1, 1, maxRows, maxCols).getValues();

  for (let r = 0; r < values.length; r++) {
    const normalized = values[r].map(v => canonicalKey_(v));

    const hasGoldEvent = normalized.includes('gold_event_id');
    const hasGramsIn = normalized.includes('grams_in');
    const hasRawText = normalized.includes('raw_text');

    if (hasGoldEvent && hasGramsIn && hasRawText) {
      const lastNonEmpty = values[r].reduce((last, v, idx) => {
        return String(v || '').trim() ? idx + 1 : last;
      }, 0);

      return {
        row: r + 1,
        headers: values[r].slice(0, lastNonEmpty).map(v => String(v || '').trim())
      };
    }
  }

  return null;
}

function goldFieldForHeader_(header) {
  const h = canonicalKey_(header);

  const aliases = {
    gold_event_id: ['gold_event_id', 'event_id', 'id'],
    date: ['date', 'tanggal', 'tanggal_beli', 'purchase_date'],
