  );
}

function missingCategoryClarificationResolvedText_(pending, rawText) {
  const c = normalizeMissingCategoryClarificationAnswer_(rawText);
  const originalText = String((pending && pending.original_text) || '').trim();

  if (c === 'makan') return originalText + ' makan';
  if (c === 'transport') return originalText + ' transport';
  if (c === 'tagihan') return originalText + ' tagihan';
  if (c === 'belanja') return originalText + ' belanja';
  if (c === 'manual') return 'MISSING_CATEGORY_MANUAL';

  return '';
}

function canAskMissingAccountClarification_(parsed, rawText) {
  const text = String(rawText || '').toLowerCase();

  if (!parsed) return false;
  if (!parsed.amount || Number(parsed.amount) <= 0) return false;

  const account = String(parsed.account || '').trim().toLowerCase();
  if (account && account !== 'unknown') return false;

  const category = String(parsed.category || '').trim().toLowerCase();
  if (!category || category === 'lainnya') return false;

  // First implementation target: regular expense-like purchase, not debts/assets/cash movement/CC payment.
  if (/\b(hutang|utang|pinjam|pinjaman|cicilan rumah|kpr|angsuran rumah|emas|gold|aset|transfer|tf|topup|tarik|cash|tunai|cc|credit card|kartu kredit)\b/i.test(text)) {
    return false;
  }

  if (!/\b(beli|bayar|jajan|makan|minum|kopi|sarapan|siang|malam)\b/i.test(text)) {
    return false;
  }

  return true;
}

