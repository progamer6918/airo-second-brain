[Unit]
Description=AIRO Earesmes Telegram Gateway Ingress Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AI_WORKSPACES/airo-second-brain
ExecStart=/usr/bin/python3 ops/telegram/telegram-gateway.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ubuntu/.airo/telegram.env

[Install]
WantedBy=multi-user.target
