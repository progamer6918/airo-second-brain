[Unit]
Description=AIRO Earesmes Telegram Gateway Ingress Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/egitaristorandas/AI_WORKSPACES/airo-second-brain
ExecStart=/usr/bin/python3 ops/telegram/telegram-gateway.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
